---
import designs from "../../../data/suzuri-designs.json";
import ZhKoGoodsDetailPage from "../../../components/ZhKoGoodsDetailPage.astro";

export function getStaticPaths() {
  return designs.map((design) => ({ params: { id: String(design.id) }, props: { design } }));
}
const { design } = Astro.props;
---
<ZhKoGoodsDetailPage design={design} locale="zh-tw" />
