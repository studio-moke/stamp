---
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { absoluteUrl } from "../lib/seo";
const title = "お知らせ｜新作LINEスタンプ・SUZURI・無料ツール・フリー素材 | stamp moke";
const description = "stamp mokeの新作LINEスタンプ、SUZURIグッズ、無料ツール、フリー素材の更新情報をお届けします。";
const canonical = absoluteUrl("/news/");
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <SeoHead title={title} description={description} canonical={canonical} locale="ja" path="/news/" />
  <Analytics />
  <link rel="stylesheet" href="/news.css?v=20260907-1" />
</head>
<body class="news-page">
  <SiteHeader locale="ja" path="/news/" />
  <section class="hero"><div class="hero-inner"><h1>お知らせ</h1><p>stamp moke の最新情報をお届けします。</p></div></section>
  <div id="index-view"><main class="content"><div class="filters" id="filters"></div><div class="list" id="news-list"><div class="empty">お知らせを読み込んでいます…</div></div></main></div>
  <main class="article-shell" id="article-shell"><a class="back" href="/news/">← お知らせ一覧へ</a><article class="article" id="article"></article></main>
  <footer class="footer">© stamp moke</footer>
  <script is:inline>
    const listEl=document.getElementById('news-list'),filtersEl=document.getElementById('filters'),article=document.getElementById('article'),articleShell=document.getElementById('article-shell'),indexView=document.getElementById('index-view');
    const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const cleanBody=s=>String(s||'')
      .replace(/(?:^|\s)詳しくはこちら[：:]\s*(?:https?:\/\/[^\s]+|\/[^\s]+)/gi,'')
      .replace(/(?:^|\s)詳細はこちら[：:]\s*(?:https?:\/\/[^\s]+|\/[^\s]+)/gi,'')
      .replace(/\s{2,}/g,' ')
      .trim();
    const sourceUrl=n=>{let u=String(n?.url||'/');if(n?.type==='free'||n?.type==='free-day')u=u.replace(/\/+$/,'')||'/free';return u||'/'};
    const freeSlug=n=>{if(n?.type!=='free')return'';const id=String(n?.id||'');if(id.startsWith('free:'))return id.slice(5);const m=sourceUrl(n).match(/\/free\/([^/?#]+)/);if(!m)return'';try{return decodeURIComponent(m[1])}catch{return m[1]}};
    const imageUrl=n=>{const direct=n?.image||n?.thumbnail||n?.imageUrl||n?.ogImage||n?.previewUrl||n?.preview||'';if(direct)return direct;const slug=freeSlug(n);return slug?`/api/free?route=preview&slug=${encodeURIComponent(slug)}`:''};
    const fallbackLogo='/favicon.svg?v=20260906-2';
    const thumbMarkup=img=>img
      ? `<img src="${esc(img)}" alt="" loading="lazy" onerror="this.onerror=null;this.src='${fallbackLogo}';this.classList.add('fallback-logo')">`
      : `<img class="fallback-logo" src="${fallbackLogo}" alt="stamp moke" loading="lazy">`;
    const qs=new URLSearchParams(location.search);let all=[];
    async function load(){try{const r=await fetch('/api/news?limit=80&sync=0');const d=await r.json();all=d.items||[];const slug=qs.get('slug');if(slug)return showArticle(all.find(x=>x.slug===slug));renderFilters();render(all)}catch(e){listEl.innerHTML='<div class="empty">お知らせを読み込めませんでした。</div>'}}
    function renderFilters(){const types=[['all','すべて'],['sticker','LINEスタンプ'],['suzuri','SUZURI'],['tool','無料ツール'],['free','フリー素材']];filtersEl.innerHTML=types.map(([v,l],i)=>`<button class="filter${i===0?' on':''}" data-type="${v}">${l}</button>`).join('');filtersEl.addEventListener('click',e=>{const b=e.target.closest('.filter');if(!b)return;filtersEl.querySelectorAll('.filter').forEach(x=>x.classList.remove('on'));b.classList.add('on');const type=b.dataset.type;render(type==='all'?all:all.filter(x=>type==='free'?(x.type==='free'||x.type==='free-day'):x.type===type))})}
    function render(rows){listEl.innerHTML=rows.length?rows.map(n=>{const img=imageUrl(n);return `<a class="card" href="/news/?slug=${encodeURIComponent(n.slug)}"><div class="thumb">${thumbMarkup(img)}</div><div><div class="meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="label">${esc(n.label)}</span></div><h2>${esc(n.title)}</h2>${n.lead?`<p class="summary">${esc(n.lead)}</p>`:''}</div><div class="arrow">›</div></a>`}).join(''):'<div class="empty">まだお知らせはありません。</div>'}
    function showArticle(n){indexView.style.display='none';articleShell.classList.add('show');if(!n){article.innerHTML='<p>記事が見つかりませんでした。</p>';return}const img=imageUrl(n),body=cleanBody(n?.body||n?.lead||n?.sourceDescription||'');const ctaLabel=n.type==='sticker'?'このLINEスタンプを見る':n.type==='suzuri'?'グッズを見る':n.type==='tool'?'無料ツールを使う':n.type==='site'?'TOPページを見る':'素材を見る';article.innerHTML=`<div class="meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="label">${esc(n.label)}</span></div><h1>${esc(n.title)}</h1>${img?`<div class="article-image"><img src="${esc(img)}" alt="${esc(n.sourceTitle||n.title||'')}" /></div>`:''}${body?`<div class="body">${esc(body)}</div>`:''}<a class="cta" href="${esc(sourceUrl(n))}">${ctaLabel}　›</a>`}
    load();
  </script>
</body>
</html>