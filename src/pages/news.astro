---
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import { absoluteUrl } from "../lib/seo";
const title = "NEWS｜新作LINEスタンプ・SUZURI・無料ツール・フリー素材 | stamp moke";
const description = "stamp mokeの新作LINEスタンプ、SUZURIグッズ、無料ツール、フリー素材の更新情報。新作のコンセプトや使いどころを、少しフランクな短い記事で紹介します。";
const canonical = absoluteUrl("/news/");
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <SeoHead title={title} description={description} canonical={canonical} locale="ja" path="/news/" />
  <Analytics />
  <style>
    *{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.head{position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;height:76px;padding:0 5vw;background:rgba(255,255,255,.96);border-bottom:1px solid #e5e3dd;backdrop-filter:blur(10px)}.brand{font-weight:900;letter-spacing:.08em;text-decoration:none}.back{padding:10px 14px;border:1px solid #d9d7d0;border-radius:999px;background:#fff;color:#171717;text-decoration:none;font-size:12px;font-weight:800}.wrap{max-width:980px;margin:auto;padding:58px 5vw 100px}.kicker{font-size:10px;font-weight:900;letter-spacing:.2em;color:#777}.title{margin:10px 0 14px;font-size:clamp(38px,7vw,68px);letter-spacing:-.05em}.lead{max-width:720px;color:#666;line-height:1.9;font-size:14px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:28px 0}.filter{border:1px solid #d9d7d0;background:#fff;border-radius:999px;padding:9px 13px;font-weight:800;font-size:11px;cursor:pointer}.filter.on{background:#171717;color:#fff;border-color:#171717}.list{display:grid;gap:12px}.card{display:grid;grid-template-columns:110px 1fr auto;gap:18px;align-items:center;padding:18px;background:#fff;border:1px solid #e1dfd9;border-radius:18px;text-decoration:none;color:inherit;transition:.2s}.card:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,0,0,.06)}.date{font-size:11px;color:#777}.label{display:inline-flex;margin-bottom:7px;padding:5px 8px;background:#f1f0eb;border-radius:999px;font-size:9px;font-weight:900}.card h2{margin:0;font-size:16px;line-height:1.55}.arrow{font-size:18px}.article{display:none;background:#fff;border:1px solid #e1dfd9;border-radius:22px;padding:34px;margin-top:26px}.article.show{display:block}.article .meta{display:flex;gap:10px;align-items:center;color:#777;font-size:11px}.article h1{font-size:clamp(28px,5vw,44px);line-height:1.35;margin:16px 0}.article .article-lead{font-size:17px;font-weight:800;line-height:1.8}.article .body{color:#555;font-size:14px;line-height:2;margin-top:18px}.article .cta{display:inline-flex;margin-top:24px;padding:12px 17px;border-radius:999px;background:#171717;color:#fff;text-decoration:none;font-size:12px;font-weight:900}.empty{padding:30px;text-align:center;color:#777}.footer{padding:35px 5vw;background:#171717;color:#999;font-size:11px;text-align:center}@media(max-width:640px){.wrap{padding:38px 18px 70px}.card{grid-template-columns:1fr auto;gap:10px}.date{grid-column:1/-1}.article{padding:23px}.head{padding:0 18px}.title{font-size:42px}}
  </style>
</head>
<body>
  <header class="head"><a class="brand" href="/">stamp moke</a><a class="back" href="/">TOPへ戻る</a></header>
  <main class="wrap">
    <div id="index-view">
      <div class="kicker">NEWS / stamp moke</div>
      <h1 class="title">NEWS</h1>
      <p class="lead">新作LINEスタンプ、SUZURIグッズ、無料ツール、フリー素材。stamp mokeで増えたものを、そのコンセプトや使いどころと一緒に短く紹介します。</p>
      <div class="filters" id="filters"></div>
      <div class="list" id="news-list"><div class="empty">NEWSを読み込んでいます…</div></div>
    </div>
    <article class="article" id="article"></article>
  </main>
  <footer class="footer">© stamp moke / NEWS</footer>
  <script is:inline>
    const listEl=document.getElementById('news-list'),filtersEl=document.getElementById('filters'),article=document.getElementById('article'),indexView=document.getElementById('index-view');
    const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const qs=new URLSearchParams(location.search);let all=[];
    async function load(){try{const r=await fetch('/api/news?limit=80');const d=await r.json();all=d.items||[];const slug=qs.get('slug');if(slug)return showArticle(all.find(x=>x.slug===slug));renderFilters();render(all);}catch(e){listEl.innerHTML='<div class="empty">NEWSを読み込めませんでした。</div>'}}
    function renderFilters(){const types=[['all','すべて'],['sticker','LINEスタンプ'],['suzuri','SUZURI'],['tool','無料ツール'],['free','フリー素材']];filtersEl.innerHTML=types.map(([v,l],i)=>`<button class="filter${i===0?' on':''}" data-type="${v}">${l}</button>`).join('');filtersEl.addEventListener('click',e=>{const b=e.target.closest('.filter');if(!b)return;filtersEl.querySelectorAll('.filter').forEach(x=>x.classList.remove('on'));b.classList.add('on');render(b.dataset.type==='all'?all:all.filter(x=>x.type===b.dataset.type))})}
    function render(rows){listEl.innerHTML=rows.length?rows.map(n=>`<a class="card" href="/news/?slug=${encodeURIComponent(n.slug)}"><div class="date">${esc((n.date||'').replaceAll('-','/'))}</div><div><span class="label">${esc(n.label)}</span><h2>${esc(n.title)}</h2></div><div class="arrow">→</div></a>`).join(''):'<div class="empty">まだNEWSはありません。</div>'}
    function showArticle(n){if(!n){article.classList.add('show');article.innerHTML='<p>記事が見つかりませんでした。</p>';return}indexView.style.display='none';article.classList.add('show');article.innerHTML=`<div class="meta"><span>${esc((n.date||'').replaceAll('-','/'))}</span><span class="label">${esc(n.label)}</span></div><h1>${esc(n.title)}</h1><div class="article-lead">${esc(n.lead)}</div><div class="body">${esc(n.body)}</div><a class="cta" href="${esc(n.url)}">${n.type==='sticker'?'このLINEスタンプを見る':n.type==='suzuri'?'グッズを見る':n.type==='tool'?'無料ツールを使う':'素材を見る'} →</a>`}
    load();
  </script>
</body>
</html>
