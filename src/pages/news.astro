---
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import { absoluteUrl } from "../lib/seo";
const title = "お知らせ｜新作LINEスタンプ・SUZURI・無料ツール・フリー素材 | stamp moke";
const description = "stamp mokeの新作LINEスタンプ、SUZURIグッズ、無料ツール、フリー素材の更新情報をお届けします。";
const canonical = absoluteUrl("/news/");
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <SeoHead title={title} description={description} canonical={canonical} locale="ja" path="/news/" />
  <Analytics />
  <style is:global>
    *{box-sizing:border-box}body{margin:0;background:#fbfcfb;color:#141820;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}a{color:inherit}
    .hero{background:linear-gradient(105deg,#f2f8fa,#eef5f4 48%,#f8f7f0);border-bottom:1px solid #e9eeea}.hero-inner{max-width:1180px;margin:auto;padding:52px clamp(18px,4vw,56px)}.hero h1{margin:0;font-size:clamp(40px,6vw,64px);letter-spacing:-.05em}.hero p{margin:14px 0 0;color:#63706c;line-height:1.8}
    .content{max-width:1180px;margin:auto;padding:32px clamp(18px,4vw,56px) 90px}.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}.filter{min-height:42px;padding:0 20px;border:1px solid #e3e7e4;background:#f8faf9;border-radius:16px;font-size:12px;font-weight:850;cursor:pointer}.filter.on{background:#16a361;color:#fff;border-color:#16a361}
    .list{display:grid;gap:14px}.card{display:grid;grid-template-columns:225px 1fr 54px;gap:26px;align-items:center;padding:14px;background:#fff;border:1px solid #e1e7e3;border-radius:16px;text-decoration:none}.thumb{height:112px;border-radius:12px;overflow:hidden;background:#f3f4f3}.thumb img{width:100%;height:100%;object-fit:cover;display:block}.meta{display:flex;gap:10px;align-items:center;color:#7b8581;font-size:11px}.label{padding:6px 10px;border-radius:999px;background:#e4f2ff;font-size:10px;font-weight:900}.card h2{margin:8px 0 0;font-size:20px;line-height:1.45}.summary{margin:7px 0 0;color:#6f7a76;font-size:12px;line-height:1.75}.arrow{font-size:24px}
    .article-shell{display:none;max-width:900px;margin:auto;padding:42px clamp(18px,4vw,56px) 90px}.article-shell.show{display:block}.article{background:#fff;border:1px solid #e1e7e3;border-radius:24px;padding:clamp(26px,5vw,54px)}.article h1{margin:16px 0 0;font-size:clamp(30px,5vw,48px);line-height:1.35}.article-image{margin-top:28px;border-radius:18px;overflow:hidden;background:#f4f5f4}.article-image img{display:block;width:100%;max-height:520px;object-fit:contain}.body{margin-top:24px;color:#59635f;font-size:15px;line-height:2.05;white-space:pre-line}.cta{display:inline-flex;margin-top:30px;padding:13px 19px;border-radius:999px;background:#16a361;color:#fff;text-decoration:none;font-size:12px;font-weight:900}.back{display:inline-flex;margin-bottom:18px;text-decoration:none;font-size:12px;font-weight:800;color:#5f6b66}.empty{padding:42px;text-align:center;color:#7b8581;background:#fff;border:1px solid #e1e7e3;border-radius:16px}.footer{padding:36px 5vw;background:#14201a;color:#aeb8b2;font-size:11px;text-align:center}
    @media(max-width:680px){.content{padding:24px 14px 65px}.card{grid-template-columns:96px 1fr 30px;gap:12px;padding:10px}.thumb{height:92px}.card h2{font-size:14px}.summary{font-size:10px}.article-shell{padding:28px 14px 65px}.article{padding:24px 20px}.hero-inner{padding:38px 18px}.hero h1{font-size:42px}}
  </style>
</head>
<body>
  <section class="hero"><div class="hero-inner"><h1>お知らせ</h1><p>stamp moke の最新情報をお届けします。</p></div></section>
  <div id="index-view"><main class="content"><div class="filters" id="filters"></div><div class="list" id="news-list"><div class="empty">お知らせを読み込んでいます…</div></div></main></div>
  <main class="article-shell" id="article-shell"><a class="back" href="/news/">← お知らせ一覧へ</a><article class="article" id="article"></article></main>
  <footer class="footer">© stamp moke</footer>
  <script is:inline>
    const listEl=document.getElementById('news-list'),filtersEl=document.getElementById('filters'),article=document.getElementById('article'),articleShell=document.getElementById('article-shell'),indexView=document.getElementById('index-view');
    const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const cleanBody=s=>String(s||'')
      .replace(/(?:^|\s)詳しくはこちら[：:]\s*(?:https?:\/\/[^\s]+|\/[^\s]+)/gi,'')
      .replace(/(?:^|\s)詳細はこちら[：:]\s*(?:https?:\/\/[^\s]+|\/[^\s]+)/gi,'')
      .replace(/\s{2,}/g,' ')
      .trim();
    const sourceUrl=n=>{let u=String(n?.url||'/');if(n?.type==='free')u=u.replace(/\/+$/,'');return u||'/free/'};
    const freeSlug=n=>{if(n?.type!=='free')return'';const id=String(n?.id||'');if(id.startsWith('free:'))return id.slice(5);const m=sourceUrl(n).match(/\/free\/([^/?#]+)/);if(!m)return'';try{return decodeURIComponent(m[1])}catch{return m[1]}};
    const imageUrl=n=>{const direct=n?.image||n?.thumbnail||n?.imageUrl||n?.ogImage||n?.previewUrl||n?.preview||'';if(direct)return direct;const slug=freeSlug(n);return slug?`/api/free?route=preview&slug=${encodeURIComponent(slug)}`:''};
    const qs=new URLSearchParams(location.search);let all=[];
    async function load(){try{const r=await fetch('/api/news?limit=80&sync=0');const d=await r.json();all=d.items||[];const slug=qs.get('slug');if(slug)return showArticle(all.find(x=>x.slug===slug));renderFilters();render(all)}catch(e){listEl.innerHTML='<div class="empty">お知らせを読み込めませんでした。</div>'}}
    function renderFilters(){const types=[['all','すべて'],['sticker','LINEスタンプ'],['suzuri','SUZURI'],['tool','無料ツール'],['free','フリー素材']];filtersEl.innerHTML=types.map(([v,l],i)=>`<button class="filter${i===0?' on':''}" data-type="${v}">${l}</button>`).join('');filtersEl.addEventListener('click',e=>{const b=e.target.closest('.filter');if(!b)return;filtersEl.querySelectorAll('.filter').forEach(x=>x.classList.remove('on'));b.classList.add('on');render(b.dataset.type==='all'?all:all.filter(x=>x.type===b.dataset.type))})}
    function render(rows){listEl.innerHTML=rows.length?rows.map(n=>{const img=imageUrl(n);return `<a class="card" href="/news/?slug=${encodeURIComponent(n.slug)}"><div class="thumb">${img?`<img src="${esc(img)}" alt="" loading="lazy">`:''}</div><div><div class="meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="label">${esc(n.label)}</span></div><h2>${esc(n.title)}</h2>${n.lead?`<p class="summary">${esc(n.lead)}</p>`:''}</div><div class="arrow">›</div></a>`}).join(''):'<div class="empty">まだお知らせはありません。</div>'}
    function showArticle(n){indexView.style.display='none';articleShell.classList.add('show');if(!n){article.innerHTML='<p>記事が見つかりませんでした。</p>';return}const img=imageUrl(n),body=cleanBody(n.body);article.innerHTML=`<div class="meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="label">${esc(n.label)}</span></div><h1>${esc(n.title)}</h1>${img?`<div class="article-image"><img src="${esc(img)}" alt="${esc(n.sourceTitle||n.title||'')}" /></div>`:''}${body?`<div class="body">${esc(body)}</div>`:''}<a class="cta" href="${esc(sourceUrl(n))}">${n.type==='sticker'?'このLINEスタンプを見る':n.type==='suzuri'?'グッズを見る':n.type==='tool'?'無料ツールを使う':'素材を見る'}　›</a>`}
    load();
  </script>
</body>
</html>
