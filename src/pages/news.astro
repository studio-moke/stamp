---
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import { absoluteUrl } from "../lib/seo";
const title = "お知らせ｜新作LINEスタンプ・SUZURI・無料ツール・フリー素材 | stamp moke";
const description = "stamp mokeの新作LINEスタンプ、SUZURIグッズ、無料ツール、フリー素材の更新情報をお届けします。";
const canonical = absoluteUrl("/news/");
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <SeoHead title={title} description={description} canonical={canonical} locale="ja" path="/news/" />
  <Analytics />
  <style is:global>
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:#fbfcfb;color:#141820;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}

    .site-header{position:sticky;top:0;z-index:30;height:78px;display:flex;align-items:center;gap:28px;padding:0 clamp(18px,4vw,56px);background:rgba(255,255,255,.96);border-bottom:1px solid #edf0ed;backdrop-filter:blur(14px)}
    .logo{display:flex;align-items:center;gap:12px;text-decoration:none;flex:0 0 auto}
    .logo-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#e9f9ef;color:#14a85d;font-size:30px;font-weight:1000;line-height:1;letter-spacing:-.12em;padding-right:3px}
    .logo-copy{display:block}
    .logo-title{display:block;font-size:22px;font-weight:950;letter-spacing:.06em;line-height:1}
    .logo-sub{display:block;margin-top:6px;color:#8a9290;font-size:9px;font-weight:700;white-space:nowrap}
    .nav{display:flex;align-items:center;justify-content:center;gap:26px;flex:1;min-width:0}
    .nav a{position:relative;padding:29px 0 26px;text-decoration:none;font-size:12px;font-weight:850;white-space:nowrap}
    .nav a.active{color:#159958}
    .nav a.active:after{content:"";position:absolute;left:0;right:0;bottom:10px;height:2px;border-radius:10px;background:#159958}
    .head-actions{display:flex;align-items:center;gap:10px;flex:0 0 auto}
    .search-btn,.lang-btn{height:42px;border:1px solid #e2e7e3;background:#fff;color:#1f2428;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;font-weight:850}
    .search-btn{width:42px;border-radius:50%;font-size:18px}
    .lang-btn{gap:7px;padding:0 14px;border-radius:12px;font-size:11px}

    .breadcrumb{max-width:1180px;margin:0 auto;padding:15px clamp(18px,4vw,56px);color:#7c8582;font-size:10px}
    .breadcrumb a{text-decoration:none}

    .hero{position:relative;overflow:hidden;background:linear-gradient(105deg,#f2f8fa 0%,#eef5f4 48%,#f8f7f0 100%);border-top:1px solid #f3f5f3;border-bottom:1px solid #e9eeea}
    .hero-inner{position:relative;max-width:1180px;min-height:250px;margin:0 auto;padding:55px clamp(18px,4vw,56px);display:flex;align-items:center}
    .hero-copy{position:relative;z-index:2;max-width:530px}
    .hero h1{margin:0;font-size:clamp(40px,6vw,64px);line-height:1;font-weight:950;letter-spacing:-.05em}
    .hero p{margin:18px 0 0;color:#63706c;font-size:15px;line-height:1.8}
    .hero-visual{position:absolute;right:3%;top:26px;width:min(45vw,520px);height:210px;transform:rotate(-4deg)}
    .note{position:absolute;inset:0;border-radius:22px;background:linear-gradient(#fffdf6,#f8f3e7);border:1px solid rgba(171,158,124,.22);box-shadow:0 20px 45px rgba(56,62,58,.08)}
    .note:before{content:"";position:absolute;inset:22px;background:repeating-linear-gradient(to bottom,transparent 0 25px,#ddd8c8 26px 27px);opacity:.65}
    .note-word{position:absolute;z-index:2;left:42%;top:72px;font-size:50px;letter-spacing:.03em;color:#505558;font-family:Georgia,serif;transform:rotate(2deg)}
    .note-word:after{content:"";display:block;width:130px;height:2px;margin-top:8px;background:#79756e}
    .plant{position:absolute;right:-12px;top:-28px;width:115px;height:115px;border-radius:60% 40% 60% 40%;background:radial-gradient(circle at 35% 35%,#82cb73 0 20%,#56b665 22% 45%,transparent 47%),radial-gradient(circle at 75% 65%,#72c870 0 20%,#3ea55b 22% 46%,transparent 48%);filter:blur(.4px);opacity:.9}

    .content{max-width:1180px;margin:0 auto;padding:32px clamp(18px,4vw,56px) 90px}
    .filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}
    .filter{min-height:42px;padding:0 20px;border:1px solid #e3e7e4;background:#f8faf9;color:#57615e;border-radius:16px;font-size:12px;font-weight:850;cursor:pointer;transition:.2s}
    .filter:hover{background:#f1f5f2}
    .filter.on{background:#16a361;color:#fff;border-color:#16a361;box-shadow:0 8px 20px rgba(22,163,97,.16)}

    .list{display:grid;gap:14px}
    .card{display:grid;grid-template-columns:225px 1fr 54px;gap:26px;align-items:center;min-height:142px;padding:14px 18px 14px 14px;background:#fff;border:1px solid #e1e7e3;border-radius:16px;text-decoration:none;box-shadow:0 2px 8px rgba(33,48,39,.02);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
    .card:hover{transform:translateY(-2px);border-color:#d4dfd8;box-shadow:0 14px 34px rgba(33,48,39,.07)}
    .thumb{position:relative;height:112px;overflow:hidden;border-radius:12px;display:flex;align-items:center;justify-content:center;background:#f3f4f3}
    .thumb img{width:100%;height:100%;object-fit:cover;display:block}
    .thumb-fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:950}
    .thumb-fallback small{position:absolute;bottom:10px;left:12px;padding:4px 7px;border-radius:999px;background:rgba(255,255,255,.82);font-size:9px;letter-spacing:.05em}
    .thumb-sticker{background:linear-gradient(135deg,#fff0d6,#ffe3b4);color:#d88b1d}
    .thumb-free{background:linear-gradient(135deg,#dff7ff,#cde5ff);color:#3987d5}
    .thumb-suzuri{background:linear-gradient(135deg,#f7e5ef,#fde1e8);color:#d94f83}
    .thumb-tool{background:linear-gradient(135deg,#e7f7ea,#d4f3df);color:#159a59}
    .card-main{min-width:0}
    .meta{display:flex;align-items:center;gap:12px;margin-bottom:10px;color:#7b8581;font-size:11px}
    .label{display:inline-flex;align-items:center;justify-content:center;min-height:28px;padding:0 11px;border-radius:999px;font-size:10px;font-weight:950}
    .label-sticker{background:#dff5e8;color:#159458}.label-free{background:#e4f2ff;color:#3685ce}.label-suzuri{background:#fde5ef;color:#d93875}.label-tool{background:#eee7ff;color:#6e4ed3}
    .card h2{margin:0;color:#15191d;font-size:20px;line-height:1.45;letter-spacing:-.02em}
    .summary{margin:7px 0 0;color:#6f7a76;font-size:12px;line-height:1.75;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .arrow{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#f6f8f7;color:#28312e;font-size:23px;font-weight:400}

    .article-shell{display:none;max-width:900px;margin:0 auto;padding:42px clamp(18px,4vw,56px) 90px}
    .article-shell.show{display:block}
    .article{background:#fff;border:1px solid #e1e7e3;border-radius:24px;padding:clamp(26px,5vw,54px);box-shadow:0 18px 50px rgba(38,51,44,.05)}
    .article .meta{margin-bottom:18px}.article h1{margin:0;font-size:clamp(30px,5vw,48px);line-height:1.35;letter-spacing:-.04em}.article .article-lead{margin-top:24px;font-size:18px;font-weight:800;line-height:1.9;color:#333c38}.article .body{margin-top:20px;color:#59635f;font-size:15px;line-height:2.05;white-space:pre-line}.article .cta{display:inline-flex;align-items:center;gap:8px;margin-top:30px;padding:13px 19px;border-radius:999px;background:#16a361;color:#fff;text-decoration:none;font-size:12px;font-weight:900}.article-back{display:inline-flex;margin-bottom:18px;color:#5f6b66;text-decoration:none;font-size:12px;font-weight:800}
    .empty{padding:42px;text-align:center;color:#7b8581;background:#fff;border:1px solid #e1e7e3;border-radius:16px;font-size:13px}
    .footer{padding:36px 5vw;background:#14201a;color:#aeb8b2;font-size:11px;text-align:center}

    @media(max-width:980px){.nav{display:none}.site-header{gap:16px}.head-actions{margin-left:auto}.hero-visual{opacity:.72;right:-110px}.card{grid-template-columns:170px 1fr 48px}.card h2{font-size:17px}}
    @media(max-width:680px){.site-header{height:68px;padding:0 16px}.logo-title{font-size:19px}.logo-sub{display:none}.logo-mark{width:34px;height:34px;font-size:27px}.lang-btn{display:none}.breadcrumb{padding:12px 18px}.hero-inner{min-height:210px;padding:40px 18px}.hero h1{font-size:42px}.hero p{font-size:13px;max-width:290px}.hero-visual{right:-145px;top:28px;width:360px;height:165px;opacity:.42}.note-word{font-size:38px;top:57px}.content{padding:24px 14px 65px}.filters{gap:8px;overflow-x:auto;flex-wrap:nowrap;padding-bottom:4px}.filter{flex:0 0 auto;min-height:40px;padding:0 16px}.card{grid-template-columns:96px 1fr 34px;gap:12px;min-height:116px;padding:10px}.thumb{height:92px}.thumb-fallback{font-size:23px}.thumb-fallback small{display:none}.meta{gap:7px;margin-bottom:6px;font-size:9px}.label{min-height:24px;padding:0 8px;font-size:8px}.card h2{font-size:14px;line-height:1.5}.summary{font-size:10px;line-height:1.55;-webkit-line-clamp:2}.arrow{width:32px;height:32px;font-size:18px}.article-shell{padding:28px 14px 65px}.article{padding:24px 20px;border-radius:18px}.article .article-lead{font-size:16px}}
  </style>
</head>
<body>
  <header class="site-header">
    <a class="logo" href="/" aria-label="stamp moke トップ">
      <span class="logo-mark">m</span>
      <span class="logo-copy"><span class="logo-title">stamp moke</span><span class="logo-sub">LINEスタンプ・イラスト・グッズ・無料ツール</span></span>
    </a>
    <nav class="nav" aria-label="メインナビゲーション">
      <a href="/">LINEスタンプ</a>
      <a href="/free/">イラスト素材</a>
      <a href="/goods/">グッズ</a>
      <a href="/tools/">無料ツール</a>
      <a class="active" href="/news/">お知らせ</a>
      <a href="/">について</a>
    </nav>
    <div class="head-actions">
      <a class="search-btn" href="/search/" aria-label="検索">⌕</a>
      <span class="lang-btn">◎ 日本語⌄</span>
    </div>
  </header>

  <div class="breadcrumb"><a href="/">ホーム</a>　›　お知らせ</div>

  <div id="index-view">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <h1>お知らせ</h1>
          <p>stamp moke の最新情報をお届けします。</p>
        </div>
        <div class="hero-visual" aria-hidden="true"><div class="note"></div><div class="note-word">News</div><div class="plant"></div></div>
      </div>
    </section>
    <main class="content">
      <div class="filters" id="filters"></div>
      <div class="list" id="news-list"><div class="empty">お知らせを読み込んでいます…</div></div>
    </main>
  </div>

  <main class="article-shell" id="article-shell">
    <a class="article-back" href="/news/">← お知らせ一覧へ</a>
    <article class="article" id="article"></article>
  </main>

  <footer class="footer">© stamp moke</footer>

  <script is:inline>
    const listEl=document.getElementById('news-list'),filtersEl=document.getElementById('filters'),article=document.getElementById('article'),articleShell=document.getElementById('article-shell'),indexView=document.getElementById('index-view');
    const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const sourceUrl=n=>{let u=String(n?.url||'/');if(n?.type==='free')u=u.replace(/\/+$/,'');return u||'/free/'};
    const labelClass=t=>t==='sticker'?'label-sticker':t==='free'?'label-free':t==='suzuri'?'label-suzuri':'label-tool';
    const thumbClass=t=>t==='sticker'?'thumb-sticker':t==='free'?'thumb-free':t==='suzuri'?'thumb-suzuri':'thumb-tool';
    const thumbIcon=t=>t==='sticker'?'☺':t==='free'?'▧':t==='suzuri'?'m':t==='tool'?'⌘':'•';
    const imageUrl=n=>n?.image||n?.thumbnail||n?.imageUrl||n?.ogImage||'';
    const qs=new URLSearchParams(location.search);let all=[];

    async function load(){
      try{
        const r=await fetch('/api/news?limit=80&sync=0');
        const d=await r.json();
        all=d.items||[];
        const slug=qs.get('slug');
        if(slug)return showArticle(all.find(x=>x.slug===slug));
        renderFilters();render(all);
      }catch(e){listEl.innerHTML='<div class="empty">お知らせを読み込めませんでした。</div>'}
    }

    function renderFilters(){
      const types=[['all','すべて'],['sticker','LINEスタンプ'],['suzuri','SUZURI'],['tool','無料ツール'],['free','フリー素材']];
      filtersEl.innerHTML=types.map(([v,l],i)=>`<button class="filter${i===0?' on':''}" data-type="${v}">${l}</button>`).join('');
      filtersEl.addEventListener('click',e=>{
        const b=e.target.closest('.filter');if(!b)return;
        filtersEl.querySelectorAll('.filter').forEach(x=>x.classList.remove('on'));b.classList.add('on');
        render(b.dataset.type==='all'?all:all.filter(x=>x.type===b.dataset.type));
      });
    }

    function render(rows){
      listEl.innerHTML=rows.length?rows.map(n=>{
        const img=imageUrl(n);
        const thumb=img?`<div class="thumb"><img src="${esc(img)}" alt="" loading="lazy" /></div>`:`<div class="thumb"><div class="thumb-fallback ${thumbClass(n.type)}">${thumbIcon(n.type)}<small>${esc(n.label||'NEWS')}</small></div></div>`;
        const summary=esc(n.lead||n.body||'');
        return `<a class="card" href="/news/?slug=${encodeURIComponent(n.slug)}">${thumb}<div class="card-main"><div class="meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="label ${labelClass(n.type)}">${esc(n.label)}</span></div><h2>${esc(n.title)}</h2>${summary?`<p class="summary">${summary}</p>`:''}</div><div class="arrow">›</div></a>`;
      }).join(''):'<div class="empty">まだお知らせはありません。</div>';
    }

    function showArticle(n){
      indexView.style.display='none';articleShell.classList.add('show');
      if(!n){article.innerHTML='<p>記事が見つかりませんでした。</p>';return}
      article.innerHTML=`<div class="meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="label ${labelClass(n.type)}">${esc(n.label)}</span></div><h1>${esc(n.title)}</h1>${n.lead?`<div class="article-lead">${esc(n.lead)}</div>`:''}${n.body?`<div class="body">${esc(n.body)}</div>`:''}<a class="cta" href="${esc(sourceUrl(n))}">${n.type==='sticker'?'このLINEスタンプを見る':n.type==='suzuri'?'グッズを見る':n.type==='tool'?'無料ツールを使う':'素材を見る'}　›</a>`;
    }
    load();
  </script>
</body>
</html>
