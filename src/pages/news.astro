---
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import { absoluteUrl } from "../lib/seo";
const title = "お知らせ｜新作LINEスタンプ・SUZURI・無料ツール・フリー素材 | stamp moke";
const description = "stamp mokeの新作LINEスタンプ、SUZURIグッズ、無料ツール、フリー素材の更新情報をお届けします。";
const canonical = absoluteUrl("/news/");
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <SeoHead title={title} description={description} canonical={canonical} locale="ja" path="/news/" />
  <Analytics />
  <style is:global>
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fbfcfb;color:#141820;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}
    .smn-hero{position:relative;overflow:hidden;background:linear-gradient(105deg,#f2f8fa 0%,#eef5f4 48%,#f8f7f0 100%);border-bottom:1px solid #e9eeea}.smn-hero-inner{position:relative;max-width:1180px;min-height:250px;margin:0 auto;padding:55px clamp(18px,4vw,56px);display:flex;align-items:center}.smn-hero-copy{position:relative;z-index:3;max-width:530px}.smn-hero h1{margin:0;font-size:clamp(40px,6vw,64px);line-height:1;font-weight:950;letter-spacing:-.05em}.smn-hero p{margin:18px 0 0;color:#63706c;font-size:15px;line-height:1.8}.smn-hero-visual{position:absolute;right:3%;top:26px;width:min(45vw,520px);height:210px;transform:rotate(-4deg);z-index:1;pointer-events:none}.smn-note{position:absolute;inset:0;border-radius:22px;background:linear-gradient(#fffdf6,#f8f3e7);border:1px solid rgba(171,158,124,.22);box-shadow:0 20px 45px rgba(56,62,58,.08)}.smn-note:before{content:"";position:absolute;inset:22px;background:repeating-linear-gradient(to bottom,transparent 0 25px,#ddd8c8 26px 27px);opacity:.65}.smn-news-word{position:absolute;z-index:2;left:42%;top:72px;font-size:50px;letter-spacing:.03em;color:#505558;font-family:Georgia,serif;transform:rotate(2deg)}.smn-news-word:after{content:"";display:block;width:130px;height:2px;margin-top:8px;background:#79756e}.smn-plant{position:absolute;right:-12px;top:-28px;width:115px;height:115px;border-radius:60% 40% 60% 40%;background:radial-gradient(circle at 35% 35%,#82cb73 0 20%,#56b665 22% 45%,transparent 47%),radial-gradient(circle at 75% 65%,#72c870 0 20%,#3ea55b 22% 46%,transparent 48%);opacity:.9}
    .smn-content{max-width:1180px;margin:0 auto;padding:32px clamp(18px,4vw,56px) 90px}.smn-filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}.smn-filter{min-height:42px;padding:0 20px;border:1px solid #e3e7e4;background:#f8faf9;color:#57615e;border-radius:16px;font-size:12px;font-weight:850;cursor:pointer}.smn-filter.smn-on{background:#16a361;color:#fff;border-color:#16a361;box-shadow:0 8px 20px rgba(22,163,97,.16)}
    .smn-list{display:grid;gap:14px}.smn-card{display:grid;grid-template-columns:225px 1fr 54px;gap:26px;align-items:center;min-height:142px;padding:14px 18px 14px 14px;background:#fff;border:1px solid #e1e7e3;border-radius:16px;text-decoration:none;box-shadow:0 2px 8px rgba(33,48,39,.02);transition:.18s}.smn-card:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(33,48,39,.07)}.smn-thumb{position:relative;height:112px;overflow:hidden;border-radius:12px;display:flex;align-items:center;justify-content:center;background:#f3f4f3}.smn-thumb img{width:100%;height:100%;object-fit:cover;display:block}.smn-thumb-fallback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:950}.smn-thumb-fallback small{position:absolute;bottom:10px;left:12px;padding:4px 7px;border-radius:999px;background:rgba(255,255,255,.82);font-size:9px}.smn-thumb-sticker{background:linear-gradient(135deg,#fff0d6,#ffe3b4);color:#d88b1d}.smn-thumb-free{background:linear-gradient(135deg,#dff7ff,#cde5ff);color:#3987d5}.smn-thumb-suzuri{background:linear-gradient(135deg,#f7e5ef,#fde1e8);color:#d94f83}.smn-thumb-tool{background:linear-gradient(135deg,#e7f7ea,#d4f3df);color:#159a59}.smn-main{min-width:0}.smn-meta{display:flex;align-items:center;gap:12px;margin-bottom:10px;color:#7b8581;font-size:11px}.smn-label{display:inline-flex;align-items:center;justify-content:center;min-height:28px;padding:0 11px;border-radius:999px;font-size:10px;font-weight:950}.smn-label-sticker{background:#dff5e8;color:#159458}.smn-label-free{background:#e4f2ff;color:#3685ce}.smn-label-suzuri{background:#fde5ef;color:#d93875}.smn-label-tool{background:#eee7ff;color:#6e4ed3}.smn-card h2{margin:0;color:#15191d;font-size:20px;line-height:1.45;letter-spacing:-.02em}.smn-summary{margin:7px 0 0;color:#6f7a76;font-size:12px;line-height:1.75;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.smn-arrow{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#f6f8f7;color:#28312e;font-size:23px}
    .smn-article-shell{display:none;max-width:900px;margin:0 auto;padding:42px clamp(18px,4vw,56px) 90px}.smn-article-shell.smn-show{display:block}.smn-article{background:#fff;border:1px solid #e1e7e3;border-radius:24px;padding:clamp(26px,5vw,54px);box-shadow:0 18px 50px rgba(38,51,44,.05)}.smn-article .smn-meta{margin-bottom:18px}.smn-article h1{margin:0;font-size:clamp(30px,5vw,48px);line-height:1.35;letter-spacing:-.04em}.smn-body{margin-top:24px;color:#59635f;font-size:15px;line-height:2.05;white-space:pre-line}.smn-cta{display:inline-flex;align-items:center;gap:8px;margin-top:30px;padding:13px 19px;border-radius:999px;background:#16a361;color:#fff;text-decoration:none;font-size:12px;font-weight:900}.smn-article-back{display:inline-flex;margin-bottom:18px;color:#5f6b66;text-decoration:none;font-size:12px;font-weight:800}.smn-empty{padding:42px;text-align:center;color:#7b8581;background:#fff;border:1px solid #e1e7e3;border-radius:16px;font-size:13px}.smn-footer{padding:36px 5vw;background:#14201a;color:#aeb8b2;font-size:11px;text-align:center}
    @media(max-width:900px){.smn-hero-visual{opacity:.72;right:-110px}.smn-card{grid-template-columns:170px 1fr 48px}.smn-card h2{font-size:17px}}@media(max-width:680px){.smn-hero-inner{min-height:210px;padding:40px 18px}.smn-hero h1{font-size:42px}.smn-hero p{font-size:13px;max-width:290px}.smn-hero-visual{right:-145px;top:28px;width:360px;height:165px;opacity:.42}.smn-news-word{font-size:38px;top:57px}.smn-content{padding:24px 14px 65px}.smn-filters{gap:8px;overflow-x:auto;flex-wrap:nowrap;padding-bottom:4px}.smn-filter{flex:0 0 auto;min-height:40px;padding:0 16px}.smn-card{grid-template-columns:96px 1fr 34px;gap:12px;min-height:116px;padding:10px}.smn-thumb{height:92px}.smn-thumb-fallback{font-size:23px}.smn-thumb-fallback small{display:none}.smn-meta{gap:7px;margin-bottom:6px;font-size:9px}.smn-label{min-height:24px;padding:0 8px;font-size:8px}.smn-card h2{font-size:14px;line-height:1.5}.smn-summary{font-size:10px;line-height:1.55;-webkit-line-clamp:2}.smn-arrow{width:32px;height:32px;font-size:18px}.smn-article-shell{padding:28px 14px 65px}.smn-article{padding:24px 20px;border-radius:18px}}
  </style>
</head>
<body>
  <section class="smn-hero" id="smn-hero"><div class="smn-hero-inner"><div class="smn-hero-copy"><h1>お知らせ</h1><p>stamp moke の最新情報をお届けします。</p></div><div class="smn-hero-visual" aria-hidden="true"><div class="smn-note"></div><div class="smn-news-word">News</div><div class="smn-plant"></div></div></div></section>
  <div id="smn-index-view"><main class="smn-content"><div class="smn-filters" id="smn-filters"></div><div class="smn-list" id="smn-news-list"><div class="smn-empty">お知らせを読み込んでいます…</div></div></main></div>
  <main class="smn-article-shell" id="smn-article-shell"><a class="smn-article-back" href="/news/">← お知らせ一覧へ</a><article class="smn-article" id="smn-article"></article></main>
  <footer class="smn-footer">© stamp moke</footer>
  <script is:inline>
    const listEl=document.getElementById('smn-news-list'),filtersEl=document.getElementById('smn-filters'),article=document.getElementById('smn-article'),articleShell=document.getElementById('smn-article-shell'),indexView=document.getElementById('smn-index-view');
    const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const sourceUrl=n=>{let u=String(n?.url||'/');if(n?.type==='free')u=u.replace(/\/+$/,'');return u||'/free/'};
    const labelClass=t=>t==='sticker'?'smn-label-sticker':t==='free'?'smn-label-free':t==='suzuri'?'smn-label-suzuri':'smn-label-tool';
    const thumbClass=t=>t==='sticker'?'smn-thumb-sticker':t==='free'?'smn-thumb-free':t==='suzuri'?'smn-thumb-suzuri':'smn-thumb-tool';
    const thumbIcon=t=>t==='sticker'?'☺':t==='free'?'▧':t==='suzuri'?'m':t==='tool'?'⌘':'•';
    const freeSlug=n=>{if(n?.type!=='free')return'';const id=String(n?.id||'');if(id.startsWith('free:'))return id.slice(5);const url=String(n?.url||'').split('?')[0].replace(/\/+$/,'');const m=url.match(/\/free\/([^/]+)$/);if(!m)return'';try{return decodeURIComponent(m[1])}catch{return m[1]}};
    const imageUrl=n=>{const direct=n?.image||n?.thumbnail||n?.imageUrl||n?.ogImage||n?.previewUrl||n?.preview||'';if(direct)return direct;const slug=freeSlug(n);return slug?`/api/free?route=preview&slug=${encodeURIComponent(slug)}&variant=thumb`:''};
    const qs=new URLSearchParams(location.search);let all=[];
    async function load(){try{const r=await fetch('/api/news?limit=80&sync=0');const d=await r.json();all=d.items||[];const slug=qs.get('slug');if(slug)return showArticle(all.find(x=>x.slug===slug));renderFilters();render(all)}catch(e){listEl.innerHTML='<div class="smn-empty">お知らせを読み込めませんでした。</div>'}}
    function renderFilters(){const types=[['all','すべて'],['sticker','LINEスタンプ'],['suzuri','SUZURI'],['tool','無料ツール'],['free','フリー素材']];filtersEl.innerHTML=types.map(([v,l],i)=>`<button class="smn-filter${i===0?' smn-on':''}" data-type="${v}">${l}</button>`).join('');filtersEl.addEventListener('click',e=>{const b=e.target.closest('.smn-filter');if(!b)return;filtersEl.querySelectorAll('.smn-filter').forEach(x=>x.classList.remove('smn-on'));b.classList.add('smn-on');render(b.dataset.type==='all'?all:all.filter(x=>x.type===b.dataset.type))})}
    function render(rows){listEl.innerHTML=rows.length?rows.map(n=>{const img=imageUrl(n);const thumb=img?`<div class="smn-thumb"><img src="${esc(img)}" alt="" loading="lazy" /></div>`:`<div class="smn-thumb"><div class="smn-thumb-fallback ${thumbClass(n.type)}">${thumbIcon(n.type)}<small>${esc(n.label||'NEWS')}</small></div></div>`;const summary=esc(n.lead||n.body||'');return `<a class="smn-card" href="/news/?slug=${encodeURIComponent(n.slug)}">${thumb}<div class="smn-main"><div class="smn-meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="smn-label ${labelClass(n.type)}">${esc(n.label)}</span></div><h2>${esc(n.title)}</h2>${summary?`<p class="smn-summary">${summary}</p>`:''}</div><div class="smn-arrow">›</div></a>`}).join(''):'<div class="smn-empty">まだお知らせはありません。</div>'}
    function showArticle(n){indexView.style.display='none';articleShell.classList.add('smn-show');if(!n){article.innerHTML='<p>記事が見つかりませんでした。</p>';return}article.innerHTML=`<div class="smn-meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="smn-label ${labelClass(n.type)}">${esc(n.label)}</span></div><h1>${esc(n.title)}</h1>${n.body?`<div class="smn-body">${esc(n.body)}</div>`:''}<a class="smn-cta" href="${esc(sourceUrl(n))}">${n.type==='sticker'?'このLINEスタンプを見る':n.type==='suzuri'?'グッズを見る':n.type==='tool'?'無料ツールを使う':'素材を見る'}　›</a>`}
    load();
  </script>
</body>
</html>
