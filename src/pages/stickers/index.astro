---
import stickers from "../../data/stickers.json";
import Analytics from "../../components/Analytics.astro";
import SeoHead from "../../components/SeoHead.astro";
import { absoluteUrl } from "../../lib/seo";

function getCategory(sticker) {
  const text = `${sticker.title || ""} ${sticker.description || ""}`;
  if (/博多|福岡|筑後|方言|関西弁|九州弁/.test(text)) return "方言";
  if (/猫|ねこ|ネコ|犬|いぬ|イヌ|柴犬|コーギー|ポメラニアン|うさぎ|ウサギ|兎|くま|クマ|パンダ|鳥|すずめ|ペンギン|アザラシ|猿|サル|タヌキ|たぬき|ねずみ|動物/.test(text)) return "動物";
  if (/ハート|恋|恋愛|カップル|彼氏|彼女|好き|愛/.test(text)) return "恋愛";
  if (/仕事|ビジネス|敬語|丁寧|会社|職場|マーケター|バイト|働く/.test(text)) return "仕事";
  if (/食べ物|料理|ごはん|肉まん|ビール|お酒|ジョッキ|パン|ケーキ|お菓子/.test(text)) return "食べ物";
  if (/面白|おもしろ|ネタ|シュール|ギャグ|ツッコミ|あるある|ウザい|正論|本音/.test(text)) return "おもしろ";
  if (/挨拶|ありがとう|おはよう|こんにちは|こんばんは|おやすみ|よろしく|おつかれ/.test(text)) return "あいさつ";
  if (/かわいい|可愛い|キュート|癒し|ほんわか|ゆるかわ|もふもふ/.test(text)) return "かわいい";
  if (/日常|毎日|返信|返事|会話|リアクション|気持ち/.test(text)) return "日常";
  return "その他";
}

const items = stickers.map((sticker) => ({ ...sticker, category: getCategory(sticker) }));
const categories = ["すべて", ...Array.from(new Set(items.map((item) => item.category)))];
const title = "LINEスタンプ一覧｜stamp moke";
const description = "stamp mokeのLINEスタンプを一覧で探せます。仕事、日常、方言、動物、おもしろ系など、オリジナルLINEスタンプをカテゴリやキーワードから検索できます。";
const canonical = absoluteUrl("/stickers/");
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <SeoHead title={title} description={description} canonical={canonical} locale="ja" path="/stickers/" />
  <Analytics />
  <style>
    *{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}a{color:inherit}.header{height:86px;background:rgba(255,255,255,.96);border-bottom:1px solid #e4e3df;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)}.brand{text-decoration:none}.brand-title{font-size:21px;font-weight:900;letter-spacing:.1em;line-height:1}.brand-sub{margin-top:7px;font-size:11px;color:#777}.home-link{text-decoration:none;border:1px solid #d9d8d4;background:#fff;padding:12px 18px;border-radius:999px;font-size:12px;font-weight:800}.main{max-width:1180px;margin:0 auto;padding:56px 5vw 110px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#777;margin-bottom:12px}.title{margin:0;font-size:clamp(38px,6vw,68px);line-height:1;font-weight:900;letter-spacing:-.045em}.lead{max-width:720px;margin:22px 0 0;color:#666;font-size:14px;line-height:1.9}.toolbar{display:grid;grid-template-columns:minmax(220px,1fr) auto;gap:18px;align-items:center;margin:42px 0 28px;padding:20px;background:#fff;border:1px solid #e3e2de;border-radius:18px}.search{width:100%;height:46px;border:1px solid #d8d7d2;border-radius:12px;padding:0 15px;font:inherit;font-size:14px}.count{font-size:12px;color:#777;white-space:nowrap}.categories{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}.cat{border:1px solid #d8d7d2;background:#fff;border-radius:999px;padding:9px 14px;font:inherit;font-size:12px;font-weight:700;cursor:pointer}.cat.is-active{background:#161616;color:#fff;border-color:#161616}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.card{display:block;text-decoration:none;background:#fff;border:1px solid #e3e2de;border-radius:18px;overflow:hidden;transition:.22s}.card:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(0,0,0,.07)}.image-wrap{aspect-ratio:1;background:#7696c4;overflow:hidden}.image{display:block;width:100%;height:100%;object-fit:contain;padding:18px}.content{padding:17px}.card-title{margin:0;font-size:15px;line-height:1.5;font-weight:800;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.category{margin-top:10px;color:#777;font-size:10px}.empty{display:none;padding:60px 20px;text-align:center;color:#777}.footer{padding:45px 5vw;background:#181818;color:#999;text-align:center;font-size:11px}.card[hidden]{display:none}@media(max-width:900px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:640px){.header{height:72px;padding:0 20px}.brand-title{font-size:17px}.home-link{padding:10px 13px;font-size:11px}.main{padding:34px 18px 70px}.toolbar{grid-template-columns:1fr;gap:10px;margin-top:30px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.image{padding:9px}.content{padding:12px}.card-title{font-size:13px}}
  </style>
</head>
<body>
  <header class="header">
    <a class="brand" href="/"><div class="brand-title">stamp moke</div><div class="brand-sub">LINE STICKER & CREATIVE</div></a>
    <a class="home-link" href="/">トップへ戻る</a>
  </header>
  <main class="main">
    <div class="eyebrow">LINE STICKER COLLECTION</div>
    <h1 class="title">LINEスタンプ一覧</h1>
    <p class="lead">stamp mokeのLINEスタンプをまとめて探せるメインページです。キーワード検索やカテゴリから、お好みのスタンプを見つけられます。</p>

    <div class="toolbar">
      <input id="search" class="search" type="search" placeholder="タイトル・説明文から検索" aria-label="LINEスタンプを検索" />
      <div id="count" class="count">{items.length} STICKERS</div>
    </div>
    <div class="categories" aria-label="カテゴリー">
      {categories.map((category) => <button class={`cat${category === "すべて" ? " is-active" : ""}`} type="button" data-category={category}>{category}</button>)}
    </div>

    <div id="grid" class="grid">
      {items.map((sticker, index) => (
        <a class="card" href={`/stickers/${sticker.id}/`} data-category={sticker.category} data-search={`${sticker.title || ""} ${sticker.description || ""}`.toLowerCase()}>
          <div class="image-wrap"><img class="image" src={sticker.image} alt={sticker.title} loading={index < 12 ? "eager" : "lazy"} /></div>
          <div class="content"><h2 class="card-title">{sticker.title}</h2><div class="category">{sticker.category}</div></div>
        </a>
      ))}
    </div>
    <div id="empty" class="empty">該当するLINEスタンプが見つかりませんでした。</div>
  </main>
  <footer class="footer">© stamp moke</footer>
  <script is:inline>
    (() => {
      const cards = [...document.querySelectorAll('.card')];
      const buttons = [...document.querySelectorAll('.cat')];
      const search = document.getElementById('search');
      const count = document.getElementById('count');
      const empty = document.getElementById('empty');
      let category = 'すべて';
      const update = () => {
        const q = (search.value || '').trim().toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const okCategory = category === 'すべて' || card.dataset.category === category;
          const okSearch = !q || (card.dataset.search || '').includes(q);
          card.hidden = !(okCategory && okSearch);
          if (!card.hidden) visible++;
        });
        count.textContent = `${visible} STICKERS`;
        empty.style.display = visible ? 'none' : 'block';
      };
      buttons.forEach((button) => button.addEventListener('click', () => {
        category = button.dataset.category;
        buttons.forEach((item) => item.classList.toggle('is-active', item === button));
        update();
      }));
      search.addEventListener('input', update);
    })();
  </script>
</body>
</html>
