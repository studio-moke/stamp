---
import stickers from "../../data/stickers.json";
import SeoHead from "../../components/SeoHead.astro";
import Analytics from "../../components/Analytics.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import { categoryLabels, localeInfo, localizedPath, localizeLineUrl, messages, normalizeLocale } from "../../lib/i18n";
import { makeTitle, makeDescription, absoluteUrl } from "../../lib/seo";
import { getCategory } from "../../lib/stickers";
import { localizedStickerDescription, localizedStickerPrice, localizedStickerTitle } from "../../lib/sticker-content";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  return stickers.map((sticker) => ({ params: { id: sticker.id }, props: { sticker } }));
}

const { sticker, locale: localeProp = "ja" } = Astro.props;
const locale = normalizeLocale(localeProp);
const t = messages[locale];
const basePurchaseUrl = sticker.purchaseUrl || sticker.url;
const purchaseUrl = localizeLineUrl(basePurchaseUrl, locale);
const giftUrl = localizeLineUrl(sticker.giftUrl || basePurchaseUrl, locale);
const qrTarget = purchaseUrl;
const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(qrTarget)}`;
const cleanTitle = localizedStickerTitle(sticker, locale);
const localizedDescription = localizedStickerDescription(sticker, locale);
const localizedPrice = localizedStickerPrice(sticker.price, locale);
const titleSuffix = locale === "ja" ? "LINEスタンプ" : locale === "en" ? "LINE Stickers" : locale === "zh-tw" ? "LINE貼圖" : locale === "th" ? "สติกเกอร์ LINE" : "Stiker LINE";
const pageTitle = makeTitle([`${cleanTitle} | ${titleSuffix}`]);
const localizedFallback = locale === "ja"
  ? `${cleanTitle}のLINEスタンプ。stamp mokeで作品情報を紹介しています。`
  : locale === "en"
    ? `Discover ${cleanTitle}, an original LINE sticker set by stamp moke for everyday chats.`
    : locale === "zh-tw"
      ? `探索stamp moke原創LINE貼圖「${cleanTitle}」，適合日常聊天使用。`
      : locale === "th"
        ? `พบกับ ${cleanTitle} ชุดสติกเกอร์ LINE ต้นฉบับจาก stamp moke สำหรับแชตประจำวัน`
        : `Temukan ${cleanTitle}, set stiker LINE orisinal dari stamp moke untuk obrolan sehari-hari.`;
const description = makeDescription(localizedDescription, localizedFallback);
const canonicalPath = `/stickers/${sticker.id}`;
const canonical = absoluteUrl(localizedPath(locale, canonicalPath));
const category = getCategory(sticker);
const localizedCategory = categoryLabels[locale][category] || category;
const pageText = {
  ja: { list:"スタンプ一覧へ", breadcrumb:"LINEスタンプ", gift:"プレゼントする", safe:"安心・安全", safeText:"LINE STORE公式ページから購入できます。", mobile:"スマホで簡単", mobileText:"QRコードからすぐに商品ページを開けます。", giftOk:"プレゼントOK", giftText:"友だちへのギフトにも利用できます。", phone:"スマホで見る", phoneText:"スマートフォンのカメラでQRコードを読み取ると、LINE STOREの商品ページを開けます。", open:"スマホで商品ページを開く →", id:"商品ID", category:"カテゴリ", price:"価格", seller:"販売元", work:"作品名", official:"LINE STORE公式ページを見る →", included:"収録スタンプ一覧", note:"低解像度・透かし入りの確認用プレビューです。画像の保存・転載はご遠慮ください。", related:"関連するLINEスタンプ", footer:"かわいい、おもしろい、毎日使えるLINEスタンプを紹介するメディア。" },
  en: { list:"Sticker collection", breadcrumb:"LINE Stickers", gift:"Send as a gift", safe:"Official & secure", safeText:"Purchase safely on the official LINE STORE.", mobile:"Easy on mobile", mobileText:"Open the product page instantly with the QR code.", giftOk:"Gift ready", giftText:"Send this sticker set to a friend on LINE.", phone:"Open on your phone", phoneText:"Scan the QR code with your phone camera to open this set on LINE STORE.", open:"Open product page →", id:"Product ID", category:"Category", price:"Price", seller:"Seller", work:"Title", official:"View official LINE STORE page →", included:"All stickers in this set", note:"Low-resolution watermarked preview. Please do not save or redistribute these images.", related:"Related LINE stickers", footer:"Cute, funny and practical LINE stickers for everyday chats." },
  "zh-tw": { list:"貼圖列表", breadcrumb:"LINE貼圖", gift:"贈送給朋友", safe:"官方安全購買", safeText:"可於LINE STORE官方頁面安心購買。", mobile:"手機快速開啟", mobileText:"掃描QR Code即可開啟商品頁面。", giftOk:"可作為禮物", giftText:"可將這組貼圖贈送給LINE好友。", phone:"用手機查看", phoneText:"使用手機相機掃描QR Code，即可開啟LINE STORE商品頁面。", open:"開啟商品頁面 →", id:"商品ID", category:"分類", price:"價格", seller:"販售平台", work:"作品名稱", official:"查看LINE STORE官方頁面 →", included:"收錄貼圖一覽", note:"此為低解析度浮水印預覽，請勿儲存或轉載圖片。", related:"相關LINE貼圖", footer:"提供可愛、有趣又適合日常使用的原創LINE貼圖。" },
  th: { list:"รวมสติกเกอร์", breadcrumb:"สติกเกอร์ LINE", gift:"ส่งเป็นของขวัญ", safe:"ปลอดภัยและเป็นทางการ", safeText:"ซื้อได้จากหน้า LINE STORE อย่างเป็นทางการ", mobile:"เปิดง่ายบนมือถือ", mobileText:"สแกน QR Code เพื่อเปิดหน้าสินค้าได้ทันที", giftOk:"ส่งเป็นของขวัญได้", giftText:"ส่งชุดสติกเกอร์นี้ให้เพื่อนบน LINE ได้", phone:"เปิดบนมือถือ", phoneText:"สแกน QR Code ด้วยกล้องมือถือเพื่อเปิดหน้าสินค้าบน LINE STORE", open:"เปิดหน้าสินค้า →", id:"รหัสสินค้า", category:"หมวดหมู่", price:"ราคา", seller:"ผู้จำหน่าย", work:"ชื่อผลงาน", official:"ดูหน้า LINE STORE อย่างเป็นทางการ →", included:"สติกเกอร์ทั้งหมดในชุด", note:"ภาพตัวอย่างความละเอียดต่ำพร้อมลายน้ำ กรุณาอย่าบันทึกหรือนำภาพไปเผยแพร่ต่อ", related:"สติกเกอร์ LINE ที่เกี่ยวข้อง", footer:"สติกเกอร์ LINE น่ารัก สนุก และใช้ได้ทุกวัน" },
  id: { list:"Koleksi stiker", breadcrumb:"Stiker LINE", gift:"Kirim sebagai hadiah", safe:"Resmi dan aman", safeText:"Beli dengan aman melalui halaman resmi LINE STORE.", mobile:"Mudah dibuka di ponsel", mobileText:"Pindai QR Code untuk langsung membuka halaman produk.", giftOk:"Bisa dikirim sebagai hadiah", giftText:"Kirim set stiker ini kepada teman di LINE.", phone:"Buka di ponsel", phoneText:"Pindai QR Code dengan kamera ponsel untuk membuka produk ini di LINE STORE.", open:"Buka halaman produk →", id:"ID Produk", category:"Kategori", price:"Harga", seller:"Penjual", work:"Judul karya", official:"Lihat halaman resmi LINE STORE →", included:"Semua stiker dalam set ini", note:"Pratinjau beresolusi rendah dengan tanda air. Mohon jangan menyimpan atau menyebarkan ulang gambar.", related:"Stiker LINE terkait", footer:"Stiker LINE yang lucu, seru, dan praktis untuk obrolan sehari-hari." },
}[locale];
const related = stickers.filter((item) => item.id !== sticker.id && getCategory(item) === category).slice(0, 6);
const sheetUrl = `/images/sticker-sheets/${sticker.id}.webp`;
const hasSheet = fs.existsSync(path.join(process.cwd(), "public", "images", "sticker-sheets", `${sticker.id}.webp`));
---
<!doctype html>
<html lang={localeInfo[locale].htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <SeoHead title={pageTitle} description={description} canonical={canonical} image={sticker.image} type="article" locale={locale} path={canonicalPath} />
  <Analytics />
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"stamp moke","item":absoluteUrl(localizedPath(locale, "/"))},{"@type":"ListItem","position":2,"name":pageText.breadcrumb,"item":absoluteUrl(localizedPath(locale, "/"))},{"@type":"ListItem","position":3,"name":cleanTitle,"item":canonical}]})} />
  <style>
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin:0; background:#f7f6f2; color:#161616; font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif; -webkit-font-smoothing:antialiased; }
    a { color:inherit; }
    .header { min-height:86px; background:rgba(255,255,255,.96); border-bottom:1px solid #e4e3df; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:14px 5vw; position:sticky; top:0; z-index:20; backdrop-filter:blur(12px); }
    .brand { text-decoration:none; }
    .brand-title { font-size:21px; font-weight:900; letter-spacing:.1em; line-height:1; }
    .brand-sub { margin-top:7px; font-size:11px; color:#777; letter-spacing:.05em; }
    .header-actions { display:flex; align-items:center; gap:9px; }
    .header-link { text-decoration:none; border:1px solid #d9d8d4; background:#fff; padding:13px 22px; border-radius:999px; font-size:13px; font-weight:700; white-space:nowrap; }
    .main { max-width:1180px; margin:0 auto; padding:38px 5vw 100px; }
    .breadcrumb { color:#777; font-size:12px; line-height:1.8; margin-bottom:28px; }
    .breadcrumb a { text-decoration:none; }
    .breadcrumb a:hover { text-decoration:underline; }
    .detail-card { display:grid; grid-template-columns:minmax(300px,1fr) minmax(340px,1fr); gap:56px; align-items:center; background:#fff; border:1px solid #e3e2de; border-radius:24px; padding:42px; }
    .image-panel { aspect-ratio:1/1; background:#7696c4; border-radius:18px; display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .sticker-image { display:block; width:100%; height:100%; object-fit:contain; padding:28px; }
    .category-label { display:inline-block; margin-bottom:16px; padding:7px 12px; border:1px solid #deddd8; border-radius:999px; color:#777; font-size:11px; font-weight:700; letter-spacing:.08em; }
    h1 { margin:0; font-size:clamp(30px,4vw,52px); line-height:1.14; letter-spacing:-.035em; font-weight:900; }
    .description { margin:22px 0 0; color:#666; font-size:14px; line-height:2; }
    .price { margin:24px 0 0; font-size:24px; font-weight:900; }
    .actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; }
    .action { min-height:50px; padding:0 22px; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; text-decoration:none; font-size:13px; font-weight:800; }
    .action-buy { background:#168b52; color:#fff; }
    .action-gift { background:#171717; color:#fff; }
    .trust-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:28px; padding-top:22px; border-top:1px solid #eeeeeb; }
    .trust-item { font-size:11px; line-height:1.6; color:#666; }
    .trust-item strong { display:block; color:#222; font-size:12px; margin-bottom:3px; }
    .info-grid { display:grid; grid-template-columns:minmax(260px,.8fr) minmax(360px,1.2fr); gap:18px; margin-top:20px; }
    .sub-card { background:#fff; border:1px solid #e3e2de; border-radius:20px; padding:28px; }
    .sub-label { font-size:11px; letter-spacing:.18em; color:#777; margin-bottom:8px; }
    .sub-title { margin:0 0 18px; font-size:24px; font-weight:900; letter-spacing:-.02em; }
    .qr-wrap { display:flex; align-items:center; gap:22px; }
    .qr { width:150px; height:150px; border-radius:12px; border:1px solid #eee; background:#fff; padding:8px; flex:0 0 auto; }
    .qr-copy { color:#666; font-size:12px; line-height:1.8; }
    .smartphone-link { display:inline-block; margin-top:10px; font-weight:800; color:#168b52; text-decoration:none; }
    .detail-list { margin:0; }
    .detail-row { display:grid; grid-template-columns:110px 1fr; gap:14px; padding:11px 0; border-bottom:1px solid #efefec; font-size:12px; line-height:1.6; }
    .detail-row dt { color:#777; }
    .detail-row dd { margin:0; font-weight:700; overflow-wrap:anywhere; }
    .official-link { display:inline-flex; margin-top:18px; min-height:44px; align-items:center; font-size:12px; font-weight:800; text-decoration:none; border-bottom:1px solid #222; }
    .all-stickers { margin-top:70px; }
    .preview-card { position:relative; max-width:720px; margin:0 auto; padding:20px; background:#fff; border:1px solid #e3e2de; border-radius:20px; overflow:hidden; }
    .preview-sheet { display:block; width:100%; height:auto; border-radius:14px; -webkit-user-drag:none; -webkit-touch-callout:none; user-select:none; pointer-events:none; }
    .preview-shield { position:absolute; inset:20px; z-index:2; border-radius:14px; background:transparent; }
    .preview-note { max-width:720px; margin:14px auto 0; color:#777; font-size:11px; line-height:1.8; text-align:center; }
    .related { margin-top:70px; }
    .section-label { font-size:11px; letter-spacing:.18em; color:#777; margin-bottom:8px; }
    .section-title { margin:0 0 20px; font-size:32px; line-height:1.1; font-weight:900; letter-spacing:-.03em; }
    .related-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; list-style:none; padding:0; margin:0; }
    .related-card { height:100%; display:flex; flex-direction:column; background:#fff; border:1px solid #e3e2de; border-radius:16px; overflow:hidden; text-decoration:none; transition:transform .2s ease,box-shadow .2s ease; }
    .related-card:hover { transform:translateY(-3px); box-shadow:0 12px 30px rgba(0,0,0,.07); }
    .related-media { height:260px; display:flex; align-items:center; justify-content:center; background:#7696c4; padding:18px; }
    .related-image { display:block; width:100%; height:100%; object-fit:contain; }
    .related-title { margin:0; padding:14px 15px 16px; font-size:13px; line-height:1.5; font-weight:800; overflow-wrap:anywhere; }
    .footer { background:#181818; color:#fff; padding:55px 5vw 30px; }
    .footer-inner { max-width:1180px; margin:0 auto; }
    .footer-brand { font-size:18px; font-weight:900; letter-spacing:.1em; }
    .footer-copy { margin:14px 0 0; color:#999; font-size:11px; line-height:1.9; }
    .footer-links { display:flex; flex-wrap:wrap; gap:16px; margin-top:18px; }
    .footer-links a { color:#ccc; font-size:11px; text-decoration:none; }
    .copyright { margin-top:28px; padding-top:20px; border-top:1px solid #333; color:#666; font-size:10px; }
    @media (max-width:850px) {
      .detail-card { grid-template-columns:1fr; gap:30px; padding:24px; }
      .image-panel { max-width:560px; width:100%; margin:0 auto; }
      .info-grid { grid-template-columns:1fr; }
      .related-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .related-media { height:220px; }
    }
    @media (max-width:640px) {
      .header { min-height:72px; padding:12px 20px; }
      .brand-title { font-size:17px; }
      .brand-sub { font-size:9px; margin-top:5px; }
      .header-link { padding:10px 14px; font-size:11px; }
      .main { padding:24px 18px 70px; }
      .breadcrumb { font-size:11px; margin-bottom:20px; }
      .detail-card { border-radius:16px; padding:16px; gap:24px; }
      .image-panel { border-radius:13px; }
      .sticker-image { padding:12px; }
      h1 { font-size:29px; }
      .description { margin-top:16px; font-size:12px; line-height:1.9; }
      .price { font-size:21px; margin-top:18px; }
      .actions { display:grid; grid-template-columns:1fr; }
      .action { width:100%; min-height:48px; }
      .trust-grid { grid-template-columns:1fr; gap:12px; }
      .sub-card { padding:20px; border-radius:16px; }
      .qr-wrap { align-items:flex-start; }
      .qr { width:112px; height:112px; }
      .sub-title { font-size:21px; }
      .detail-row { grid-template-columns:88px 1fr; }
      .related { margin-top:52px; }
      .all-stickers { margin-top:52px; }
      .preview-card { padding:10px; border-radius:16px; }
      .preview-sheet,.preview-shield { border-radius:10px; }
      .preview-shield { inset:10px; }
      .section-title { font-size:27px; }
      .related-grid { gap:10px; }
      .related-card { border-radius:12px; }
      .related-media { height:170px; padding:12px; }
      .related-title { padding:10px 10px 12px; font-size:11px; }
      .footer { padding:45px 20px 25px; }
    }
    @media (max-width:390px) {
      .related-media { height:150px; }
      .qr-wrap { flex-direction:column; }
    }
  </style>
</head>
<body>
  <header class="header">
    <a href={localizedPath(locale, "/")} class="brand"><div class="brand-title">stamp moke</div><div class="brand-sub">{t.brandSub}</div></a>
    <div class="header-actions"><LanguageSwitcher locale={locale} path={canonicalPath} /><a href={localizedPath(locale, "/")} class="header-link">{pageText.list}</a></div>
  </header>

  <main class="main">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={localizedPath(locale, "/")}>stamp moke</a> / <a href={localizedPath(locale, "/")}>{pageText.breadcrumb}</a> / {cleanTitle}</nav>

    <article class="detail-card">
      <div class="image-panel"><img class="sticker-image" src={sticker.image} alt={`${cleanTitle} - ${titleSuffix}`} loading="eager" decoding="async" width="512" height="512" /></div>
      <div>
        <div class="category-label">{localizedCategory}</div>
        <h1>{cleanTitle}</h1>
        <p class="description">{description}</p>
        {localizedPrice && <div class="price">{localizedPrice}</div>}
        <div class="actions">
          <a class="action action-buy" href={purchaseUrl} rel="noopener">{t.buy}</a>
          <a class="action action-gift" href={giftUrl} rel="noopener">{pageText.gift}</a>
        </div>
        <div class="trust-grid">
          <div class="trust-item"><strong>{pageText.safe}</strong>{pageText.safeText}</div>
          <div class="trust-item"><strong>{pageText.mobile}</strong>{pageText.mobileText}</div>
          <div class="trust-item"><strong>{pageText.giftOk}</strong>{pageText.giftText}</div>
        </div>
      </div>
    </article>

    <div class="info-grid">
      <section class="sub-card">
        <div class="sub-label">OPEN ON SMARTPHONE</div>
        <h2 class="sub-title">{pageText.phone}</h2>
        <div class="qr-wrap">
          <img class="qr" src={qrUrl} alt={`${cleanTitle} - QR Code`} width="240" height="240" loading="lazy" />
          <div class="qr-copy">{pageText.phoneText}<br /><a class="smartphone-link" href={purchaseUrl} rel="noopener">{pageText.open}</a></div>
        </div>
      </section>

      <section class="sub-card">
        <div class="sub-label">ABOUT THIS STICKER</div>
        <h2 class="sub-title">{t.productAbout}</h2>
        <dl class="detail-list">
          <div class="detail-row"><dt>{pageText.id}</dt><dd>{sticker.id}</dd></div>
          <div class="detail-row"><dt>{pageText.category}</dt><dd>{localizedCategory}</dd></div>
          {localizedPrice && <div class="detail-row"><dt>{pageText.price}</dt><dd>{localizedPrice}</dd></div>}
          <div class="detail-row"><dt>{pageText.seller}</dt><dd>LINE STORE</dd></div>
          <div class="detail-row"><dt>{pageText.work}</dt><dd>{cleanTitle}</dd></div>
        </dl>
        <a class="official-link" href={purchaseUrl} rel="noopener">{pageText.official}</a>
      </section>
    </div>

    {hasSheet && (
      <section class="all-stickers" aria-labelledby="all-stickers-title">
        <div class="section-label">ALL STICKERS PREVIEW</div>
        <h2 id="all-stickers-title" class="section-title">{pageText.included}</h2>
        <div class="preview-card protected-preview" oncontextmenu="return false">
          <img class="preview-sheet" src={sheetUrl} alt={`${cleanTitle} - ${pageText.included}`} loading="lazy" draggable="false" />
          <div class="preview-shield" aria-hidden="true"></div>
        </div>
        <p class="preview-note">{pageText.note}</p>
      </section>
    )}

    {related.length > 0 && (
      <section class="related" aria-labelledby="related">
        <div class="section-label">RELATED STICKERS</div>
        <h2 id="related" class="section-title">{pageText.related}</h2>
        <ul class="related-grid">
          {related.map((item) => (
            <li><a class="related-card" href={localizedPath(locale, `/stickers/${item.id}`)}><div class="related-media"><img class="related-image" src={item.image} alt={localizedStickerTitle(item, locale)} loading="lazy" width="512" height="512" /></div><p class="related-title">{localizedStickerTitle(item, locale)}</p></a></li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <footer class="footer"><div class="footer-inner"><div class="footer-brand">stamp moke</div><p class="footer-copy">{pageText.footer}</p><div class="footer-links"><a href={localizedPath(locale, "/")}>{pageText.list}</a><a href="https://x.com/stampmoke" rel="noopener">公式X @stampmoke</a></div><div class="copyright">© stamp moke</div></div></footer>
  <script is:inline>
    document.addEventListener("contextmenu", (event) => {
      if (event.target.closest(".protected-preview")) event.preventDefault();
    });
    document.addEventListener("dragstart", (event) => {
      if (event.target.closest(".protected-preview")) event.preventDefault();
    });
  </script>
</body>
</html>
