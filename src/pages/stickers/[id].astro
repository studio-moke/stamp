---
import stickers from "../../data/stickers.json";

export function getStaticPaths() {
  return stickers.map((sticker) => ({
    params: { id: sticker.id },
    props: { sticker },
  }));
}

const { sticker } = Astro.props;

const purchaseUrl = sticker.purchaseUrl || sticker.url;
const giftUrl = sticker.giftUrl || sticker.url;

const qrUrl =
  "https://api.qrserver.com/v1/create-qr-code/?size=320x320&margin=12&data=" +
  encodeURIComponent(sticker.url);

const pageTitle = `${sticker.title} | STAMP MOKE`;

const description =
  sticker.description ||
  `${sticker.title}をSTAMP MOKEで紹介しています。LINE STOREで購入できます。`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      property="og:title"
      content={pageTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:image"
      content={sticker.image}
    />

    <meta
      property="og:type"
      content="article"
    />

    <meta
      property="og:site_name"
      content="STAMP MOKE"
    />

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: #f7f6f2;
    color: #161616;
    font-family:
      Arial,
      "Hiragino Kaku Gothic ProN",
      "Hiragino Sans",
      "Yu Gothic",
      Meiryo,
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  /* =========================
     HEADER
  ========================= */

  .header {
    height: 86px;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid #e4e3df;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 5vw;
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(12px);
  }

  /* 以下は今のCSSをそのまま */

      .site-header {
        height: 76px;
        background: rgba(255, 255, 255, 0.94);
        border-bottom: 1px solid #e5e3dd;
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(14px);
      }

      .header-inner {
        width: min(1180px, calc(100% - 48px));
        height: 100%;
        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        text-decoration: none;
        display: inline-flex;
        flex-direction: column;
        gap: 2px;
      }

      .logo-main {
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 0.14em;
        line-height: 1;
      }

      .logo-sub {
        font-size: 10px;
        color: #888;
        letter-spacing: 0.04em;
      }

      .back-link {
        text-decoration: none;

        display: inline-flex;
        align-items: center;
        gap: 8px;

        font-size: 13px;
        font-weight: 700;

        color: #333;

        padding: 10px 15px;
        border: 1px solid #dddcd6;
        border-radius: 999px;
        background: #fff;

        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }

      .back-link:hover {
        background: #f2f1ed;
        transform: translateY(-1px);
      }


      /* ==================================================
         MAIN
      ================================================== */

      .page {
        width: min(1180px, calc(100% - 48px));
        margin: 0 auto;
        padding: 30px 0 100px;
      }


      /* ==================================================
         BREADCRUMB
      ================================================== */

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 10px;

        color: #8b8983;
        font-size: 11px;

        margin-bottom: 30px;

        white-space: nowrap;
        overflow: hidden;
      }

      .breadcrumb a {
        color: #666;
        text-decoration: none;
      }

      .breadcrumb a:hover {
        text-decoration: underline;
      }

      .breadcrumb-current {
        overflow: hidden;
        text-overflow: ellipsis;
      }


      /* ==================================================
         HERO / PRODUCT
      ================================================== */

      .product {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 70px;
        align-items: center;
      }


      /* ==================================================
         IMAGE
      ================================================== */

      .product-visual {
        min-height: 600px;

        background: #fff;
        border: 1px solid #e6e4de;
        border-radius: 28px;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 45px;

        position: relative;
        overflow: hidden;
      }

      .product-visual::before {
        content: "";

        width: 420px;
        height: 420px;

        position: absolute;
        left: 50%;
        top: 50%;

        transform: translate(-50%, -50%);

        background: #f1f0eb;
        border-radius: 50%;
      }

      .product-image {
        width: 100%;
        max-width: 500px;
        height: auto;

        position: relative;
        z-index: 2;

        display: block;

        filter: drop-shadow(
          0 20px 30px rgba(0, 0, 0, 0.08)
        );
      }


      /* ==================================================
         PRODUCT INFO
      ================================================== */

      .product-info {
        padding: 15px 0;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.16em;

        color: #77736b;

        margin-bottom: 16px;
      }

      .eyebrow::before {
        content: "";
        display: block;

        width: 24px;
        height: 2px;

        background: #222;
      }

      .product-title {
        margin: 0 0 25px;

        font-size: clamp(38px, 4.3vw, 62px);
        line-height: 1.13;

        font-weight: 900;
        letter-spacing: -0.045em;
      }

      .description {
        margin: 0;

        font-size: 15px;
        line-height: 2;

        color: #65625c;
      }


      /* ==================================================
         PRICE
      ================================================== */

      .price-area {
        margin-top: 30px;
        padding-top: 25px;

        border-top: 1px solid #dedcd5;
      }

      .price-label {
        font-size: 11px;
        color: #888;
        margin-bottom: 3px;
      }

      .price {
        font-size: 38px;
        line-height: 1;

        font-weight: 900;
        letter-spacing: -0.03em;
      }


      /* ==================================================
         BUTTONS
      ================================================== */

      .actions {
        display: grid;
        gap: 10px;

        margin-top: 26px;
      }

      .button {
        min-height: 62px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 0 21px;

        border-radius: 12px;

        text-decoration: none;

        font-size: 14px;
        font-weight: 800;

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button-main {
        color: #fff;
        background: #06c755;

        box-shadow:
          0 10px 24px rgba(6, 199, 85, 0.18);
      }

      .button-main:hover {
        background: #05b94f;

        box-shadow:
          0 14px 30px rgba(6, 199, 85, 0.24);
      }

      .button-gift {
        color: #fff;
        background: #202020;
      }

      .button-gift:hover {
        background: #333;
      }

      .button-left {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .button-icon {
        font-size: 17px;
      }

      .button-arrow {
        font-size: 18px;
        opacity: 0.7;
      }


      /* ==================================================
         TRUST POINTS
      ================================================== */

      .trust {
        margin-top: 18px;

        display: grid;
        grid-template-columns: repeat(3, 1fr);

        border: 1px solid #e1dfd8;
        border-radius: 12px;

        overflow: hidden;
        background: #fff;
      }

      .trust-item {
        padding: 15px 10px;

        text-align: center;

        border-right: 1px solid #e7e5df;
      }

      .trust-item:last-child {
        border-right: 0;
      }

      .trust-icon {
        font-size: 16px;
        margin-bottom: 4px;
      }

      .trust-title {
        font-size: 11px;
        font-weight: 800;
      }

      .trust-text {
        margin-top: 2px;

        font-size: 9px;
        line-height: 1.5;

        color: #999;
      }


      /* ==================================================
         LOWER CONTENT
      ================================================== */

      .content-grid {
        margin-top: 70px;

        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 22px;
      }

      .content-card {
        background: #fff;

        border: 1px solid #e5e3dd;
        border-radius: 20px;

        padding: 35px;
      }

      .section-kicker {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.15em;

        color: #888;

        margin-bottom: 7px;
      }

      .section-title {
        margin: 0;

        font-size: 24px;
        line-height: 1.3;

        font-weight: 900;
        letter-spacing: -0.025em;
      }

      .section-description {
        margin: 13px 0 25px;

        color: #777;

        font-size: 13px;
        line-height: 1.8;
      }


      /* ==================================================
         QR
      ================================================== */

      .qr-area {
        display: flex;
        justify-content: center;
        align-items: center;

        padding: 20px 0 8px;
      }

      .qr-box {
        width: 230px;
        height: 230px;

        padding: 14px;

        background: #fff;

        border: 1px solid #dedcd5;
        border-radius: 16px;

        box-shadow:
          0 10px 30px rgba(0, 0, 0, 0.06);
      }

      .qr-box img {
        width: 100%;
        height: 100%;

        display: block;
      }

      .qr-note {
        margin: 18px 0 0;

        text-align: center;

        font-size: 10px;
        color: #999;
      }


      /* ==================================================
         DETAILS
      ================================================== */

      .specs {
        margin-top: 24px;

        border-top: 1px solid #e4e2dc;
      }

      .spec {
        min-height: 52px;

        display: grid;
        grid-template-columns: 120px 1fr;
        align-items: center;

        border-bottom: 1px solid #e4e2dc;
      }

      .spec-label {
        color: #999;
        font-size: 12px;
      }

      .spec-value {
        font-size: 13px;
        font-weight: 700;
      }


      /* ==================================================
         OFFICIAL LINK
      ================================================== */

      .official-link {
        margin-top: 22px;

        min-height: 56px;

        padding: 0 18px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border-radius: 10px;

        background: #f1faf4;
        color: #087c3c;

        text-decoration: none;

        font-size: 13px;
        font-weight: 800;

        border: 1px solid #d9efdf;

        transition:
          background 0.2s ease,
          transform 0.2s ease;
      }

      .official-link:hover {
        background: #e5f7eb;
        transform: translateY(-1px);
      }

      .official-label {
        display: flex;
        align-items: center;
        gap: 8px;
      }


      /* ==================================================
         FOOTER
      ================================================== */

      .site-footer {
        background: #191919;
        color: #fff;

        padding: 55px 0 30px;
      }

      .footer-inner {
        width: min(1180px, calc(100% - 48px));
        margin: 0 auto;
      }

      .footer-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;

        padding-bottom: 35px;

        border-bottom: 1px solid #333;
      }

      .footer-logo {
        font-size: 19px;
        font-weight: 900;

        letter-spacing: 0.12em;
      }

      .footer-description {
        margin-top: 10px;

        color: #999;

        font-size: 11px;
        line-height: 1.8;
      }

      .footer-links {
        display: flex;
        gap: 25px;
      }

      .footer-links a {
        color: #aaa;
        text-decoration: none;

        font-size: 11px;
      }

      .footer-links a:hover {
        color: #fff;
      }

      .copyright {
        padding-top: 22px;

        color: #777;

        font-size: 9px;
      }


      /* ==================================================
         MOBILE
      ================================================== */

      @media (max-width: 900px) {
        .product {
          grid-template-columns: 1fr;
          gap: 35px;
        }

        .product-visual {
          min-height: auto;
          padding: 30px;
        }

        .product-visual::before {
          width: 330px;
          height: 330px;
        }

        .product-image {
          max-width: 460px;
        }

        .product-info {
          padding: 0;
        }

        .product-title {
          font-size: clamp(34px, 8vw, 48px);
        }

        .content-grid {
          grid-template-columns: 1fr;
        }
      }


      @media (max-width: 600px) {
        .site-header {
          height: 68px;
        }

        .header-inner {
          width: min(100% - 30px, 1180px);
        }

        .logo-main {
          font-size: 15px;
        }

        .logo-sub {
          font-size: 8px;
        }

        .back-link {
          padding: 8px 11px;
          font-size: 11px;
        }

        .page {
          width: min(100% - 30px, 1180px);
          padding-top: 20px;
          padding-bottom: 65px;
        }

        .breadcrumb {
          margin-bottom: 20px;
          font-size: 9px;
        }

        .product-visual {
          padding: 18px;
          border-radius: 18px;
        }

        .product-visual::before {
          width: 270px;
          height: 270px;
        }

        .product-title {
          font-size: 34px;
          letter-spacing: -0.035em;
        }

        .description {
          font-size: 14px;
          line-height: 1.9;
        }

        .price {
          font-size: 34px;
        }

        .button {
          min-height: 58px;
        }

        .trust {
          grid-template-columns: 1fr;
        }

        .trust-item {
          border-right: 0;
          border-bottom: 1px solid #e7e5df;
        }

        .trust-item:last-child {
          border-bottom: 0;
        }

        .content-grid {
          margin-top: 45px;
        }

        .content-card {
          padding: 25px 20px;
          border-radius: 16px;
        }

        .section-title {
          font-size: 21px;
        }

        .qr-box {
          width: 210px;
          height: 210px;
        }

        .spec {
          grid-template-columns: 90px 1fr;
        }

        .footer-top {
          display: block;
        }

        .footer-links {
          margin-top: 25px;
          flex-wrap: wrap;
          gap: 15px;
        }

        .footer-inner {
          width: min(100% - 30px, 1180px);
        }
      }
    </style>
  </head>


  <body>

    <!-- ==================================================
         HEADER
    ================================================== -->

    <header class="site-header">
      <div class="header-inner">

        <a href="/" class="logo">
          <span class="logo-main">STAMP MOKE</span>
          <span class="logo-sub">LINEスタンプ専門メディア</span>
        </a>

        <a href="/" class="back-link">
          ← スタンプ一覧へ
        </a>

      </div>
    </header>


    <!-- ==================================================
         MAIN
    ================================================== -->

    <main class="page">

      <!-- BREADCRUMB -->

      <nav class="breadcrumb" aria-label="パンくず">

        <a href="/">
          STAMP MOKE
        </a>

        <span>›</span>

        <span class="breadcrumb-current">
          {sticker.title}
        </span>

      </nav>


      <!-- ==================================================
           PRODUCT
      ================================================== -->

      <section class="product">

        <!-- IMAGE -->

        <div class="product-visual">

          <img
            class="product-image"
            src={sticker.image}
            alt={sticker.title}
            loading="eager"
          />

        </div>


        <!-- INFORMATION -->

        <div class="product-info">

          <div class="eyebrow">
            LINE STICKERS
          </div>


          <h1 class="product-title">
            {sticker.title}
          </h1>


          <p class="description">
            {description}
          </p>


          <!-- PRICE -->

          <div class="price-area">

            <div class="price-label">
              LINE STORE 販売価格
            </div>

            <div class="price">
              {sticker.price}
            </div>

          </div>


          <!-- BUTTONS -->

          <div class="actions">

            <a
              href={purchaseUrl}
              class="button button-main"
              target="_blank"
              rel="noopener noreferrer"
            >

              <span class="button-left">
                <span class="button-icon">🛒</span>
                <span>LINE STOREで購入する</span>
              </span>

              <span class="button-arrow">
                ↗
              </span>

            </a>


            <a
              href={giftUrl}
              class="button button-gift"
              target="_blank"
              rel="noopener noreferrer"
            >

              <span class="button-left">
                <span class="button-icon">🎁</span>
                <span>プレゼントする</span>
              </span>

              <span class="button-arrow">
                ↗
              </span>

            </a>

          </div>


          <!-- TRUST -->

          <div class="trust">

            <div class="trust-item">

              <div class="trust-icon">
                ✓
              </div>

              <div class="trust-title">
                安心・安全
              </div>

              <div class="trust-text">
                LINE STORE公式ページ
              </div>

            </div>


            <div class="trust-item">

              <div class="trust-icon">
                📱
              </div>

              <div class="trust-title">
                スマホで簡単
              </div>

              <div class="trust-text">
                QRコードから確認
              </div>

            </div>


            <div class="trust-item">

              <div class="trust-icon">
                🎁
              </div>

              <div class="trust-title">
                プレゼントOK
              </div>

              <div class="trust-text">
                LINEの友だちへ贈れます
              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- ==================================================
           LOWER CONTENT
      ================================================== -->

      <section class="content-grid">


        <!-- QR CARD -->

        <div class="content-card">

          <div class="section-kicker">
            FOR SMARTPHONE
          </div>

          <h2 class="section-title">
            スマホで見る
          </h2>

          <p class="section-description">
            QRコードをスマホで読み取ると、
            LINE STOREのスタンプページを
            すぐに確認できます。
          </p>


          <div class="qr-area">

            <div class="qr-box">

              <img
                src={qrUrl}
                alt={`${sticker.title} LINE STORE QRコード`}
                loading="lazy"
              />

            </div>

          </div>


          <p class="qr-note">
            ※ LINEアプリのコードリーダーで読み取ってください
          </p>

        </div>


        <!-- DETAIL CARD -->

        <div class="content-card">

          <div class="section-kicker">
            ABOUT THIS STICKER
          </div>

          <h2 class="section-title">
            このスタンプについて
          </h2>

          <p class="section-description">
            STAMP MOKEで紹介している
            LINEスタンプです。
          </p>


          <div class="specs">

            <div class="spec">

              <div class="spec-label">
                スタンプ名
              </div>

              <div class="spec-value">
                {sticker.title}
              </div>

            </div>


            <div class="spec">

              <div class="spec-label">
                価格
              </div>

              <div class="spec-value">
                {sticker.price}
              </div>

            </div>


            <div class="spec">

              <div class="spec-label">
                販売元
              </div>

              <div class="spec-value">
                moke
              </div>

            </div>


            <div class="spec">

              <div class="spec-label">
                種類
              </div>

              <div class="spec-value">
                LINEスタンプ
              </div>

            </div>

          </div>


          <!-- OFFICIAL LINE STORE -->

          <a
            href={sticker.url}
            class="official-link"
            target="_blank"
            rel="noopener noreferrer"
          >

            <span class="official-label">
              <span>↗</span>
              <span>LINE STORE公式ページを見る</span>
            </span>

            <span>
              外部サイト
            </span>

          </a>

        </div>

      </section>

    </main>


    <!-- ==================================================
         FOOTER
    ================================================== -->

    <footer class="site-footer">

      <div class="footer-inner">

        <div class="footer-top">

          <div>

            <div class="footer-logo">
              STAMP MOKE
            </div>

            <div class="footer-description">
              みんなの日常を、<br />
              スタンプでもっと楽しく。
            </div>

          </div>


          <nav class="footer-links">

            <a href="/">
              HOME
            </a>

            <a href="/">
              スタンプ一覧
            </a>

            <a
              href={sticker.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              LINE STORE
            </a>

          </nav>

        </div>


        <div class="copyright">
          © {new Date().getFullYear()} STAMP MOKE
        </div>

      </div>

    </footer>


    <!-- ==================================================
         STRUCTURED DATA
    ================================================== -->

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Product",
        name: sticker.title,
        description: description,
        image: sticker.image,
        brand: {
          "@type": "Brand",
          name: "STAMP MOKE"
        },
        offers: {
          "@type": "Offer",
          price: String(sticker.price).replace(/[^\d.]/g, ""),
          priceCurrency: "JPY",
          url: sticker.url,
          availability: "https://schema.org/InStock"
        }
      })}
    </script>

  </body>
</html>