---
import stickers from "../../data/stickers.json";
import SeoHead from "../../components/SeoHead.astro";
import { makeTitle, makeDescription, absoluteUrl } from "../../lib/seo";
import { getCategory } from "../../lib/stickers";

export function getStaticPaths() {
  return stickers.map((sticker) => ({ params: { id: sticker.id }, props: { sticker } }));
}

const { sticker } = Astro.props;
const purchaseUrl = sticker.purchaseUrl || sticker.url;
const pageTitle = makeTitle([`${sticker.title}｜LINEスタンプ`]);
const description = makeDescription(sticker.description || "", `${sticker.title}のLINEスタンプ。STAMP MOKEで作品情報を紹介しています。`);
const canonical = absoluteUrl(`/stickers/${sticker.id}`);
const category = getCategory(sticker);
const related = stickers.filter((item) => item.id !== sticker.id && getCategory(item) === category).slice(0, 6);
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <SeoHead title={pageTitle} description={description} canonical={canonical} image={sticker.image} type="article" />
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"STAMP MOKE","item":absoluteUrl("/")},{"@type":"ListItem","position":2,"name":"LINEスタンプ","item":absoluteUrl("/")},{"@type":"ListItem","position":3,"name":sticker.title,"item":canonical}]})} />
  <style>
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: #f7f6f2;
      color: #161616;
      font-family: Arial, "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }
    .header {
      height: 86px;
      background: rgba(255,255,255,.96);
      border-bottom: 1px solid #e4e3df;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5vw;
      position: sticky;
      top: 0;
      z-index: 20;
      backdrop-filter: blur(12px);
    }
    .brand { text-decoration: none; }
    .brand-title { font-size: 21px; font-weight: 900; letter-spacing: .1em; line-height: 1; }
    .brand-sub { margin-top: 7px; font-size: 11px; color: #777; letter-spacing: .05em; }
    .header-link {
      text-decoration: none;
      border: 1px solid #d9d8d4;
      background: #fff;
      padding: 13px 22px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
    }
    .main { max-width: 1180px; margin: 0 auto; padding: 38px 5vw 100px; }
    .breadcrumb { color: #777; font-size: 12px; line-height: 1.8; margin-bottom: 28px; }
    .breadcrumb a { text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .detail-card {
      display: grid;
      grid-template-columns: minmax(320px, 1fr) minmax(360px, 1fr);
      gap: 64px;
      align-items: center;
      background: #fff;
      border: 1px solid #e3e2de;
      border-radius: 24px;
      padding: 42px;
    }
    .image-panel {
      aspect-ratio: 1 / 1;
      background: #f3f2ee;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .sticker-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 28px;
    }
    .category-label {
      display: inline-block;
      margin-bottom: 16px;
      padding: 7px 12px;
      border: 1px solid #deddd8;
      border-radius: 999px;
      color: #777;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .08em;
    }
    h1 {
      margin: 0;
      font-size: clamp(32px, 4vw, 54px);
      line-height: 1.12;
      letter-spacing: -.035em;
      font-weight: 900;
    }
    .description {
      margin: 24px 0 0;
      color: #666;
      font-size: 14px;
      line-height: 2;
    }
    .purchase-box {
      margin-top: 30px;
      padding-top: 24px;
      border-top: 1px solid #eeeeeb;
    }
    .purchase-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      padding: 0 24px;
      border-radius: 999px;
      background: #168b52;
      color: #fff;
      text-decoration: none;
      font-size: 13px;
      font-weight: 800;
      transition: transform .2s ease, opacity .2s ease;
    }
    .purchase-button:hover { transform: translateY(-2px); opacity: .9; }
    .related { margin-top: 70px; }
    .section-label { font-size: 11px; letter-spacing: .18em; color: #777; margin-bottom: 8px; }
    .section-title { margin: 0 0 20px; font-size: 32px; line-height: 1.1; font-weight: 900; letter-spacing: -.03em; }
    .related-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .related-card {
      display: block;
      background: #fff;
      border: 1px solid #e3e2de;
      border-radius: 16px;
      overflow: hidden;
      text-decoration: none;
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .related-card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0,0,0,.07); }
    .related-image { width: 100%; aspect-ratio: 1 / 1; object-fit: contain; display: block; background: #f3f2ee; padding: 14px; }
    .related-title { margin: 0; padding: 14px 15px 16px; font-size: 13px; line-height: 1.5; font-weight: 800; }
    .footer { background: #181818; color: #fff; padding: 55px 5vw 30px; }
    .footer-inner { max-width: 1180px; margin: 0 auto; }
    .footer-brand { font-size: 18px; font-weight: 900; letter-spacing: .1em; }
    .footer-copy { margin: 14px 0 0; color: #999; font-size: 11px; line-height: 1.9; }
    .copyright { margin-top: 28px; padding-top: 20px; border-top: 1px solid #333; color: #666; font-size: 10px; }
    @media (max-width: 800px) {
      .detail-card { grid-template-columns: 1fr; gap: 35px; padding: 24px; }
      .image-panel { max-width: 600px; width: 100%; margin: 0 auto; }
      .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 640px) {
      .header { height: 72px; padding: 0 20px; }
      .brand-title { font-size: 17px; }
      .brand-sub { font-size: 9px; margin-top: 5px; }
      .header-link { padding: 10px 14px; font-size: 11px; }
      .main { padding: 24px 18px 70px; }
      .breadcrumb { font-size: 11px; margin-bottom: 20px; }
      .detail-card { border-radius: 16px; padding: 16px; gap: 28px; }
      .image-panel { border-radius: 13px; }
      .sticker-image { padding: 12px; }
      h1 { font-size: 30px; }
      .description { margin-top: 18px; font-size: 12px; line-height: 1.9; }
      .purchase-box { margin-top: 22px; padding-top: 18px; }
      .purchase-button { width: 100%; min-height: 48px; }
      .related { margin-top: 55px; }
      .section-title { font-size: 27px; }
      .related-grid { gap: 10px; }
      .related-card { border-radius: 12px; }
      .related-image { padding: 8px; }
      .related-title { padding: 10px 10px 12px; font-size: 11px; }
      .footer { padding: 45px 20px 25px; }
    }
  </style>
</head>
<body>
  <header class="header">
    <a href="/" class="brand">
      <div class="brand-title">STAMP MOKE</div>
      <div class="brand-sub">LINEスタンプ専門メディア</div>
    </a>
    <a href="/" class="header-link">スタンプ一覧へ</a>
  </header>

  <main class="main">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">STAMP MOKE</a> / <a href="/">LINEスタンプ</a> / {sticker.title}
    </nav>

    <article class="detail-card">
      <div class="image-panel">
        <img class="sticker-image" src={sticker.image} alt={`${sticker.title}のLINEスタンプ`} loading="eager" decoding="async" width="512" height="512" />
      </div>
      <div>
        <div class="category-label">{category}</div>
        <h1>{sticker.title}</h1>
        <p class="description">{description}</p>
        <div class="purchase-box">
          <a class="purchase-button" href={purchaseUrl} rel="noopener">LINE STOREで見る・購入する</a>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related">
        <div class="section-label">RELATED STICKERS</div>
        <h2 id="related" class="section-title">関連するLINEスタンプ</h2>
        <ul class="related-grid">
          {related.map((item) => (
            <li>
              <a class="related-card" href={`/stickers/${item.id}`}>
                <img class="related-image" src={item.image} alt={`${item.title}のLINEスタンプ`} loading="lazy" width="512" height="512" />
                <p class="related-title">{item.title}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">STAMP MOKE</div>
      <p class="footer-copy">かわいい、おもしろい、毎日使えるLINEスタンプを紹介するメディア。</p>
      <div class="copyright">© STAMP MOKE</div>
    </div>
  </footer>
</body>
</html>
