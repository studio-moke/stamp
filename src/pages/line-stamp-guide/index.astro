*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f6f3ed;color:#17251d;font-family:Arial,"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif;line-height:1.85;font-size:17px}a{color:#1d7243}a:focus-visible{outline:3px solid #27995d;outline-offset:3px}header,footer{padding:20px max(20px,calc((100% - 1100px)/2));background:#fff}header{border-bottom:1px solid #e5e3dc}footer{border-top:1px solid #e2dfd8;color:#667067;font-size:14px}.brand{font-weight:900;font-size:23px;text-decoration:none;color:#182a1e}nav{margin-top:6px;display:flex;gap:16px;flex-wrap:wrap}nav a{font-size:14px}main{max-width:1100px;margin:auto;padding:0 22px 90px}.hero{display:grid;grid-template-columns:minmax(0,1fr) 260px;align-items:center;gap:36px;padding:72px 0 42px}.eyebrow{font-size:12px;color:#35764c;font-weight:900;letter-spacing:.15em}.hero h1{font-size:clamp(32px,4.7vw,55px);line-height:1.35;margin:16px 0 18px;letter-spacing:-.03em}.lead{font-size:19px;color:#526158;max-width:740px}.art{border-radius:32px;aspect-ratio:1;background:linear-gradient(145deg,#def3df,#fff);display:grid;place-items:center;box-shadow:0 18px 40px #334f3420;border:1px solid #d6e8d4}.art span{font-size:105px}.content{max-width:850px;margin:auto}.section{padding:34px 0 24px;border-top:1px solid #dddcd5}.section h2{font-size:clamp(26px,3.1vw,34px);line-height:1.35}.section h3{font-size:21px;margin-top:30px}.section p,.section li{line-height:1.9}.table-scroll{overflow-x:auto}.table-scroll table{width:100%;border-collapse:collapse;min-width:520px}.table-scroll th,.table-scroll td{padding:14px;text-align:left;border-bottom:1px solid #d8dbd3;vertical-align:top}.table-scroll th{background:#e9efe9}.steps{padding-left:28px}.steps li{padding:5px 0 8px}.resource-list{display:grid;gap:20px}.resource{background:#fff;border-radius:18px;padding:23px 25px;border:1px solid #e0e4da}.resource strong{font-size:19px}.resource p{margin:7px 0}.resource .tag{font-size:13px;color:#346646;font-weight:800}.note{font-size:14px;color:#5a6259}.cta{display:inline-block;background:#153a25;color:white;text-decoration:none;font-weight:800;padding:13px 23px;border-radius:50px;margin:12px 0;min-height:48px}.cta:hover{background:#235a3a}@media(max-width:700px){body{font-size:17px}.hero{grid-template-columns:1fr;padding:42px 0 30px}.art{display:none}.section{padding:24px 0}.resource{padding:20px}}
