---
import stickers from "../data/stickers.json";
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import { absoluteUrl } from "../lib/seo";
const cleanTitle=(v="")=>String(v).replace(/\s*-\s*LINE スタンプ\s*\|\s*LINE STORE\s*$/u,"").replace(/\s*\d+種類\s*$/u,"").trim();
const cleanMaterialDescription=(v="")=>String(v).replace(/販売用(?:PNG|素材)(?:を)?準備中[。]?/gu,"").replace(/\s{2,}/g," ").trim();
function getCategory(sticker){const text=`${sticker.title||""} ${sticker.description||""}`;if(/博多|福岡|筑後|方言|関西弁|九州弁/.test(text))return"方言";if(/猫|ねこ|ネコ|犬|いぬ|イヌ|柴犬|コーギー|ポメラニアン|うさぎ|ウサギ|兎|くま|クマ|パンダ|鳥|すずめ|ペンギン|アザラシ|猿|サル|タヌキ|たぬき|ねずみ|動物/.test(text))return"動物";if(/ハート|恋|恋愛|カップル|彼氏|彼女|好き|愛/.test(text))return"恋愛";if(/仕事|ビジネス|敬語|丁寧|会社|職場|マーケター|バイト|働く/.test(text))return"仕事";if(/食べ物|料理|ごはん|肉まん|ビール|お酒|ジョッキ|パン|ケーキ|お菓子/.test(text))return"食べ物";if(/面白|おもしろ|ネタ|シュール|ギャグ|ツッコミ|あるある|ウザい|正論|本音/.test(text))return"おもしろ";if(/挨拶|ありがとう|おはよう|こんにちは|こんばんは|おやすみ|よろしく|おつかれ/.test(text))return"あいさつ";if(/かわいい|可愛い|キュート|癒し|ほんわか|ゆるかわ|もふもふ/.test(text))return"かわいい";if(/日常|毎日|返信|返事|会話|リアクション|気持ち/.test(text))return"日常";return"その他";}
const products=stickers.map(s=>({id:String(s.id),title:cleanTitle(s.title),description:cleanMaterialDescription(s.description||""),image:s.image||"",previewUrl:s.url||"",category:getCategory(s)}));
const productIds=products.map(p=>p.id);
const categories=["すべて",...Array.from(new Set(products.map(p=>p.category)))];
const title="商用利用OKのPNG素材｜全品150円 - stamp moke";
const description="stamp mokeのオリジナル素材を、商用利用可能なPNG素材セットとして一律150円で販売。購入後すぐにZIPでダウンロードできます。";
const canonical=absoluteUrl("/materials/");
---
<html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><SeoHead title={title} description={description} canonical={canonical} locale="ja" path="/materials/" /><Analytics />
<style>
*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.header{height:82px;background:#fff;border-bottom:1px solid #e5e3dd;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;position:sticky;top:0;z-index:20}.brand,.back{text-decoration:none;color:inherit}.brand{font-weight:900;letter-spacing:.08em}.back{border:1px solid #ddd9d1;border-radius:999px;padding:11px 16px;font-size:12px;font-weight:800}.main{max-width:1180px;margin:auto;padding:58px 5vw 100px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#777}.hero h1{font-size:clamp(42px,7vw,78px);line-height:.98;letter-spacing:-.05em;margin:14px 0}.lead{max-width:760px;color:#666;font-size:14px;line-height:2}.price-rule{display:inline-flex;margin-top:18px;background:#171717;color:#fff;border-radius:999px;padding:12px 18px;font-size:13px;font-weight:900}.stamp-notice{margin-top:18px;max-width:760px;padding:16px 18px;border:2px solid #168b52;border-radius:14px;background:#effaf3;color:#115d39;font-size:14px;font-weight:900;line-height:1.65}.section{margin-top:58px}.toolbar{display:grid;grid-template-columns:minmax(220px,1fr) auto;gap:16px;align-items:center;margin:0 0 18px;padding:16px;background:#fff;border:1px solid #e3e0d9;border-radius:15px}.search{width:100%;height:44px;border:1px solid #d8d7d2;border-radius:11px;padding:0 14px;font:inherit;font-size:14px}.result-count{font-size:12px;color:#777;white-space:nowrap}.categories{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 20px}.cat{border:1px solid #d8d7d2;background:#fff;border-radius:999px;padding:8px 13px;font:inherit;font-size:12px;font-weight:700;cursor:pointer}.cat.is-active{background:#171717;color:#fff;border-color:#171717}.section-head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #ddd9d1;padding-bottom:16px;margin-bottom:20px}.section-head h2{font-size:30px;margin:0}.count{font-size:12px;color:#777}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.card{background:#fff;border:1px solid #e3e0d9;border-radius:18px;overflow:hidden;display:flex;flex-direction:column}.media{aspect-ratio:1;background:#fff}.media img{width:100%;height:100%;object-fit:contain;display:block}.body{padding:15px;display:flex;flex:1;flex-direction:column}.title{font-size:14px;line-height:1.5;margin:0;font-weight:900}.desc{font-size:11px;line-height:1.7;color:#777;margin:8px 0 10px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.assets{font-size:10px;color:#168b52;font-weight:800;margin-bottom:6px}.preview-link{display:inline-flex;width:fit-content;color:#555;font-size:10px;font-weight:800;text-decoration:underline;text-underline-offset:3px;margin-bottom:12px}.preview-link:hover{color:#168b52}.meta{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:8px}.price{font-size:20px;font-weight:900}.tax{font-size:10px;color:#888}.buy,.soon{border:0;border-radius:999px;padding:10px 13px;font-size:11px;font-weight:900}.buy{position:relative;isolation:isolate;background:linear-gradient(135deg,#45c77c,#168b52);color:#fff;cursor:pointer;border:2px solid #d9f7e5;box-shadow:0 4px 0 #0d6639,0 7px 15px rgba(22,139,82,.2);letter-spacing:.03em;transition:transform .16s ease,box-shadow .16s ease}.buy::before{content:"✦";display:inline-block;margin-right:4px;font-size:10px}.buy:hover{transform:translateY(-2px);box-shadow:0 6px 0 #0d6639,0 10px 18px rgba(22,139,82,.24)}.buy:active{transform:translateY(2px);box-shadow:0 2px 0 #0d6639,0 4px 9px rgba(22,139,82,.18)}.buy:focus-visible{outline:3px solid #ffbf4d;outline-offset:3px}.buy:disabled{opacity:.55;cursor:wait;transform:none;box-shadow:0 3px 0 #0d6639}.soon{background:#efede7;color:#888}.notice{margin-top:24px;padding:18px;border-radius:14px;background:#fff;border:1px solid #e3e0d9;color:#666;font-size:12px;line-height:1.8}.notice a{color:#168b52;font-weight:800}@media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){.toolbar{grid-template-columns:1fr;gap:9px;padding:12px}.result-count{display:none}.header{height:70px;padding:0 18px}.main{padding:38px 18px 70px}.hero h1{font-size:46px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.card{border-radius:13px}.body{padding:12px}.title{font-size:12px}.desc{font-size:10px}.price{font-size:17px}}
</style></head><body>
<header class="header"><a class="brand" href="/">stamp moke</a><a class="back" href="/">TOPへ</a></header><main class="main"><section class="hero"><div class="eyebrow">COMMERCIAL PNG MATERIALS</div><h1>全部、150円。</h1><p class="lead">LINEスタンプから生まれたstamp mokeのオリジナル素材を、商用利用可能なPNG素材セットとして販売します。販売用ZIPが準備できた商品だけ購入できます。</p><div class="price-rule">1セット 150円（税込）</div><p class="stamp-notice">このページで販売しているのは、LINEスタンプではありません。<br>商用利用可能なPNG素材セット（ZIP形式）です。</p></section>
<section class="section"><div class="section-head"><h2>素材一覧</h2><div class="count">{products.length} sets</div></div><div class="toolbar"><input id="search" class="search" type="search" placeholder="タイトル・説明文から検索" aria-label="タイトル・説明文から検索"><div id="result-count" class="result-count">{products.length} SETS</div></div><div class="categories" aria-label="カテゴリから探す">{categories.map(category=><button class={`cat${category==="すべて"?" is-active":""}`} type="button" data-category={category}>{category}</button>)}</div><div class="grid">{products.map((p,index)=><article class="card" data-product-id={p.id} data-category={p.category} data-search={`${p.title} ${p.description} ${p.category}`.toLowerCase()}><div class="media"><img src={p.image} alt={p.title} loading={index<8?"eager":"lazy"}></div><div class="body"><h3 class="title">{p.title}</h3><p class="desc">{p.description}</p><div class="assets">販売状態を確認中…</div>{p.previewUrl&&<a class="preview-link" href={p.previewUrl} target="_blank" rel="noopener noreferrer">LINEスタンプの収録画像を見る ↗</a>}<div class="meta"><div><div class="price">¥150</div><div class="tax">税込 / 商用利用OK</div></div><span class="soon">確認中</span></div></div></article>)}</div><div class="notice">販売用ZIPが揃っていない商品は決済できません。購入完了後は期限付きダウンロードURLを発行します。<br><a href="/materials/license/">商用素材の利用条件を見る →</a></div></section></main>
<script define:vars={{productIds}}>
async function startCheckout(button,id){button.disabled=true;const old=button.textContent;button.textContent='決済へ…';try{const r=await fetch('/api/store?action=checkout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId:id})});const d=await r.json();if(!r.ok||!d.checkoutUrl)throw new Error(d.error||'決済を開始できませんでした。');location.href=d.checkoutUrl;}catch(e){alert(e instanceof Error?e.message:'決済を開始できませんでした。');button.disabled=false;button.textContent=old;}}
async function hydrate(){try{const r=await fetch('/api/store?action=catalog',{cache:'no-store'});const d=await r.json();const states=new Map((d.products||[]).map(x=>[String(x.id),x]));document.querySelectorAll('.card').forEach((card,i)=>{const id=String(card.dataset.productId||productIds[i]||''),s=states.get(id),assets=card.querySelector('.assets'),slot=card.querySelector('.soon,.buy');if(assets)assets.textContent=s?.assetCount?`PNG ${s.assetCount}点 / ZIP`:'販売用素材を準備中';if(!slot)return;if(s?.published){const b=document.createElement('button');b.className='buy';b.textContent='購入する';b.addEventListener('click',()=>{location.href=`/materials/${encodeURIComponent(id)}/`;});slot.replaceWith(b);}else{slot.className='soon';slot.textContent='準備中';}});}catch{document.querySelectorAll('.assets').forEach(x=>x.textContent='販売状態を取得できませんでした');}}
hydrate();
const cards=[...document.querySelectorAll('.card')],categoryButtons=[...document.querySelectorAll('.cat')],search=document.getElementById('search'),resultCount=document.getElementById('result-count');let category='すべて';
function filterProducts(){const q=(search?.value||'').trim().toLowerCase();let visible=0;cards.forEach(card=>{const categoryOk=category==='すべて'||card.dataset.category===category;const searchOk=!q||(card.dataset.search||'').includes(q);card.hidden=!(categoryOk&&searchOk);if(!card.hidden)visible+=1;});if(resultCount)resultCount.textContent=`${visible} SETS`;}
categoryButtons.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.category||'すべて';categoryButtons.forEach(item=>item.classList.toggle('is-active',item===button));filterProducts();}));search?.addEventListener('input',filterProducts);
</script></body></html>
