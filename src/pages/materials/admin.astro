---
import stickers from "../../data/stickers.json";
const cleanTitle=(value="")=>String(value).replace(/\s*-\s*LINE スタンプ\s*\|\s*LINE STORE\s*$/u,"").replace(/\s*\d+種類\s*$/u,"").trim();
const products=stickers.map(s=>({id:String(s.id),title:cleanTitle(s.title)}));
---
<!doctype html>
<html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>商用素材 管理 | stamp moke</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.wrap{max-width:820px;margin:auto;padding:28px 18px 90px}.top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:20px}.brand{font-size:22px;font-weight:900}.top a{color:inherit}.panel{background:#fff;border:1px solid #e0ddd6;border-radius:20px;padding:18px;margin-bottom:16px}.field{display:grid;gap:7px;margin-bottom:14px}label{font-size:13px;font-weight:900}input,select,button{font:inherit}input,select{width:100%;padding:12px;border:1px solid #d8d5ce;border-radius:11px;background:#fff}button{border:0;border-radius:999px;padding:12px 17px;font-weight:900;cursor:pointer}.primary{background:#171717;color:#fff}.sub{background:#efede7}.danger{background:#fff0f0;color:#9c1c1c}.actions{display:flex;gap:9px;flex-wrap:wrap}.drop{border:2px dashed #c8c4ba;border-radius:16px;padding:28px 16px;text-align:center;background:#faf9f5;cursor:pointer}.drop strong{display:block;font-size:18px;margin-bottom:7px}.note,.meta{font-size:12px;line-height:1.7;color:#707070}.status{display:none;margin-bottom:16px;padding:14px;border-radius:13px;background:#171717;color:#fff;font-weight:800;line-height:1.55}.status.show{display:block}.status.error{background:#9c1c1c}.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:14px}.box{background:#f7f6f2;border-radius:12px;padding:12px}.box b{display:block;font-size:18px}.state{font-weight:900}.live{color:#168b52}.off{color:#8a6500}.hint{margin-top:12px;padding:12px;border-radius:12px;background:#eef7f1;color:#315b41;font-size:12px;line-height:1.7}@media(max-width:560px){.top{align-items:flex-start;flex-direction:column}.summary{grid-template-columns:1fr}.actions button{flex:1 1 100%}}
</style></head><body><main class="wrap">
<div class="top"><div><div class="brand">stamp moke / 商用素材管理</div><div class="meta">LINE商品パッケージの個別PNGをそのままZIP化 → 自動販売</div></div><a href="/materials/">販売ページを見る</a></div>
<div id="status" class="status"></div>
<section class="panel">
<div class="field"><label>管理トークン</label><input id="token" type="password" placeholder="STORE_ADMIN_TOKEN または FREE_ADMIN_TOKEN"></div>
<div class="field"><label>商品</label><select id="product">{products.map(p=><option value={p.id}>{p.id}｜{p.title}</option>)}</select></div>
<div class="summary"><div class="box"><span class="meta">状態</span><b id="liveState" class="state off">確認中</b></div><div class="box"><span class="meta">登録点数</span><b id="registeredCount">-</b></div><div class="box"><span class="meta">価格</span><b>¥150</b></div></div>
<div class="actions" style="margin-top:14px"><button id="autoPrepareAll" class="primary">販売できる商品を一括で販売開始</button></div>
<div class="hint">8・24・32・40枚の個別PNGだけをZIPにまとめます。素材の準備が成功した時点で自動的に販売中になります。</div>
</section>
<section class="panel" style="display:none" aria-hidden="true">
<div class="field"><label>入力形式</label><select id="mode"><option value="individual">個別PNG（8・24・32・40枚）</option></select></div>
<div id="drop" class="drop"><strong>素材画像をまとめて選択</strong><span id="dropHelp" class="meta">40個セットなら、8個入り画像を5枚選択してください</span><input id="files" type="file" accept="image/png,.png" multiple hidden></div>
<div class="summary"><div class="box"><span class="meta">選択ファイル</span><b id="fileCount">0</b></div><div class="box"><span class="meta">生成予定</span><b id="assetCount">0点</b></div><div class="box"><span class="meta">合計容量</span><b id="fileSize">0 MB</b></div></div>
<div class="actions" style="margin-top:14px"><button id="testZip" class="sub" disabled>R2に送らずZIPテスト</button><button id="publish" class="primary" disabled>ZIP化して販売準備</button><button id="promote" class="sub">Previewで確認済みの商品を公開へ反映</button><button id="clear" class="sub" disabled>選択をクリア</button><button id="unpublish" class="danger">販売を停止</button></div>
<div class="hint">8個入り画像モードでは、画像を4列×2行に分け、各マスの透明余白を自動トリミングして個別PNGにします。最初は「R2に送らずZIPテスト」で確認できます。管理トークン不要・販売状態変更なしです。</div>
<p class="note">分割後のPNGは再圧縮されますが、透明背景を維持したPNGとして書き出します。ZIPには連番PNG、README.txt、LICENSE.txt、manifest.jsonを同梱します。</p>
</section>
</main>
<script define:vars={{products}}>
const $=id=>document.getElementById(id);const token=$("token"),product=$("product"),mode=$("mode"),files=$("files"),drop=$("drop"),publish=$("publish"),promote=$("promote"),autoPrepareAll=$("autoPrepareAll"),testZip=$("testZip"),clear=$("clear"),unpublish=$("unpublish"),status=$("status");
token.value=sessionStorage.getItem("sm_store_admin")||sessionStorage.getItem("sm_free_admin")||"";token.addEventListener("input",()=>sessionStorage.setItem("sm_store_admin",token.value));let selected=[];let states=new Map();
function msg(text,error=false){status.textContent=text;status.className=`status show${error?' error':''}`;status.scrollIntoView({behavior:'smooth',block:'nearest'});}function fmt(bytes){return(bytes/1024/1024).toFixed(2)+" MB";}function titleFor(id){return products.find(p=>p.id===id)?.title||id;}function plannedCount(){return mode.value==='sheet'?selected.length*8:selected.length;}
async function api(action,body={}){const r=await fetch(`/api/store?action=${encodeURIComponent(action)}`,{method:"POST",headers:{"Content-Type":"application/json","x-admin-token":token.value},body:JSON.stringify(body)});const data=await r.json();if(!r.ok)throw new Error(data.error||"処理に失敗しました。");return data;}
async function loadStates(){try{const r=await fetch('/api/store?action=catalog',{cache:'no-store'});const d=await r.json();states=new Map((d.products||[]).map(x=>[String(x.id),x]));renderState();}catch{}}
function renderState(){const s=states.get(product.value);$("liveState").textContent=s?.published?"販売中":"準備中";$("liveState").className=`state ${s?.published?'live':'off'}`;$("registeredCount").textContent=s?.assetCount?`${s.assetCount}点`:"-";}
function renderSelection(){const total=selected.reduce((n,f)=>n+f.size,0),count=plannedCount();$("fileCount").textContent=String(selected.length);$("assetCount").textContent=`${count}点`;$("fileSize").textContent=fmt(total);$("dropHelp").textContent=mode.value==='sheet'?"40個セットなら、8個入り画像を5枚選択してください":"個別PNGを1〜80枚まとめて選択してください";const disabled=selected.length<1||count<1||count>80||total>100*1024*1024;publish.disabled=disabled;testZip.disabled=disabled;clear.disabled=!selected.length;}
product.addEventListener("change",renderState);mode.addEventListener("change",renderSelection);drop.onclick=()=>files.click();files.onchange=()=>setFiles([...files.files]);clear.onclick=()=>setFiles([]);
function setFiles(list){selected=list.filter(f=>f.type==="image/png"||f.name.toLowerCase().endsWith('.png')).sort((a,b)=>a.name.localeCompare(b.name,undefined,{numeric:true,sensitivity:'base'}));renderSelection();if(list.length!==selected.length)msg("PNG以外のファイルは除外しました。",true);}
function loadImage(file){return new Promise((resolve,reject)=>{const url=URL.createObjectURL(file),img=new Image();img.onload=()=>{URL.revokeObjectURL(url);resolve(img)};img.onerror=()=>{URL.revokeObjectURL(url);reject(new Error(`${file.name} を画像として開けません。`))};img.src=url;});}
function canvasPng(canvas){return new Promise((resolve,reject)=>canvas.toBlob(async blob=>{if(!blob)return reject(new Error('PNG書き出しに失敗しました。'));resolve(new Uint8Array(await blob.arrayBuffer()));},'image/png'));}
async function splitSheet(file){const img=await loadImage(file),out=[];for(let row=0;row<2;row++){for(let col=0;col<4;col++){const x0=Math.round(img.width*col/4),x1=Math.round(img.width*(col+1)/4),y0=Math.round(img.height*row/2),y1=Math.round(img.height*(row+1)/2),w=x1-x0,h=y1-y0;const cell=document.createElement('canvas');cell.width=w;cell.height=h;const ctx=cell.getContext('2d',{willReadFrequently:true});ctx.drawImage(img,x0,y0,w,h,0,0,w,h);const data=ctx.getImageData(0,0,w,h).data;let minX=w,minY=h,maxX=-1,maxY=-1;for(let y=0;y<h;y++)for(let x=0;x<w;x++){if(data[(y*w+x)*4+3]>8){if(x<minX)minX=x;if(x>maxX)maxX=x;if(y<minY)minY=y;if(y>maxY)maxY=y;}}if(maxX<0)throw new Error(`${file.name} の ${row*4+col+1}番目が空白です。`);const bw=maxX-minX+1,bh=maxY-minY+1,pad=Math.max(12,Math.round(Math.max(bw,bh)*0.04)),dst=document.createElement('canvas');dst.width=bw+pad*2;dst.height=bh+pad*2;dst.getContext('2d').drawImage(cell,minX,minY,bw,bh,pad,pad,bw,bh);out.push(await canvasPng(dst));}}return out;}
async function prepareAssets(){const assets=[];if(mode.value==='individual'){for(const f of selected){const data=new Uint8Array(await f.arrayBuffer());if(data.length<8||data[0]!==137||data[1]!==80||data[2]!==78||data[3]!==71)throw new Error(`${f.name} は正しいPNGではありません。`);assets.push(data);}return assets;}for(let i=0;i<selected.length;i++){msg(`${i+1}/${selected.length}枚目を8個に分割しています…`);assets.push(...await splitSheet(selected[i]));}return assets;}
function crcTable(){const t=new Uint32Array(256);for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=(c&1)?0xedb88320^(c>>>1):c>>>1;t[n]=c>>>0;}return t;}const table=crcTable();function crc32(data){let c=0xffffffff;for(const b of data)c=table[(c^b)&255]^(c>>>8);return(c^0xffffffff)>>>0;}
function u16(v){const b=new Uint8Array(2);new DataView(b.buffer).setUint16(0,v,true);return b}function u32(v){const b=new Uint8Array(4);new DataView(b.buffer).setUint32(0,v>>>0,true);return b}function concat(parts){let len=parts.reduce((n,p)=>n+p.length,0),out=new Uint8Array(len),o=0;for(const p of parts){out.set(p,o);o+=p.length;}return out;}
function dosNow(){const d=new Date(),time=((d.getHours()&31)<<11)|((d.getMinutes()&63)<<5)|((Math.floor(d.getSeconds()/2))&31),date=(((d.getFullYear()-1980)&127)<<9)|(((d.getMonth()+1)&15)<<5)|(d.getDate()&31);return{time,date};}
function makeZip(entries){const enc=new TextEncoder(),locals=[],centrals=[];let offset=0;const dt=dosNow();for(const e of entries){const name=enc.encode(e.name),data=e.data,c=crc32(data);const local=concat([u32(0x04034b50),u16(20),u16(0x0800),u16(0),u16(dt.time),u16(dt.date),u32(c),u32(data.length),u32(data.length),u16(name.length),u16(0),name,data]);locals.push(local);centrals.push(concat([u32(0x02014b50),u16(20),u16(20),u16(0x0800),u16(0),u16(dt.time),u16(dt.date),u32(c),u32(data.length),u32(data.length),u16(name.length),u16(0),u16(0),u16(0),u16(0),u32(0),u32(offset),name]));offset+=local.length;}const central=concat(centrals),body=concat(locals),end=concat([u32(0x06054b50),u16(0),u16(0),u16(entries.length),u16(entries.length),u32(central.length),u32(body.length),u16(0)]);return new Blob([body,central,end],{type:'application/zip'});}
async function buildZip(){const id=product.value,title=titleFor(id),assets=await prepareAssets(),entries=[];for(let i=0;i<assets.length;i++)entries.push({name:`png/${String(i+1).padStart(2,'0')}.png`,data:assets[i]});const enc=new TextEncoder();const license=`stamp moke 商用素材ライセンス（販売前ドラフト）\n\n商用利用: 可\n加工・編集: 可\n禁止: 素材データ自体またはZIPの再配布・再販売、素材そのものを主目的とする配布、第三者の権利を侵害する利用。\n\nクレジット表記など未確定の条件は販売開始前に最終確定します。詳細条件は stamp-moke.jp/materials/license/ を確認してください。\n`;const readme=`${title}\n商品ID: ${id}\n収録PNG: ${assets.length}点\n価格: 150円（税込）\n商用利用: 可\n\n© stamp moke\n`;const manifest={productId:id,title,assetCount:assets.length,sourceMode:mode.value,sourceFiles:selected.length,generatedAt:new Date().toISOString(),format:'PNG',commercialUse:true,licenseVersion:'draft-2026-09-07'};entries.push({name:'README.txt',data:enc.encode(readme)},{name:'LICENSE.txt',data:enc.encode(license)},{name:'manifest.json',data:enc.encode(JSON.stringify(manifest,null,2))});return{zip:makeZip(entries),assetCount:assets.length};}
async function sha256Hex(blob){const digest=await crypto.subtle.digest('SHA-256',await blob.arrayBuffer());return [...new Uint8Array(digest)].map(b=>b.toString(16).padStart(2,'0')).join('');}
testZip.onclick=async()=>{if(!selected.length)return;testZip.disabled=true;try{msg("端末内だけで素材を分割・ZIP化しています…");const {zip,assetCount}=await buildZip();const url=URL.createObjectURL(zip),a=document.createElement('a');a.href=url;a.download=`stamp-moke-test-${product.value}.zip`;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),30000);msg(`ローカルZIPテスト成功：${assetCount}点 / ${fmt(zip.size)}。R2・販売状態には何も変更していません。`);}catch(e){msg(e instanceof Error?e.message:"ZIPテストに失敗しました。",true);}finally{renderSelection();}};
autoPrepareAll.onclick=async()=>{if(!confirm("販売できる商品を、LINE商品パッケージ内の個別PNGだけでZIP化し、順番に販売開始します。画像の結合・分割は行いません。開始しますか？"))return;autoPrepareAll.disabled=true;try{await api("admin-health");await loadStates();const targets=products.filter(item=>!states.get(String(item.id))?.published);if(!targets.length){msg("未販売の商品はありません。");return;}let completed=0,failed=[];for(const item of targets){msg(`自動販売の準備中… ${completed+1}/${targets.length}｜${item.title}`);try{await api("admin-prepare-line",{productId:item.id});completed++;}catch(error){failed.push(item.title);}}await loadStates();msg(failed.length?`完了：${completed}商品を販売開始しました。${failed.length}商品は次回の実行で再試行します。`:`完了：${completed}商品をすべて販売開始しました。`);}catch(e){msg(e instanceof Error?e.message:"一括自動販売の準備に失敗しました。",true);}finally{autoPrepareAll.disabled=false;}};
promote.onclick=async()=>{if(!confirm(`${titleFor(product.value)} をPreviewの確認済みZIPから公開サイトへ反映しますか？`))return;promote.disabled=true;try{msg("Previewで確認済みのZIPを公開カタログへ反映しています…");const result=await api("admin-promote-preview",{productId:product.value});msg(`公開しました：${titleFor(product.value)}（${result.product.assetCount}点）を販売中にしました。`);await loadStates();}catch(e){msg(e instanceof Error?e.message:"公開への反映に失敗しました。",true);}finally{promote.disabled=false;}};
publish.onclick=async()=>{if(!selected.length)return;publish.disabled=true;try{msg("管理権限を確認しています…");await api('admin-health');msg("素材を分割・ZIP化しています…");const {zip,assetCount}=await buildZip();msg("ZIPの固有ハッシュを計算しています…");const contentHash=await sha256Hex(zip);msg(`ZIP ${fmt(zip.size)} をR2へ送信しています…`);const prep=await api('admin-upload-url',{productId:product.value,assetCount,contentHash});const put=await fetch(prep.uploadUrl,{method:'PUT',headers:{'Content-Type':'application/zip'},body:zip});if(!put.ok)throw new Error(`R2アップロードに失敗しました (${put.status})`);msg("アップロードを確認して販売状態を更新しています…");await api('admin-publish',{productId:product.value,assetCount,contentHash,published:true});msg(`完了：${titleFor(product.value)} を ${assetCount}点・150円の商品として販売準備しました。`);await loadStates();}catch(e){msg(e instanceof Error?e.message:"処理に失敗しました。",true);}finally{renderSelection();}};
unpublish.onclick=async()=>{if(!confirm(`${titleFor(product.value)} の販売を停止しますか？`))return;try{msg("販売を停止しています…");await api('admin-unpublish',{productId:product.value});msg("販売を停止しました。購入済みのZIPは保持されます。");await loadStates();}catch(e){msg(e instanceof Error?e.message:"処理に失敗しました。",true);}};
loadStates();renderSelection();
</script></body></html>
