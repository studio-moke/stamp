---
import stickers from "../../../data/stickers.json";
import { CATEGORY_DEFINITIONS, getCategory } from "../../../lib/stickers";
import SeoHead from "../../../components/SeoHead.astro";
import { makeTitle, makeDescription, absoluteUrl } from "../../../lib/seo";
const pageSize = 24;
export function getStaticPaths(){const paths=[];for(const category of CATEGORY_DEFINITIONS){const items=stickers.filter(s=>getCategory(s)===category.name);const totalPages=Math.max(1,Math.ceil(items.length/pageSize));for(let page=1;page<=totalPages;page++)paths.push({params:{category:category.slug,page:String(page)},props:{category,items,page,totalPages}})}return paths;}
const {category:categoryParam,items,page,totalPages}=Astro.props; const category=categoryParam; const visible=items.slice((page-1)*pageSize,page*pageSize); const title=makeTitle([`${category.name}のLINEスタンプ${page>1?`｜${page}ページ目`:""}`]); const description=makeDescription("",`${category.name}のLINEスタンプをSTAMP MOKEで紹介。${items.length}作品から探せます。${page>1?`${page}ページ目。`:""}`); const canonical=absoluteUrl(`/categories/${category.slug}/${page}`);
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>{title}</title><SeoHead title={title} description={description} canonical={canonical}/></head><body><main><nav aria-label="パンくず"><a href="/">STAMP MOKE</a> / <a href="/categories/">カテゴリー</a> / {category.name}</nav><header><h1>{category.name}のLINEスタンプ</h1><p>{items.length}作品を掲載中。気になるスタンプを探せます。</p></header><section aria-label={`${category.name}のLINEスタンプ一覧`}>{visible.map(sticker=><article><a href={`/stickers/${sticker.id}`}><img src={sticker.image} alt={`${sticker.title}のLINEスタンプ`} loading="lazy" width="512" height="512"/><h2>{sticker.title}</h2></a></article>)}</section><nav aria-label="ページ移動">{page>1&&<a href={`/categories/${category.slug}/${page-1}`}>前のページ</a>}<span>{page} / {totalPages}</span>{page<totalPages&&<a href={`/categories/${category.slug}/${page+1}`}>次のページ</a>}</nav></main></body></html>
