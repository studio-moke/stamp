---
import stickers from "../../../data/stickers.json";
import {
  CATEGORY_DEFINITIONS,
  getCategory,
  getCategoryBySlug,
  SITE_URL,
} from "../../../lib/stickers";

const PAGE_SIZE = Astro.props.pageSize ?? 24;

export function getStaticPaths() {
  const paths = [];
  const pageSize = 24;

  for (const category of CATEGORY_DEFINITIONS) {
    const items = stickers.filter((sticker) => getCategory(sticker) === category.name);
    const totalPages = Math.max(1, Math.ceil(items.length / pageSize));

    for (let page = 1; page <= totalPages; page += 1) {
      paths.push({
        params: { category: category.slug, page: String(page) },
        props: { category, items, page, totalPages, pageSize },
      });
    }
  }

  return paths;
}

const { category: categoryParam, items, page, totalPages } = Astro.props;
const category = categoryParam;
const start = (page - 1) * PAGE_SIZE;
const visible = items.slice(start, start + PAGE_SIZE);
const categoryMeta = getCategoryBySlug(category.slug);
const basePath = `${SITE_URL}/categories/${category.slug}`;

const pageTitle = `${category.name}のLINEスタンプ${page > 1 ? `｜${page}ページ目` : ""} | STAMP MOKE`;
const description = `${category.name}のLINEスタンプをSTAMP MOKEで紹介。${items.length}作品から探せます。${page > 1 ? `${page}ページ目。` : ""}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${basePath}/${page}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${basePath}/${page}`} />
  </head>
  <body style="margin:0;background:#f7f6f2;color:#161616;font-family:Arial,'Hiragino Kaku Gothic ProN','Hiragino Sans','Yu Gothic',Meiryo,sans-serif;">
    <main style="max-width:1180px;margin:0 auto;padding:45px 24px 90px;">
      <nav style="font-size:12px;color:#777;margin-bottom:30px;"><a href="/">STAMP MOKE</a> / <a href="/categories/">カテゴリー</a> / {category.name}</nav>

      <header style="border-bottom:1px solid #dddcd8;padding-bottom:25px;margin-bottom:28px;">
        <p style="font-size:11px;letter-spacing:.18em;color:#777;margin:0 0 10px;">CATEGORY / {categoryMeta?.slug?.toUpperCase()}</p>
        <h1 style="font-size:clamp(38px,5vw,64px);line-height:1.05;margin:0 0 15px;font-weight:900;">{category.name}のLINEスタンプ</h1>
        <p style="margin:0;color:#666;font-size:14px;line-height:1.9;">{items.length}作品を掲載中。気になるスタンプを選んで詳細をご覧ください。</p>
      </header>

      <section aria-label={`${category.name}のスタンプ一覧`} style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;">
        {visible.map((sticker) => (
          <a href={`/stickers/${sticker.id}`} style="display:block;text-decoration:none;color:inherit;background:#fff;border:1px solid #e3e2de;border-radius:16px;overflow:hidden;">
            <div style="aspect-ratio:1;background:#f3f2ee;display:flex;align-items:center;justify-content:center;">
              <img src={sticker.image} alt={sticker.title} loading="lazy" style="width:100%;height:100%;object-fit:contain;padding:14px;box-sizing:border-box;" />
            </div>
            <div style="padding:16px;">
              <h2 style="font-size:16px;line-height:1.5;margin:0;font-weight:800;">{sticker.title}</h2>
              {sticker.description && <p style="font-size:12px;line-height:1.7;color:#777;margin:9px 0 0;">{sticker.description}</p>}
              <div style="font-size:12px;font-weight:700;color:#168b52;margin-top:14px;">詳しく見る →</div>
            </div>
          </a>
        ))}
      </section>

      <nav aria-label="カテゴリー内ページ移動" style="display:flex;justify-content:center;align-items:center;gap:10px;margin-top:40px;">
        {page > 1 && <a href={`/categories/${category.slug}/${page - 1}`} style="padding:10px 16px;border:1px solid #d8d7d2;border-radius:10px;background:#fff;text-decoration:none;color:#333;">← 前へ</a>}
        <span style="font-size:13px;color:#777;">{page} / {totalPages}</span>
        {page < totalPages && <a href={`/categories/${category.slug}/${page + 1}`} style="padding:10px 16px;border:1px solid #d8d7d2;border-radius:10px;background:#fff;text-decoration:none;color:#333;">次へ →</a>}
      </nav>

      <p style="margin-top:40px;font-size:13px;"><a href="/categories/">← カテゴリー一覧へ</a></p>
    </main>
  </body>
</html>
