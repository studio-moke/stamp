---
const title = "無料フリー素材 | SNS・ポケカラ・個人利用向け | stamp moke";
const description = "ポケカラ、X、Instagram、Facebookなどで使えるstamp mokeの無料フリー素材。個人・非商用利用向け。商用利用・再配布は禁止です。";
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://stamp-moke.jp/free/" />
  <style>
    :root{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#202124;background:#fff}*{box-sizing:border-box}body{margin:0}.wrap{max-width:1100px;margin:auto;padding:32px 18px 80px}.hero{text-align:center;padding:28px 0 30px}.hero h1{font-size:clamp(28px,6vw,46px);margin:0 0 10px}.hero p{color:#667085;line-height:1.8;max-width:760px;margin:auto}.terms{margin:22px auto 30px;max-width:900px;padding:16px 18px;background:#f7f7f5;border-radius:14px;font-size:14px;line-height:1.8}.filters{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.filters button{border:1px solid #ddd;background:#fff;border-radius:999px;padding:8px 13px;cursor:pointer}.filters button.active{background:#111;color:#fff;border-color:#111}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.card{border:1px solid #e5e7eb;border-radius:16px;overflow:hidden;background:#fff}.thumb{display:block;aspect-ratio:1/1;background:#f7f7f7}.thumb img{width:100%;height:100%;object-fit:contain;display:block}.body{padding:12px}.body h2{font-size:15px;margin:0 0 6px}.body p{font-size:12px;color:#667085;margin:0;line-height:1.55}.empty{text-align:center;color:#667085;padding:60px 0}.brand{font-weight:900;text-decoration:none;color:#111}@media(max-width:850px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:600px){.grid{grid-template-columns:repeat(2,1fr);gap:10px}.wrap{padding-inline:12px}.body{padding:9px}}
  </style>
</head>
<body>
<div class="wrap">
  <a class="brand" href="/">stamp moke</a>
  <section class="hero"><h1>無料フリー素材</h1><p>ポケカラや各SNS、個人プロフィール、学校・サークルなどの非商用チラシで使いやすい素材を配布しています。公開画像は透かし入りです。ダウンロードボタンから透かしなし原本を取得できます。</p></section>
  <section class="terms"><strong>利用条件</strong><br>個人利用・非商用利用のみ無料です。ポケカラ、X、Instagram、FacebookなどのSNS、個人用プロフィール、壁紙、非商用のチラシ・印刷物などに利用できます。商用利用、販売、再配布、自作発言は禁止です。著作権は <strong>© stamp-moke.jp</strong> に帰属します。</section>
  <div class="filters" id="filters"></div>
  <div class="grid" id="grid"><div class="empty">素材を読み込んでいます…</div></div>
</div>
<script>
  const platforms=["all","pokekara","x","instagram","facebook","line","youtube"];
  const labels={all:"すべて",pokekara:"ポケカラ",x:"X",instagram:"Instagram",facebook:"Facebook",line:"LINE",youtube:"YouTube"};
  let assets=[];let active="all";
  const grid=document.getElementById("grid"),filters=document.getElementById("filters");
  const esc=(v="")=>String(v).replace(/[&<>\"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
  function renderFilters(){filters.innerHTML=platforms.map(p=>`<button data-p="${p}" class="${p===active?'active':''}">${labels[p]}</button>`).join("");filters.querySelectorAll("button").forEach(b=>b.onclick=()=>{active=b.dataset.p;renderFilters();render()})}
  function render(){const rows=active==="all"?assets:assets.filter(a=>(a.platforms||[]).includes(active));if(!rows.length){grid.innerHTML='<div class="empty">この条件の素材はまだありません。</div>';return}grid.innerHTML=rows.map(a=>{const ja=a.locales?.ja||{};return `<article class="card"><a class="thumb" href="/free/${encodeURIComponent(a.slug)}"><img loading="lazy" src="${esc(a.previewUrl)}" alt="${esc(ja.alt||ja.title||'無料素材')}"></a><div class="body"><h2><a href="/free/${encodeURIComponent(a.slug)}">${esc(ja.title||a.slug)}</a></h2><p>${esc((ja.description||'').slice(0,72))}</p></div></article>`}).join("")}
  renderFilters();fetch('/api/free-assets?action=list&limit=200').then(r=>r.json()).then(j=>{assets=j.assets||[];render()}).catch(()=>{grid.innerHTML='<div class="empty">素材を読み込めませんでした。</div>'});
</script>
</body>
</html>
