---
const title = "かわいいQRコードメーカー｜色・動物・キャラ入りQRを無料作成 | stamp moke";
const description = "色・形・余白・動物キャラを自由に選んで、かわいいQRコードを無料作成。猫・犬・うさぎ・くま・パンダなどのシルエットを中央に配置でき、キャラなしも選択可能。登録不要・ブラウザ内生成・PNG保存対応。";
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href="https://stamp-moke.jp/qr-maker" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content="https://stamp-moke.jp/qr-maker" />
<style>
:root{--ink:#302b30;--muted:#766d75;--line:#eadfe6;--pink:#ed78aa;--soft:#fff0f6;--bg:#fff9fb}*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#fff7fb,#fff 44%);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.wrap{max-width:1160px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between;align-items:center}.brand,.back{color:var(--ink);text-decoration:none;font-weight:900}.brand{font-size:22px}.back{font-size:14px}.hero{text-align:center;padding:30px 10px 24px}.eyebrow{font-size:12px;font-weight:900;letter-spacing:.13em;color:#b45b83}.hero h1{font-size:clamp(31px,5vw,52px);line-height:1.12;margin:8px 0 12px}.hero p{max-width:760px;margin:auto;color:var(--muted);line-height:1.8}.badges{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:14px}.badge{background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 11px;font-size:12px;font-weight:800}.grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(350px,.95fr);gap:20px}.card{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px;box-shadow:0 14px 40px rgba(126,70,98,.08)}h2{margin:0 0 18px;font-size:21px}.field{margin-bottom:20px}.field>label{display:block;font-size:14px;font-weight:900;margin-bottom:9px}.text{width:100%;border:2px solid #e5d7df;border-radius:14px;padding:14px 15px;font-size:16px;outline:none}.text:focus{border-color:#ef9bc0}.color-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.colorbox{display:flex;align-items:center;gap:9px;border:1px solid var(--line);border-radius:13px;padding:9px;background:#fff}.colorbox input{width:36px;height:36px;border:0;padding:0;background:transparent}.small{font-size:12px;color:var(--muted);font-weight:800}.presets,.choices{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.swatch{width:34px;height:34px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #d9d1d6;cursor:pointer}.choice,.size-btn{border:1px solid var(--line);background:#fff;border-radius:12px;padding:10px 13px;font-weight:850;cursor:pointer}.choice.active,.size-btn.active{background:#342f33;color:#fff;border-color:#342f33}.characters{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.char{border:1px solid var(--line);background:#fff;border-radius:15px;min-height:76px;padding:8px 3px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:11px;font-weight:850;cursor:pointer}.char.active{border:2px solid var(--pink);background:var(--soft)}.char svg{width:35px;height:35px;fill:#5c5157}.size-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.range-row{display:flex;align-items:center;gap:12px}.range-row input{width:100%}.value{min-width:42px;text-align:right;font-size:13px;font-weight:850}.preview{display:flex;align-items:center;justify-content:center;min-height:430px;background:linear-gradient(45deg,#fff3f8 25%,#fff 25%,#fff 50%,#fff3f8 50%,#fff3f8 75%,#fff 75%);background-size:28px 28px;border:1px solid var(--line);border-radius:20px;padding:22px;position:sticky;top:16px}.preview canvas{display:block;width:min(100%,430px);height:auto;border-radius:14px;box-shadow:0 10px 28px rgba(80,50,65,.12)}.status{font-size:13px;line-height:1.7;margin-top:12px;padding:11px 12px;border-radius:12px;background:#f8f6f7;color:var(--muted)}.status.warn{background:#fff2df;color:#94560b}.download{width:100%;margin-top:14px;border:0;border-radius:14px;background:var(--pink);color:#fff;padding:14px;font-size:16px;font-weight:900;cursor:pointer}.download:hover{filter:brightness(.97)}.note{margin-top:24px;padding:19px;border:1px solid var(--line);border-radius:18px;background:#fff;color:var(--muted);line-height:1.8}.note strong{color:var(--ink)}@media(max-width:850px){.wrap{padding:14px}.grid{grid-template-columns:1fr}.preview{position:static;min-height:330px}.characters{grid-template-columns:repeat(4,1fr)}}@media(max-width:460px){.characters{grid-template-columns:repeat(3,1fr)}.color-grid{grid-template-columns:1fr}.hero{padding-top:20px}}
</style>
</head>
<body>
<main class="wrap">
<div class="top"><a class="brand" href="/">stamp moke</a><a class="back" href="/">← サイトへ戻る</a></div>
<section class="hero"><div class="eyebrow">CUTE QR MAKER</div><h1>かわいいQRコードを、<br/>自分らしく。</h1><p>URLや文字を入れて、色・形・動物キャラを選ぶだけ。シンプルにも、かわいくも作れます。</p><div class="badges"><span class="badge">無料</span><span class="badge">登録不要</span><span class="badge">PNG保存</span><span class="badge">ブラウザ内生成</span></div></section>
<section class="grid">
<div class="card"><h2>デザインする</h2>
<div class="field"><label for="qrText">URL・テキスト</label><input id="qrText" class="text" value="https://stamp-moke.jp/" autocomplete="off" /></div>
<div class="field"><label>カラー</label><div class="color-grid"><div><div class="small">QRの色</div><div class="colorbox"><input id="qrColor" type="color" value="#342f33"><span id="qrHex">#342f33</span></div></div><div><div class="small">背景色</div><div class="colorbox"><input id="bgColor" type="color" value="#ffffff"><span id="bgHex">#ffffff</span></div></div></div><div class="presets" id="presets"><button class="swatch" data-color="#342f33" style="background:#342f33" aria-label="ブラック"></button><button class="swatch" data-color="#e66fa1" style="background:#e66fa1" aria-label="ピンク"></button><button class="swatch" data-color="#7e74c9" style="background:#7e74c9" aria-label="ラベンダー"></button><button class="swatch" data-color="#52a99a" style="background:#52a99a" aria-label="ミント"></button><button class="swatch" data-color="#5f8fc8" style="background:#5f8fc8" aria-label="ブルー"></button><button class="swatch" data-color="#aa795d" style="background:#aa795d" aria-label="ブラウン"></button></div></div>
<div class="field"><label>QRの形</label><div class="choices" id="shapes"><button class="choice active" data-shape="square">四角</button><button class="choice" data-shape="rounded">角丸</button><button class="choice" data-shape="dots">ドット</button></div></div>
<div class="field"><label>余白</label><div class="range-row"><input id="margin" type="range" min="2" max="8" value="4"><span id="marginValue" class="value">4</span></div></div>
<div class="field"><label>真ん中のキャラ</label><div class="characters" id="characters">
<button class="char active" data-char="none"><svg viewBox="0 0 64 64"><path d="M15 29h34v6H15z" opacity=".25"/></svg><span>なし</span></button>
<button class="char" data-char="cat"><svg viewBox="0 0 64 64"><path d="M17 24 13 10l14 8c3-1 7-1 10 0l14-8-4 14c4 4 6 9 6 15 0 12-9 19-21 19S11 51 11 39c0-6 2-11 6-15Z"/></svg><span>ねこ</span></button>
<button class="char" data-char="dog"><svg viewBox="0 0 64 64"><path d="M18 19C8 19 6 10 8 5c9 2 15 7 18 12 4-1 8-1 12 0C41 12 47 7 56 5c2 5 0 14-10 14 5 5 8 11 8 19 0 13-9 20-22 20S10 51 10 38c0-8 3-14 8-19Z"/></svg><span>いぬ</span></button>
<button class="char" data-char="rabbit"><svg viewBox="0 0 64 64"><path d="M24 26C14 16 14 3 19 2c6-1 10 12 11 20h4c1-8 5-21 11-20 5 1 5 14-5 24 8 3 13 10 13 18 0 10-9 17-21 17S11 54 11 44c0-8 5-15 13-18Z"/></svg><span>うさぎ</span></button>
<button class="char" data-char="bear"><svg viewBox="0 0 64 64"><path d="M16 20a9 9 0 1 1 12-9c3-1 5-1 8 0a9 9 0 1 1 12 9c5 5 8 11 8 19 0 13-10 21-24 21S8 52 8 39c0-8 3-14 8-19Z"/></svg><span>くま</span></button>
<button class="char" data-char="panda"><svg viewBox="0 0 64 64"><path d="M16 19a9 9 0 1 1 12-9h8a9 9 0 1 1 12 9c5 5 8 12 8 20 0 13-10 21-24 21S8 52 8 39c0-8 3-15 8-20Zm8 12a6 8 0 1 0 0 16 6 8 0 0 0 0-16Zm16 0a6 8 0 1 0 0 16 6 8 0 0 0 0-16Z"/></svg><span>パンダ</span></button>
<button class="char" data-char="chick"><svg viewBox="0 0 64 64"><path d="M33 8c12 0 22 10 22 23 0 4-1 8-3 11l9 4-12 3c-4 5-10 8-16 8-13 0-23-10-23-24S20 8 33 8Z"/></svg><span>ひよこ</span></button>
<button class="char" data-char="hedgehog"><svg viewBox="0 0 64 64"><path d="m8 34 6-4-5-6 8-1-2-8 8 3 2-9 7 6 6-8 4 9 9-5v10l8-1-4 9 7 3-7 6c0 13-9 21-23 21S8 49 8 34Z"/></svg><span>ハリネズミ</span></button>
<button class="char" data-char="fox"><svg viewBox="0 0 64 64"><path d="M10 12l17 9c3-1 7-1 10 0l17-9-5 17c3 4 5 8 5 13 0 11-10 18-22 18S10 53 10 42c0-5 2-9 5-13L10 12Z"/></svg><span>きつね</span></button>
<button class="char" data-char="penguin"><svg viewBox="0 0 64 64"><path d="M32 5c13 0 21 12 21 27 0 6-2 12-5 17l8 6-13-1c-3 3-7 5-11 5s-8-2-11-5L8 55l8-6c-3-5-5-11-5-17C11 17 19 5 32 5Z"/></svg><span>ペンギン</span></button>
<button class="char" data-char="koala"><svg viewBox="0 0 64 64"><path d="M14 22a11 11 0 1 1 15-12c2-1 4-1 6 0a11 11 0 1 1 15 12c4 5 6 10 6 17 0 13-10 21-24 21S8 52 8 39c0-7 2-12 6-17Z"/></svg><span>コアラ</span></button>
</div></div>
<div class="field"><label>キャラサイズ</label><div class="size-row" id="sizes"><button class="size-btn" data-size="small">小</button><button class="size-btn active" data-size="medium">中</button><button class="size-btn" data-size="large">大</button></div></div>
</div>
<div class="card"><h2>プレビュー</h2><div class="preview"><canvas id="qrCanvas" width="720" height="720"></canvas></div><div class="status" id="status">QRコードを生成しています。</div><button class="download" id="downloadBtn">PNGで保存</button></div>
</section>
<section class="note"><strong>読み取りについて：</strong>色が薄すぎる、背景とのコントラストが低い、中央キャラが大きすぎる場合は読み取りにくくなることがあります。重要なQRコードは、保存後に実際のスマートフォンで読み取れることをご確認ください。入力内容は保存せず、QR生成はブラウザ内で完結します。</section>
</main>
<script>
import QRCode from 'qrcode';
const canvas=document.getElementById('qrCanvas'),ctx=canvas.getContext('2d'),input=document.getElementById('qrText'),qrColor=document.getElementById('qrColor'),bgColor=document.getElementById('bgColor'),qrHex=document.getElementById('qrHex'),bgHex=document.getElementById('bgHex'),margin=document.getElementById('margin'),marginValue=document.getElementById('marginValue'),status=document.getElementById('status');
let currentChar='none',currentSize='medium',currentShape='square';
const paths={cat:'M17 24 13 10l14 8c3-1 7-1 10 0l14-8-4 14c4 4 6 9 6 15 0 12-9 19-21 19S11 51 11 39c0-6 2-11 6-15Z',dog:'M18 19C8 19 6 10 8 5c9 2 15 7 18 12 4-1 8-1 12 0C41 12 47 7 56 5c2 5 0 14-10 14 5 5 8 11 8 19 0 13-9 20-22 20S10 51 10 38c0-8 3-14 8-19Z',rabbit:'M24 26C14 16 14 3 19 2c6-1 10 12 11 20h4c1-8 5-21 11-20 5 1 5 14-5 24 8 3 13 10 13 18 0 10-9 17-21 17S11 54 11 44c0-8 5-15 13-18Z',bear:'M16 20a9 9 0 1 1 12-9c3-1 5-1 8 0a9 9 0 1 1 12 9c5 5 8 11 8 19 0 13-10 21-24 21S8 52 8 39c0-8 3-14 8-19Z',panda:'M16 19a9 9 0 1 1 12-9h8a9 9 0 1 1 12 9c5 5 8 12 8 20 0 13-10 21-24 21S8 52 8 39c0-8 3-15 8-20Z',chick:'M33 8c12 0 22 10 22 23 0 4-1 8-3 11l9 4-12 3c-4 5-10 8-16 8-13 0-23-10-23-24S20 8 33 8Z',hedgehog:'m8 34 6-4-5-6 8-1-2-8 8 3 2-9 7 6 6-8 4 9 9-5v10l8-1-4 9 7 3-7 6c0 13-9 21-23 21S8 49 8 34Z',fox:'M10 12l17 9c3-1 7-1 10 0l17-9-5 17c3 4 5 8 5 13 0 11-10 18-22 18S10 53 10 42c0-5 2-9 5-13L10 12Z',penguin:'M32 5c13 0 21 12 21 27 0 6-2 12-5 17l8 6-13-1c-3 3-7 5-11 5s-8-2-11-5L8 55l8-6c-3-5-5-11-5-17C11 17 19 5 32 5Z',koala:'M14 22a11 11 0 1 1 15-12c2-1 4-1 6 0a11 11 0 1 1 15 12c4 5 6 10 6 17 0 13-10 21-24 21S8 52 8 39c0-7 2-12 6-17Z'};
const ratios={small:.13,medium:.18,large:.23};
function hexRgb(h){const n=parseInt(h.slice(1),16);return[(n>>16)&255,(n>>8)&255,n&255]}function lum(h){return hexRgb(h).map(v=>{v/=255;return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4)}).reduce((a,v,i)=>a+v*[.2126,.7152,.0722][i],0)}function contrast(a,b){const x=lum(a),y=lum(b);return(Math.max(x,y)+.05)/(Math.min(x,y)+.05)}
function finder(r,c,n){return (r<7&&c<7)||(r<7&&c>=n-7)||(r>=n-7&&c<7)}
function drawModule(x,y,s,shape,isFinder){ctx.fillStyle=qrColor.value;if(isFinder||shape==='square'){ctx.fillRect(x,y,s+.15,s+.15);return}if(shape==='dots'){ctx.beginPath();ctx.arc(x+s/2,y+s/2,s*.42,0,Math.PI*2);ctx.fill();return}const rad=s*.32;ctx.beginPath();ctx.roundRect(x+.08*s,y+.08*s,s*.84,s*.84,rad);ctx.fill()}
async function draw(){const text=input.value.trim()||'https://stamp-moke.jp/';qrHex.textContent=qrColor.value;bgHex.textContent=bgColor.value;marginValue.textContent=margin.value;try{const qr=QRCode.create(text,{errorCorrectionLevel:currentChar==='none'?'M':'H'}),n=qr.modules.size,m=Number(margin.value),cell=canvas.width/(n+m*2);ctx.clearRect(0,0,canvas.width,canvas.height);ctx.fillStyle=bgColor.value;ctx.fillRect(0,0,canvas.width,canvas.height);for(let r=0;r<n;r++)for(let c=0;c<n;c++)if(qr.modules.get(r,c))drawModule((c+m)*cell,(r+m)*cell,cell,currentShape,finder(r,c,n));if(currentChar!=='none')await overlay();const cr=contrast(qrColor.value,bgColor.value);status.classList.toggle('warn',cr<3||currentSize==='large'&&currentChar!=='none');status.textContent=cr<3?'QRと背景の色が近すぎます。より濃淡差のある色をおすすめします。':currentSize==='large'&&currentChar!=='none'?'大サイズのキャラはデザイン性重視です。保存後に読み取り確認をしてください。':'読み取りやすさを保ちながら生成しています。';}catch(e){status.classList.add('warn');status.textContent='QRコードを生成できませんでした。入力内容をご確認ください。'}}
function overlay(){return new Promise(resolve=>{const box=canvas.width*ratios[currentSize],pad=box*.17,x=(canvas.width-box)/2,y=x;ctx.fillStyle=bgColor.value;ctx.beginPath();ctx.roundRect(x-pad,y-pad,box+pad*2,box+pad*2,box*.2);ctx.fill();const svg=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><path fill="${qrColor.value}" d="${paths[currentChar]}"/></svg>`,img=new Image();img.onload=()=>{ctx.drawImage(img,x,y,box,box);resolve()};img.onerror=resolve;img.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg)})}
input.addEventListener('input',draw);qrColor.addEventListener('input',draw);bgColor.addEventListener('input',draw);margin.addEventListener('input',draw);
document.getElementById('presets').addEventListener('click',e=>{const b=e.target.closest('[data-color]');if(!b)return;qrColor.value=b.dataset.color;draw()});
function activate(parent,selector,button){parent.querySelectorAll(selector).forEach(x=>x.classList.remove('active'));button.classList.add('active')}
document.getElementById('shapes').addEventListener('click',e=>{const b=e.target.closest('[data-shape]');if(!b)return;activate(e.currentTarget,'.choice',b);currentShape=b.dataset.shape;draw()});
document.getElementById('characters').addEventListener('click',e=>{const b=e.target.closest('[data-char]');if(!b)return;activate(e.currentTarget,'.char',b);currentChar=b.dataset.char;draw()});
document.getElementById('sizes').addEventListener('click',e=>{const b=e.target.closest('[data-size]');if(!b)return;activate(e.currentTarget,'.size-btn',b);currentSize=b.dataset.size;draw()});
document.getElementById('downloadBtn').addEventListener('click',()=>{const a=document.createElement('a');a.download='cute-qr-code.png';a.href=canvas.toDataURL('image/png');a.click()});draw();
</script>
</body></html>
