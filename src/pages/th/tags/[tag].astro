---
import TagPage from "../../tags/[tag].astro";
import stickers from "../../../data/stickers.json";
import { getTagIdsForSticker, tagDefinitions } from "../../../lib/sticker-search-tags";
export function getStaticPaths(){
  return tagDefinitions
    .filter((tag)=>stickers.filter((sticker)=>getTagIdsForSticker(sticker).includes(tag.id)).length>=2)
    .map((tag)=>({params:{tag:tag.slugs.th},props:{tag}}));
}
const { tag } = Astro.props;
---
<TagPage tag={tag} locale="th" />
