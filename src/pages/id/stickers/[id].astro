---
import stickers from "../../../data/stickers.json";
import StickerPage from "../../stickers/[id].astro";

export function getStaticPaths() {
  return stickers.map((sticker) => ({
    params: { id: String(sticker.id) },
    props: { sticker },
    cacheKey: JSON.stringify(sticker),
  }));
}
const { sticker } = Astro.props;
---
<StickerPage sticker={sticker} locale="id" />
