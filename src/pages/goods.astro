---
import Analytics from "../components/Analytics.astro";

const shopUrl = "https://suzuri.jp/bayasihimokei/designs";
const title = "オリジナルグッズ｜stamp moke × SUZURI";
const description = "stamp moke / studio moke のSUZURIオリジナルグッズ。販売中のデザインやTシャツ、雑貨などを紹介します。";
let products = [];
try {
  const response = await fetch("https://suzuri.jp/api/v1/products?userName=bayasihimokei&limit=50&offset=0");
  if (response.ok) {
    const data = await response.json();
    products = (data.products || []).filter((product) => product.published !== false);
  }
} catch (error) {
  console.warn("SUZURI products fetch failed", error);
}
---
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://stamp-moke.jp/goods/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://stamp-moke.jp/goods/" />
  <Analytics />
  <style>
    *{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}a{color:inherit}.header{height:86px;background:rgba(255,255,255,.96);border-bottom:1px solid #e4e3df;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;position:sticky;top:0;z-index:20}.brand{text-decoration:none}.brand-title{font-size:21px;font-weight:900;letter-spacing:.1em}.brand-sub{margin-top:7px;font-size:11px;color:#777}.back{padding:12px 18px;border:1px solid #d9d8d4;border-radius:999px;text-decoration:none;font-size:12px;font-weight:800}.main{max-width:1180px;margin:auto;padding:60px 5vw 110px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#777}.hero h1{font-size:clamp(42px,7vw,82px);line-height:.95;letter-spacing:-.05em;margin:14px 0 22px}.lead{max-width:700px;color:#666;font-size:14px;line-height:2}.shop-button{display:inline-flex;margin-top:22px;padding:14px 20px;border-radius:999px;background:#161616;color:#fff;text-decoration:none;font-size:12px;font-weight:800}.section{margin-top:65px}.section-head{display:flex;align-items:end;justify-content:space-between;border-bottom:1px solid #dddcd8;padding-bottom:18px;margin-bottom:22px}.section-head h2{font-size:34px;margin:0}.count{font-size:12px;color:#777}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.card{display:flex;flex-direction:column;background:#fff;border:1px solid #e3e2de;border-radius:18px;overflow:hidden;text-decoration:none;transition:.2s}.card:hover{transform:translateY(-4px);box-shadow:0 15px 35px rgba(0,0,0,.07)}.media{aspect-ratio:1;background:#efeee9;overflow:hidden}.media img{width:100%;height:100%;object-fit:cover;display:block}.body{padding:15px}.title{font-size:14px;line-height:1.5;font-weight:800;margin:0}.price{font-size:12px;color:#777;margin-top:9px}.empty{padding:45px;background:#fff;border:1px solid #e3e2de;border-radius:18px;color:#666;line-height:1.9}.footer{background:#181818;color:#fff;padding:45px 5vw}.footer-inner{max-width:1180px;margin:auto}.footer a{color:#ccc}.note{font-size:11px;color:#999;margin-top:12px}@media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){.header{height:72px;padding:0 18px}.brand-title{font-size:17px}.brand-sub{font-size:9px}.main{padding:38px 18px 75px}.hero h1{font-size:45px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.card{border-radius:13px}.body{padding:11px}.title{font-size:12px}.section-head h2{font-size:27px}}
  </style>
</head>
<body>
<header class="header"><a class="brand" href="/"><div class="brand-title">stamp moke</div><div class="brand-sub">LINEスタンプ専門メディア</div></a><a class="back" href="/">トップへ</a></header>
<main class="main">
  <section class="hero"><div class="eyebrow">ORIGINAL GOODS / SUZURI</div><h1>GOODS</h1><p class="lead">stamp moke / studio moke のキャラクターやデザインを、SUZURIのオリジナルグッズで楽しめます。販売状況や価格などの最終情報はSUZURIの商品ページでご確認ください。</p><a class="shop-button" href={shopUrl} target="_blank" rel="noopener noreferrer">SUZURIのお店を見る ↗</a></section>
  <section class="section"><div class="section-head"><h2>販売中のグッズ</h2><div class="count">{products.length} ITEMS</div></div>
  {products.length ? <div class="grid">{products.map((product) => <a class="card" href={`https://suzuri.jp/bayasihimokei/${product.id}`} target="_blank" rel="noopener noreferrer"><div class="media"><img src={product.sampleImageUrl} alt={product.title} loading="lazy" /></div><div class="body"><h3 class="title">{product.title}</h3>{product.priceWithTax && <div class="price">税込 ¥{Number(product.priceWithTax).toLocaleString("ja-JP")}</div>}</div></a>)}</div> : <div class="empty">現在、SUZURI APIから商品一覧を取得できませんでした。販売中のデザインはSUZURI公式ショップからご覧いただけます。<br /><a href={shopUrl} target="_blank" rel="noopener noreferrer">SUZURIで販売中のデザインを見る →</a></div>}
  </section>
</main>
<footer class="footer"><div class="footer-inner"><strong>stamp moke</strong><div class="note">SUZURIの商品情報はSUZURI公式APIを利用して取得します。</div></div></footer>
</body></html>