---
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { localeInfo, localizedPath, messages, normalizeLocale } from "../lib/i18n";
import { absoluteUrl } from "../lib/seo";

const locale = normalizeLocale(Astro.props.locale);
const t = messages[locale];

const shopUrl = "https://suzuri.jp/bayasihimokei/designs";
const title = locale === "ja" ? "オリジナルグッズ｜stamp moke × SUZURI" : locale === "en" ? "Original Character Goods | stamp moke × SUZURI" : locale === "zh-tw" ? "原創角色周邊｜stamp moke × SUZURI" : locale === "th" ? "สินค้าคาแรกเตอร์ต้นฉบับ | stamp moke × SUZURI" : "Produk Karakter Orisinal | stamp moke × SUZURI";
const description = locale === "ja" ? "stamp moke / studio moke のSUZURIオリジナルグッズ。販売中のデザインやTシャツ、雑貨などを紹介します。" : t.goodsLead;
const canonicalPath = "/goods/";
const canonical = absoluteUrl(localizedPath(locale, canonicalPath));
const goodsText = {
  ja:{lead:"stamp moke / studio moke のキャラクターやデザインを、SUZURIのオリジナルグッズで楽しめます。販売状況や価格などの最終情報はSUZURIの商品ページでご確認ください。",shop:"SUZURIのお店を見る ↗",empty:"現在、SUZURI APIから商品一覧を取得できませんでした。販売中のデザインはSUZURI公式ショップからご覧いただけます。",view:"SUZURIで販売中のデザインを見る →",note:"SUZURIの商品情報はSUZURI公式APIを利用して取得します。"},
  en:{lead:"Enjoy stamp moke characters and designs on original SUZURI goods. Please check each SUZURI product page for current availability and final prices.",shop:"Visit our SUZURI shop ↗",empty:"The product list is temporarily unavailable. You can still browse all available designs in our official SUZURI shop.",view:"View available designs on SUZURI →",note:"Product information is provided by the official SUZURI API."},
  "zh-tw":{lead:"在SUZURI選購stamp moke原創角色與設計周邊。最新庫存與價格請以SUZURI商品頁面為準。",shop:"前往SUZURI商店 ↗",empty:"目前暫時無法取得商品列表，仍可前往SUZURI官方商店查看販售中的設計。",view:"在SUZURI查看販售中的設計 →",note:"商品資訊由SUZURI官方API提供。"},
  th:{lead:"พบกับคาแรกเตอร์และดีไซน์ของ stamp moke บนสินค้าออริจินัลจาก SUZURI โปรดตรวจสอบสถานะและราคาล่าสุดที่หน้าสินค้า SUZURI",shop:"ไปที่ร้าน SUZURI ↗",empty:"ไม่สามารถโหลดรายการสินค้าได้ชั่วคราว แต่ยังดูดีไซน์ที่จำหน่ายได้จากร้าน SUZURI อย่างเป็นทางการ",view:"ดูดีไซน์ที่จำหน่ายบน SUZURI →",note:"ข้อมูลสินค้ามาจาก API อย่างเป็นทางการของ SUZURI"},
  id:{lead:"Nikmati karakter dan desain stamp moke dalam berbagai produk orisinal di SUZURI. Periksa ketersediaan dan harga terbaru pada halaman produk SUZURI.",shop:"Kunjungi toko SUZURI ↗",empty:"Daftar produk untuk sementara tidak dapat dimuat. Anda tetap dapat melihat semua desain di toko resmi SUZURI.",view:"Lihat desain yang tersedia di SUZURI →",note:"Informasi produk disediakan oleh API resmi SUZURI."},
}[locale];
let products = [];
try {
  const response = await fetch("https://suzuri.jp/api/v1/products?userName=bayasihimokei&limit=50&offset=0");
  if (response.ok) {
    const data = await response.json();
    products = (data.products || []).filter((product) => product.published !== false);
  }
} catch (error) {
  console.warn("SUZURI products fetch failed", error);
}
---
<html lang={localeInfo[locale].htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <SeoHead title={title} description={description} canonical={canonical} locale={locale} path={canonicalPath} />
  
  <Analytics />
  <style>
    *{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}a{color:inherit}.header{height:86px;background:rgba(255,255,255,.96);border-bottom:1px solid #e4e3df;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;position:sticky;top:0;z-index:20}.brand{text-decoration:none}.brand-title{font-size:21px;font-weight:900;letter-spacing:.1em}.brand-sub{margin-top:7px;font-size:11px;color:#777}.header-actions{display:flex;align-items:center;gap:9px}.back{padding:12px 18px;border:1px solid #d9d8d4;border-radius:999px;text-decoration:none;font-size:12px;font-weight:800}.main{max-width:1180px;margin:auto;padding:60px 5vw 110px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#777}.hero h1{font-size:clamp(42px,7vw,82px);line-height:.95;letter-spacing:-.05em;margin:14px 0 22px}.lead{max-width:700px;color:#666;font-size:14px;line-height:2}.shop-button{display:inline-flex;margin-top:22px;padding:14px 20px;border-radius:999px;background:#161616;color:#fff;text-decoration:none;font-size:12px;font-weight:800}.section{margin-top:65px}.section-head{display:flex;align-items:end;justify-content:space-between;border-bottom:1px solid #dddcd8;padding-bottom:18px;margin-bottom:22px}.section-head h2{font-size:34px;margin:0}.count{font-size:12px;color:#777}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.card{display:flex;flex-direction:column;background:#fff;border:1px solid #e3e2de;border-radius:18px;overflow:hidden;text-decoration:none;transition:.2s}.card:hover{transform:translateY(-4px);box-shadow:0 15px 35px rgba(0,0,0,.07)}.media{aspect-ratio:1;background:#efeee9;overflow:hidden}.media img{width:100%;height:100%;object-fit:cover;display:block}.body{padding:15px}.title{font-size:14px;line-height:1.5;font-weight:800;margin:0}.price{font-size:12px;color:#777;margin-top:9px}.empty{padding:45px;background:#fff;border:1px solid #e3e2de;border-radius:18px;color:#666;line-height:1.9}.footer{background:#181818;color:#fff;padding:45px 5vw}.footer-inner{max-width:1180px;margin:auto}.footer a{color:#ccc}.note{font-size:11px;color:#999;margin-top:12px}@media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){.header{height:72px;padding:0 18px}.brand-title{font-size:17px}.brand-sub{font-size:9px}.main{padding:38px 18px 75px}.hero h1{font-size:45px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.card{border-radius:13px}.body{padding:11px}.title{font-size:12px}.section-head h2{font-size:27px}}
  </style>
</head>
<body>
<header class="header"><a class="brand" href={localizedPath(locale, "/")}><div class="brand-title">stamp moke</div><div class="brand-sub">{t.brandSub}</div></a><div class="header-actions"><LanguageSwitcher locale={locale} path={canonicalPath} /><a class="back" href={localizedPath(locale, "/")}>{t.back}</a></div></header>
<main class="main">
  <section class="hero"><div class="eyebrow">ORIGINAL GOODS / SUZURI</div><h1>GOODS</h1><p class="lead">{goodsText.lead}</p><a class="shop-button" href={shopUrl} target="_blank" rel="noopener noreferrer">{goodsText.shop}</a></section>
  <section class="section"><div class="section-head"><h2>{t.goodsProducts}</h2><div class="count">{products.length} ITEMS</div></div>
  {products.length ? <div class="grid">{products.map((product) => <a class="card" href={`https://suzuri.jp/bayasihimokei/${product.id}`} target="_blank" rel="noopener noreferrer"><div class="media"><img src={product.sampleImageUrl} alt={product.title} loading="lazy" /></div><div class="body"><h3 class="title">{product.title}</h3>{product.priceWithTax && <div class="price">{locale === "id" ? "Periksa harga di SUZURI" : `¥${Number(product.priceWithTax).toLocaleString(locale === "zh-tw" ? "zh-TW" : locale === "th" ? "th-TH" : locale === "en" ? "en-US" : "ja-JP")} ${t.taxIncluded}`}</div>}</div></a>)}</div> : <div class="empty">{goodsText.empty}<br /><a href={shopUrl} target="_blank" rel="noopener noreferrer">{goodsText.view}</a></div>}
  </section>
</main>
<footer class="footer"><div class="footer-inner"><strong>stamp moke</strong><div class="note">{goodsText.note}</div></div></footer>
</body></html>
