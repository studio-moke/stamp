---
import designs from "../data/suzuri-designs.json";
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { localeInfo, localizedPath, messages, normalizeLocale } from "../lib/i18n";
import { absoluteUrl } from "../lib/seo";

const locale = normalizeLocale(Astro.props.locale);
const t = messages[locale];

const shopUrl = "https://suzuri.jp/stamp-moke/designs";
const title = locale === "ja" ? "stamp mokeのオリジナルキャラグッズ｜Tシャツ・雑貨をSUZURIで販売" : locale === "en" ? "stamp moke Original Character Goods | T-Shirts & Items on SUZURI" : locale === "zh-tw" ? "stamp moke 原創角色周邊｜T恤與雜貨・SUZURI販售" : locale === "th" ? "สินค้าออริจินัล stamp moke | เสื้อและของใช้บน SUZURI" : "Produk Karakter Orisinal stamp moke | Kaos & Aksesori di SUZURI";
const description = locale === "ja" ? "stamp moke / studio moke のオリジナルキャラクターやイラストを使ったSUZURIグッズを、キャラクター別に紹介。気になるキャラクターからTシャツ、雑貨、日用品などの商品を探せます。" : t.goodsLead;
const canonicalPath = "/goods/";
const canonical = absoluteUrl(localizedPath(locale, canonicalPath));
const goodsText = {
  ja:{lead:"stamp moke / studio moke のLINEスタンプやオリジナルイラストから生まれたグッズを、キャラクター・デザイン別にまとめました。気になるキャラクターを選ぶと、そのデザインで販売中のTシャツ、ファッション小物、雑貨、日用品などを確認できます。商品を1点ずつ探すのではなく、まず好きなキャラクターから選んでください。",shop:"SUZURIのお店を見る ↗",collection:"キャラクターから探す",count:"キャラクター",view:"このキャラのグッズを見る →",empty:"現在表示できるキャラクターグッズがありません。SUZURI公式ショップをご覧ください。",note:"販売状況や価格などの最終情報はSUZURIの商品ページでご確認ください。"},
  en:{lead:"Browse stamp moke goods by character and design. Choose a character first, then see the T-shirts, accessories and everyday items currently available for that design on SUZURI.",shop:"Visit our SUZURI shop ↗",collection:"Browse by character",count:"characters",view:"View this character's goods →",empty:"No character goods are available to display right now. Please visit our official SUZURI shop.",note:"Please check SUZURI for current availability and final prices."},
  "zh-tw":{lead:"以角色與設計分類瀏覽 stamp moke 的 SUZURI 周邊。先選擇喜歡的角色，再查看該設計目前販售中的 T 恤、配件與生活雜貨。",shop:"前往SUZURI商店 ↗",collection:"依角色瀏覽",count:"個角色",view:"查看這個角色的周邊 →",empty:"目前沒有可顯示的角色周邊，請前往SUZURI官方商店。",note:"最新販售狀況與價格請以SUZURI商品頁面為準。"},
  th:{lead:"เลือกดูสินค้าของ stamp moke ตามตัวละครและดีไซน์ เลือกตัวละครที่ชอบก่อน แล้วดูเสื้อยืด ของใช้ และอุปกรณ์ต่าง ๆ ที่วางจำหน่ายบน SUZURI",shop:"ไปที่ร้าน SUZURI ↗",collection:"เลือกตามตัวละคร",count:"ตัวละคร",view:"ดูสินค้าของตัวละครนี้ →",empty:"ขณะนี้ไม่มีสินค้าตัวละครให้แสดง โปรดไปที่ร้าน SUZURI อย่างเป็นทางการ",note:"โปรดตรวจสอบสถานะและราคาล่าสุดที่หน้าสินค้า SUZURI"},
  id:{lead:"Jelajahi produk stamp moke berdasarkan karakter dan desain. Pilih karakter yang disukai, lalu lihat kaos, aksesori, dan barang sehari-hari yang tersedia untuk desain tersebut di SUZURI.",shop:"Kunjungi toko SUZURI ↗",collection:"Cari berdasarkan karakter",count:"karakter",view:"Lihat produk karakter ini →",empty:"Saat ini tidak ada produk karakter yang dapat ditampilkan. Silakan kunjungi toko resmi SUZURI.",note:"Periksa ketersediaan dan harga terbaru di halaman produk SUZURI."},
}[locale];
---
<html lang={localeInfo[locale].htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <SeoHead title={title} description={description} canonical={canonical} locale={locale} path={canonicalPath} />
  <Analytics />
  <style>
    *{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}a{color:inherit}.header{height:86px;background:rgba(255,255,255,.96);border-bottom:1px solid #e4e3df;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;position:sticky;top:0;z-index:20}.brand{text-decoration:none}.brand-title{font-size:21px;font-weight:900;letter-spacing:.1em}.brand-sub{margin-top:7px;font-size:11px;color:#777}.header-actions{display:flex;align-items:center;gap:9px}.back{padding:12px 18px;border:1px solid #d9d8d4;border-radius:999px;text-decoration:none;font-size:12px;font-weight:800}.main{max-width:1180px;margin:auto;padding:60px 5vw 110px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#777}.hero h1{font-size:clamp(42px,7vw,82px);line-height:.95;letter-spacing:-.05em;margin:14px 0 22px}.lead{max-width:800px;color:#666;font-size:14px;line-height:2}.shop-button{display:inline-flex;margin-top:22px;padding:14px 20px;border-radius:999px;background:#161616;color:#fff;text-decoration:none;font-size:12px;font-weight:800}.section{margin-top:65px}.section-head{display:flex;align-items:end;justify-content:space-between;border-bottom:1px solid #dddcd8;padding-bottom:18px;margin-bottom:22px}.section-head h2{font-size:34px;margin:0}.count{font-size:12px;color:#777}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.card{display:flex;flex-direction:column;background:#fff;border:1px solid #e3e2de;border-radius:18px;overflow:hidden;text-decoration:none;transition:.2s}.card:hover{transform:translateY(-4px);box-shadow:0 15px 35px rgba(0,0,0,.07)}.media{aspect-ratio:1;background:#fff;overflow:hidden}.media img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(1.055) contrast(1.02);transition:transform .35s ease}.card:hover .media img{transform:scale(1.035)}.body{padding:15px 16px 18px}.label{margin-bottom:8px;color:#999;font-size:9px;font-weight:800;letter-spacing:.15em}.title{font-size:14px;line-height:1.5;font-weight:800;margin:0}.detail{font-size:11px;color:#168b52;font-weight:800;margin-top:12px}.empty{padding:45px;background:#fff;border:1px solid #e3e2de;border-radius:18px;color:#666;line-height:1.9}.footer{background:#181818;color:#fff;padding:45px 5vw}.footer-inner{max-width:1180px;margin:auto}.note{font-size:11px;color:#999;margin-top:12px}@media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){.header{height:72px;padding:0 18px}.brand-title{font-size:17px}.brand-sub{font-size:9px}.main{padding:38px 18px 75px}.hero h1{font-size:45px}.section-head{align-items:flex-end;gap:14px}.section-head h2{font-size:27px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.card{border-radius:13px}.body{padding:12px}.title{font-size:12px}.detail{font-size:10px}}
  </style>
</head>
<body>
<header class="header"><a class="brand" href={localizedPath(locale, "/")}><div class="brand-title">stamp moke</div><div class="brand-sub">{t.brandSub}</div></a><div class="header-actions"><LanguageSwitcher locale={locale} path={canonicalPath} /><a class="back" href={localizedPath(locale, "/")}>{t.back}</a></div></header>
<main class="main">
  <section class="hero"><div class="eyebrow">ORIGINAL GOODS / SUZURI</div><h1>GOODS</h1><p class="lead">{goodsText.lead}</p><a class="shop-button" href={shopUrl} target="_blank" rel="noopener noreferrer">{goodsText.shop}</a></section>
  <section class="section">
    <div class="section-head"><h2>{goodsText.collection}</h2><div class="count">{designs.length} {goodsText.count}</div></div>
    {designs.length ? <div class="grid">{designs.map((design,index) => <a class="card" href={localizedPath(locale, `/goods/${design.id}`)}><div class="media"><img src={design.image} alt={design.title} loading={index < 8 ? "eager" : "lazy"} /></div><div class="body"><div class="label">CHARACTER DESIGN / SUZURI</div><h3 class="title">{design.title}</h3><div class="detail">{goodsText.view}</div></div></a>)}</div> : <div class="empty">{goodsText.empty}</div>}
  </section>
</main>
<footer class="footer"><div class="footer-inner"><strong>stamp moke</strong><div class="note">{goodsText.note}</div></div></footer>
</body></html>
