---
const title = "フリー素材 管理 | stamp moke";
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>{title}</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.wrap{max-width:1100px;margin:auto;padding:28px 18px 90px}.top{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:20px}.brand{font-size:23px;font-weight:900;letter-spacing:.04em}.subtxt,.meta,.notice{color:#737373;font-size:12px;line-height:1.65}.panel{background:#fff;border:1px solid #deddd8;border-radius:22px;padding:20px;margin-bottom:18px;box-shadow:0 15px 40px rgba(42,40,32,.05)}.row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.field{display:grid;gap:6px}label{font-size:13px;font-weight:800}input,select,textarea,button{font:inherit}input,select,textarea{width:100%;padding:11px 12px;border:1px solid #d8d7d2;border-radius:11px;background:#fff}textarea{min-height:82px;resize:vertical}button{border:0;border-radius:999px;padding:11px 16px;font-weight:800;cursor:pointer}.primary{background:#161616;color:#fff}.sub{background:#efeee9}.danger{background:#fff0f0;color:#9d1c1c;border:1px solid #f4caca}.drop{border:2px dashed #c9c7c0;border-radius:18px;padding:34px 18px;text-align:center;background:#faf9f5;cursor:pointer}.drop strong{display:block;font-size:19px;margin-bottom:7px}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px;align-items:center}.queue{display:grid!important;grid-template-columns:repeat(auto-fill,minmax(160px,1fr))!important;gap:10px!important;align-items:start}.manager{display:grid;gap:12px}.item{position:relative!important;display:flex!important;flex-direction:column!important;gap:7px!important;min-width:0!important;width:100%!important;max-width:220px!important;border:1px solid #e5e3dd!important;border-radius:13px!important;padding:8px!important;background:#fff!important;overflow:hidden!important}.item img{display:block!important;width:100%!important;height:105px!important;max-width:180px!important;max-height:105px!important;min-height:105px!important;object-fit:contain!important;background:#f3f2ee!important;border-radius:9px!important;margin:0 auto!important}.item strong{display:block;font-size:11px;line-height:1.35;word-break:break-all;max-height:2.7em;overflow:hidden}.item .meta{font-size:10px;line-height:1.35}.status{display:inline-block;width:max-content;max-width:100%;font-size:10px;font-weight:900;padding:4px 7px;border-radius:99px;background:#efeee9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ok{background:#e7f6ea;color:#176b2c}.err{background:#feecec;color:#9b1c1c}.skip{background:#fff4d6;color:#815c00}.progress{display:none;margin:0 0 18px;padding:14px 16px;border-radius:14px;background:#161616;color:#fff;font-weight:800}.progress.show{display:block}.progress.error{background:#9b1c1c}.manage-card{display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:14px;align-items:start;border:1px solid #e5e3dd;border-radius:15px;padding:12px}.manage-card img{width:110px!important;height:110px!important;max-width:110px!important;max-height:110px!important;object-fit:contain!important;background:#f3f2ee;border-radius:11px}.manage-fields{display:grid;gap:8px}.manage-actions{display:flex;gap:7px;flex-wrap:wrap}.section-title{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.section-title h2{margin:0;font-size:18px}.section-buttons{display:flex;gap:8px;flex-wrap:wrap}.count{font-size:12px;color:#737373}@media(max-width:720px){.row{grid-template-columns:1fr}.queue{grid-template-columns:repeat(3,minmax(0,1fr))!important}.item{max-width:none!important}.item img{height:88px!important;min-height:88px!important;max-height:88px!important;max-width:140px!important}.manage-card{grid-template-columns:82px 1fr}.manage-card img{width:82px!important;height:82px!important;max-width:82px!important;max-height:82px!important}.manage-card>.manage-actions{grid-column:2}.top{align-items:flex-start;flex-direction:column}.section-title{align-items:flex-start;flex-direction:column}}@media(max-width:520px){.queue{grid-template-columns:repeat(2,minmax(0,1fr))!important}}@media(max-width:360px){.queue{grid-template-columns:1fr!important}}
</style></head><body><main class="wrap">
<div class="top"><div><div class="brand">stamp moke / フリー素材管理</div><div class="subtxt">ドカッと入れる → 重複チェック → AI解析 → R2保存 → 公開</div></div><a href="/free/">公開ページを見る</a></div>
<div id="progress" class="progress"></div>
<section class="panel"><div class="row"><div class="field"><label>管理トークン</label><input id="adminToken" type="password" placeholder="FREE_ADMIN_TOKEN"></div><div class="field"><label>共通キャラクター（任意）</label><input id="characterHint" placeholder="例：くろねこ"></div><div class="field"><label>主な用途（任意）</label><select id="platformHint"><option value="">AIに任せる</option><option value="pokekara">ポケカラ</option><option value="x">X</option><option value="instagram">Instagram</option><option value="facebook">Facebook</option><option value="line">LINE</option><option value="youtube">YouTube</option></select></div><div class="field"><label>透かし文字</label><input id="watermark" value="stamp-moke.jp"></div></div><p class="notice">長辺最大2560px・縦横比維持で保存（切り抜きなし）。JPEGは品質82%、PNGは透過・形式を維持。2560px以内で変換後の容量が増える場合は元ファイルを使用します。別途バックアップは保存せず、圧縮前SHA-256を重複判定に使用します。同じ投入一覧内の重複は事前にスキップ、公開済みとの重複もOpenAI APIを呼ぶ前にスキップします。</p></section>
<section class="panel"><div class="drop" id="drop"><strong>画像をドカッと入れる</strong><span>複数選択 / ドラッグ＆ドロップ</span><input id="files" type="file" accept="image/png,image/jpeg,image/webp" multiple hidden></div><div class="actions"><button class="primary" id="run" disabled>画像を追加してください</button><button class="sub" id="clear" disabled>一覧をクリア</button><span id="queueNote" class="count">0枚</span></div></section>
<section class="panel"><div id="queue" class="queue"><div class="meta">まだ画像はありません。</div></div></section>
<section class="panel"><div class="section-title"><h2>公開済み素材の管理</h2><div class="section-buttons"><button class="sub" id="optimizeThumbs">既存サムネを一括軽量化</button><button class="sub" id="loadManager">一覧を読み込む</button></div></div><div id="manager" class="manager"><div class="meta">管理トークン入力後、「一覧を読み込む」で編集できます。</div></div></section>
</main>
<script>
const $=id=>document.getElementById(id);const filesInput=$("files"),drop=$("drop"),queueEl=$("queue"),run=$("run"),clear=$("clear"),progress=$("progress"),queueNote=$("queueNote"),tokenEl=$("adminToken"),characterEl=$("characterHint"),platformEl=$("platformHint"),watermarkEl=$("watermark"),manager=$("manager"),loadManager=$("loadManager"),optimizeThumbs=$("optimizeThumbs");tokenEl.value=sessionStorage.getItem("sm_free_admin")||"";tokenEl.addEventListener("input",()=>sessionStorage.setItem("sm_free_admin",tokenEl.value));let queue=[];
function setProgress(text,error=false){progress.textContent=text;progress.className=`progress show${error?' error':''}`;progress.scrollIntoView({behavior:'smooth',block:'nearest'})}function esc(v=""){return String(v).replace(/[&<>\"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]))}
function render(){const actionable=queue.filter(q=>q.state!=="重複").length;const dupes=queue.length-actionable;queueNote.textContent=`${queue.length}枚${dupes?` / 重複${dupes}枚`:''}`;if(!queue.length){queueEl.innerHTML='<div class="meta">まだ画像はありません。</div>';run.disabled=true;run.textContent='画像を追加してください';clear.disabled=true;return}run.disabled=actionable===0;run.textContent=actionable?`AI解析して${actionable}枚を一括公開`:'すべて重複です';clear.disabled=false;queueEl.innerHTML=queue.map(q=>`<div class="item"><img src="${q.localUrl}" alt="" width="180" height="105" style="display:block;width:100%;height:105px;max-width:180px;max-height:105px;object-fit:contain;margin:0 auto;background:#f3f2ee;border-radius:9px"><strong>${esc(q.file.name)}</strong><div class="meta">${q.width} × ${q.height}<br>${(q.file.size/1024/1024).toFixed(2)}MB</div>${q.compression?`<div class="meta">${esc(q.compression)}</div>`:""}${q.title?`<div class="meta">${esc(q.title)}</div>`:''}<span class="status ${q.state==='公開済み'?'ok':q.state==='エラー'?'err':q.state==='重複'?'skip':''}">${esc(q.state)}</span></div>`).join("")}
async function imageInfo(file){const bitmap=await createImageBitmap(file);const out={width:bitmap.width,height:bitmap.height};bitmap.close();return out}async function fileHash(file){const buf=await file.arrayBuffer();const hash=await crypto.subtle.digest("SHA-256",buf);return [...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,"0")).join("")}
async function addFiles(files){try{const known=new Set(queue.map(q=>q.contentHash).filter(Boolean));let added=0,dupes=0;for(const file of files){if(!file.type.startsWith("image/"))continue;const [info,contentHash]=await Promise.all([imageInfo(file),fileHash(file)]);const duplicated=known.has(contentHash);if(!duplicated)known.add(contentHash);queue.push({file,localUrl:URL.createObjectURL(file),...info,state:duplicated?"重複":"待機中",title:duplicated?"この投入一覧内に同じ画像があります":"",contentHash});added++;if(duplicated)dupes++}render();if(added)setProgress(`${added}枚を読み込みました。${dupes?` 同一画像${dupes}枚は公開対象から除外します。`:''}`)}catch(e){setProgress(`画像読込エラー：${e?.message||e}`,true)}}drop.onclick=()=>filesInput.click();filesInput.onchange=()=>addFiles(filesInput.files);drop.ondragover=e=>e.preventDefault();drop.ondrop=e=>{e.preventDefault();addFiles(e.dataTransfer.files)};clear.onclick=()=>{queue.forEach(q=>URL.revokeObjectURL(q.localUrl));queue=[];render();progress.className='progress'};
// contentHash is SHA-256 of the source file bytes, never of a compressed derivative.
async function compressDownload(file) {
  const bitmap = await createImageBitmap(file);
  const scale = Math.min(1, 2560 / Math.max(bitmap.width, bitmap.height));
  const canvas = document.createElement("canvas");
  canvas.width = Math.max(1, Math.round(bitmap.width * scale));
  canvas.height = Math.max(1, Math.round(bitmap.height * scale));
  // Keep every PNG as PNG: no visual classification that could destroy alpha or text.
  const type = file.type === "image/jpeg" ? "image/jpeg"
    : file.type === "image/webp" ? "image/webp" : "image/png";
  try {
    const context = canvas.getContext("2d", { alpha: true });
    if (!context) throw new Error("画像圧縮を開始できませんでした。");
    context.imageSmoothingEnabled = true;
    context.imageSmoothingQuality = "high";
    context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
  } finally {
    bitmap.close();
  }
  const compressed = await new Promise((resolve, reject) => {
    canvas.toBlob(blob => blob && blob.type === type && blob.size > 0
      ? resolve(blob)
      : reject(new Error("画像圧縮に失敗しました。保存は行っていません。")), type, type === "image/jpeg" ? 0.82 : 0.85);
  });
  // A source larger than 2560px cannot be reused without breaking the size limit.
  return scale === 1 && compressed.size >= file.size ? file : compressed;
}
function compressionSummary(before, after) {
  const size = bytes => bytes < 1024 * 1024 ? (bytes / 1024).toFixed(1) + " KB" : (bytes / 1024 / 1024).toFixed(2) + " MB";
  const reduction = before ? (1 - after / before) * 100 : 0;
  return size(before) + " → " + size(after) + "（" + (reduction >= 0 ? reduction.toFixed(1) + "%削減" : (-reduction).toFixed(1) + "%増加") + "）";
}
async function makePreview(file,text){const bitmap=await createImageBitmap(file),max=1200,scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));const canvas=document.createElement("canvas");canvas.width=Math.max(1,Math.round(bitmap.width*scale));canvas.height=Math.max(1,Math.round(bitmap.height*scale));const ctx=canvas.getContext("2d");ctx.drawImage(bitmap,0,0,canvas.width,canvas.height);bitmap.close();ctx.save();ctx.globalAlpha=.22;ctx.fillStyle="#111";ctx.font=`700 ${Math.max(18,Math.round(canvas.width/18))}px sans-serif`;ctx.textAlign="center";ctx.textBaseline="middle";ctx.translate(canvas.width/2,canvas.height/2);ctx.rotate(-Math.PI/6);const stepX=Math.max(220,canvas.width*.55),stepY=Math.max(120,canvas.height*.3);for(let y=-canvas.height;y<=canvas.height;y+=stepY)for(let x=-canvas.width;x<=canvas.width;x+=stepX)ctx.fillText(text,x,y);ctx.restore();return await new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error("プレビュー生成失敗")),"image/png",.88))}
async function makeThumb(sourceBlob){const bitmap=await createImageBitmap(sourceBlob),max=360,scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));const c=document.createElement("canvas");c.width=Math.max(1,Math.round(bitmap.width*scale));c.height=Math.max(1,Math.round(bitmap.height*scale));const ctx=c.getContext("2d",{alpha:true});ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality="high";ctx.drawImage(bitmap,0,0,c.width,c.height);bitmap.close();return await new Promise((resolve,reject)=>c.toBlob(b=>b?resolve(b):reject(new Error("サムネ生成失敗")),"image/webp",.58))}
async function api(action,body={},token=tokenEl.value.trim()){const r=await fetch(`/api/free-assets?action=${encodeURIComponent(action)}`,{method:"POST",headers:{"Content-Type":"application/json","x-admin-token":token},body:JSON.stringify(body)});const text=await r.text();let j={};try{j=JSON.parse(text)}catch{throw new Error(text||`HTTP ${r.status}`)}if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);return j}async function uploadR2(role,blob,adminToken){const signed=await api("upload-url",{role,contentType:blob.type},adminToken);const r=await fetch(signed.uploadUrl,{method:"PUT",headers:{"Content-Type":blob.type||"application/octet-stream"},body:blob});if(!r.ok)throw new Error(`R2アップロード失敗 (${r.status})`);return signed.key}
async function analyzeAsset(body, adminToken) {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 100000);
  try {
    const response = await fetch("https://stamp-moke-free-ai.yukipro1783.workers.dev/analyze", {
      method: "POST",
      headers: { "Content-Type": "application/json", "x-admin-token": adminToken },
      body: JSON.stringify(body),
      signal: controller.signal,
    });
    if (!response.ok) throw new Error(`AI解析Workerがエラーを返しました (HTTP ${response.status})。時間をおいて再度お試しください。`);
    const result = await response.json();
    if (!result || result.error || !result.metadata || typeof result.metadata !== "object" || Array.isArray(result.metadata)) {
      throw new Error("AI解析Workerから有効な解析結果を取得できませんでした。再度お試しください。");
    }
    return result;
  } catch (error) {
    if (controller.signal.aborted) {
      throw new Error("AI解析Workerへの接続がタイムアウトしました。時間をおいて再度お試しください。");
    }
    if (error instanceof SyntaxError) {
      throw new Error("AI解析Workerの応答を読み込めませんでした。再度お試しください。");
    }
    if (error instanceof TypeError) {
      throw new Error("AI解析Workerに接続できませんでした。通信状態を確認して再度お試しください。");
    }
    throw error;
  } finally {
    clearTimeout(timeout);
  }
}
run.onclick=async()=>{const adminToken=tokenEl.value.trim();if(!adminToken)return setProgress("管理トークンを入力してください。",true);const targets=queue.filter(q=>q.state!=="公開済み"&&q.state!=="重複");if(!targets.length)return;run.disabled=true;clear.disabled=true;try{setProgress("設定確認中…");await api("health",{},adminToken);setProgress(`重複チェック開始：${targets.length}枚`)}catch(e){setProgress(`設定エラー：${e?.message||e}`,true);run.disabled=false;clear.disabled=false;return}let done=0,skipped=queue.filter(q=>q.state==="重複").length;for(let i=0;i<targets.length;i++){const q=targets[i];try{setProgress(`${i+1}/${targets.length} 重複チェック中…`);q.state="重複確認中";render();if(!q.contentHash)q.contentHash=await fileHash(q.file);const dup=await api("duplicate",{contentHash:q.contentHash},adminToken);if(dup.duplicate){q.state="重複";q.title=`登録済み：${dup.asset?.title||dup.asset?.slug||"既存素材"}`;skipped++;render();continue}setProgress(`${i+1}/${targets.length} プレビュー生成中…`);q.state="透かし生成中";render();const compressedBlob=await compressDownload(q.file);const savedInfo=await imageInfo(compressedBlob);q.compression=compressionSummary(q.file.size,compressedBlob.size);render();const previewBlob=await makePreview(compressedBlob,watermarkEl.value.trim()||"stamp-moke.jp");const thumbBlob=await makeThumb(previewBlob);setProgress(`${i+1}/${targets.length} R2へ保存中…`);q.state="R2保存中";render();const [previewKey,thumbKey]=await Promise.all([uploadR2("preview",previewBlob,adminToken),uploadR2("thumb",thumbBlob,adminToken)]);setProgress(`${i+1}/${targets.length} AI解析中…`);q.state="AI解析中";render();const analyzed=await analyzeAsset({filename:q.file.name,width:savedInfo.width,height:savedInfo.height,previewKey,characterHint:characterEl.value.trim(),platformHint:platformEl.value},adminToken);q.title=analyzed.metadata?.locales?.ja?.title||"";setProgress(`${i+1}/${targets.length} 圧縮画像保存・公開中…`);q.state="圧縮画像保存中";render();const originalKey=await uploadR2("original",compressedBlob,adminToken);q.state="公開中";render();await api("publish",{metadata:analyzed.metadata,originalKey,previewKey,thumbKey,contentHash:q.contentHash,width:savedInfo.width,height:savedInfo.height,contentType:compressedBlob.type,characterHint:characterEl.value.trim()},adminToken);q.state="公開済み";done++;render()}catch(e){console.error(e);q.state="エラー";q.title=e?.message||String(e);render();setProgress(`エラー：${q.title}`,true);run.disabled=false;clear.disabled=false;return}}setProgress(`${done}枚を公開、${skipped}枚は重複のためスキップしました。`);run.disabled=false;clear.disabled=false};
async function loadAssets(){const token=tokenEl.value.trim();if(!token){setProgress("管理トークンを入力してください。",true);return}manager.innerHTML='<div class="meta">読み込み中…</div>';try{const j=await api("admin-list",{},token);const assets=j.assets||[];if(!assets.length){manager.innerHTML='<div class="meta">公開素材はありません。</div>';return}manager.innerHTML=assets.map(a=>{const ja=a.locales?.ja||{},tags=[...(a.platforms||[]),...(a.types||[]),...(a.styles||[])].join(",");return `<article class="manage-card" data-slug="${esc(a.slug)}"><img src="/api/free-preview?variant=thumb&slug=${encodeURIComponent(a.slug)}" alt=""><div class="manage-fields"><input class="m-title" value="${esc(ja.title||"")}"><textarea class="m-desc">${esc(ja.description||"")}</textarea><input class="m-tags" value="${esc(tags)}" disabled><div class="meta">DL ${Number(a.downloads||0)} / ${a.thumbKey?'軽量サムネ済み':'未軽量化'} / ${esc(a.slug)}</div></div><div class="manage-actions"><button class="sub m-save">保存</button><button class="danger m-delete">非公開</button></div></article>`}).join("");manager.querySelectorAll(".manage-card").forEach(card=>{card.querySelector(".m-save").onclick=async()=>{const slug=card.dataset.slug,title=card.querySelector(".m-title").value.trim(),description=card.querySelector(".m-desc").value.trim();try{await api("update",{slug,patch:{locales:{ja:{title,description}}}},token);setProgress(`${title||slug} を更新しました。`)}catch(e){setProgress(`更新エラー：${e.message}`,true)}};card.querySelector(".m-delete").onclick=async()=>{if(!confirm("この素材を公開一覧から外しますか？"))return;try{await api("delete",{slug:card.dataset.slug},token);card.remove();setProgress("非公開にしました。R2原本は保全しています。") }catch(e){setProgress(`非公開エラー：${e.message}`,true)}}})}catch(e){manager.innerHTML=`<div class="meta">${esc(e.message)}</div>`}}loadManager.onclick=loadAssets;
optimizeThumbs.onclick=async()=>{const token=tokenEl.value.trim();if(!token)return setProgress("管理トークンを入力してください。",true);optimizeThumbs.disabled=true;try{const j=await api("admin-list",{},token);const targets=(j.assets||[]).filter(a=>!a.thumbKey);if(!targets.length){setProgress("既存素材はすべて軽量サムネ化済みです。");return}let done=0;for(const a of targets){setProgress(`${done+1}/${targets.length}：${a.locales?.ja?.title||a.slug} の軽量サムネを生成中…`);const r=await fetch(`/api/free-preview?slug=${encodeURIComponent(a.slug)}`);if(!r.ok)throw new Error(`${a.slug} のプレビュー取得に失敗しました`);const source=await r.blob();const thumb=await makeThumb(source);const thumbKey=await uploadR2("thumb",thumb,token);await api("attach-thumb",{slug:a.slug,thumbKey},token);done++}setProgress(`${done}件の既存素材を360px WebPへ軽量化しました。`);await loadAssets()}catch(e){setProgress(`サムネ軽量化エラー：${e.message}`,true)}finally{optimizeThumbs.disabled=false}};
render();
</script></body></html>