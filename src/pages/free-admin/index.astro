---
const title = "フリー素材 管理 | stamp moke";
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>{title}</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.wrap{max-width:1100px;margin:auto;padding:28px 18px 90px}.top{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:20px}.brand{font-size:23px;font-weight:900;letter-spacing:.04em}.subtxt,.meta,.notice{color:#737373;font-size:12px;line-height:1.65}.panel{background:#fff;border:1px solid #deddd8;border-radius:22px;padding:20px;margin-bottom:18px;box-shadow:0 15px 40px rgba(42,40,32,.05)}.row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.field{display:grid;gap:6px}label{font-size:13px;font-weight:800}input,select,textarea,button{font:inherit}input,select,textarea{width:100%;padding:11px 12px;border:1px solid #d8d7d2;border-radius:11px;background:#fff}textarea{min-height:82px;resize:vertical}button{border:0;border-radius:999px;padding:11px 16px;font-weight:800;cursor:pointer}.primary{background:#161616;color:#fff}.sub{background:#efeee9}.danger{background:#fff0f0;color:#9d1c1c;border:1px solid #f4caca}.drop{border:2px dashed #c9c7c0;border-radius:18px;padding:42px 18px;text-align:center;background:#faf9f5;cursor:pointer}.drop strong{display:block;font-size:19px;margin-bottom:7px}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px;align-items:center}.queue,.manager{display:grid;gap:12px}.item,.manage-card{display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:14px;align-items:start;border:1px solid #e5e3dd;border-radius:15px;padding:12px}.item img,.manage-card img{width:110px;height:110px;object-fit:contain;background:#f3f2ee;border-radius:11px}.status{font-size:11px;font-weight:900;padding:5px 8px;border-radius:99px;background:#efeee9;white-space:nowrap}.ok{background:#e7f6ea;color:#176b2c}.err{background:#feecec;color:#9b1c1c}.skip{background:#fff4d6;color:#815c00}.progress{display:none;margin:0 0 18px;padding:14px 16px;border-radius:14px;background:#161616;color:#fff;font-weight:800}.progress.show{display:block}.progress.error{background:#9b1c1c}.manage-fields{display:grid;gap:8px}.manage-actions{display:flex;gap:7px;flex-wrap:wrap}.section-title{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.section-title h2{margin:0;font-size:18px}.count{font-size:12px;color:#737373}@media(max-width:720px){.row{grid-template-columns:1fr}.item,.manage-card{grid-template-columns:82px 1fr}.item img,.manage-card img{width:82px;height:82px}.item .status,.manage-card>.manage-actions{grid-column:2}.top{align-items:flex-start;flex-direction:column}}
</style></head><body><main class="wrap">
<div class="top"><div><div class="brand">stamp moke / フリー素材管理</div><div class="subtxt">ドカッと入れる → 重複チェック → AI解析 → R2保存 → 公開</div></div><a href="/free/">公開ページを見る</a></div>
<div id="progress" class="progress"></div>
<section class="panel"><div class="row"><div class="field"><label>管理トークン</label><input id="adminToken" type="password" placeholder="FREE_ADMIN_TOKEN"></div><div class="field"><label>共通キャラクター（任意）</label><input id="characterHint" placeholder="例：くろねこ"></div><div class="field"><label>主な用途（任意）</label><select id="platformHint"><option value="">AIに任せる</option><option value="pokekara">ポケカラ</option><option value="x">X</option><option value="instagram">Instagram</option><option value="facebook">Facebook</option><option value="line">LINE</option><option value="youtube">YouTube</option></select></div><div class="field"><label>透かし文字</label><input id="watermark" value="stamp-moke.jp"></div></div><p class="notice">原本・透かし画像・軽量サムネはCloudflare R2へ保存。元ファイル名はR2内部にも公開ダウンロード名にも残しません。同じ画像はSHA-256で重複判定し、重複時はOpenAI APIを呼びません。</p></section>
<section class="panel"><div class="drop" id="drop"><strong>画像をドカッと入れる</strong><span>複数選択 / ドラッグ＆ドロップ</span><input id="files" type="file" accept="image/png,image/jpeg,image/webp" multiple hidden></div><div class="actions"><button class="primary" id="run" disabled>画像を追加してください</button><button class="sub" id="clear" disabled>一覧をクリア</button><span id="queueNote" class="count">0枚</span></div></section>
<section class="panel"><div id="queue" class="queue"><div class="meta">まだ画像はありません。</div></div></section>
<section class="panel"><div class="section-title"><h2>公開済み素材の管理</h2><button class="sub" id="loadManager">一覧を読み込む</button></div><div id="manager" class="manager"><div class="meta">管理トークン入力後、「一覧を読み込む」で編集できます。</div></div></section>
</main>
<script>
const $=id=>document.getElementById(id);const filesInput=$("files"),drop=$("drop"),queueEl=$("queue"),run=$("run"),clear=$("clear"),progress=$("progress"),queueNote=$("queueNote"),tokenEl=$("adminToken"),characterEl=$("characterHint"),platformEl=$("platformHint"),watermarkEl=$("watermark"),manager=$("manager"),loadManager=$("loadManager");tokenEl.value=sessionStorage.getItem("sm_free_admin")||"";tokenEl.addEventListener("input",()=>sessionStorage.setItem("sm_free_admin",tokenEl.value));let queue=[];
function setProgress(text,error=false){progress.textContent=text;progress.className=`progress show${error?' error':''}`;progress.scrollIntoView({behavior:'smooth',block:'nearest'})}function esc(v=""){return String(v).replace(/[&<>\"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]))}
function render(){queueNote.textContent=`${queue.length}枚`;if(!queue.length){queueEl.innerHTML='<div class="meta">まだ画像はありません。</div>';run.disabled=true;run.textContent='画像を追加してください';clear.disabled=true;return}run.disabled=false;run.textContent=`AI解析して${queue.length}枚を一括公開`;clear.disabled=false;queueEl.innerHTML=queue.map(q=>`<div class="item"><img src="${q.localUrl}" alt=""><div><strong>${esc(q.file.name)}</strong><div class="meta">${q.width} × ${q.height} / ${(q.file.size/1024/1024).toFixed(2)}MB</div><div class="meta">${esc(q.title||"")}</div></div><span class="status ${q.state==='公開済み'?'ok':q.state==='エラー'?'err':q.state==='重複'?'skip':''}">${esc(q.state)}</span></div>`).join("")}
async function imageInfo(file){const bitmap=await createImageBitmap(file);const out={width:bitmap.width,height:bitmap.height};bitmap.close();return out}async function fileHash(file){const buf=await file.arrayBuffer();const hash=await crypto.subtle.digest("SHA-256",buf);return [...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,"0")).join("")}
async function addFiles(files){try{for(const file of files){if(!file.type.startsWith("image/"))continue;const info=await imageInfo(file);queue.push({file,localUrl:URL.createObjectURL(file),...info,state:"待機中",title:"",contentHash:""})}render();if(queue.length)setProgress(`${queue.length}枚を読み込みました。`)}catch(e){setProgress(`画像読込エラー：${e?.message||e}`,true)}}drop.onclick=()=>filesInput.click();filesInput.onchange=()=>addFiles(filesInput.files);drop.ondragover=e=>e.preventDefault();drop.ondrop=e=>{e.preventDefault();addFiles(e.dataTransfer.files)};clear.onclick=()=>{queue.forEach(q=>URL.revokeObjectURL(q.localUrl));queue=[];render();progress.className='progress'};
async function makePreview(file,text){const bitmap=await createImageBitmap(file),max=1200,scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));const canvas=document.createElement("canvas");canvas.width=Math.max(1,Math.round(bitmap.width*scale));canvas.height=Math.max(1,Math.round(bitmap.height*scale));const ctx=canvas.getContext("2d");ctx.drawImage(bitmap,0,0,canvas.width,canvas.height);bitmap.close();ctx.save();ctx.globalAlpha=.22;ctx.fillStyle="#111";ctx.font=`700 ${Math.max(18,Math.round(canvas.width/18))}px sans-serif`;ctx.textAlign="center";ctx.textBaseline="middle";ctx.translate(canvas.width/2,canvas.height/2);ctx.rotate(-Math.PI/6);const stepX=Math.max(220,canvas.width*.55),stepY=Math.max(120,canvas.height*.3);for(let y=-canvas.height;y<=canvas.height;y+=stepY)for(let x=-canvas.width;x<=canvas.width;x+=stepX)ctx.fillText(text,x,y);ctx.restore();return await new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error("プレビュー生成失敗")),"image/png",.9))}
async function makeThumb(previewBlob){const bitmap=await createImageBitmap(previewBlob),max=480,scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));const c=document.createElement("canvas");c.width=Math.max(1,Math.round(bitmap.width*scale));c.height=Math.max(1,Math.round(bitmap.height*scale));c.getContext("2d").drawImage(bitmap,0,0,c.width,c.height);bitmap.close();return await new Promise((resolve,reject)=>c.toBlob(b=>b?resolve(b):reject(new Error("サムネ生成失敗")),"image/webp",.72))}
async function api(action,body={},token=tokenEl.value.trim()){const r=await fetch(`/api/free-assets?action=${encodeURIComponent(action)}`,{method:"POST",headers:{"Content-Type":"application/json","x-admin-token":token},body:JSON.stringify(body)});const text=await r.text();let j={};try{j=JSON.parse(text)}catch{throw new Error(text||`HTTP ${r.status}`)}if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);return j}async function uploadR2(role,blob,adminToken){const signed=await api("upload-url",{role,contentType:blob.type},adminToken);const r=await fetch(signed.uploadUrl,{method:"PUT",headers:{"Content-Type":blob.type||"application/octet-stream"},body:blob});if(!r.ok)throw new Error(`R2アップロード失敗 (${r.status})`);return signed.key}
run.onclick=async()=>{const adminToken=tokenEl.value.trim();if(!adminToken)return setProgress("管理トークンを入力してください。",true);if(!queue.length)return;run.disabled=true;clear.disabled=true;try{setProgress("R2 / OpenAI 接続確認中…");await api("health",{},adminToken)}catch(e){setProgress(`設定エラー：${e?.message||e}`,true);run.disabled=false;clear.disabled=false;return}let done=0,skipped=0;for(const q of queue){if(q.state==="公開済み"||q.state==="重複")continue;try{q.state="重複確認中";render();q.contentHash=await fileHash(q.file);const dup=await api("duplicate",{contentHash:q.contentHash},adminToken);if(dup.duplicate){q.state="重複";q.title=`登録済み：${dup.asset?.title||dup.asset?.slug||"既存素材"}`;skipped++;render();continue}q.state="透かし生成中";render();const previewBlob=await makePreview(q.file,watermarkEl.value.trim()||"stamp-moke.jp");const thumbBlob=await makeThumb(previewBlob);q.state="R2保存中";render();const [previewKey,thumbKey]=await Promise.all([uploadR2("preview",previewBlob,adminToken),uploadR2("thumb",thumbBlob,adminToken)]);q.state="AI解析中";render();const analyzed=await api("analyze",{filename:q.file.name,width:q.width,height:q.height,previewKey,characterHint:characterEl.value.trim(),platformHint:platformEl.value},adminToken);q.title=analyzed.metadata?.locales?.ja?.title||"";q.state="原本保存中";render();const originalKey=await uploadR2("original",q.file,adminToken);q.state="公開中";render();await api("publish",{metadata:analyzed.metadata,originalKey,previewKey,thumbKey,contentHash:q.contentHash,width:q.width,height:q.height,contentType:q.file.type,characterHint:characterEl.value.trim()},adminToken);q.state="公開済み";done++;render()}catch(e){console.error(e);q.state="エラー";q.title=e?.message||String(e);render();setProgress(`エラー：${q.title}`,true);run.disabled=false;clear.disabled=false;return}}setProgress(`${done}枚を公開、${skipped}枚は重複のためスキップしました。`);run.disabled=false;clear.disabled=false};
async function loadAssets(){const token=tokenEl.value.trim();if(!token){setProgress("管理トークンを入力してください。",true);return}manager.innerHTML='<div class="meta">読み込み中…</div>';try{const j=await api("admin-list",{},token);const assets=j.assets||[];if(!assets.length){manager.innerHTML='<div class="meta">公開素材はありません。</div>';return}manager.innerHTML=assets.map(a=>{const ja=a.locales?.ja||{},tags=[...(a.platforms||[]),...(a.types||[]),...(a.styles||[])].join(",");return `<article class="manage-card" data-slug="${esc(a.slug)}"><img src="/api/free-preview?variant=thumb&slug=${encodeURIComponent(a.slug)}" alt=""><div class="manage-fields"><input class="m-title" value="${esc(ja.title||"")}"><textarea class="m-desc">${esc(ja.description||"")}</textarea><input class="m-tags" value="${esc(tags)}" disabled><div class="meta">DL ${Number(a.downloads||0)} / ${esc(a.slug)}</div></div><div class="manage-actions"><button class="sub m-save">保存</button><button class="danger m-delete">非公開</button></div></article>`}).join("");manager.querySelectorAll(".manage-card").forEach(card=>{card.querySelector(".m-save").onclick=async()=>{const slug=card.dataset.slug,title=card.querySelector(".m-title").value.trim(),description=card.querySelector(".m-desc").value.trim();try{await api("update",{slug,patch:{locales:{ja:{title,description}}}},token);setProgress(`${title||slug} を更新しました。`)}catch(e){setProgress(`更新エラー：${e.message}`,true)}};card.querySelector(".m-delete").onclick=async()=>{if(!confirm("この素材を公開一覧から外しますか？"))return;try{await api("delete",{slug:card.dataset.slug},token);card.remove();setProgress("非公開にしました。R2原本は保全しています。") }catch(e){setProgress(`非公開エラー：${e.message}`,true)}}})}catch(e){manager.innerHTML=`<div class="meta">${esc(e.message)}</div>`}}loadManager.onclick=loadAssets;render();
</script></body></html>
