---
const title = "フリー素材 管理 | stamp moke";
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width">
<meta name="robots" content="noindex,nofollow">
<title>{title}</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}
.wrap{max-width:1180px;margin:auto;padding:28px 18px 90px}
.top{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:20px}
.brand{font-size:23px;font-weight:900;letter-spacing:.04em}
.subtxt,.meta,.notice{color:#737373;font-size:12px;line-height:1.65}
.panel{background:#fff;border:1px solid #deddd8;border-radius:22px;padding:20px;margin-bottom:18px;box-shadow:0 15px 40px rgba(42,40,32,.05);min-width:0;max-width:100%;overflow:hidden}
.row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.field{display:grid;gap:6px}.field-wide{grid-column:1/-1}
label{font-size:13px;font-weight:800}input,select,textarea,button{font:inherit}input,select,textarea{width:100%;padding:11px 12px;border:1px solid #d8d7d2;border-radius:11px;background:#fff}textarea{min-height:82px;resize:vertical}.usage-hint{min-height:96px}
button{border:0;border-radius:999px;padding:11px 16px;font-weight:800;cursor:pointer}button:disabled{opacity:.45;cursor:not-allowed}.primary{background:#161616;color:#fff}.sub{background:#efeee9}.danger{background:#fff0f0;color:#9d1c1c;border:1px solid #f4caca}
.drop{border:2px dashed #c9c7c0;border-radius:18px;padding:34px 18px;text-align:center;background:#faf9f5;cursor:pointer}.drop strong{display:block;font-size:19px;margin-bottom:7px}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px;align-items:center}
.queue{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:14px!important;align-items:start!important;width:100%!important;max-width:100%!important;min-width:0!important;overflow:hidden!important}.item{position:relative!important;display:flex!important;flex-direction:column!important;gap:8px!important;min-width:0!important;max-width:100%!important;width:100%!important;border:1px solid #e5e3dd!important;border-radius:15px!important;padding:10px!important;background:#fff!important;overflow:hidden!important;contain:layout paint!important}.item img{display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;height:190px!important;max-height:190px!important;min-height:190px!important;object-fit:contain!important;background:#f3f2ee!important;border-radius:11px!important;margin:0 auto!important;cursor:zoom-in;flex:0 0 auto!important}.item strong{display:block;font-size:12px;line-height:1.4;word-break:break-all;max-height:2.8em;overflow:hidden}.item .meta{font-size:11px;line-height:1.4;overflow-wrap:anywhere}
.status{display:inline-block;width:max-content;max-width:100%;font-size:10px;font-weight:900;padding:4px 7px;border-radius:99px;background:#efeee9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ok{background:#e7f6ea;color:#176b2c}.err{background:#feecec;color:#9b1c1c}.skip{background:#fff4d6;color:#815c00}.progress{display:none;margin:0 0 18px;padding:14px 16px;border-radius:14px;background:#161616;color:#fff;font-weight:800}.progress.show{display:block}.progress.error{background:#9b1c1c}
.section-title{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.section-title h2{margin:0;font-size:18px}.section-buttons{display:flex;gap:8px;flex-wrap:wrap}.count{font-size:12px;color:#737373}.manager-toolbar{display:grid;grid-template-columns:minmax(220px,1fr) 150px 150px;gap:10px;margin-bottom:10px}.bulkbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px;padding:10px;background:#faf9f5;border-radius:14px}.manager{display:grid;gap:12px}
.manage-card{display:grid;grid-template-columns:42px 110px minmax(0,1fr) auto;gap:14px;align-items:start;border:2px solid #e5e3dd;border-radius:15px;padding:12px;background:#fff;transition:.15s}.manage-card.unpublished{background:#fbfbfb;border-style:dashed}.manage-card.selected{border-color:#161616;background:#fffef5}.manage-card.duplicate-candidate{box-shadow:inset 0 0 0 2px #f0b400}.manage-check{width:28px;height:28px;margin-top:4px;accent-color:#161616;cursor:pointer}.manage-card img{width:110px!important;height:110px!important;max-width:110px!important;max-height:110px!important;object-fit:contain!important;background:#f3f2ee;border-radius:11px;cursor:zoom-in}.manage-fields{display:grid;gap:8px}.manage-actions{display:flex;gap:7px;flex-wrap:wrap;max-width:240px}.thumb-placeholder{width:110px;height:110px;border-radius:11px;background:#f3f2ee;display:grid;place-items:center;color:#888;font-size:11px;text-align:center;padding:8px}.tagline{font-size:11px;color:#777;line-height:1.45}.usage-line{font-size:11px;line-height:1.55;background:#f7f6f2;border-radius:9px;padding:7px 9px;color:#555}.duplicate-badge{display:inline-block;width:max-content;background:#fff0bd;color:#6b4b00;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:900}.status-published{color:#176b2c;font-weight:900}.status-hidden{color:#8a5b00;font-weight:900}
.preview-modal{position:fixed;inset:0;background:rgba(0,0,0,.82);display:none;align-items:center;justify-content:center;padding:28px;z-index:9999}.preview-modal.show{display:flex}.preview-modal-inner{position:relative;max-width:min(1100px,96vw);max-height:94vh;display:grid;gap:10px;place-items:center}.preview-modal img{max-width:94vw;max-height:84vh;object-fit:contain;background:#222;border-radius:12px}.preview-close{position:absolute;right:0;top:-48px;background:#fff;color:#111;min-width:44px;min-height:44px;font-size:20px}.preview-caption{color:#fff;font-size:12px;text-align:center;word-break:break-all;max-width:90vw}
@media(max-width:960px){.queue{grid-template-columns:repeat(3,minmax(0,1fr))!important}.item img{height:180px!important;min-height:180px!important;max-height:180px!important}}
@media(max-width:820px){.manager-toolbar{grid-template-columns:1fr 1fr}.manager-toolbar input{grid-column:1/-1}.manage-card{grid-template-columns:36px 82px minmax(0,1fr)}.manage-card img,.thumb-placeholder{width:82px!important;height:82px!important;max-width:82px!important;max-height:82px!important}.manage-actions{grid-column:2/-1;max-width:none}}
@media(max-width:720px){.row{grid-template-columns:1fr}.field-wide{grid-column:auto}.queue{grid-template-columns:repeat(2,minmax(0,1fr))!important}.item img{height:160px!important;min-height:160px!important;max-height:160px!important}.top{align-items:flex-start;flex-direction:column}.section-title{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.manager-toolbar{grid-template-columns:1fr}.manager-toolbar input{grid-column:auto}.bulkbar button{flex:1 1 calc(50% - 8px)}.manage-card{grid-template-columns:34px 70px minmax(0,1fr);padding:10px;gap:9px}.manage-card img,.thumb-placeholder{width:70px!important;height:70px!important;max-width:70px!important;max-height:70px!important}.manage-actions{grid-column:1/-1}.manage-actions button{flex:1 1 calc(33.3% - 7px)}.item img{height:140px!important;min-height:140px!important;max-height:140px!important}}
@media(max-width:360px){.queue{grid-template-columns:1fr!important}}
</style>
</head>
<body>
<main class="wrap">
<div class="top"><div><div class="brand">stamp moke / フリー素材管理</div><div class="subtxt">ドカッと入れる → 重複チェック → AI解析 → R2保存 → 公開</div></div><a href="/free/">公開ページを見る</a></div>
<div id="progress" class="progress"></div>
<section class="panel"><div class="row"><div class="field"><label>管理トークン</label><input id="adminToken" type="password" placeholder="FREE_ADMIN_TOKEN"></div><div class="field"><label>透かし文字</label><input id="watermark" value="stamp-moke.jp"></div><div class="field field-wide"><label>用途・紹介文への反映（任意）</label><textarea id="usageHint" class="usage-hint" placeholder="例：音楽ライブのチラシ背景用。ポスターや印刷物にも使いやすい素材として紹介してほしい"></textarea><div class="meta">自由に書いてください。GPTが画像内容とこの用途を合わせて紹介文・SEO・用途カテゴリへ反映します。既存カテゴリを優先し、合うカテゴリが無い場合だけ大きな括りの新カテゴリを追加します。</div></div></div><p class="notice">長辺最大2560px・縦横比維持で保存（切り抜きなし）。JPEGは品質82%、PNGは透過・形式を維持。2560px以内で変換後の容量が増える場合は元ファイルを使用します。別途バックアップは保存せず、圧縮前SHA-256を重複判定に使用します。</p></section>
<section class="panel"><div class="drop" id="drop"><strong>画像をドカッと入れる</strong><span>複数選択 / ドラッグ＆ドロップ</span><input id="files" type="file" accept="image/png,image/jpeg,image/webp" multiple hidden></div><div class="actions"><button class="primary" id="run" disabled>画像を追加してください</button><button class="sub" id="clear" disabled>一覧をクリア</button><span id="queueNote" class="count">0枚</span></div></section>
<section class="panel"><div id="queue" class="queue"><div class="meta">まだ画像はありません。</div></div></section>
<section class="panel"><div class="section-title"><h2>素材の管理</h2><div class="section-buttons"><button class="sub" id="optimizeThumbs">既存サムネを一括軽量化</button><button class="sub" id="loadManager">一覧を読み込む</button></div></div><div class="manager-toolbar"><input id="managerSearch" placeholder="タイトル・説明・slug・タグ・用途カテゴリを検索"><select id="statusFilter"><option value="all">すべての状態</option><option value="published">公開中</option><option value="unpublished">非公開</option></select><select id="typeFilter"><option value="all">すべての形式</option><option value="image/jpeg">JPG</option><option value="image/png">PNG</option><option value="transparent">透過あり</option><option value="opaque">透過なし</option></select></div><div class="bulkbar"><button class="sub" id="selectVisible">表示中を全選択</button><button class="sub" id="selectDuplicates">重複候補だけ選択</button><button class="sub" id="clearSelection">選択解除</button><button class="sub" id="bulkUnpublish" disabled>選択中を非公開</button><button class="danger" id="bulkHardDelete" disabled>選択中を完全削除</button><span id="managerCount" class="count">未読込</span><span id="selectedCount" class="count">選択 0件</span></div><div id="manager" class="manager"><div class="meta">管理トークン入力後、「一覧を読み込む」で編集できます。</div></div></section>
</main>
<div id="previewModal" class="preview-modal" aria-hidden="true"><div class="preview-modal-inner"><button id="previewClose" class="preview-close" aria-label="閉じる">×</button><img id="previewModalImg" alt=""><div id="previewCaption" class="preview-caption"></div></div></div>
<script>
const $=id=>document.getElementById(id);
const filesInput=$("files"),drop=$("drop"),queueEl=$("queue"),run=$("run"),clear=$("clear"),progress=$("progress"),queueNote=$("queueNote");
const tokenEl=$("adminToken"),usageHintEl=$("usageHint"),watermarkEl=$("watermark");
const manager=$("manager"),loadManager=$("loadManager"),optimizeThumbs=$("optimizeThumbs"),managerSearch=$("managerSearch"),statusFilter=$("statusFilter"),typeFilter=$("typeFilter");
const selectVisible=$("selectVisible"),selectDuplicates=$("selectDuplicates"),clearSelection=$("clearSelection"),bulkUnpublish=$("bulkUnpublish"),bulkHardDelete=$("bulkHardDelete"),managerCount=$("managerCount"),selectedCount=$("selectedCount");
const previewModal=$("previewModal"),previewModalImg=$("previewModalImg"),previewCaption=$("previewCaption"),previewClose=$("previewClose");
tokenEl.value=sessionStorage.getItem("sm_free_admin")||"";tokenEl.addEventListener("input",()=>sessionStorage.setItem("sm_free_admin",tokenEl.value));
let queue=[],managerAssets=[],visibleAssets=[];const selected=new Set();let searchTimer;
function setProgress(text,error=false){progress.textContent=text;progress.className=`progress show${error?' error':''}`;progress.scrollIntoView({behavior:'smooth',block:'nearest'})}
function esc(v=""){return String(v).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]))}
function formatBytes(bytes){return bytes<1024*1024?(bytes/1024).toFixed(1)+" KB":(bytes/1024/1024).toFixed(2)+" MB"}
function openPreview(src,caption=""){previewModalImg.src=src;previewCaption.textContent=caption;previewModal.classList.add("show");previewModal.setAttribute("aria-hidden","false")}
function closePreview(){previewModal.classList.remove("show");previewModal.setAttribute("aria-hidden","true");previewModalImg.removeAttribute("src")}
previewClose.onclick=closePreview;previewModal.onclick=e=>{if(e.target===previewModal)closePreview()};document.addEventListener("keydown",e=>{if(e.key==="Escape")closePreview()});
function bindQueuePreviews(){queueEl.querySelectorAll(".item img").forEach((img,i)=>img.onclick=()=>openPreview(img.src,queue[i]?.file?.name||""))}
function render(){const actionable=queue.filter(q=>q.state!=="重複").length,dupes=queue.length-actionable;queueNote.textContent=`${queue.length}枚${dupes?` / 重複${dupes}枚`:''}`;if(!queue.length){queueEl.innerHTML='<div class="meta">まだ画像はありません。</div>';run.disabled=true;run.textContent='画像を追加してください';clear.disabled=true;return}run.disabled=actionable===0;run.textContent=actionable?`AI解析して${actionable}枚を一括公開`:'すべて重複です';clear.disabled=false;queueEl.innerHTML=queue.map(q=>`<div class="item"><img src="${q.localUrl}" alt=""><strong>${esc(q.file.name)}</strong><div class="meta">${q.width} × ${q.height}<br>${formatBytes(q.file.size)}</div>${q.compression?`<div class="meta">${esc(q.compression)}</div>`:""}${q.title?`<div class="meta">${esc(q.title)}</div>`:""}<span class="status ${q.state==='公開済み'?'ok':q.state==='エラー'?'err':q.state==='重複'?'skip':''}">${esc(q.state)}</span></div>`).join("");bindQueuePreviews()}
async function imageInfo(file){const bitmap=await createImageBitmap(file);const out={width:bitmap.width,height:bitmap.height};bitmap.close();return out}
async function fileHash(file){const buf=await file.arrayBuffer();const hash=await crypto.subtle.digest("SHA-256",buf);return [...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,"0")).join("")}
async function addFiles(files){try{const known=new Set(queue.map(q=>q.contentHash).filter(Boolean));let added=0,dupes=0;for(const file of files){if(!file.type.startsWith("image/"))continue;const [info,contentHash]=await Promise.all([imageInfo(file),fileHash(file)]);const duplicated=known.has(contentHash);if(!duplicated)known.add(contentHash);queue.push({file,localUrl:URL.createObjectURL(file),...info,state:duplicated?"重複":"待機中",title:duplicated?"この投入一覧内に同じ画像があります":"",contentHash});added++;if(duplicated)dupes++}render();if(added)setProgress(`${added}枚を読み込みました。${dupes?` 同一画像${dupes}枚は公開対象から除外します。`:""}`)}catch(e){setProgress(`画像読込エラー：${e?.message||e}`,true)}}
drop.onclick=()=>filesInput.click();filesInput.onchange=()=>addFiles(filesInput.files);drop.ondragover=e=>e.preventDefault();drop.ondrop=e=>{e.preventDefault();addFiles(e.dataTransfer.files)};clear.onclick=()=>{queue.forEach(q=>URL.revokeObjectURL(q.localUrl));queue=[];render();progress.className="progress"};
async function compressDownload(file){const bitmap=await createImageBitmap(file);const scale=Math.min(1,2560/Math.max(bitmap.width,bitmap.height));const canvas=document.createElement("canvas");canvas.width=Math.max(1,Math.round(bitmap.width*scale));canvas.height=Math.max(1,Math.round(bitmap.height*scale));const type=file.type==="image/jpeg"?"image/jpeg":file.type==="image/webp"?"image/webp":"image/png";try{const context=canvas.getContext("2d",{alpha:true});if(!context)throw new Error("画像圧縮を開始できませんでした。");context.imageSmoothingEnabled=true;context.imageSmoothingQuality="high";context.drawImage(bitmap,0,0,canvas.width,canvas.height)}finally{bitmap.close()}const compressed=await new Promise((resolve,reject)=>canvas.toBlob(blob=>blob&&blob.type===type&&blob.size>0?resolve(blob):reject(new Error("画像圧縮に失敗しました。保存は行っていません。")),type,type==="image/jpeg"?0.82:0.85));return scale===1&&compressed.size>=file.size?file:compressed}
function compressionSummary(before,after){const reduction=before?(1-after/before)*100:0;return `${formatBytes(before)} → ${formatBytes(after)}（${reduction>=0?reduction.toFixed(1)+"%削減":(-reduction).toFixed(1)+"%増加"}）`}
async function makePreview(file,text){const bitmap=await createImageBitmap(file),max=1200,scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));const canvas=document.createElement("canvas");canvas.width=Math.max(1,Math.round(bitmap.width*scale));canvas.height=Math.max(1,Math.round(bitmap.height*scale));const ctx=canvas.getContext("2d");ctx.drawImage(bitmap,0,0,canvas.width,canvas.height);bitmap.close();ctx.save();ctx.globalAlpha=.22;ctx.fillStyle="#111";ctx.font=`700 ${Math.max(18,Math.round(canvas.width/18))}px sans-serif`;ctx.textAlign="center";ctx.textBaseline="middle";ctx.translate(canvas.width/2,canvas.height/2);ctx.rotate(-Math.PI/6);const stepX=Math.max(220,canvas.width*.55),stepY=Math.max(120,canvas.height*.3);for(let y=-canvas.height;y<=canvas.height;y+=stepY)for(let x=-canvas.width;x<=canvas.width;x+=stepX)ctx.fillText(text,x,y);ctx.restore();return await new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error("プレビュー生成失敗")),"image/png",.88))}
async function makeThumb(sourceBlob){const bitmap=await createImageBitmap(sourceBlob),max=360,scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));const c=document.createElement("canvas");c.width=Math.max(1,Math.round(bitmap.width*scale));c.height=Math.max(1,Math.round(bitmap.height*scale));const ctx=c.getContext("2d",{alpha:true});ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality="high";ctx.drawImage(bitmap,0,0,c.width,c.height);bitmap.close();return await new Promise((resolve,reject)=>c.toBlob(b=>b?resolve(b):reject(new Error("サムネ生成失敗")),"image/webp",.58))}
async function api(action,body={},token=tokenEl.value.trim()){const r=await fetch(`/api/free-assets?action=${encodeURIComponent(action)}`,{method:"POST",headers:{"Content-Type":"application/json","x-admin-token":token},body:JSON.stringify(body)});const text=await r.text();let j={};try{j=JSON.parse(text)}catch{throw new Error(text||`HTTP ${r.status}`)}if(!r.ok){const error=new Error(j.error||`HTTP ${r.status}`);error.status=r.status;error.payload=j;throw error}return j}
async function uploadR2(role,blob,adminToken){const signed=await api("upload-url",{role,contentType:blob.type},adminToken);const r=await fetch(signed.uploadUrl,{method:"PUT",headers:{"Content-Type":blob.type||"application/octet-stream"},body:blob});if(!r.ok)throw new Error(`R2アップロード失敗 (${r.status})`);return signed.key}
async function analyzeAsset(body,adminToken){const controller=new AbortController(),timeout=setTimeout(()=>controller.abort(),100000);try{const response=await fetch("https://stamp-moke-free-ai.yukipro1783.workers.dev/analyze",{method:"POST",headers:{"Content-Type":"application/json","x-admin-token":adminToken},body:JSON.stringify(body),signal:controller.signal});if(!response.ok)throw new Error(`Worker HTTP ${response.status}`);const result=await response.json();if(result.error||!result.metadata||typeof result.metadata!=="object"||Array.isArray(result.metadata))throw new Error("Worker returned invalid metadata");return result}finally{clearTimeout(timeout)}}
run.onclick=async()=>{const adminToken=tokenEl.value.trim();if(!adminToken)return setProgress("管理トークンを入力してください。",true);const targets=queue.filter(q=>q.state!=="公開済み"&&q.state!=="重複");if(!targets.length)return;run.disabled=true;clear.disabled=true;try{setProgress("設定確認中…");await api("health",{},adminToken);setProgress(`重複チェック開始：${targets.length}枚`)}catch(e){setProgress(`設定エラー：${e?.message||e}`,true);run.disabled=false;clear.disabled=false;return}let done=0,skipped=queue.filter(q=>q.state==="重複").length;const usageHint=usageHintEl.value.trim();for(let i=0;i<targets.length;i++){const q=targets[i];try{setProgress(`${i+1}/${targets.length} 重複チェック中…`);q.state="重複確認中";render();if(!q.contentHash)q.contentHash=await fileHash(q.file);const dup=await api("duplicate",{contentHash:q.contentHash},adminToken);if(dup.duplicate){q.state="重複";q.title=`登録済み：${dup.asset?.title||dup.asset?.slug||"既存素材"}`;skipped++;render();continue}setProgress(`${i+1}/${targets.length} 原本を軽量化中…`);q.state="圧縮中";render();const storedBlob=await compressDownload(q.file);const storedInfo=await imageInfo(storedBlob);q.compression=compressionSummary(q.file.size,storedBlob.size);render();setProgress(`${i+1}/${targets.length} プレビュー生成中…`);q.state="透かし生成中";render();const previewBlob=await makePreview(storedBlob,watermarkEl.value.trim()||"stamp-moke.jp");const thumbBlob=await makeThumb(previewBlob);setProgress(`${i+1}/${targets.length} R2へ保存中…`);q.state="R2保存中";render();const [previewKey,thumbKey]=await Promise.all([uploadR2("preview",previewBlob,adminToken),uploadR2("thumb",thumbBlob,adminToken)]);setProgress(`${i+1}/${targets.length} AI解析中…`);q.state="AI解析中";render();const analyzed=await analyzeAsset({filename:q.file.name,width:storedInfo.width,height:storedInfo.height,previewKey,usageHint},adminToken);q.title=analyzed.metadata?.locales?.ja?.title||"";setProgress(`${i+1}/${targets.length} 原本保存・公開中…`);q.state="原本保存中";render();const originalKey=await uploadR2("original",storedBlob,adminToken);q.state="公開中";render();await api("publish",{metadata:analyzed.metadata,originalKey,previewKey,thumbKey,contentHash:q.contentHash,width:storedInfo.width,height:storedInfo.height,contentType:storedBlob.type,usageHint},adminToken);q.state="公開済み";done++;render()}catch(e){console.error(e);if(e?.status===409){q.state="重複";q.title=e.payload?.asset?.title||e.message;skipped++;render();continue}q.state="エラー";q.title=e?.message||String(e);render();setProgress(`エラー：${q.title}`,true);run.disabled=false;clear.disabled=false;return}}setProgress(`${done}枚を公開、${skipped}枚は重複のためスキップしました。`);run.disabled=false;clear.disabled=false};
function searchText(asset){return [asset.slug,asset.character,asset.usageIntent,(asset.useCategories||[]).join(" "),(asset.platforms||[]).join(" "),(asset.types||[]).join(" "),(asset.motifs||[]).join(" "),(asset.styles||[]).join(" "),...Object.values(asset.locales||{}).flatMap(v=>[v?.title,v?.description,v?.seoTitle,v?.metaDescription,v?.alt,(v?.keywords||[]).join(" ")])].filter(Boolean).join(" ").toLowerCase()}
function isPublished(asset){return asset?.status==="published"}
function typeMatches(asset,value){if(value==="all")return true;if(value==="transparent")return Boolean(asset.transparent);if(value==="opaque")return !asset.transparent;return asset.contentType===value}
function duplicateMapByHash(){const groups=new Map();for(const a of managerAssets){const h=String(a.contentHash||"");if(!/^[a-f0-9]{64}$/i.test(h))continue;if(!groups.has(h))groups.set(h,[]);groups.get(h).push(a)}const info=new Map();for(const group of groups.values()){if(group.length<2)continue;const ordered=[...group].sort((a,b)=>String(a.publishedAt||a.updatedAt||"").localeCompare(String(b.publishedAt||b.updatedAt||"")));ordered.forEach((a,i)=>info.set(a.slug,{count:ordered.length,keeper:i===0}))}return info}
function duplicateExtraSlugs(){const info=duplicateMapByHash();return [...info.entries()].filter(([,v])=>!v.keeper).map(([slug])=>slug)}
function applyManagerFilters(){const q=managerSearch.value.trim().toLowerCase(),status=statusFilter.value,type=typeFilter.value;visibleAssets=managerAssets.filter(asset=>{if(status==="published"&&!isPublished(asset))return false;if(status==="unpublished"&&isPublished(asset))return false;if(!typeMatches(asset,type))return false;if(q&&!searchText(asset).includes(q))return false;return true});const dupes=duplicateExtraSlugs().length;managerCount.textContent=`${managerAssets.length}件中 ${visibleAssets.length}件表示${dupes?` / 重複候補 ${dupes}件`:""}`;renderManager()}
function updateSelectedUi(){for(const slug of [...selected])if(!managerAssets.some(a=>a.slug===slug))selected.delete(slug);selectedCount.textContent=`選択 ${selected.size}件`;bulkUnpublish.disabled=selected.size===0;bulkHardDelete.disabled=selected.size===0}
function renderManager(){if(!visibleAssets.length){manager.innerHTML='<div class="meta">条件に一致する素材はありません。</div>';updateSelectedUi();return}const dupInfo=duplicateMapByHash();manager.innerHTML=visibleAssets.map(a=>{const ja=a.locales?.ja||{},tags=[...(a.useCategories||[]),...(a.platforms||[]),...(a.types||[]),...(a.motifs||[]),...(a.styles||[])].join(", ");const published=isPublished(a),d=dupInfo.get(a.slug);const img=published?`<img src="/api/free-preview?variant=thumb&slug=${encodeURIComponent(a.slug)}" alt="${esc(ja.title||a.slug)}">`:`<div class="thumb-placeholder" data-admin-thumb="${esc(a.slug)}">非公開画像<br>読込中</div>`;return `<article class="manage-card ${published?"":"unpublished"} ${selected.has(a.slug)?"selected":""} ${d?"duplicate-candidate":""}" data-slug="${esc(a.slug)}"><input class="manage-check" type="checkbox" ${selected.has(a.slug)?"checked":""} aria-label="${esc(ja.title||a.slug)}を選択">${img}<div class="manage-fields"><div class="${published?"status-published":"status-hidden"}">${published?"公開中":"非公開"}</div>${d?`<span class="duplicate-badge">${d.keeper?"重複候補・残す基準":"重複候補"}（同一SHA-256 ${d.count}件）</span>`:""}<input class="m-title" value="${esc(ja.title||"")}"><textarea class="m-desc">${esc(ja.description||"")}</textarea>${a.usageIntent?`<div class="usage-line"><b>指定用途：</b>${esc(a.usageIntent)}</div>`:""}<div class="tagline">${esc(tags)}</div><div class="meta">DL ${Number(a.downloads||0)} / ${esc(a.contentType||"")} / ${a.width||0}×${a.height||0} / ${a.transparent?"透過あり":"透過なし"}<br>${esc(a.slug)}</div></div><div class="manage-actions"><button class="sub m-save">保存</button>${published?'<button class="sub m-unpublish">非公開</button>':""}<button class="danger m-hard-delete">完全削除</button></div></article>`}).join("");bindManagerEvents();hydrateAdminThumbs();updateSelectedUi()}
async function hydrateAdminThumbs(){const token=tokenEl.value.trim();if(!token)return;for(const el of manager.querySelectorAll("[data-admin-thumb]")){const slug=el.dataset.adminThumb;try{const r=await fetch("/api/free-assets?action=admin-preview",{method:"POST",headers:{"Content-Type":"application/json","x-admin-token":token},body:JSON.stringify({slug,variant:"thumb"})});if(!r.ok){el.textContent="画像なし";continue}const blob=await r.blob(),url=URL.createObjectURL(blob),img=document.createElement("img");img.src=url;img.alt="";img.onload=()=>URL.revokeObjectURL(url);img.onclick=()=>openPreview(url,slug);el.replaceWith(img)}catch{el.textContent="画像なし"}}}
function bindManagerEvents(){manager.querySelectorAll(".manage-card").forEach(card=>{const slug=card.dataset.slug,check=card.querySelector(".manage-check");check.onchange=e=>{e.target.checked?selected.add(slug):selected.delete(slug);card.classList.toggle("selected",e.target.checked);updateSelectedUi()};card.onclick=e=>{if(e.target.closest("input,textarea,button,img"))return;check.checked=!check.checked;check.dispatchEvent(new Event("change"))};const img=card.querySelector("img");if(img)img.onclick=()=>openPreview(img.src,card.querySelector(".m-title")?.value||slug);card.querySelector(".m-save").onclick=async()=>{const title=card.querySelector(".m-title").value.trim(),description=card.querySelector(".m-desc").value.trim();try{await api("update",{slug,patch:{locales:{ja:{title,description}}}});setProgress(`${title||slug} を更新しました。`);await loadAssets()}catch(e){setProgress(`更新エラー：${e.message}`,true)}};const unpublish=card.querySelector(".m-unpublish");if(unpublish)unpublish.onclick=()=>unpublishOne(slug);card.querySelector(".m-hard-delete").onclick=()=>hardDeleteOne(slug)})}
async function loadAssets(){const token=tokenEl.value.trim();if(!token){setProgress("管理トークンを入力してください。",true);return}manager.innerHTML='<div class="meta">読み込み中…</div>';try{const j=await api("admin-list",{},token);managerAssets=j.assets||[];applyManagerFilters()}catch(e){manager.innerHTML=`<div class="meta">${esc(e.message)}</div>`}}
async function unpublishOne(slug){if(!confirm("この素材を公開ページ・一覧・サイトマップから非公開にしますか？ R2の画像やメタデータは残ります。"))return;try{await api("unpublish",{slug});selected.delete(slug);setProgress("非公開にしました。R2データは保持しています。");await loadAssets()}catch(e){setProgress(`非公開エラー：${e.message}`,true)}}
async function hardDeleteOne(slug){if(!confirm("画像本体・プレビュー・サムネイル・メタデータ・重複判定情報をR2から完全に削除します。この操作は元に戻せません。"))return;try{const j=await api("hard-delete",{slug});selected.delete(slug);setProgress(`完全削除しました。${j.skippedShared?.length?` 共有中の${j.skippedShared.length}ファイルは保護しました。`:""}`);await loadAssets()}catch(e){setProgress(`完全削除エラー：${e.message}`,true)}}
async function runBulk(action){const slugs=[...selected];if(!slugs.length)return;const hard=action==="hard-delete";const message=hard?`選択した${slugs.length}件を完全削除します。R2上の画像・サムネイル・メタデータ・重複判定情報も削除され、元に戻せません。`:`選択した${slugs.length}件を非公開にします。R2データは保持されます。`;if(!confirm(message))return;let ok=0,fail=0;for(let i=0;i<slugs.length;i++){try{setProgress(`${i+1}/${slugs.length} 処理中…`);await api(action,{slug:slugs[i]});ok++;selected.delete(slugs[i])}catch(e){console.error(action,slugs[i],e);fail++}}setProgress(`一括処理完了：成功 ${ok}件 / 失敗 ${fail}件`,fail>0);await loadAssets()}
loadManager.onclick=loadAssets;managerSearch.addEventListener("input",()=>{clearTimeout(searchTimer);searchTimer=setTimeout(applyManagerFilters,300)});statusFilter.onchange=applyManagerFilters;typeFilter.onchange=applyManagerFilters;selectVisible.onclick=()=>{visibleAssets.forEach(a=>selected.add(a.slug));renderManager()};selectDuplicates.onclick=()=>{selected.clear();const visibleSet=new Set(visibleAssets.map(a=>a.slug));duplicateExtraSlugs().filter(slug=>visibleSet.has(slug)).forEach(slug=>selected.add(slug));renderManager();setProgress(selected.size?`重複候補のうち、残す基準1件を除いた${selected.size}件を選択しました。削除前に画像を確認してください。`:"同一SHA-256の重複候補は見つかりませんでした。");};clearSelection.onclick=()=>{selected.clear();renderManager()};bulkUnpublish.onclick=()=>runBulk("unpublish");bulkHardDelete.onclick=()=>runBulk("hard-delete");
optimizeThumbs.onclick=async()=>{const token=tokenEl.value.trim();if(!token)return setProgress("管理トークンを入力してください。",true);optimizeThumbs.disabled=true;try{const j=await api("admin-list",{},token);const targets=(j.assets||[]).filter(a=>a.status==="published"&&!a.thumbKey);if(!targets.length){setProgress("公開中の既存素材はすべて軽量サムネ化済みです。");return}let done=0;for(const a of targets){setProgress(`${done+1}/${targets.length}：${a.locales?.ja?.title||a.slug} の軽量サムネを生成中…`);const r=await fetch(`/api/free-preview?slug=${encodeURIComponent(a.slug)}`);if(!r.ok)throw new Error(`${a.slug} のプレビュー取得に失敗しました`);const source=await r.blob(),thumb=await makeThumb(source),thumbKey=await uploadR2("thumb",thumb,token);await api("attach-thumb",{slug:a.slug,thumbKey},token);done++}setProgress(`${done}件の既存素材を360px WebPへ軽量化しました。`);await loadAssets()}catch(e){setProgress(`サムネ軽量化エラー：${e.message}`,true)}finally{optimizeThumbs.disabled=false}};
render();
</script>
</body>
</html>