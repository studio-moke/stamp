---
const title = "Pinterest投稿候補 | stamp moke";
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title}</title>
  <style>
    :root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#20221f;background:#f5f4ef}
    *{box-sizing:border-box}body{margin:0}.wrap{width:min(1180px,calc(100% - 28px));margin:28px auto 72px}.head{display:flex;gap:18px;justify-content:space-between;align-items:flex-start;flex-wrap:wrap}.head h1{margin:0 0 8px;font-size:clamp(26px,4vw,42px)}.head p{margin:0;color:#62665f;line-height:1.7}.auth{display:flex;gap:8px;flex-wrap:wrap;background:#fff;padding:12px;border:1px solid #dedfd9;border-radius:16px}.auth input{min-width:260px;padding:13px 14px;border:1px solid #c8cbc3;border-radius:11px;font-size:16px}.btn{appearance:none;border:0;border-radius:11px;padding:12px 16px;font-weight:700;font-size:14px;cursor:pointer;background:#20221f;color:#fff}.btn.sub{background:#e9e9e3;color:#292c27}.btn.danger{background:#f2dfdf;color:#6d2929}.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:22px 0}.toolbar button.active{outline:3px solid #bbbdb4}.status{font-size:13px;color:#666}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px}.card{background:#fff;border:1px solid #dcded7;border-radius:18px;overflow:hidden;box-shadow:0 6px 22px rgba(30,35,28,.04)}.thumb{aspect-ratio:1/1;background:#eee;display:block;width:100%;object-fit:cover}.body{padding:15px}.badge{display:inline-flex;padding:5px 9px;border-radius:999px;background:#eff0eb;font-size:11px;font-weight:700;margin-bottom:9px}.badge.posted{background:#e4efe4}.badge.excluded{background:#f2e8e8}.body h2{font-size:17px;line-height:1.45;margin:0 0 8px}.desc{font-size:13px;line-height:1.65;color:#555;min-height:64px}.url{font-size:11px;word-break:break-all;color:#777;background:#f6f6f3;padding:9px;border-radius:9px}.actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.actions .btn{padding:9px 11px;font-size:12px}.empty{padding:36px;background:#fff;border-radius:18px;border:1px dashed #c9cbc4;text-align:center;color:#666}.note{margin-top:14px;font-size:12px;color:#70736d;line-height:1.7}
  </style>
</head>
<body>
  <main class="wrap">
    <div class="head">
      <div>
        <h1>Pinterest投稿候補</h1>
        <p>stamp mokeのオリジナル背景素材だけを候補化します。<br />自動投稿はせず、内容を確認してからPinterestへ投稿する運用です。</p>
      </div>
      <div class="auth">
        <input id="token" type="password" autocomplete="off" placeholder="FREE_ADMIN_TOKEN" />
        <button id="load" class="btn">候補を読み込む</button>
      </div>
    </div>

    <div class="toolbar">
      <button class="btn sub active" data-filter="ready">未投稿</button>
      <button class="btn sub" data-filter="posted">投稿済み</button>
      <button class="btn sub" data-filter="excluded">除外</button>
      <button class="btn sub" data-filter="all">すべて</button>
      <span id="status" class="status">管理トークンを入力してください。</span>
    </div>
    <div id="grid" class="grid"></div>
    <p class="note">候補には「背景」タグが付いた公開素材のみを使用し、自動生成・外部・インポート・第三者由来の素材は除外します。投稿先URLは各素材のstamp-moke.jp詳細ページです。</p>
  </main>

<script is:inline>
(()=>{
  const tokenEl=document.getElementById('token');
  const statusEl=document.getElementById('status');
  const grid=document.getElementById('grid');
  let items=[];let filter='ready';
  tokenEl.value=localStorage.getItem('sm_free_admin_token')||'';
  const esc=s=>String(s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  async function api(method='GET',body){const token=tokenEl.value.trim();if(!token)throw new Error('FREE_ADMIN_TOKENを入力してください。');localStorage.setItem('sm_free_admin_token',token);const r=await fetch('/api/free?route=pinterest',{method,headers:{'x-admin-token':token,'content-type':'application/json'},body:body?JSON.stringify(body):undefined});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||`HTTP ${r.status}`);return data}
  async function copy(text,label){await navigator.clipboard.writeText(text);statusEl.textContent=`${label}をコピーしました。`}
  function render(){const shown=items.filter(x=>filter==='all'||x.status===filter);document.querySelectorAll('[data-filter]').forEach(b=>b.classList.toggle('active',b.dataset.filter===filter));if(!shown.length){grid.innerHTML='<div class="empty">この状態のPinterest候補はありません。</div>';return}grid.innerHTML=shown.map(x=>`<article class="card" data-slug="${esc(x.slug)}"><img class="thumb" loading="lazy" src="${esc(x.imageUrl)}" alt="${esc(x.title)}"><div class="body"><span class="badge ${esc(x.status)}">${x.status==='ready'?'未投稿':x.status==='posted'?'投稿済み':'除外'}</span><h2>${esc(x.title)}</h2><p class="desc">${esc(x.description)}</p><div class="url">${esc(x.destinationUrl)}</div><div class="actions"><button class="btn" data-copy="title">タイトル</button><button class="btn" data-copy="description">説明文</button><button class="btn" data-copy="url">URL</button><a class="btn sub" href="https://www.pinterest.com/pin-builder/" target="_blank" rel="noopener noreferrer">Pinterestを開く</a>${x.status==='ready'?'<button class="btn sub" data-action="posted">投稿済みにする</button><button class="btn danger" data-action="exclude">除外</button>':'<button class="btn sub" data-action="reset">未投稿へ戻す</button>'}</div></div></article>`).join('')}
  async function load(){try{statusEl.textContent='読み込み中…';const data=await api();items=data.candidates||[];statusEl.textContent=`候補 ${items.length}件`;render()}catch(e){statusEl.textContent=e.message;grid.innerHTML=''}}
  document.getElementById('load').addEventListener('click',load);
  document.querySelector('.toolbar').addEventListener('click',e=>{const b=e.target.closest('[data-filter]');if(!b)return;filter=b.dataset.filter;render()});
  grid.addEventListener('click',async e=>{const card=e.target.closest('.card');if(!card)return;const item=items.find(x=>x.slug===card.dataset.slug);if(!item)return;const c=e.target.closest('[data-copy]');if(c){const key=c.dataset.copy;await copy(key==='url'?item.destinationUrl:item[key],key==='title'?'タイトル':key==='description'?'説明文':'URL');return}const a=e.target.closest('[data-action]');if(!a)return;try{a.disabled=true;await api('POST',{slug:item.slug,action:a.dataset.action});await load()}catch(err){statusEl.textContent=err.message;a.disabled=false}});
  if(tokenEl.value)load();
})();
</script>
</body>
</html>
