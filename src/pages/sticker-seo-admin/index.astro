---
import stickers from "../../data/stickers.json";
import { getCategory } from "../../lib/stickers";
import { getStickerPhrases } from "../../lib/sticker-tags";
const rows=stickers.map(s=>({id:String(s.id),title:s.title,description:s.description||"",category:getCategory(s),phrases:getStickerPhrases(s.id)}));
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>スタンプGPT SEO管理 | stamp moke</title><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:1120px;margin:auto;padding:30px 18px 90px}.top{display:flex;justify-content:space-between;gap:15px;align-items:center;margin-bottom:20px}.brand{font-size:22px;font-weight:900}.panel{background:#fff;border:1px solid #deddd8;border-radius:20px;padding:18px;margin-bottom:16px;box-shadow:0 12px 34px rgba(0,0,0,.04)}.lead,.meta{color:#6d6d6d;font-size:12px;line-height:1.75}.controls{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.controls input{min-width:280px;flex:1;padding:11px 13px;border:1px solid #d7d6d1;border-radius:12px;font:inherit}.btn{border:0;border-radius:999px;padding:11px 16px;font-weight:800;cursor:pointer}.primary{background:#161616;color:#fff}.sub{background:#efeee9}.progress{display:none;margin-bottom:16px;padding:13px 15px;border-radius:13px;background:#161616;color:#fff;font-weight:800;font-size:12px}.progress.show{display:block}.progress.err{background:#9a2020}.list{display:grid;gap:8px}.row{display:grid;grid-template-columns:78px minmax(0,1fr) auto;gap:12px;align-items:center;border:1px solid #e4e3de;border-radius:13px;padding:10px 12px}.id{font-size:10px;color:#888}.title{font-size:12px;font-weight:800;line-height:1.5}.status{font-size:10px;border-radius:99px;background:#efeee9;padding:6px 8px;white-space:nowrap}.status.ok{background:#e8f6eb;color:#17682b}.status.work{background:#fff1cf;color:#775700}.status.err{background:#fde9e9;color:#8f1717}@media(max-width:640px){.row{grid-template-columns:1fr auto}.id{display:none}.controls input{min-width:100%}}</style></head><body><main class="wrap"><div class="top"><div><div class="brand">stamp moke / スタンプGPT SEO</div><div class="lead">タイトル・LINE説明・検出フレーズをもとに、ターゲット・コンセプト・用途・長文紹介・検索キーワードを5言語で生成しR2へ保存します。</div></div><a href="/">サイトへ</a></div><div id="progress" class="progress"></div><section class="panel"><div class="controls"><input id="token" type="password" placeholder="FREE_ADMIN_TOKEN"><button id="missing" class="btn primary">未解析を一括生成</button><button id="stop" class="btn sub" disabled>停止</button></div><p class="meta">解析済み作品は自動スキップするため、通常は再課金されません。既存内容を作り直す場合のみ各作品の「再生成」を使います。SEO本文を静的HTMLのmetaへ反映するには、生成完了後にVercelを1回デプロイしてください。</p></section><section class="panel"><div id="list" class="list"></div></section></main><script define:vars={{ rows }}>
const token=document.getElementById('token'),list=document.getElementById('list'),progress=document.getElementById('progress'),missing=document.getElementById('missing'),stop=document.getElementById('stop');token.value=sessionStorage.getItem('sm_free_admin')||'';token.oninput=()=>sessionStorage.setItem('sm_free_admin',token.value);let cancelled=false;const esc=(v='')=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function msg(text,err=false){progress.textContent=text;progress.className=`progress show${err?' err':''}`}
function render(){list.innerHTML=rows.map(r=>`<div class="row" data-id="${r.id}"><div class="id">${r.id}</div><div><div class="title">${esc(r.title)}</div><div class="meta">${esc(r.category)} / フレーズ ${r.phrases.length}件</div></div><div><span class="status">未確認</span> <button class="btn sub one">生成</button> <button class="btn sub force">再生成</button></div></div>`).join('');list.querySelectorAll('.row').forEach(el=>{const r=rows.find(x=>x.id===el.dataset.id);el.querySelector('.one').onclick=()=>generate(r,false,el);el.querySelector('.force').onclick=()=>generate(r,true,el)})}
async function generate(r,force,el){if(!token.value.trim())throw new Error('管理トークンを入力してください。');const st=el.querySelector('.status');st.className='status work';st.textContent='GPT解析中';const resp=await fetch(`/api/sticker-seo?id=${encodeURIComponent(r.id)}`,{method:'POST',headers:{'Content-Type':'application/json','x-admin-token':token.value.trim()},body:JSON.stringify({...r,force})});const text=await resp.text();let data;try{data=JSON.parse(text)}catch{throw new Error(text||`HTTP ${resp.status}`)}if(!resp.ok)throw new Error(data.error||`HTTP ${resp.status}`);st.className='status ok';st.textContent=data.skipped?'解析済み':'生成完了';return data}
missing.onclick=async()=>{if(!token.value.trim())return msg('管理トークンを入力してください。',true);cancelled=false;missing.disabled=true;stop.disabled=false;let done=0,skip=0,errors=0;for(const r of rows){if(cancelled)break;const el=list.querySelector(`[data-id="${r.id}"]`);try{const d=await generate(r,false,el);d.skipped?skip++:done++;msg(`${done}件生成 / ${skip}件解析済みスキップ / ${errors}件エラー`)}catch(e){errors++;const st=el.querySelector('.status');st.className='status err';st.textContent='エラー';msg(`${r.id}: ${e.message}`,true)}}missing.disabled=false;stop.disabled=true;if(!cancelled)msg(`完了：新規 ${done}件 / スキップ ${skip}件 / エラー ${errors}件。次はVercelを1回デプロイしてください。`)};stop.onclick=()=>{cancelled=true;stop.disabled=true;msg('停止しました。完了済みデータはR2に保存されています。')};render();
</script></body></html>