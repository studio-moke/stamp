---
import SiteHeader from "../components/SiteHeader.astro";
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>漫画トーンメーカー｜網点・砂目・グラデ・カケアミ・ベタフラッシュ | stamp moke</title><meta name="description" content="網点・砂目・グラデーション・カケアミ・ベタフラッシュをブラウザで生成し、透過PNGで保存できる無料漫画トーンメーカー。"/><link rel="canonical" href="https://stamp-moke.jp/manga-tone-maker/"/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:1080px;margin:auto;padding:34px 18px 80px}.crumb{font-size:11px;color:#777;margin-bottom:20px}.crumb a{color:inherit}.toolnav{display:flex;gap:7px;overflow:auto;padding:4px 0 18px}.toolnav a{white-space:nowrap;text-decoration:none;color:#555;background:#fff;border:1px solid #ddd;border-radius:999px;padding:9px 13px;font-size:10px;font-weight:800}.toolnav a.on{background:#171717;color:#fff}.hero{text-align:center;padding:18px 0 30px}.hero h1{font-size:clamp(32px,6vw,58px);letter-spacing:-.05em;margin:0 0 10px}.hero .sub{font-weight:900;font-size:15px}.hero p{max-width:700px;margin:10px auto 0;color:#666;font-size:12px;line-height:1.9}.app{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px;align-items:start}.preview{background:#fff;border:1px solid #ddd;border-radius:22px;padding:14px}.stage{overflow:hidden;border-radius:15px;background:linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0}.stage canvas{width:100%;height:auto;display:block}.controls{background:#fff;border:1px solid #ddd;border-radius:22px;padding:18px;position:sticky;top:14px}.row{margin:0 0 15px}.row label{display:flex;justify-content:space-between;gap:10px;font-size:10px;font-weight:900;margin-bottom:7px}.row input[type=range],.row select,.row input[type=color]{width:100%}.row select{border:1px solid #ccc;border-radius:10px;padding:10px;background:#fff}.row input[type=color]{height:40px;border:1px solid #ccc;border-radius:10px;padding:3px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:7px}.actions button{border:0;border-radius:11px;padding:13px 8px;font-size:10px;font-weight:900;cursor:pointer}.download{background:#171717;color:#fff}.secondary{background:#eceae4}.note{font-size:9px;color:#888;line-height:1.6;margin-top:10px}@media(max-width:800px){.app{grid-template-columns:1fr}.controls{position:static}}@media(max-width:520px){.wrap{padding:22px 10px 55px}.preview{padding:8px}.controls{padding:14px}}</style></head><body><SiteHeader locale="ja"/><main class="wrap"><div class="crumb"><a href="/">stamp moke</a> / <a href="/free/">無料ツール</a> / 漫画トーンメーカー</div><nav class="toolnav"><a href="/manga-speed-lines/">集中線</a><a href="/manga-effect-lines/">効果線</a><a class="on" href="/manga-tone-maker/">トーン</a><a href="/manga-speech-bubble/">フキダシ</a><a href="/manga-sfx/">効果音</a></nav><section class="hero"><h1>漫画トーンメーカー</h1><div class="sub">網点・砂目・グラデ・カケアミ・ベタフラッシュを自由に生成</div><p>漫画やイラストに使えるモノクロトーン素材をブラウザだけで作成。密度・粒・角度・濃さなどを調整して、透過PNGで保存できます。</p></section><section class="app"><div class="preview"><div class="stage"><canvas id="canvas" width="900" height="900"></canvas></div></div><aside class="controls"><div class="row"><label><span>トーン種類</span></label><select id="type"><option value="dots">網点</option><option value="noise">砂目</option><option value="gradient">グラデーション</option><option value="hatch">カケアミ</option><option value="flash">ベタフラッシュ</option></select></div><div class="row"><label><span>密度</span><b id="densityv">45</b></label><input id="density" type="range" min="5" max="95" value="45"></div><div class="row"><label><span>サイズ</span><b id="sizev">12</b></label><input id="size" type="range" min="2" max="40" value="12"></div><div class="row"><label><span>角度</span><b id="anglev">45</b></label><input id="angle" type="range" min="0" max="180" value="45"></div><div class="row"><label><span>ランダム感</span><b id="jitterv">35</b></label><input id="jitter" type="range" min="0" max="100" value="35"></div><div class="row"><label><span>色</span></label><input id="color" type="color" value="#111111"></div><div class="actions"><button class="secondary" id="randomize">ランダム</button><button class="download" id="download">PNG保存</button></div><div class="note">生成処理は端末内で完結します。アップロード不要・登録不要です。</div></aside></section></main><script is:inline>(()=>{const c=document.getElementById('canvas'),x=c.getContext('2d');const ids=['density','size','angle','jitter'];ids.forEach(id=>{const e=document.getElementById(id),v=document.getElementById(id+'v');e.oninput=()=>{v.textContent=e.value;draw()}});['type','color'].forEach(id=>document.getElementById(id).oninput=draw);let seed=9;function rnd(){seed=(seed*9301+49297)%233280;return seed/233280}function v(id){return +document.getElementById(id).value}function s(id){return document.getElementById(id).value}function clear(){x.clearRect(0,0,c.width,c.height)}function draw(){clear();seed=9;const t=s('type'),d=v('density')/100,z=v('size'),a=v('angle')*Math.PI/180,j=v('jitter')/100,col=s('color');x.fillStyle=col;x.strokeStyle=col;if(t==='dots'){for(let yy=0;yy<c.height+z;yy+=z){for(let xx=0;xx<c.width+z;xx+=z){const r=z*.46*d*(.75+rnd()*.5*j);x.beginPath();x.arc(xx+(yy/z%2)*z*.5,yy,r,0,Math.PI*2);x.fill()}}}else if(t==='noise'){const n=Math.floor(8000*d);for(let i=0;i<n;i++){const r=1+rnd()*z*.18;x.globalAlpha=.35+rnd()*.65;x.beginPath();x.arc(rnd()*c.width,rnd()*c.height,r,0,Math.PI*2);x.fill()}x.globalAlpha=1}else if(t==='gradient'){const g=x.createLinearGradient(Math.cos(a)*450+450,Math.sin(a)*450+450,-Math.cos(a)*450+450,-Math.sin(a)*450+450);g.addColorStop(0,col);g.addColorStop(Math.max(.05,1-d),col+'00');x.fillStyle=g;x.fillRect(0,0,c.width,c.height)}else if(t==='hatch'){x.lineWidth=Math.max(1,z*.12);const gap=Math.max(5,30-(d*25));x.save();x.translate(450,450);x.rotate(a);for(let yy=-1000;yy<1000;yy+=gap){for(let k=0;k<2;k++){x.beginPath();x.moveTo(-1000,yy+k*gap*.45);x.lineTo(1000,yy+k*gap*.45+(rnd()-.5)*60*j);x.stroke()}}x.rotate(Math.PI/2);for(let yy=-1000;yy<1000;yy+=gap*1.2){x.beginPath();x.moveTo(-1000,yy);x.lineTo(1000,yy+(rnd()-.5)*60*j);x.stroke()}x.restore()}else{const n=Math.floor(20+d*110);x.save();x.translate(450,450);x.rotate(a);for(let i=0;i<n;i++){const ang=Math.PI*2*i/n+(rnd()-.5)*.05*j,r0=120+rnd()*100*j,r1=650+rnd()*220;x.beginPath();x.lineWidth=Math.max(1,z*(.12+rnd()*.28));x.moveTo(Math.cos(ang)*r0,Math.sin(ang)*r0);x.lineTo(Math.cos(ang)*r1,Math.sin(ang)*r1);x.stroke()}x.restore()}}document.getElementById('randomize').onclick=()=>{seed=Math.floor(Math.random()*99999);draw()};document.getElementById('download').onclick=()=>{const a=document.createElement('a');a.href=c.toDataURL('image/png');a.download='manga-tone.png';a.click()};draw()})()</script></body></html>