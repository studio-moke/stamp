---
const title = "社内チャットスタンプメーカー｜Slack・Teams・LINE WORKS向け無料作成 | stamp moke";
const description = "Slack、Microsoft Teams、LINE WORKS、Chatwork、Google Chatなどで使える文字スタンプを無料作成。AI不使用、ブラウザ内生成、公開は安全判定＋本人同意のみ。";
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://stamp-moke.jp/chat-stamp-maker" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://stamp-moke.jp/chat-stamp-maker" />
  <style>
    :root{--ink:#171717;--muted:#6b7280;--line:#e5e7eb;--bg:#f7f7f5;--card:#fff;--accent:#111827;--ok:#15803d;--warn:#a16207;--bad:#b91c1c}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.wrap{max-width:1180px;margin:auto;padding:24px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px}.brand{font-weight:900;font-size:22px;text-decoration:none;color:var(--ink)}.back{color:#444;text-decoration:none;font-weight:700}.hero{background:linear-gradient(135deg,#fff,#f1f5f9);border:1px solid var(--line);border-radius:24px;padding:34px;margin-bottom:22px}.eyebrow{font-size:13px;font-weight:800;color:#64748b;letter-spacing:.08em}.hero h1{font-size:clamp(30px,5vw,54px);line-height:1.08;margin:8px 0 14px}.hero p{font-size:16px;line-height:1.8;color:#4b5563;max-width:780px}.badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.badge{background:#fff;border:1px solid var(--line);border-radius:999px;padding:8px 12px;font-size:13px;font-weight:700}.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.9fr);gap:22px}.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 10px 30px rgba(0,0,0,.04)}h2{margin:0 0 18px;font-size:22px}.field{margin-bottom:18px}.field label{display:block;font-weight:800;font-size:14px;margin-bottom:8px}.field input[type=text]{width:100%;font-size:22px;padding:14px 16px;border:2px solid #d1d5db;border-radius:12px;outline:none}.field input[type=text]:focus{border-color:#111827}.row{display:flex;gap:10px;flex-wrap:wrap}.choice{border:1px solid #d1d5db;background:#fff;border-radius:12px;padding:10px 13px;cursor:pointer;font-weight:750}.choice.active{background:#111827;color:white;border-color:#111827}.preview-shell{min-height:390px;display:flex;align-items:center;justify-content:center;background:repeating-conic-gradient(#f8fafc 0 25%,#eef2f7 0 50%) 50%/24px 24px;border-radius:16px;border:1px solid var(--line);padding:18px}.preview-shell canvas{width:min(100%,640px);aspect-ratio:1/1;height:auto;filter:drop-shadow(0 8px 18px rgba(0,0,0,.16))}.status{margin:16px 0;padding:12px 14px;border-radius:12px;font-size:14px;font-weight:750}.status.green{background:#ecfdf5;color:var(--ok)}.status.yellow{background:#fffbeb;color:var(--warn)}.status.red{background:#fef2f2;color:var(--bad)}.privacy{font-size:13px;color:#6b7280;line-height:1.65}.actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}.btn{border:0;border-radius:12px;padding:13px 16px;font-size:15px;font-weight:850;cursor:pointer}.btn.primary{background:#111827;color:#fff}.btn.secondary{background:#eef2f7;color:#111827}.publishbox{margin-top:14px;padding:14px;background:#f8fafc;border-radius:14px;border:1px solid var(--line)}.publishbox label{display:flex;gap:10px;align-items:flex-start;font-size:13px;font-weight:700;line-height:1.5}.gallery{margin-top:28px}.gallery-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:14px}.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px}.stamp-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px}.stamp-card canvas{width:100%;height:auto;background:transparent}.stamp-meta{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-top:8px}.mini{border:0;background:#eef2f7;border-radius:9px;padding:7px 9px;cursor:pointer;font-size:12px;font-weight:800}.note{margin-top:30px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;line-height:1.8;color:#4b5563}.toast{position:fixed;right:20px;bottom:20px;background:#111827;color:#fff;padding:12px 16px;border-radius:12px;display:none;z-index:20;max-width:360px}.toast.show{display:block}@media(max-width:820px){.grid{grid-template-columns:1fr}.wrap{padding:14px}.hero{padding:24px 18px}.actions{grid-template-columns:1fr}.preview-shell{min-height:300px}}
  </style>
</head>
<body>
  <main class="wrap">
    <div class="top"><a class="brand" href="/">stamp moke</a><a class="back" href="/">← サイトへ戻る</a></div>
    <section class="hero">
      <div class="eyebrow">FREE CHAT STAMP MAKER</div>
      <h1>社内チャットで使える<br/>文字スタンプを、すぐ作る。</h1>
      <p>Slack、LINE WORKS、Microsoft Teams、Chatwork、Google Chat、direct、ChatLuckなどで使いやすいPNG画像を無料で作成できます。画像生成AIやGPTは使わず、画像はあなたのブラウザ内で生成します。</p>
      <div class="badges"><span class="badge">AI不使用</span><span class="badge">PNG保存</span><span class="badge">公開は本人同意制</span><span class="badge">個人情報フィルタ</span></div>
    </section>

    <section class="grid">
      <div class="card">
        <h2>スタンプを作る</h2>
        <div class="field"><label for="stampText">文字</label><input id="stampText" type="text" maxlength="24" value="確認しました" autocomplete="off" /></div>
        <div class="field"><label>デザイン</label><div class="row" id="styleChoices">
          <button class="choice active" data-style="business">ビジネス</button><button class="choice" data-style="pop">ポップ</button><button class="choice" data-style="stamp">ハンコ</button><button class="choice" data-style="bold">無骨</button><button class="choice" data-style="soft">やわらか</button><button class="choice" data-style="mono">白黒</button>
        </div></div>
        <div class="field"><label>文字方向</label><div class="row" id="layoutChoices"><button class="choice active" data-layout="horizontal">横書き</button><button class="choice" data-layout="vertical">縦書き</button></div></div>
        <div id="safetyStatus" class="status green">GREEN：公開可能な範囲と判定しました</div>
        <div class="privacy">非公開のスタンプはサーバーへ保存しません。PNG生成・ダウンロードはブラウザ内だけで完結します。公開を選んだ場合のみ、サーバー側でも安全判定を再実行します。</div>
        <div class="publishbox"><label><input id="publishConsent" type="checkbox" /> <span>このスタンプを「みんなのチャットスタンプ」に一般公開することに同意します。個人名・会社名・顧客情報・機密情報を含めません。</span></label></div>
        <div class="actions"><button id="downloadBtn" class="btn primary">PNGをダウンロード</button><button id="publishBtn" class="btn secondary">みんなに公開する</button></div>
        <div id="deleteInfo" class="privacy" style="margin-top:12px"></div>
      </div>

      <div class="card">
        <h2>プレビュー</h2>
        <div class="preview-shell"><canvas id="preview" width="640" height="640"></canvas></div>
        <div class="privacy" style="margin-top:12px">背景透過PNG・640×640px。文字数に応じて自動改行し、正方形いっぱいにバランスよく配置します。</div>
      </div>
    </section>

    <section class="gallery">
      <div class="gallery-head"><div><div class="eyebrow">PUBLIC GALLERY</div><h2 style="margin:4px 0 0">みんなのチャットスタンプ</h2></div><button id="reloadBtn" class="mini">更新</button></div>
      <div id="galleryGrid" class="gallery-grid"></div>
    </section>

    <section class="note"><strong>安全について：</strong>公開判定はルールベースで行い、メールアドレス、電話番号、住所らしい文字列、長い数字列、認証情報、機密・顧客関連語、固有名詞らしい表現などを検知した場合は自動公開しません。ただし自動判定は完全ではありません。公開前に必ず入力内容をご確認ください。非公開で作る場合は、この公開判定に関係なくPNGを作成できます。</section>
  </main>
  <div class="toast" id="toast"></div>

<script>
const canvas = document.getElementById('preview');
const ctx = canvas.getContext('2d');
const input = document.getElementById('stampText');
const safetyEl = document.getElementById('safetyStatus');
const consent = document.getElementById('publishConsent');
const toast = document.getElementById('toast');
let style = 'business';
let layout = 'horizontal';

const styles = {
  business:{fill:'#111827',stroke:'#ffffff',bg:null,weight:900,family:'"Noto Sans JP", sans-serif',shadow:false},
  pop:{fill:'#ff4f87',stroke:'#ffffff',bg:'#fff3f7',weight:900,family:'"Noto Sans JP", sans-serif',shadow:true},
  stamp:{fill:'#b91c1c',stroke:'#ffffff',bg:null,weight:900,family:'serif',shadow:false,stamp:true},
  bold:{fill:'#111111',stroke:'#ffffff',bg:null,weight:900,family:'Impact, "Noto Sans JP", sans-serif',shadow:true},
  soft:{fill:'#6d5c80',stroke:'#ffffff',bg:'#f6f1fb',weight:800,family:'"Noto Sans JP", sans-serif',shadow:false},
  mono:{fill:'#ffffff',stroke:'#111111',bg:'#111111',weight:900,family:'"Noto Sans JP", sans-serif',shadow:false}
};

function splitBalanced(text){
  const chars=[...String(text||'').replace(/\s+/g,'')];
  if(chars.length<=4)return[chars.join('')];
  if(chars.length<=8){const cut=Math.floor(chars.length/2);return[chars.slice(0,cut).join(''),chars.slice(cut).join('')]}
  if(chars.length<=15){const rows=3,base=Math.floor(chars.length/rows),extra=chars.length%rows;let i=0;return Array.from({length:rows},(_,r)=>{const n=base+(r<extra?1:0);const part=chars.slice(i,i+n).join('');i+=n;return part})}
  const rows=4,base=Math.floor(chars.length/rows),extra=chars.length%rows;let i=0;return Array.from({length:rows},(_,r)=>{const n=base+(r<extra?1:0);const part=chars.slice(i,i+n).join('');i+=n;return part});
}
function fitBlock(x,lines,cfg,maxW,maxH){
  let size=220;
  while(size>36){
    x.font=`${cfg.weight} ${size}px ${cfg.family}`;
    const widest=Math.max(...lines.map(line=>x.measureText(line).width));
    const lineH=size*1.02;
    if(widest<=maxW && lineH*lines.length<=maxH)return{size,lineH};
    size-=2;
  }
  return{size:36,lineH:37};
}
function drawStamp(target=canvas, text=input.value.trim()||'確認しました', s=style, l=layout){
  const c=target, x=c.getContext('2d'), cfg=styles[s]||styles.business;
  x.clearRect(0,0,c.width,c.height);x.save();
  const pad=Math.round(c.width*0.07);
  if(cfg.bg){x.fillStyle=cfg.bg;x.beginPath();x.roundRect(pad,pad,c.width-pad*2,c.height-pad*2,48);x.fill()}
  x.textAlign='center';x.textBaseline='middle';x.lineJoin='round';x.strokeStyle=cfg.stroke;x.fillStyle=cfg.fill;
  if(cfg.shadow){x.shadowColor='rgba(0,0,0,.22)';x.shadowBlur=12;x.shadowOffsetY=7}
  if(l==='vertical'){
    const chars=[...text.replace(/\s+/g,'')].slice(0,12);
    const maxH=c.height-pad*2,maxW=c.width-pad*2;
    let fs=Math.min(150,Math.floor(maxH/Math.max(chars.length,1)*0.9),Math.floor(maxW*0.72));
    fs=Math.max(fs,40);x.font=`${cfg.weight} ${fs}px ${cfg.family}`;x.lineWidth=Math.max(10,fs*0.12);
    const step=Math.min(fs*0.98,maxH/Math.max(chars.length,1));const total=step*(chars.length-1);const start=c.height/2-total/2;
    chars.forEach((ch,i)=>{x.strokeText(ch,c.width/2,start+i*step);x.fillText(ch,c.width/2,start+i*step)});
  }else{
    const lines=splitBalanced(text);
    const fit=fitBlock(x,lines,cfg,c.width-pad*2,c.height-pad*2);
    x.font=`${cfg.weight} ${fit.size}px ${cfg.family}`;x.lineWidth=Math.max(10,fit.size*0.11);
    const totalH=fit.lineH*lines.length;const firstY=c.height/2-totalH/2+fit.lineH/2;
    lines.forEach((line,i)=>{const y=firstY+i*fit.lineH;x.strokeText(line,c.width/2,y);x.fillText(line,c.width/2,y)});
  }
  if(cfg.stamp){x.shadowColor='transparent';x.strokeStyle='#b91c1c';x.lineWidth=8;x.beginPath();x.roundRect(pad,pad,c.width-pad*2,c.height-pad*2,30);x.stroke()}
  x.restore();
}
function safetyCheck(raw){
  const text=String(raw||'').normalize('NFKC').trim();if(!text)return{level:'red',reason:'文字を入力してください'};
  const red=[/(?:https?:\/\/|www\.)/i,/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i,/(?:\+?81[- ]?)?0\d{1,4}[- ]?\d{1,4}[- ]?\d{3,4}/,/(?:パスワード|暗証番号|社外秘|機密|極秘|顧客情報|個人情報|口座番号|カード番号|社員番号|契約番号|注文番号)/,/(?:〒?\d{3}[-ー]\d{4})/];
  if(red.some(p=>p.test(text)))return{level:'red',reason:'個人情報・機密情報の可能性があります'};
  const yellow=[/\d{4,}/,/[A-Za-z]{2,}\d{2,}|\d{2,}[A-Za-z]{2,}/,/(?:株式会社|有限会社|合同会社|部署|部長|課長|担当者|取引先|クライアント|案件|見積|請求)/,/(?:[一-龯々]{2,8})(?:さん|様|くん|君|ちゃん|氏)/];
  if(yellow.some(p=>p.test(text)))return{level:'yellow',reason:'固有情報を含む可能性があります'};return{level:'green',reason:'公開可能な範囲と判定しました'};
}
function update(){drawStamp();const s=safetyCheck(input.value);safetyEl.className=`status ${s.level}`;safetyEl.textContent=`${s.level.toUpperCase()}：${s.reason}`}
function notify(msg){toast.textContent=msg;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2600)}
function downloadCanvas(c,name='chat-stamp.png'){const a=document.createElement('a');a.download=name;a.href=c.toDataURL('image/png');a.click()}
input.addEventListener('input',update);
document.querySelectorAll('[data-style]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-style]').forEach(x=>x.classList.remove('active'));b.classList.add('active');style=b.dataset.style;update()});
document.querySelectorAll('[data-layout]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-layout]').forEach(x=>x.classList.remove('active'));b.classList.add('active');layout=b.dataset.layout;update()});
document.getElementById('downloadBtn').onclick=()=>{drawStamp();downloadCanvas(canvas,`stamp-moke-${Date.now()}.png`)};

document.getElementById('publishBtn').onclick=async()=>{
  const s=safetyCheck(input.value);if(s.level!=='green'){notify('GREEN判定のスタンプだけ公開できます');return}if(!consent.checked){notify('公開への同意チェックが必要です');return}
  try{const r=await fetch('/api/chat-stamps',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:input.value,style,layout,consent:true})});const data=await r.json();if(!r.ok)throw new Error(data?.safety?.reason||data.error||'公開できません');localStorage.setItem(`chat-stamp-delete-${data.item.id}`,data.deleteToken);document.getElementById('deleteInfo').textContent='公開しました。この端末では、ギャラリーの「削除」ボタンから削除できます。';notify('公開しました');consent.checked=false;loadGallery()}catch(e){notify(e.message||'公開に失敗しました')}
};

function galleryCanvas(item){const c=document.createElement('canvas');c.width=640;c.height=640;drawStamp(c,item.text,item.style,item.layout);return c}
async function deleteItem(item){const token=localStorage.getItem(`chat-stamp-delete-${item.id}`);if(!token)return;try{const r=await fetch('/api/chat-stamps',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:item.id,deleteToken:token})});if(!r.ok)throw new Error('削除できませんでした');localStorage.removeItem(`chat-stamp-delete-${item.id}`);notify('削除しました');loadGallery()}catch(e){notify(e.message)}}
async function loadGallery(){const grid=document.getElementById('galleryGrid');grid.innerHTML='<div class="privacy">読み込み中...</div>';try{const r=await fetch('/api/chat-stamps');const data=await r.json();grid.innerHTML='';if(!data.items?.length){grid.innerHTML='<div class="privacy">まだ公開スタンプはありません。最初の1個を作ってみてください。</div>';return}data.items.forEach(item=>{const card=document.createElement('div');card.className='stamp-card';const c=galleryCanvas(item);card.appendChild(c);const meta=document.createElement('div');meta.className='stamp-meta';const dl=document.createElement('button');dl.className='mini';dl.textContent='PNG保存';dl.onclick=()=>downloadCanvas(c,`stamp-moke-${item.id}.png`);meta.appendChild(dl);const token=localStorage.getItem(`chat-stamp-delete-${item.id}`);if(token){const del=document.createElement('button');del.className='mini';del.textContent='削除';del.onclick=()=>deleteItem(item);meta.appendChild(del)}card.appendChild(meta);grid.appendChild(card)})}catch(e){grid.innerHTML='<div class="privacy">ギャラリーを読み込めませんでした。</div>'}}
document.getElementById('reloadBtn').onclick=loadGallery;update();loadGallery();
</script>
</body>
</html>