---
const title="社内チャットスタンプメーカー｜Slack・Teams・LINE WORKS向け無料作成 | stamp moke";
const description="Slack、Teams、LINE WORKSなどで使える文字スタンプを無料作成。フォント・色・縁取り・背景・エフェクト・行数・文字サイズ・字間・横比率・角度まで自由に編集。";
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><meta name="description" content={description}><link rel="canonical" href="https://stamp-moke.jp/chat-stamp-maker"><style>
:root{--ink:#171717;--muted:#6b7280;--line:#e5e7eb;--bg:#f7f7f5;--card:#fff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.wrap{max-width:1260px;margin:auto;padding:24px}.top{display:flex;justify-content:space-between;margin-bottom:22px}.brand,.back{color:var(--ink);font-weight:900;text-decoration:none}.hero,.card,.note{background:#fff;border:1px solid var(--line);border-radius:22px}.hero{padding:30px;margin-bottom:22px}.hero h1{font-size:clamp(30px,5vw,52px);line-height:1.08;margin:6px 0 12px}.hero p,.privacy{color:var(--muted);line-height:1.65}.badges,.row{display:flex;gap:8px;flex-wrap:wrap}.badge{border:1px solid var(--line);border-radius:999px;padding:7px 11px;font-size:12px;font-weight:800}.grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(380px,.92fr);gap:22px}.card{padding:22px}.field{margin-bottom:18px}.field>label{display:block;font-size:14px;font-weight:900;margin-bottom:8px}textarea,select,input[type=text]{width:100%;border:2px solid #d1d5db;border-radius:12px;padding:12px;font:inherit;font-size:18px}textarea{resize:vertical;min-height:76px}.choice{border:1px solid #d1d5db;background:#fff;border-radius:11px;padding:9px 12px;font-weight:800;cursor:pointer}.choice.active{background:#111827;color:#fff}.controls{display:grid;grid-template-columns:1fr 1fr;gap:12px}.control{border:1px solid var(--line);border-radius:14px;padding:12px}.control label{font-size:12px;font-weight:850;display:block;margin-bottom:7px}.colorrow{display:flex;gap:8px;align-items:center}.colorrow input[type=color]{width:52px;height:38px;border:0;padding:0;background:none}.colorrow input[type=text]{font-size:13px;padding:8px}.rangeval{font-size:12px;color:var(--muted);font-weight:800}.preview-shell{display:flex;align-items:center;justify-content:center;background:repeating-conic-gradient(#f8fafc 0 25%,#eef2f7 0 50%) 50%/24px 24px;border-radius:16px;border:1px solid var(--line);padding:8px;position:sticky;top:16px;min-height:520px}.preview-shell canvas{width:min(100%,640px);height:auto;aspect-ratio:1}.status{margin:15px 0;padding:11px 13px;border-radius:11px;font-size:13px;font-weight:800}.green{background:#ecfdf5;color:#15803d}.yellow{background:#fffbeb;color:#a16207}.red{background:#fef2f2;color:#b91c1c}.publishbox{margin-top:13px;padding:13px;background:#f8fafc;border-radius:12px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.btn{border:0;border-radius:12px;padding:13px;font-weight:900;cursor:pointer}.primary{background:#111827;color:#fff}.secondary{background:#eef2f7}.gallery{margin-top:28px}.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px}.stamp-card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:10px}.stamp-card canvas{width:100%;height:auto}.mini{border:0;border-radius:8px;padding:7px 9px;font-weight:800;cursor:pointer}.meta{display:flex;justify-content:space-between;margin-top:7px}.note{margin-top:26px;padding:18px}.toast{position:fixed;right:18px;bottom:18px;background:#111827;color:#fff;padding:12px 16px;border-radius:10px;display:none;z-index:9}.toast.show{display:block}@media(max-width:850px){.grid{grid-template-columns:1fr}.controls{grid-template-columns:1fr}.wrap{padding:13px}.preview-shell{position:static;min-height:360px}.actions{grid-template-columns:1fr}}
</style></head><body><main class="wrap"><div class="top"><a class="brand" href="/">stamp moke</a><a class="back" href="/">← サイトへ戻る</a></div><section class="hero"><b>FREE CHAT STAMP MAKER</b><h1>社内チャットで使える<br>文字スタンプを、自由に作る。</h1><p>文字・フォント・色・フチ・背景・エフェクト・行数に加え、文字サイズ・字間・横幅・角度・余白まで細かく調整できます。画像生成AIやGPTは使いません。</p><div class="badges"><span class="badge">AI不使用</span><span class="badge">640×640 PNG</span><span class="badge">10フォント</span><span class="badge">文字サイズ自由</span><span class="badge">字間・角度調整</span><span class="badge">公開は本人同意制</span></div></section>
<section class="grid"><div class="card"><h2>スタンプを作る</h2><div class="field"><label for="stampText">文字（改行もできます）</label><textarea id="stampText" maxlength="32">確認しました</textarea></div><div class="field"><label>プリセット</label><div class="row" id="styleChoices"><button class="choice active" data-style="business">ビジネス</button><button class="choice" data-style="pop">ポップ</button><button class="choice" data-style="stamp">ハンコ</button><button class="choice" data-style="bold">無骨</button><button class="choice" data-style="soft">やわらか</button><button class="choice" data-style="mono">白黒</button></div></div>
<div class="controls"><div class="control"><label>フォント</label><select id="font"><option value="gothic">極太ゴシック</option><option value="rounded">丸ゴシック</option><option value="mincho">明朝</option><option value="serif">筆・毛筆風</option><option value="hand">手書き風</option><option value="pop">ポップ</option><option value="retro">レトロ</option><option value="bold">無骨</option><option value="classic">クラシック</option><option value="casual">カジュアル</option></select></div><div class="control"><label>行数</label><select id="lineMode"><option value="auto">自動</option><option value="1">1行</option><option value="2">2行</option><option value="3">3行</option><option value="4">4行</option></select></div><div class="control"><label>文字方向</label><select id="layout"><option value="horizontal">横書き</option><option value="vertical">縦書き</option></select></div><div class="control"><label>エフェクト</label><select id="effect"><option value="none">なし</option><option value="shadow">影</option><option value="glow">発光</option><option value="depth">立体</option></select></div>
<div class="control"><label>文字サイズ <span id="fontScaleValue" class="rangeval">100%</span></label><input id="fontScale" type="range" min="60" max="160" value="100" style="width:100%"></div><div class="control"><label>文字間隔 <span id="letterSpacingValue" class="rangeval">0px</span></label><input id="letterSpacing" type="range" min="-12" max="42" value="0" style="width:100%"></div><div class="control"><label>文字の横比率 <span id="horizontalScaleValue" class="rangeval">100%</span></label><input id="horizontalScale" type="range" min="50" max="130" value="100" style="width:100%"></div><div class="control"><label>文字の角度 <span id="rotationValue" class="rangeval">0°</span></label><input id="rotation" type="range" min="-30" max="30" value="0" style="width:100%"></div><div class="control"><label>キャンバス余白 <span id="paddingValue" class="rangeval">5%</span></label><input id="padding" type="range" min="0" max="20" value="5" style="width:100%"><div class="privacy">0%で正方形いっぱいまで使用</div></div><div class="control"><label>ハンコ枠</label><select id="stampShape"><option value="rounded">角丸四角</option><option value="circle">正円</option></select></div>
<div class="control"><label>文字色</label><div class="colorrow"><input id="textColor" type="color" value="#111827"><input id="textHex" type="text" value="#111827" maxlength="7"></div></div><div class="control"><label>フチ色</label><div class="colorrow"><input id="strokeColor" type="color" value="#ffffff"><input id="strokeHex" type="text" value="#ffffff" maxlength="7"></div><label style="margin-top:8px"><input id="strokeEnabled" type="checkbox" checked> フチを付ける</label></div><div class="control"><label>フチの太さ <span id="strokeValue" class="rangeval">14</span></label><input id="strokeWidth" type="range" min="0" max="28" value="14" style="width:100%"></div><div class="control"><label>背景</label><select id="background"><option value="transparent">透明</option><option value="white">白</option><option value="color">好きな色</option></select><div class="colorrow" style="margin-top:8px"><input id="backgroundColor" type="color" value="#fff3f7"><input id="backgroundHex" type="text" value="#fff3f7" maxlength="7"></div></div></div>
<div id="safetyStatus" class="status green">GREEN：公開可能な範囲と判定しました</div><div class="privacy">非公開スタンプはサーバーへ保存しません。一般公開する場合のみ安全判定を再実行します。</div><div class="publishbox"><label><input id="publishConsent" type="checkbox"> このスタンプを「みんなのチャットスタンプ」に一般公開することに同意します。</label></div><div class="actions"><button id="downloadBtn" class="btn primary">PNGをダウンロード</button><button id="publishBtn" class="btn secondary">みんなに公開する</button></div><div id="deleteInfo" class="privacy"></div></div>
<div class="card"><h2>プレビュー</h2><div class="preview-shell"><canvas id="preview" width="640" height="640"></canvas></div><p class="privacy">背景透過対応・640×640px。余白0%ではキャンバスの端まで使えます。文字サイズを100%以上にすると、意図的にはみ出す表現も可能です。</p></div></section>
<section class="gallery"><div style="display:flex;justify-content:space-between;align-items:center"><div><b>PUBLIC GALLERY</b><h2>みんなのチャットスタンプ</h2></div><button id="reloadBtn" class="mini">更新</button></div><div id="galleryGrid" class="gallery-grid"></div></section><section class="note"><b>安全について：</b> 公開時はメールアドレス、電話番号、長い数字列、認証情報、機密関連語、固有情報らしい表現などをルールベースで検査します。自動判定は完全ではないため、公開前に必ず内容をご確認ください。</section></main><div id="toast" class="toast"></div>
<script>
const canvas=document.getElementById('preview'),input=document.getElementById('stampText'),safetyEl=document.getElementById('safetyStatus'),consent=document.getElementById('publishConsent'),toast=document.getElementById('toast');let style='business';
const fonts={gothic:{family:'"Arial Black","Noto Sans JP",sans-serif',weight:900},rounded:{family:'"Hiragino Maru Gothic ProN","Yu Gothic",sans-serif',weight:900},mincho:{family:'"Yu Mincho","Hiragino Mincho ProN",serif',weight:900},serif:{family:'"Yu Mincho",serif',weight:900},hand:{family:'"Comic Sans MS","Yu Gothic",sans-serif',weight:800},pop:{family:'"Arial Rounded MT Bold","Noto Sans JP",sans-serif',weight:900},retro:{family:'Impact,"Noto Sans JP",sans-serif',weight:900},bold:{family:'Impact,"Arial Black","Noto Sans JP",sans-serif',weight:900},classic:{family:'Georgia,"Yu Mincho",serif',weight:800},casual:{family:'"Trebuchet MS","Yu Gothic",sans-serif',weight:800}};
const presets={business:{font:'gothic',textColor:'#111827',strokeColor:'#ffffff',strokeWidth:14,effect:'none',background:'transparent',backgroundColor:'#ffffff',fontScale:100,letterSpacing:0,horizontalScale:100,rotation:0,padding:5,stampShape:'rounded'},pop:{font:'pop',textColor:'#ff4f87',strokeColor:'#ffffff',strokeWidth:16,effect:'shadow',background:'color',backgroundColor:'#fff3f7',fontScale:105,letterSpacing:1,horizontalScale:100,rotation:0,padding:5,stampShape:'rounded'},stamp:{font:'serif',textColor:'#b91c1c',strokeColor:'#ffffff',strokeWidth:8,effect:'none',background:'transparent',backgroundColor:'#ffffff',fontScale:92,letterSpacing:2,horizontalScale:100,rotation:0,padding:7,stampShape:'rounded'},bold:{font:'bold',textColor:'#111111',strokeColor:'#ffffff',strokeWidth:18,effect:'depth',background:'transparent',backgroundColor:'#ffffff',fontScale:108,letterSpacing:-1,horizontalScale:92,rotation:-2,padding:3,stampShape:'rounded'},soft:{font:'rounded',textColor:'#6d5c80',strokeColor:'#ffffff',strokeWidth:12,effect:'none',background:'color',backgroundColor:'#f6f1fb',fontScale:100,letterSpacing:1,horizontalScale:100,rotation:0,padding:6,stampShape:'rounded'},mono:{font:'gothic',textColor:'#ffffff',strokeColor:'#111111',strokeWidth:10,effect:'none',background:'color',backgroundColor:'#111111',fontScale:100,letterSpacing:0,horizontalScale:100,rotation:0,padding:4,stampShape:'rounded'}};
const $=id=>document.getElementById(id);function validHex(v){return /^#[0-9a-fA-F]{6}$/.test(v)}function syncPair(colorId,hexId){const c=$(colorId),h=$(hexId);c.oninput=()=>{h.value=c.value;update()};h.oninput=()=>{if(validHex(h.value)){c.value=h.value;update()}}}syncPair('textColor','textHex');syncPair('strokeColor','strokeHex');syncPair('backgroundColor','backgroundHex');
function settings(){return{lineMode:$('lineMode').value,font:$('font').value,textColor:$('textColor').value,strokeEnabled:$('strokeEnabled').checked,strokeColor:$('strokeColor').value,strokeWidth:Number($('strokeWidth').value),effect:$('effect').value,background:$('background').value,backgroundColor:$('backgroundColor').value,fontScale:Number($('fontScale').value),letterSpacing:Number($('letterSpacing').value),horizontalScale:Number($('horizontalScale').value),rotation:Number($('rotation').value),padding:Number($('padding').value),stampShape:$('stampShape').value}}
function applySettings(s){$('lineMode').value=s.lineMode||'auto';$('font').value=s.font||'gothic';$('textColor').value=s.textColor||'#111827';$('textHex').value=$('textColor').value;$('strokeEnabled').checked=s.strokeEnabled!==false;$('strokeColor').value=s.strokeColor||'#ffffff';$('strokeHex').value=$('strokeColor').value;$('strokeWidth').value=s.strokeWidth??14;$('effect').value=s.effect||'none';$('background').value=s.background||'transparent';$('backgroundColor').value=s.backgroundColor||'#fff3f7';$('backgroundHex').value=$('backgroundColor').value;$('fontScale').value=s.fontScale??100;$('letterSpacing').value=s.letterSpacing??0;$('horizontalScale').value=s.horizontalScale??100;$('rotation').value=s.rotation??0;$('padding').value=s.padding??5;$('stampShape').value=s.stampShape||'rounded';updateLabels()}
function balanced(text,mode){const manual=String(text).split('\n').map(x=>x.trim()).filter(Boolean);if(manual.length>1)return manual.slice(0,4);const chars=[...String(text).replace(/\s+/g,'')];let rows=mode==='auto'?(chars.length<=4?1:chars.length<=8?2:chars.length<=15?3:4):Number(mode);rows=Math.max(1,Math.min(4,rows));const base=Math.floor(chars.length/rows),extra=chars.length%rows;let i=0;return Array.from({length:rows},(_,r)=>{const n=base+(r<extra?1:0),v=chars.slice(i,i+n).join('');i+=n;return v}).filter(Boolean)}
function measureSpaced(x,text,spacing){const chars=[...text];return chars.reduce((w,ch)=>w+x.measureText(ch).width,0)+Math.max(0,chars.length-1)*spacing}
function fitBlock(x,lines,f,maxW,maxH,spacing,hScale){let size=270;while(size>30){x.font=`${f.weight} ${size}px ${f.family}`;const widest=Math.max(...lines.map(v=>measureSpaced(x,v,spacing)*(hScale/100))),lh=size*.98;if(widest<=maxW&&lh*lines.length<=maxH)return{size,lh};size-=2}return{size:30,lh:30}}
function drawSpaced(x,text,y,spacing,strokeEnabled,strokeWidth){const chars=[...text],width=measureSpaced(x,text,spacing),start=-width/2;let cur=start;chars.forEach(ch=>{const w=x.measureText(ch).width,px=cur+w/2;if(strokeEnabled&&strokeWidth>0)x.strokeText(ch,px,y);x.fillText(ch,px,y);cur+=w+spacing})}
function drawStamp(c=canvas,text=input.value.trim()||'確認しました',st=settings(),lay=$('layout').value){const x=c.getContext('2d'),f=fonts[st.font]||fonts.gothic,pad=Math.round(c.width*(Math.max(0,Math.min(20,st.padding??5))/100));x.clearRect(0,0,c.width,c.height);x.save();if(st.background!=='transparent'){x.fillStyle=st.background==='white'?'#ffffff':st.backgroundColor;x.fillRect(0,0,c.width,c.height)}x.textAlign='center';x.textBaseline='middle';x.lineJoin='round';x.fillStyle=st.textColor;x.strokeStyle=st.strokeColor;if(st.effect==='shadow'){x.shadowColor='rgba(0,0,0,.35)';x.shadowBlur=12;x.shadowOffsetX=7;x.shadowOffsetY=9}else if(st.effect==='glow'){x.shadowColor=st.textColor;x.shadowBlur=25}else if(st.effect==='depth'){x.shadowColor='rgba(0,0,0,.45)';x.shadowBlur=0;x.shadowOffsetX=10;x.shadowOffsetY=10}
if(lay==='vertical'){const chars=[...text.replace(/\s+/g,'')].slice(0,12),base=Math.max(34,Math.min(155,(c.height-pad*2)/Math.max(chars.length,1)*.9)),fs=base*((st.fontScale||100)/100);x.translate(c.width/2,c.height/2);x.rotate((st.rotation||0)*Math.PI/180);x.scale((st.horizontalScale||100)/100,1);x.font=`${f.weight} ${fs}px ${f.family}`;x.lineWidth=st.strokeEnabled?Math.min(st.strokeWidth,fs*.18):0;const step=Math.min(fs*.96+st.letterSpacing,(c.height-pad*2)/Math.max(chars.length,1)),start=-step*(chars.length-1)/2;chars.forEach((ch,i)=>{if(st.strokeEnabled&&st.strokeWidth>0)x.strokeText(ch,0,start+i*step);x.fillText(ch,0,start+i*step)})}else{const lines=balanced(text,st.lineMode),fit=fitBlock(x,lines,f,c.width-pad*2,c.height-pad*2,st.letterSpacing||0,st.horizontalScale||100),fs=fit.size*((st.fontScale||100)/100),lh=fit.lh*((st.fontScale||100)/100);x.translate(c.width/2,c.height/2);x.rotate((st.rotation||0)*Math.PI/180);x.scale((st.horizontalScale||100)/100,1);x.font=`${f.weight} ${fs}px ${f.family}`;x.lineWidth=st.strokeEnabled?Math.min(st.strokeWidth,fs*.2):0;const first=-lh*lines.length/2+lh/2;lines.forEach((line,i)=>drawSpaced(x,line,first+i*lh,st.letterSpacing||0,st.strokeEnabled,st.strokeWidth))}x.restore();
if(style==='stamp'){x.save();x.shadowColor='transparent';x.strokeStyle=st.textColor;x.lineWidth=7;if((st.stampShape||'rounded')==='circle'){const r=Math.max(10,Math.min(c.width,c.height)/2-pad-4);x.beginPath();x.arc(c.width/2,c.height/2,r,0,Math.PI*2);x.stroke()}else{x.beginPath();x.roundRect(pad,pad,c.width-pad*2,c.height-pad*2,Math.min(40,c.width*.06));x.stroke()}x.restore()}}
function safetyCheck(raw){const t=String(raw||'').normalize('NFKC').trim(),flat=t.replace(/\n/g,' ');if(!t)return{level:'red',reason:'文字を入力してください'};const red=[/(?:https?:\/\/|www\.)/i,/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i,/(?:パスワード|暗証番号|社外秘|機密|極秘|顧客情報|個人情報|口座番号|カード番号)/,/\d{8,}/];if(red.some(p=>p.test(flat)))return{level:'red',reason:'個人情報・機密情報の可能性があります'};const yellow=[/\d{4,}/,/(?:株式会社|有限会社|合同会社|担当者|取引先|クライアント)/];if(yellow.some(p=>p.test(flat)))return{level:'yellow',reason:'固有情報を含む可能性があります'};return{level:'green',reason:'公開可能な範囲と判定しました'}}
function updateLabels(){$('strokeValue').textContent=$('strokeWidth').value;$('fontScaleValue').textContent=`${$('fontScale').value}%`;$('letterSpacingValue').textContent=`${$('letterSpacing').value}px`;$('horizontalScaleValue').textContent=`${$('horizontalScale').value}%`;$('rotationValue').textContent=`${$('rotation').value}°`;$('paddingValue').textContent=`${$('padding').value}%`}
function update(){updateLabels();drawStamp();const s=safetyCheck(input.value);safetyEl.className=`status ${s.level}`;safetyEl.textContent=`${s.level.toUpperCase()}：${s.reason}`}function notify(m){toast.textContent=m;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2500)}function download(c,n){const a=document.createElement('a');a.download=n;a.href=c.toDataURL('image/png');a.click()}
input.oninput=update;['font','lineMode','layout','effect','background','strokeWidth','strokeEnabled','fontScale','letterSpacing','horizontalScale','rotation','padding','stampShape'].forEach(id=>$(id).addEventListener('input',update));document.querySelectorAll('[data-style]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-style]').forEach(x=>x.classList.remove('active'));b.classList.add('active');style=b.dataset.style;applySettings({...presets[style],lineMode:$('lineMode').value,strokeEnabled:true});update()});$('downloadBtn').onclick=()=>{drawStamp();download(canvas,`stamp-moke-${Date.now()}.png`)};
$('publishBtn').onclick=async()=>{const safe=safetyCheck(input.value);if(safe.level!=='green')return notify('GREEN判定のスタンプだけ公開できます');if(!consent.checked)return notify('公開への同意チェックが必要です');try{const r=await fetch('/api/chat-stamps',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:input.value,style,layout:$('layout').value,settings:settings(),consent:true})}),d=await r.json();if(!r.ok)throw new Error(d?.safety?.reason||d.error||'公開できません');localStorage.setItem(`chat-stamp-delete-${d.item.id}`,d.deleteToken);$('deleteInfo').textContent='公開しました。この端末から削除できます。';consent.checked=false;notify('公開しました');loadGallery()}catch(e){notify(e.message)}};
function galleryCanvas(item){const c=document.createElement('canvas');c.width=c.height=640;const oldStyle=style;style=item.style||'business';drawStamp(c,item.text,item.settings||presets[item.style]||presets.business,item.layout||'horizontal');style=oldStyle;return c}async function del(item){const token=localStorage.getItem(`chat-stamp-delete-${item.id}`);if(!token)return;const r=await fetch('/api/chat-stamps',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:item.id,deleteToken:token})});if(r.ok){localStorage.removeItem(`chat-stamp-delete-${item.id}`);notify('削除しました');loadGallery()}}
async function loadGallery(){const g=$('galleryGrid');g.innerHTML='<div class="privacy">読み込み中...</div>';try{const r=await fetch('/api/chat-stamps'),d=await r.json();g.innerHTML='';if(!d.items?.length){g.innerHTML='<div class="privacy">まだ公開スタンプはありません。</div>';return}d.items.forEach(item=>{const card=document.createElement('div');card.className='stamp-card';const c=galleryCanvas(item);card.appendChild(c);const meta=document.createElement('div');meta.className='meta';const dl=document.createElement('button');dl.className='mini';dl.textContent='PNG保存';dl.onclick=()=>download(c,`stamp-moke-${item.id}.png`);meta.appendChild(dl);if(localStorage.getItem(`chat-stamp-delete-${item.id}`)){const b=document.createElement('button');b.className='mini';b.textContent='削除';b.onclick=()=>del(item);meta.appendChild(b)}card.appendChild(meta);g.appendChild(card)})}catch(e){g.innerHTML='<div class="privacy">ギャラリーを読み込めませんでした。</div>'}}$('reloadBtn').onclick=loadGallery;update();loadGallery();
</script></body></html>