---
import SiteHeader from "../../../components/SiteHeader.astro";
import { LOCALES, localeInfo } from "../../../lib/i18n";

const slugs=["date-calculator","gross-profit","text-counter","dedupe-lines","postal-code","mojibake","password-generator","html-entities","age-table","text-sort","sku-generator","zenkaku-hankaku","trim-spaces","tax-calculator","price-change-rate","roas","roi","marketing-kpi"];
const locales=LOCALES.filter(x=>x!=="ja");
export function getStaticPaths(){return locales.flatMap(locale=>slugs.map(slug=>({params:{locale,slug},props:{locale,slug}})));}
const {locale,slug}=Astro.props;
const prefix=`/${locale}`;
const C={
 en:{back:"Free Tools",eyebrow:"FREE BUSINESS TOOL",copy:"Copy result",copied:"Copied!",run:"Calculate",input:"Input",result:"Result",titles:{"date-calculator":"Date Calculator","gross-profit":"Gross Profit Calculator","text-counter":"Character & Line Counter","dedupe-lines":"Remove Duplicate Lines","postal-code":"Japanese Postal Code Lookup","mojibake":"Mojibake Fixer","password-generator":"Password Generator","html-entities":"HTML Entity Encoder / Decoder","age-table":"Age / Year Quick Table","text-sort":"Text Sort","sku-generator":"Sequential SKU Generator","zenkaku-hankaku":"Full-width to Half-width","trim-spaces":"Remove Extra Spaces","tax-calculator":"Tax Included / Excluded Calculator","price-change-rate":"Price Increase / Decrease Rate","roas":"ROAS Calculator","roi":"ROI Calculator","marketing-kpi":"CPA / CVR / CTR Calculator"}},
 "zh-tw":{back:"免費工具",eyebrow:"免費商務工具",copy:"複製結果",copied:"已複製！",run:"計算",input:"輸入",result:"結果",titles:{"date-calculator":"日期計算工具","gross-profit":"毛利計算工具","text-counter":"字數・行數計算","dedupe-lines":"刪除重複行","postal-code":"日本郵遞區號查詢","mojibake":"亂碼修復","password-generator":"密碼產生器","html-entities":"HTML實體編碼・解碼","age-table":"年齡速查表","text-sort":"文字排序工具","sku-generator":"連號SKU產生器","zenkaku-hankaku":"全形英數轉半形","trim-spaces":"刪除多餘空格","tax-calculator":"含稅・未稅計算","price-change-rate":"漲價・降價率計算","roas":"ROAS計算工具","roi":"ROI計算工具","marketing-kpi":"CPA・CVR・CTR計算"}},
 th:{back:"เครื่องมือฟรี",eyebrow:"เครื่องมือธุรกิจฟรี",copy:"คัดลอกผลลัพธ์",copied:"คัดลอกแล้ว!",run:"คำนวณ",input:"ข้อมูล",result:"ผลลัพธ์",titles:{"date-calculator":"เครื่องคำนวณวันที่","gross-profit":"เครื่องคำนวณกำไรขั้นต้น","text-counter":"นับตัวอักษรและบรรทัด","dedupe-lines":"ลบบรรทัดซ้ำ","postal-code":"ค้นหารหัสไปรษณีย์ญี่ปุ่น","mojibake":"แก้ข้อความเพี้ยน","password-generator":"สร้างรหัสผ่าน","html-entities":"เข้ารหัส / ถอดรหัส HTML Entity","age-table":"ตารางอายุแบบรวดเร็ว","text-sort":"เรียงข้อความ","sku-generator":"สร้าง SKU แบบเลขลำดับ","zenkaku-hankaku":"แปลงตัวเต็มเป็นครึ่งความกว้าง","trim-spaces":"ลบช่องว่างเกิน","tax-calculator":"คำนวณราคารวม / ไม่รวมภาษี","price-change-rate":"คำนวณอัตราขึ้น / ลดราคา","roas":"คำนวณ ROAS","roi":"คำนวณ ROI","marketing-kpi":"คำนวณ CPA / CVR / CTR"}},
 id:{back:"Alat Gratis",eyebrow:"ALAT BISNIS GRATIS",copy:"Salin hasil",copied:"Tersalin!",run:"Hitung",input:"Input",result:"Hasil",titles:{"date-calculator":"Kalkulator Tanggal","gross-profit":"Kalkulator Laba Kotor","text-counter":"Penghitung Karakter & Baris","dedupe-lines":"Hapus Baris Duplikat","postal-code":"Pencarian Kode Pos Jepang","mojibake":"Perbaiki Teks Rusak","password-generator":"Generator Kata Sandi","html-entities":"Encode / Decode HTML Entity","age-table":"Tabel Umur Cepat","text-sort":"Urutkan Teks","sku-generator":"Generator SKU Berurutan","zenkaku-hankaku":"Lebar Penuh ke Setengah","trim-spaces":"Hapus Spasi Berlebih","tax-calculator":"Kalkulator Pajak Termasuk / Tidak","price-change-rate":"Persentase Naik / Turun Harga","roas":"Kalkulator ROAS","roi":"Kalkulator ROI","marketing-kpi":"Kalkulator CPA / CVR / CTR"}}
}[locale];
const title=C.titles[slug]||slug;
---
<!doctype html><html lang={localeInfo[locale].htmlLang}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title} | stamp moke</title><link rel="icon" href="/favicon.svg?v=20260902" type="image/svg+xml"><link rel="shortcut icon" href="/favicon.ico?v=20260902"><link rel="canonical" href={`https://stamp-moke.jp${prefix}/tools/${slug}/`}><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:840px;margin:auto;padding:28px 16px 84px}.crumb{font-size:12px;margin:8px 0 22px}.crumb a{color:#555}.hero{margin-bottom:20px}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.16em;color:#888}.hero h1{font-size:clamp(30px,7vw,46px);margin:8px 0}.toolbox{background:#fff;border:1px solid #ddd;border-radius:22px;padding:20px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{margin-bottom:14px}.field label{display:block;font-weight:800;font-size:13px;margin-bottom:7px}.field input,.field textarea,.field select{width:100%;min-height:56px;border:1px solid #d8d8d3;border-radius:14px;padding:13px 14px;font-size:18px;background:white;color:#171717}.field textarea{min-height:170px;resize:vertical}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}.metric{border:1px solid #e2e2dd;border-radius:16px;padding:14px;background:#fafaf8}.metric small{display:block;color:#777;font-size:11px}.metric strong{display:block;font-size:25px;margin-top:5px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}.btn{min-height:50px;border:0;border-radius:14px;background:#171717;color:white;padding:0 18px;font-size:16px;font-weight:800}.btn.sub{background:#ecebe6;color:#222}.result{margin-top:16px;background:#f1f0ec;border-radius:16px;padding:16px;min-height:64px;font-size:17px;line-height:1.7}.check{display:flex;gap:16px;flex-wrap:wrap;font-size:14px}.age{max-height:460px;overflow:auto}.age table{width:100%;border-collapse:collapse}.age th,.age td{padding:9px;border-bottom:1px solid #eee;text-align:left}.copyStatus{font-size:12px;color:#666;margin-top:8px}@media(max-width:650px){.wrap{padding:20px 11px 70px}.toolbox{padding:14px}.grid,.metrics{grid-template-columns:1fr}.field input,.field textarea,.field select{font-size:18px!important}.hero h1{font-size:34px}.metric strong{font-size:26px}}</style></head><body><SiteHeader locale={locale}/><main class="wrap"><div class="crumb"><a href={`${prefix}/tools/`}>{C.back}</a> / {title}</div><section class="hero"><div class="eyebrow">{C.eyebrow} / stamp moke</div><h1>{title}</h1></section><section id="app" class="toolbox" data-slug={slug} data-copy={C.copy} data-copied={C.copied} data-run={C.run} data-input={C.input} data-result={C.result}></section></main><script is:inline>
(()=>{const a=document.getElementById('app'),s=a.dataset.slug,T=a.dataset,$=id=>document.getElementById(id),n=id=>Number($(id)?.value||0),fmt=x=>new Intl.NumberFormat(undefined,{maximumFractionDigits:2}).format(x),cp=async t=>{try{await navigator.clipboard.writeText(t)}catch{};const z=$('copyStatus');if(z)z.textContent=T.copied},bind=f=>a.querySelectorAll('input,textarea,select').forEach(e=>e.addEventListener('input',f)),copyBtn=()=>`<div class="actions"><button class="btn sub" id="copyBtn">${T.copy}</button></div><div class="copyStatus" id="copyStatus"></div>`;
if(s==='gross-profit'){a.innerHTML=`<div class="grid"><div class="field"><label>Sales</label><input id="sales" type="number" value="10000"></div><div class="field"><label>Cost</label><input id="cost" type="number" value="6000"></div></div><div class="metrics"><div class="metric"><small>Gross profit</small><strong id="m1"></strong></div><div class="metric"><small>Margin</small><strong id="m2"></strong></div><div class="metric"><small>Cost ratio</small><strong id="m3"></strong></div></div>${copyBtn()}`;let text='';const f=()=>{let x=n('sales'),c=n('cost'),g=x-c;$('m1').textContent=fmt(g);$('m2').textContent=x?fmt(g/x*100)+'%':'-';$('m3').textContent=x?fmt(c/x*100)+'%':'-';text=`Gross profit: ${fmt(g)} / Margin: ${x?fmt(g/x*100):0}% / Cost ratio: ${x?fmt(c/x*100):0}%`};bind(f);f();$('copyBtn').onclick=()=>cp(text)}
else if(s==='roas'||s==='roi'||s==='price-change-rate'){const isR=s==='roas',isI=s==='roi';a.innerHTML=`<div class="grid"><div class="field"><label>${isR?'Revenue':isI?'Profit':'Before'}</label><input id="x" type="number" value="${isR?500000:isI?150000:1000}"></div><div class="field"><label>${isR?'Ad cost':isI?'Investment':'After'}</label><input id="y" type="number" value="${isR||isI?100000:1200}"></div></div><div class="metrics"><div class="metric"><small>${isR?'ROAS':isI?'ROI':'Rate'}</small><strong id="m1"></strong></div><div class="metric"><small>${isR?'Multiple':isI?'Profit':'Difference'}</small><strong id="m2"></strong></div></div>${copyBtn()}`;let text='';const f=()=>{let x=n('x'),y=n('y');if(isR){$('m1').textContent=y?fmt(x/y*100)+'%':'-';$('m2').textContent=y?fmt(x/y)+'×':'-';text=`ROAS: ${y?fmt(x/y*100):0}%`}else if(isI){$('m1').textContent=y?fmt(x/y*100)+'%':'-';$('m2').textContent=fmt(x);text=`ROI: ${y?fmt(x/y*100):0}%`}else{let d=y-x;$('m1').textContent=x?fmt(d/x*100)+'%':'-';$('m2').textContent=fmt(d);text=`Change: ${x?fmt(d/x*100):0}% / Difference: ${fmt(d)}`}};bind(f);f();$('copyBtn').onclick=()=>cp(text)}
else if(s==='marketing-kpi'){a.innerHTML=`<div class="grid"><div class="field"><label>Ad cost</label><input id="cost" type="number" value="100000"></div><div class="field"><label>Impressions</label><input id="imp" type="number" value="100000"></div><div class="field"><label>Clicks</label><input id="click" type="number" value="2000"></div><div class="field"><label>Conversions</label><input id="cv" type="number" value="100"></div></div><div class="metrics"><div class="metric"><small>CPA</small><strong id="m1"></strong></div><div class="metric"><small>CVR</small><strong id="m2"></strong></div><div class="metric"><small>CTR</small><strong id="m3"></strong></div></div>${copyBtn()}`;let text='';const f=()=>{let c=n('cost'),i=n('imp'),cl=n('click'),v=n('cv');$('m1').textContent=v?fmt(c/v):'-';$('m2').textContent=cl?fmt(v/cl*100)+'%':'-';$('m3').textContent=i?fmt(cl/i*100)+'%':'-';text=`CPA: ${v?fmt(c/v):0} / CVR: ${cl?fmt(v/cl*100):0}% / CTR: ${i?fmt(cl/i*100):0}%`};bind(f);f();$('copyBtn').onclick=()=>cp(text)}
else if(s==='tax-calculator'){a.innerHTML=`<div class="grid"><div class="field"><label>Amount</label><input id="amount" type="number" value="1000"></div><div class="field"><label>Tax rate</label><select id="rate"><option value="10">10%</option><option value="8">8%</option></select></div></div><div class="metrics"><div class="metric"><small>Tax included</small><strong id="m1"></strong></div><div class="metric"><small>Tax excluded</small><strong id="m2"></strong></div><div class="metric"><small>Tax</small><strong id="m3"></strong></div></div>${copyBtn()}`;let text='';const f=()=>{let x=n('amount'),r=n('rate')/100,inc=Math.round(x*(1+r)),exc=Math.round(x/(1+r));$('m1').textContent=fmt(inc);$('m2').textContent=fmt(exc);$('m3').textContent=fmt(inc-x);text=`Tax included: ${fmt(inc)} / Tax excluded: ${fmt(exc)} / Tax: ${fmt(inc-x)}`};bind(f);f();$('copyBtn').onclick=()=>cp(text)}
else if(s==='text-counter'){a.innerHTML=`<div class="field"><label>${T.input}</label><textarea id="text"></textarea></div><div class="metrics"><div class="metric"><small>Characters</small><strong id="m1">0</strong></div><div class="metric"><small>No spaces</small><strong id="m2">0</strong></div><div class="metric"><small>Lines</small><strong id="m3">0</strong></div></div>${copyBtn()}`;let out='';const f=()=>{let x=$('text').value;$('m1').textContent=x.length;$('m2').textContent=x.replace(/\s/g,'').length;$('m3').textContent=x?x.split(/\r?\n/).length:0;out=`Characters: ${x.length} / No spaces: ${x.replace(/\s/g,'').length} / Lines: ${x?x.split(/\r?\n/).length:0}`};$('text').oninput=f;f();$('copyBtn').onclick=()=>cp(out)}
else if(s==='password-generator'){a.innerHTML=`<div class="grid"><div class="field"><label>Length</label><input id="len" type="number" value="20"></div><div class="field"><label>Count</label><input id="cnt" type="number" value="5"></div></div><div class="actions"><button id="run" class="btn">${T.run}</button></div><div class="field"><label>${T.result}</label><textarea id="out" readonly></textarea></div>${copyBtn()}`;const f=()=>{const chars='abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#$%&*+-_=?';let rows=[];for(let k=0;k<Math.min(20,n('cnt'));k++){let u=new Uint32Array(Math.min(128,n('len')));crypto.getRandomValues(u);rows.push([...u].map(x=>chars[x%chars.length]).join(''))}$('out').value=rows.join('\n')};$('run').onclick=f;f();$('copyBtn').onclick=()=>cp($('out').value)}
else if(s==='date-calculator'){a.innerHTML=`<div class="grid"><div class="field"><label>Base date</label><input id="base" type="date"></div><div class="field"><label>Days (+ / -)</label><input id="days" type="number" value="30"></div></div><div class="result" id="result"></div>${copyBtn()}`;$('base').value=new Date().toISOString().slice(0,10);let text='';const f=()=>{let d=new Date($('base').value+'T00:00:00');d.setDate(d.getDate()+n('days'));text=d.toLocaleDateString(localeInfo?.htmlLang||undefined);$('result').textContent=text};bind(f);f();$('copyBtn').onclick=()=>cp(text)}
else if(s==='age-table'){a.innerHTML=`<div class="field"><label>Reference year</label><input id="year" type="number" value="${new Date().getFullYear()}"></div><div class="age"><table><thead><tr><th>Age</th><th>Year</th></tr></thead><tbody id="tb"></tbody></table></div>`;const f=()=>{$('tb').innerHTML=Array.from({length:101},(_,age)=>`<tr><td>${age}</td><td>${n('year')-age}</td></tr>`).join('')};bind(f);f()}
else {const isD=s==='dedupe-lines',isS=s==='text-sort',isZ=s==='zenkaku-hankaku',isT=s==='trim-spaces',isH=s==='html-entities',isM=s==='mojibake',isSku=s==='sku-generator',isPost=s==='postal-code';if(isSku){a.innerHTML=`<div class="grid"><div class="field"><label>Prefix</label><input id="pre" value="ITEM-"></div><div class="field"><label>Start</label><input id="start" type="number" value="1"></div><div class="field"><label>Digits</label><input id="digits" type="number" value="4"></div><div class="field"><label>Count</label><input id="cnt" type="number" value="20"></div></div><div class="field"><label>${T.result}</label><textarea id="out" readonly></textarea></div>${copyBtn()}`;const f=()=>{$('out').value=Array.from({length:Math.min(1000,n('cnt'))},(_,i)=>$('pre').value+String(n('start')+i).padStart(n('digits'),'0')).join('\n')};bind(f);f();$('copyBtn').onclick=()=>cp($('out').value)}else if(isPost){a.innerHTML=`<div class="field"><label>Postal code (Japan)</label><input id="zip" inputmode="numeric" placeholder="1600023"></div><div class="actions"><button class="btn" id="run">Search</button></div><div class="result" id="result"></div>${copyBtn()}`;let text='';$('run').onclick=async()=>{let z=$('zip').value.replace(/\D/g,'');$('result').textContent='…';try{let r=await fetch(`https://postcode.teraren.com/postcodes/${z}.json`),d=await r.json();text=`〒${d.new||z} ${d.prefecture||''}${d.city||''}${d.suburb||''}`;$('result').textContent=text}catch{$('result').textContent='Not found'}};$('copyBtn').onclick=()=>cp(text)}else{a.innerHTML=`<div class="grid"><div class="field"><label>${T.input}</label><textarea id="text"></textarea></div><div class="field"><label>${T.result}</label><textarea id="out" readonly></textarea></div></div><div class="actions">${isS?'<button class="btn" id="run">Sort</button>':'<button class="btn" id="run">Convert</button>'}</div>${copyBtn()}`;$('run').onclick=()=>{let x=$('text').value;if(isD)x=[...new Set(x.split(/\r?\n/))].join('\n');else if(isS)x=x.split(/\r?\n/).sort((a,b)=>a.localeCompare(b)).join('\n');else if(isZ)x=x.replace(/[！-～]/g,c=>String.fromCharCode(c.charCodeAt(0)-0xFEE0)).replace(/　/g,' ');else if(isT)x=x.split(/\r?\n/).map(r=>r.trim().replace(/[ \t　]+/g,' ')).join('\n');else if(isH)x=x.replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]));else if(isM){try{x=new TextDecoder('utf-8').decode(Uint8Array.from([...x].map(c=>c.charCodeAt(0)&255)))}catch{}}$('out').value=x};$('copyBtn').onclick=()=>cp($('out').value)}}}
})();
</script></body></html>