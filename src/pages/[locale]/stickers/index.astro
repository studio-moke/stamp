---
import LocalizedStickerListPage from "../../../components/LocalizedStickerListPage.astro";
import { LOCALES } from "../../../lib/i18n";
export function getStaticPaths(){return LOCALES.filter(locale=>locale!=="ja").map(locale=>({params:{locale},props:{locale}}));}
const {locale}=Astro.props;
---
<LocalizedStickerListPage locale={locale} />
