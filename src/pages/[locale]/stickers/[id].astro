---
import stickers from "../../../data/stickers.json";
import Analytics from "../../../components/Analytics.astro";
import SeoHead from "../../../components/SeoHead.astro";
import LanguageSwitcher from "../../../components/LanguageSwitcher.astro";
import { LOCALES, categoryLabels, localeInfo, localizedPath, localizeLineUrl, messages, normalizeLocale } from "../../../lib/i18n";
import { absoluteUrl } from "../../../lib/seo";
import { getCategory } from "../../../lib/stickers";
import { safeStickerDescription, safeStickerPrice, safeStickerTitle } from "../../../lib/sticker-content-safe";

export function getStaticPaths(){return LOCALES.filter(locale=>locale!=="ja").flatMap(locale=>stickers.map(sticker=>({params:{locale,id:String(sticker.id)},props:{locale,sticker}})));}
const {locale:localeProp,sticker}=Astro.props;
const locale=normalizeLocale(localeProp);
const t=messages[locale];
const titleText=safeStickerTitle(sticker,locale);
const description=safeStickerDescription(sticker,locale)||t.siteDescription;
const price=safeStickerPrice(sticker.price,locale);
const category=getCategory(sticker);
const categoryText=categoryLabels[locale]?.[category]||category;
const purchaseUrl=localizeLineUrl(sticker.purchaseUrl||sticker.url,locale);
const pagePath=`/stickers/${sticker.id}/`;
const canonical=absoluteUrl(localizedPath(locale,pagePath));
const copy={en:{back:"Back to sticker collection",buy:"Buy on LINE STORE",category:"Category",price:"Price",related:"More LINE stickers"},"zh-tw":{back:"返回貼圖列表",buy:"前往LINE STORE購買",category:"分類",price:"價格",related:"更多LINE貼圖"},"zh-cn":{back:"返回贴图列表",buy:"前往LINE STORE购买",category:"分类",price:"价格",related:"更多LINE贴图"},ko:{back:"스티커 목록으로",buy:"LINE STORE에서 구매",category:"카테고리",price:"가격",related:"다른 LINE 스티커"},th:{back:"กลับไปรวมสติกเกอร์",buy:"ซื้อบน LINE STORE",category:"หมวดหมู่",price:"ราคา",related:"สติกเกอร์ LINE เพิ่มเติม"},id:{back:"Kembali ke koleksi stiker",buy:"Beli di LINE STORE",category:"Kategori",price:"Harga",related:"Stiker LINE lainnya"}}[locale];
const related=stickers.filter(item=>item.id!==sticker.id&&getCategory(item)===category).slice(0,6);
---
<!doctype html><html lang={localeInfo[locale].htmlLang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/><title>{titleText} | LINE Stickers | stamp moke</title><SeoHead title={`${titleText} | LINE Stickers | stamp moke`} description={description} canonical={canonical} image={sticker.image} type="article" locale={locale} path={pagePath}/><Analytics/><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"stamp moke","item":absoluteUrl(localizedPath(locale,"/"))},{"@type":"ListItem","position":2,"name":t.stickers,"item":absoluteUrl(localizedPath(locale,"/stickers/"))},{"@type":"ListItem","position":3,"name":titleText,"item":canonical}]})}/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}a{color:inherit}.header{min-height:86px;background:#fff;border-bottom:1px solid #e4e3df;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 5vw;position:sticky;top:0;z-index:20}.brand{text-decoration:none}.brand-title{font-size:21px;font-weight:900;letter-spacing:.1em}.brand-sub{margin-top:6px;font-size:11px;color:#777}.actions{display:flex;align-items:center;gap:9px}.back{padding:11px 16px;border:1px solid #d9d8d4;border-radius:999px;text-decoration:none;font-size:12px;font-weight:800}.main{max-width:1080px;margin:0 auto;padding:48px 5vw 100px}.crumb{font-size:12px;color:#777;margin-bottom:28px}.crumb a{text-decoration:none}.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:46px;align-items:start}.image-wrap{aspect-ratio:1;background:#7696c4;border-radius:24px;overflow:hidden}.image{width:100%;height:100%;object-fit:contain;padding:24px}.eyebrow{font-size:10px;letter-spacing:.18em;color:#777;margin-bottom:12px}.title{margin:0;font-size:clamp(32px,5vw,54px);line-height:1.12;font-weight:900;letter-spacing:-.035em}.desc{margin:22px 0 0;color:#666;font-size:14px;line-height:1.9}.meta{margin-top:28px;border-top:1px solid #ddd}.row{display:flex;justify-content:space-between;gap:20px;padding:14px 0;border-bottom:1px solid #e5e4df;font-size:13px}.row span:first-child{color:#777}.buy{display:inline-flex;margin-top:28px;padding:14px 22px;background:#161616;color:#fff;border-radius:999px;text-decoration:none;font-size:13px;font-weight:800}.related{margin-top:90px}.related h2{font-size:28px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{background:#fff;border:1px solid #e3e2de;border-radius:16px;overflow:hidden;text-decoration:none}.card img{width:100%;aspect-ratio:1;object-fit:contain;background:#7696c4;padding:12px}.card div{padding:13px;font-size:13px;font-weight:800;line-height:1.45}.footer{padding:40px 5vw;background:#181818;color:#888;text-align:center;font-size:11px}@media(max-width:720px){.header{min-height:72px;padding:10px 18px}.back{display:none}.main{padding:28px 18px 70px}.hero{grid-template-columns:1fr;gap:28px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.title{font-size:34px}}</style></head><body><header class="header"><a class="brand" href={localizedPath(locale,"/")}><div class="brand-title">stamp moke</div><div class="brand-sub">{t.brandSub}</div></a><div class="actions"><LanguageSwitcher locale={locale} path={pagePath}/><a class="back" href={localizedPath(locale,"/stickers/")}>{copy.back}</a></div></header><main class="main"><div class="crumb"><a href={localizedPath(locale,"/")}>stamp moke</a> / <a href={localizedPath(locale,"/stickers/")}>{t.stickers}</a> / {titleText}</div><div class="hero"><div class="image-wrap"><img class="image" src={sticker.image} alt={titleText}/></div><div><div class="eyebrow">LINE STICKER</div><h1 class="title">{titleText}</h1><p class="desc">{description}</p><div class="meta"><div class="row"><span>{copy.category}</span><strong>{categoryText}</strong></div>{price&&<div class="row"><span>{copy.price}</span><strong>{price}</strong></div>}</div><a class="buy" href={purchaseUrl} target="_blank" rel="noopener noreferrer">{copy.buy} ↗</a></div></div>{related.length>0&&<section class="related"><h2>{copy.related}</h2><div class="grid">{related.map(item=><a class="card" href={localizedPath(locale,`/stickers/${item.id}/`)}><img src={item.image} alt={safeStickerTitle(item,locale)} loading="lazy"/><div>{safeStickerTitle(item,locale)}</div></a>)}</div></section>}</main><footer class="footer">© stamp moke</footer></body></html>