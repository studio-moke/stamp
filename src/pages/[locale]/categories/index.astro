---
import LocalizedCategoriesPage from "../../../components/LocalizedCategoriesPage.astro";
import { LOCALES } from "../../../lib/i18n";
export function getStaticPaths(){return LOCALES.filter(locale=>locale!=="ja").map(locale=>({params:{locale},props:{locale}}));}
const {locale}=Astro.props;
---
<LocalizedCategoriesPage locale={locale} />
