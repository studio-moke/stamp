---
import LocalizedToolsHubPage from "../../components/LocalizedToolsHubPage.astro";
import { LOCALES } from "../../lib/i18n";
export function getStaticPaths(){return LOCALES.filter(locale=>locale!=="ja").map(locale=>({params:{locale},props:{locale}}));}
const locale=Astro.props.locale;
---
<LocalizedToolsHubPage locale={locale} />
