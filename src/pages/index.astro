---
import stickers from "../data/stickers.json";
import suzuriDesigns from "../data/suzuri-designs.json";
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { localeInfo, localizedPath, messages, normalizeLocale } from "../lib/i18n";
import { absoluteUrl } from "../lib/seo";
import { localizedStickerDescription, localizedStickerPrice, localizedStickerTitle } from "../lib/sticker-content";

const locale = normalizeLocale(Astro.props.locale);
const t = messages[locale];
const siteTitle = t.siteTitle;
const siteDescription = t.siteDescription;
const canonical = absoluteUrl(localizedPath(locale, "/"));

function getCategory(sticker) {
  const text = `${sticker.title || ""} ${sticker.description || ""}`;
  if (/博多|福岡|筑後|方言|関西弁|九州弁/.test(text)) return "方言";
  if (/猫|ねこ|ネコ|犬|いぬ|イヌ|柴犬|コーギー|ポメラニアン|うさぎ|ウサギ|兎|くま|クマ|パンダ|鳥|すずめ|ペンギン|アザラシ|猿|サル|タヌキ|たぬき|ねずみ|動物/.test(text)) return "動物";
  if (/ハート|恋|恋愛|カップル|彼氏|彼女|好き|愛/.test(text)) return "恋愛";
  if (/仕事|ビジネス|敬語|丁寧|会社|職場|マーケター|バイト|働く/.test(text)) return "仕事";
  if (/食べ物|料理|ごはん|肉まん|ビール|お酒|ジョッキ|パン|ケーキ|お菓子/.test(text)) return "食べ物";
  if (/面白|おもしろ|ネタ|シュール|ギャグ|ツッコミ|あるある|ウザい|正論|本音/.test(text)) return "おもしろ";
  if (/挨拶|ありがとう|おはよう|こんにちは|こんばんは|おやすみ|よろしく|おつかれ/.test(text)) return "あいさつ";
  if (/かわいい|可愛い|キュート|癒し|ほんわか|ゆるかわ|もふもふ/.test(text)) return "かわいい";
  if (/日常|毎日|返信|返事|会話|リアクション|気持ち/.test(text)) return "日常";
  return "その他";
}

const categorizedStickers = stickers.map((sticker) => ({ ...sticker, category: getCategory(sticker), localizedTitle: localizedStickerTitle(sticker, locale), localizedDescription: localizedStickerDescription(sticker, locale), localizedPrice: localizedStickerPrice(sticker.price, locale) }));
function pickForHero(categories, offset = 0) { const selected = categorizedStickers.filter((sticker) => categories.includes(sticker.category)); const pool = selected.length >= 8 ? selected : categorizedStickers; return Array.from({ length: Math.min(8, pool.length) }, (_, index) => pool[(index + offset) % pool.length]); }
const heroSlides = [
  { label: "NEW ARRIVALS", title: t.heroTitles[0], accent: "#ffd86b", stickers: categorizedStickers.slice(0, 8) },
  { label: "CUTE & ANIMALS", title: t.heroTitles[1], accent: "#a9dccc", stickers: pickForHero(["動物", "かわいい"], 2) },
  { label: "FUNNY & UNIQUE", title: t.heroTitles[2], accent: "#f2b8c6", stickers: pickForHero(["おもしろ", "食べ物", "方言"], 4) },
  { label: "DAILY & WORK", title: t.heroTitles[3], accent: "#a9c6eb", stickers: pickForHero(["仕事", "日常", "恋愛", "あいさつ"], 6) },
];
---
<html lang={localeInfo[locale].htmlLang}>
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{siteTitle}</title><SeoHead title={siteTitle} description={siteDescription} canonical={canonical} locale={locale} path="/" />
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite",name:"stamp moke",alternateName:["スタンプもけ","スタンプモケ","スタンプもけぇ","studio moke","スタジオモケ","スタジオもけぇ"],url:canonical,description:siteDescription})} />
<Analytics />
<style>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}.header{height:86px;background:rgba(255,255,255,.96);border-bottom:1px solid #e4e3df;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)}.brand{text-decoration:none}.brand-title{font-size:21px;font-weight:900;letter-spacing:.1em}.brand-sub{margin-top:7px;font-size:11px;color:#777}.header-actions{display:flex;align-items:center;gap:9px}.header-link{border:1px solid #d9d8d4;background:#fff;padding:13px 22px;border-radius:999px;font-size:13px;font-weight:700;text-decoration:none}.header-shop-link{background:#161616;color:#fff}.main{max-width:1180px;margin:0 auto;padding:45px 5vw 110px}.hero{padding:28px 0 72px}.hero-carousel{position:relative;min-height:560px;overflow:hidden;border:1px solid #deddd8;border-radius:28px;background:#fff}.hero-slide{position:absolute;inset:0;display:grid;grid-template-columns:.82fr 1.18fr;gap:28px;padding:54px;opacity:0;visibility:hidden;transition:.65s;background:#fff}.hero-slide.is-active{opacity:1;visibility:visible;z-index:1}.hero-copy{display:flex;flex-direction:column;justify-content:center}.hero-label{margin-bottom:18px;color:#666;font-size:10px;font-weight:800;letter-spacing:.2em}.hero-title{margin:0;font-size:clamp(36px,4vw,60px);line-height:1.02;font-weight:900}.hero-title-line{display:block}.hero-text{max-width:430px;margin:24px 0 0;color:#666;font-size:13px;line-height:1.9}.hero-cta{display:inline-flex;align-self:flex-start;margin-top:25px;padding:12px 17px;border-radius:999px;background:#161616;color:#fff;font-size:11px;font-weight:800;text-decoration:none}.hero-collage{align-self:center;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;padding:24px;border-radius:25px;background:#f1f1ed}.hero-sticker{aspect-ratio:1;display:grid;place-items:center;overflow:hidden;border-radius:18px;background:#fff}.hero-sticker img{width:100%;height:100%;object-fit:contain;padding:8px}.hero-nav{position:absolute;z-index:4;left:54px;bottom:35px;display:flex;gap:9px}.hero-dot{width:8px;height:8px;border:0;border-radius:99px;background:#c9c7c0}.hero-dot.is-active{width:28px;background:#161616}.hero-arrow{width:38px;height:38px;border:1px solid #d6d4cd;border-radius:50%;background:#fff}.section-header{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:18px;padding-bottom:18px;border-bottom:1px solid #dddcd8}.section-label{font-size:11px;letter-spacing:.18em;color:#777;margin-bottom:8px}.section-title{margin:0;font-size:38px;font-weight:900}.section-count{color:#777;font-size:13px}.controls{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:28px}.category-button{border:1px solid #d8d7d2;background:#fff;border-radius:999px;padding:9px 15px;font-size:12px;font-weight:700}.category-button.is-active{background:#161616;color:#fff}.sticker-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.sticker-card{display:block;text-decoration:none;background:#fff;border:1px solid #e3e2de;border-radius:18px;overflow:hidden}.sticker-card[hidden]{display:none}.sticker-image-wrap{aspect-ratio:1;background:#f4f3ef}.sticker-image{width:100%;height:100%;object-fit:contain}.sticker-info{padding:16px}.sticker-title{margin:0;font-size:14px}.sticker-description{font-size:11px;color:#777;line-height:1.7}.sticker-link{font-size:11px;font-weight:800}.goods-section,.about-section{margin-top:85px}.goods-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.goods-card{text-decoration:none;background:#fff;border:1px solid #e3e2de;border-radius:18px;overflow:hidden}.goods-image{width:100%;aspect-ratio:1;object-fit:contain}.goods-info{padding:14px}.goods-title{font-size:13px;font-weight:800}.goods-price{font-size:11px;color:#777}.about-section{padding:48px;border-radius:28px;background:#161616;color:#fff}.about-title{font-size:40px;white-space:pre-line}.about-text{max-width:700px;line-height:2;color:#ddd}.footer{padding:40px 5vw;border-top:1px solid #ddd}.footer-inner{max-width:1180px;margin:auto;display:flex;justify-content:space-between}.footer-links{display:flex;gap:18px;flex-wrap:wrap}@media(max-width:800px){.header{height:auto;padding:14px 5vw}.hero-carousel{min-height:720px}.hero-slide{grid-template-columns:1fr;padding:30px}.hero-collage{grid-template-columns:repeat(4,1fr)}.sticker-grid,.goods-grid{grid-template-columns:repeat(2,1fr)}.main{padding-top:20px}.footer-inner{display:block}.header-shop-link{display:none}}
</style>
</head>
<body>
<header class="header"><a class="brand" href={localizedPath(locale,"/")}><div class="brand-title">stamp moke</div><div class="brand-sub">{t.brandSub}</div></a><div class="header-actions"><LanguageSwitcher locale={locale}/><a class="header-link header-shop-link" href={localizedPath(locale,"/goods/")}>{t.shop}</a></div></header>
<main class="main">
<section class="hero"><div class="hero-carousel" data-hero-carousel>{heroSlides.map((slide,index)=><article class={`hero-slide ${index===0?'is-active':''}`} data-hero-slide style={`--accent:${slide.accent}`}><div class="hero-copy"><div class="hero-label">{slide.label}</div><h1 class="hero-title">{slide.title.split("\n").map(line=><span class="hero-title-line">{line}</span>)}</h1><p class="hero-text">{t.heroLead}</p><a class="hero-cta" href="#stickers">{t.heroCta}</a></div><div class="hero-collage">{slide.stickers.map(sticker=><a class="hero-sticker" href={localizedPath(locale,`/stickers/${sticker.id}/`)}><img src={sticker.image} alt={sticker.localizedTitle} loading="eager" /></a>)}</div></article>)}<div class="hero-nav"><button class="hero-arrow" data-hero-prev aria-label="Previous">‹</button>{heroSlides.map((_,index)=><button class={`hero-dot ${index===0?'is-active':''}`} data-hero-dot={index} aria-label={`Slide ${index+1}`}></button>)}<button class="hero-arrow" data-hero-next aria-label="Next">›</button></div></div></section>
<section id="stickers"><div class="section-header"><div><div class="section-label">COLLECTION</div><h2 class="section-title">{t.stickers}</h2></div><div class="section-count">{categorizedStickers.length}</div></div><div class="controls"><button class="category-button is-active" data-category="すべて">{t.all}</button>{[...new Set(categorizedStickers.map(s=>s.category))].map(category=><button class="category-button" data-category={category}>{category}</button>)}</div><div class="sticker-grid">{categorizedStickers.map(sticker=><a class="sticker-card" data-sticker-category={sticker.category} href={localizedPath(locale,`/stickers/${sticker.id}/`)}><div class="sticker-image-wrap"><img class="sticker-image" src={sticker.image} alt={sticker.localizedTitle} loading="lazy" /></div><div class="sticker-info"><h3 class="sticker-title">{sticker.localizedTitle}</h3><p class="sticker-description">{sticker.localizedDescription}</p><span class="sticker-link">{t.details}</span></div></a>)}</div></section>
<section class="goods-section"><div class="section-header"><div><div class="section-label">CHARACTER GOODS</div><h2 class="section-title">{t.goodsTitle}</h2><p>{t.goodsLead}</p></div><a href={localizedPath(locale,"/goods/")}>{t.goodsLink}</a></div><div class="goods-grid">{suzuriDesigns.slice(0,4).map(item=><a class="goods-card" href={item.url} rel="noopener noreferrer"><img class="goods-image" src={item.image} alt={item.title} loading="lazy"/><div class="goods-info"><div class="goods-title">{item.title}</div><div class="goods-price">{item.price}</div></div></a>)}</div></section>
<section class="about-section"><h2 class="about-title">{t.aboutTitle}</h2><p class="about-text">{t.aboutText}</p></section>
</main>
<footer class="footer"><div class="footer-inner"><div><strong>stamp moke</strong><p>{t.footerCopy}</p></div><nav class="footer-links"><a href={localizedPath(locale,"/stickers/")}>{t.stickers}</a><a href={localizedPath(locale,"/categories/")}>{t.categories}</a><a href={localizedPath(locale,"/goods/")}>{t.goodsTitle}</a></nav></div></footer>
<script is:inline>
const slides=[...document.querySelectorAll('[data-hero-slide]')],dots=[...document.querySelectorAll('[data-hero-dot]')];let current=0;const show=i=>{current=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.classList.toggle('is-active',n===current));dots.forEach((d,n)=>d.classList.toggle('is-active',n===current))};document.querySelector('[data-hero-prev]')?.addEventListener('click',()=>show(current-1));document.querySelector('[data-hero-next]')?.addEventListener('click',()=>show(current+1));dots.forEach((d,i)=>d.addEventListener('click',()=>show(i)));setInterval(()=>show(current+1),7000);document.querySelectorAll('[data-category]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-category]').forEach(b=>b.classList.remove('is-active'));btn.classList.add('is-active');const cat=btn.dataset.category;document.querySelectorAll('[data-sticker-category]').forEach(card=>card.hidden=cat!=='すべて'&&card.dataset.stickerCategory!==cat)}));
</script>
</body></html>