---
import stickers from "../data/stickers.json";
import suzuriDesigns from "../data/suzuri-designs.json";
import Analytics from "../components/Analytics.astro";
import SeoHead from "../components/SeoHead.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { localeInfo, localizedPath, messages, normalizeLocale } from "../lib/i18n";
import { absoluteUrl } from "../lib/seo";
import { localizedStickerDescription, localizedStickerPrice, localizedStickerTitle } from "../lib/sticker-content";

const locale = normalizeLocale(Astro.props.locale);
const t = messages[locale];
const siteTitle = t.siteTitle;
const siteDescription = t.siteDescription;
const canonical = absoluteUrl(localizedPath(locale, "/"));

function getCategory(sticker) {
  const text = `${sticker.title || ""} ${sticker.description || ""}`;
  if (/博多|福岡|筑後|方言|関西弁|九州弁/.test(text)) return "方言";
  if (/猫|ねこ|ネコ|犬|いぬ|イヌ|柴犬|コーギー|ポメラニアン|うさぎ|ウサギ|兎|くま|クマ|パンダ|鳥|すずめ|ペンギン|アザラシ|猿|サル|タヌキ|たぬき|ねずみ|動物/.test(text)) return "動物";
  if (/ハート|恋|恋愛|カップル|彼氏|彼女|好き|愛/.test(text)) return "恋愛";
  if (/仕事|ビジネス|敬語|丁寧|会社|職場|マーケター|バイト|働く/.test(text)) return "仕事";
  if (/食べ物|料理|ごはん|肉まん|ビール|お酒|ジョッキ|パン|ケーキ|お菓子/.test(text)) return "食べ物";
  if (/面白|おもしろ|ネタ|シュール|ギャグ|ツッコミ|あるある|ウザい|正論|本音/.test(text)) return "おもしろ";
  if (/挨拶|ありがとう|おはよう|こんにちは|こんばんは|おやすみ|よろしく|おつかれ/.test(text)) return "あいさつ";
  if (/かわいい|可愛い|キュート|癒し|ほんわか|ゆるかわ|もふもふ/.test(text)) return "かわいい";
  if (/日常|毎日|返信|返事|会話|リアクション|気持ち/.test(text)) return "日常";
  return "その他";
}

const categorizedStickers = stickers.map((sticker) => ({
  ...sticker,
  category: getCategory(sticker),
  localizedTitle: localizedStickerTitle(sticker, locale),
  localizedDescription: localizedStickerDescription(sticker, locale),
  localizedPrice: localizedStickerPrice(sticker.price, locale),
}));

const latestStickers = categorizedStickers.slice(0, 4);
const pickupStickers = categorizedStickers.slice(4, 7);
const isJa = locale === "ja";
const heroTitle = isJa ? "日常をちょっと\n楽しく。" : t.heroTitles?.[0] || t.stickers;
const heroLead = isJa ? "LINEスタンプ・グッズ・無料フリー素材で、毎日に小さな『楽しい』を。" : t.heroLead;
---
<html lang={localeInfo[locale].htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteTitle}</title>
  <SeoHead title={siteTitle} description={siteDescription} canonical={canonical} locale={locale} path="/" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org",
    "@type":"WebSite",
    name:"stamp moke",
    alternateName:["スタンプもけ","スタンプモケ","スタンプもけぇ","studio moke","スタジオモケ","スタジオもけぇ"],
    url:canonical,
    description:siteDescription
  })} />
  <Analytics />
  <style>
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:#f6f3ed;color:#151515;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}
    .site-header{position:sticky;top:0;z-index:30;height:104px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.96);border-bottom:1px solid #e6e3dd;backdrop-filter:blur(16px)}
    .brand{display:flex;align-items:center;gap:14px;text-decoration:none}
    .brand-mark{width:48px;height:48px;border-radius:18px;display:grid;place-items:center;font-weight:1000;font-size:23px;letter-spacing:-.14em;color:#166a3a;background:linear-gradient(145deg,#dff6ce,#f4fff0);border:1px solid #d5e9cf;box-shadow:0 8px 24px rgba(38,109,65,.12)}
    .brand-name{font-size:24px;font-weight:900;letter-spacing:.08em;color:#15243a}
    .header-actions{display:flex;align-items:center;gap:10px}
    .menu{position:relative}
    .menu summary{list-style:none;width:56px;height:56px;border:1px solid #d9dee1;border-radius:50%;background:#fff;display:grid;place-items:center;cursor:pointer;font-size:0}
    .menu summary::-webkit-details-marker{display:none}
    .menu summary::before{content:"☰";font-size:28px;line-height:1;color:#172536}
    .menu[open] summary::before{content:"×"}
    .menu-panel{position:absolute;right:0;top:68px;width:min(330px,86vw);padding:18px;background:#fff;border:1px solid #dfded9;border-radius:22px;box-shadow:0 22px 60px rgba(0,0,0,.12)}
    .menu-panel a{display:block;text-decoration:none;padding:12px 10px;border-bottom:1px solid #efeee9;font-weight:800}
    .menu-panel a:last-of-type{border-bottom:0}
    .menu-language{padding-top:12px}
    .main{max-width:1180px;margin:0 auto;padding:0 5vw 100px}
    .hero{position:relative;padding:68px 0 42px;display:grid;grid-template-columns:1.08fr .92fr;gap:32px;align-items:center}
    .hero::before{content:"";position:absolute;inset:20px -4vw -8px;z-index:-1;background:radial-gradient(circle at 72% 40%,rgba(205,237,188,.65),transparent 30%),radial-gradient(circle at 30% 60%,rgba(255,255,255,.95),transparent 42%)}
    .hero-copy{padding:24px 0}
    .hero-title{margin:0;font-size:clamp(52px,7vw,92px);line-height:1.03;letter-spacing:-.05em;font-weight:950;white-space:pre-line}
    .hero-rule{width:62px;height:4px;border-radius:99px;background:#2ca45f;margin:28px 0 20px}
    .hero-lead{max-width:620px;margin:0;color:#6e6e6a;font-size:17px;line-height:2}
    .hero-art{min-height:330px;display:flex;justify-content:center;align-items:center}
    .clover{position:relative;width:min(360px,100%);aspect-ratio:1;border-radius:50%;background:#fff;border:1px solid #e7e4de;box-shadow:0 24px 60px rgba(68,92,65,.12);display:grid;place-items:center}
    .clover::before{content:"☘";font-size:190px;filter:saturate(.9);transform:rotate(-10deg)}
    .clover::after{content:"いいこと\Aあるよ!";white-space:pre;position:absolute;right:-8px;top:52px;font-weight:950;font-size:28px;line-height:1.05;transform:rotate(-8deg)}
    .search{margin-top:28px;background:#fff;border:1px solid #e2e0da;border-radius:999px;display:flex;align-items:center;padding:0 24px;height:66px;box-shadow:0 12px 30px rgba(0,0,0,.04)}
    .search input{width:100%;border:0;outline:0;background:transparent;font-size:17px;color:#333}
    .search::before{content:"⌕";font-size:34px;margin-right:12px;line-height:1}
    .tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
    .tag{padding:9px 16px;border-radius:999px;background:#fff;border:1px solid #eeece7;text-decoration:none;font-size:13px;font-weight:700}
    .quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:22px 0 38px}
    .quick-card{min-height:140px;padding:22px 18px;border-radius:22px;background:#fff;border:1px solid #e6e3dd;text-decoration:none;box-shadow:0 12px 28px rgba(0,0,0,.035);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
    .quick-icon{font-size:34px;margin-bottom:9px}
    .quick-title{font-size:17px;font-weight:900}
    .quick-sub{margin-top:7px;color:#8a8984;font-size:12px;line-height:1.5}
    .section-card{background:#fff;border:1px solid #e4e1db;border-radius:28px;padding:26px;margin-top:28px;box-shadow:0 18px 40px rgba(0,0,0,.035)}
    .section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:20px}
    .section-kicker{display:inline-flex;padding:7px 15px;border-radius:999px;background:#ef6684;color:#fff;font-size:12px;font-weight:900;letter-spacing:.08em}
    .section-title{margin:8px 0 0;font-size:34px;line-height:1;font-weight:950}
    .section-more{color:#2d9e61;text-decoration:none;font-weight:800;white-space:nowrap}
    .latest-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
    .mini-sticker{display:block;text-decoration:none;border:1px solid #ece9e4;border-radius:18px;overflow:hidden;background:#faf9f6}
    .mini-sticker img{width:100%;aspect-ratio:1;object-fit:contain;background:#fff}
    .mini-sticker strong{display:block;padding:12px 12px 14px;font-size:13px;line-height:1.5}
    .pickup-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .pickup-card{display:block;text-decoration:none;border-radius:20px;overflow:hidden;background:#edf7ed;border:1px solid #dfebdd}
    .pickup-card img{width:100%;aspect-ratio:1.25;object-fit:contain;background:#fff}
    .pickup-card div{padding:15px;font-weight:900}
    .collection{margin-top:56px}
    .collection-head{display:flex;justify-content:space-between;align-items:end;padding-bottom:18px;border-bottom:1px solid #ddd9d3;margin-bottom:18px}
    .collection-label{font-size:11px;letter-spacing:.18em;color:#777;margin-bottom:8px}
    .collection-title{margin:0;font-size:38px;font-weight:950}
    .section-count{color:#777;font-size:13px}
    .controls{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:28px}
    .category-button{border:1px solid #d8d7d2;background:#fff;border-radius:999px;padding:9px 15px;font-size:12px;font-weight:700;cursor:pointer}
    .category-button.is-active{background:#161616;color:#fff}
    .sticker-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}
    .sticker-card{display:block;text-decoration:none;background:#fff;border:1px solid #e3e2de;border-radius:18px;overflow:hidden}
    .sticker-card[hidden]{display:none}
    .sticker-image-wrap{aspect-ratio:1;background:#f4f3ef}
    .sticker-image{width:100%;height:100%;object-fit:contain}
    .sticker-info{padding:16px}
    .sticker-title{margin:0;font-size:14px}
    .sticker-description{font-size:11px;color:#777;line-height:1.7}
    .sticker-link{font-size:11px;font-weight:800}
    .goods-section,.about-section{margin-top:70px}
    .goods-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
    .goods-card{text-decoration:none;background:#fff;border:1px solid #e3e2de;border-radius:18px;overflow:hidden}
    .goods-image{width:100%;aspect-ratio:1;object-fit:contain}
    .goods-info{padding:14px}
    .goods-title{font-size:13px;font-weight:800}
    .goods-price{font-size:11px;color:#777}
    .about-section{padding:48px;border-radius:28px;background:#16261e;color:#fff}
    .about-title{font-size:40px;white-space:pre-line;margin-top:0}
    .about-text{max-width:700px;line-height:2;color:#d7dfd9}
    .footer{padding:40px 5vw;border-top:1px solid #ddd9d3;background:#fff}
    .footer-inner{max-width:1180px;margin:auto;display:flex;justify-content:space-between;gap:30px}
    .footer-links{display:flex;gap:18px;flex-wrap:wrap}
    @media(max-width:850px){
      .site-header{height:88px}.brand-mark{width:42px;height:42px}.brand-name{font-size:22px}
      .hero{grid-template-columns:1fr;padding-top:44px}.hero-title{font-size:58px}.hero-art{min-height:250px}.clover{width:260px}.clover::before{font-size:140px}.clover::after{font-size:22px;right:-16px;top:42px}
      .quick-grid{grid-template-columns:repeat(2,1fr)}.latest-grid{grid-template-columns:repeat(2,1fr)}.pickup-grid{grid-template-columns:1fr}.sticker-grid,.goods-grid{grid-template-columns:repeat(2,1fr)}
      .footer-inner{display:block}.section-title,.collection-title{font-size:30px}
    }
    @media(max-width:520px){
      .site-header{padding:0 20px}.main{padding-left:20px;padding-right:20px}.brand-name{font-size:20px}.menu summary{width:50px;height:50px}
      .hero-title{font-size:52px}.hero-lead{font-size:15px}.hero-art{min-height:220px}.clover{width:230px}.clover::before{font-size:126px}.clover::after{font-size:20px;right:-10px}
      .quick-grid{gap:12px}.quick-card{min-height:125px;padding:16px 10px}.quick-title{font-size:15px}.latest-grid{gap:10px}.section-card{padding:20px}.sticker-grid,.goods-grid{gap:12px}
    }
  </style>
</head>
<body>
  <header class="site-header">
    <a class="brand" href={localizedPath(locale,"/")} aria-label="stamp moke home">
      <span class="brand-mark">sm</span>
      <span class="brand-name">stamp moke</span>
    </a>
    <div class="header-actions">
      <details class="menu">
        <summary aria-label="menu"></summary>
        <div class="menu-panel">
          <a href={localizedPath(locale,"/stickers/")}>{t.stickers}</a>
          <a href={localizedPath(locale,"/free/")}>{isJa ? "無料フリー素材" : "Free materials"}</a>
          <a href={localizedPath(locale,"/goods/")}>{t.goodsTitle}</a>
          <a href={localizedPath(locale,"/categories/")}>{t.categories}</a>
          <div class="menu-language"><LanguageSwitcher locale={locale}/></div>
        </div>
      </details>
    </div>
  </header>

  <main class="main">
    <section class="hero">
      <div class="hero-copy">
        <h1 class="hero-title">{heroTitle}</h1>
        <div class="hero-rule"></div>
        <p class="hero-lead">{heroLead}</p>
        <form class="search" action={localizedPath(locale,"/search/")} method="get">
          <input name="q" type="search" placeholder={isJa ? "スタンプ・素材・グッズを検索..." : "Search stamp moke..."} aria-label="search" />
        </form>
        <div class="tags">
          <a class="tag" href={localizedPath(locale,"/stickers/")}># LINEスタンプ</a>
          <a class="tag" href={localizedPath(locale,"/free/")}># フリー素材</a>
          <a class="tag" href={localizedPath(locale,"/goods/")}># グッズ</a>
          <a class="tag" href={localizedPath(locale,"/free-tools/")}># 無料ツール</a>
        </div>
      </div>
      <div class="hero-art"><div class="clover" aria-hidden="true"></div></div>
    </section>

    <nav class="quick-grid" aria-label="main navigation">
      <a class="quick-card" href={localizedPath(locale,"/stickers/")}><span class="quick-icon">🐕</span><span class="quick-title">{isJa ? "スタンプ一覧" : t.stickers}</span><span class="quick-sub">{isJa ? "LINEスタンプを見る" : t.details}</span></a>
      <a class="quick-card" href={localizedPath(locale,"/free/")}><span class="quick-icon">🎨</span><span class="quick-title">{isJa ? "無料フリー素材" : "Free materials"}</span><span class="quick-sub">{isJa ? "イラスト・背景・アイコンなど" : "Illustrations and assets"}</span></a>
      <a class="quick-card" href={localizedPath(locale,"/goods/")}><span class="quick-icon">🛒</span><span class="quick-title">{isJa ? "グッズショップ" : t.goodsTitle}</span><span class="quick-sub">SUZURI</span></a>
      <a class="quick-card" href="#language"><span class="quick-icon">🌐</span><span class="quick-title">Language</span><span class="quick-sub">{isJa ? "言語を切り替える" : "Change language"}</span></a>
    </nav>

    <section class="section-card">
      <div class="section-head">
        <div><span class="section-kicker">NEW</span><h2 class="section-title">{isJa ? "新着スタンプ" : t.stickers}</h2></div>
        <a class="section-more" href={localizedPath(locale,"/stickers/")}>{isJa ? "もっと見る →" : t.details}</a>
      </div>
      <div class="latest-grid">
        {latestStickers.map(sticker => <a class="mini-sticker" href={localizedPath(locale,`/stickers/${sticker.id}/`)}><img src={sticker.image} alt={sticker.localizedTitle} loading="eager" /><strong>{sticker.localizedTitle}</strong></a>)}
      </div>
    </section>

    <section class="section-card">
      <div class="section-head"><div><h2 class="section-title">{isJa ? "ピックアップ" : "Pickup"}</h2></div><a class="section-more" href={localizedPath(locale,"/stickers/")}>{isJa ? "もっと見る →" : t.details}</a></div>
      <div class="pickup-grid">
        {pickupStickers.map(sticker => <a class="pickup-card" href={localizedPath(locale,`/stickers/${sticker.id}/`)}><img src={sticker.image} alt={sticker.localizedTitle} loading="lazy" /><div>{sticker.localizedTitle}</div></a>)}
      </div>
    </section>

    <section class="collection" id="stickers">
      <div class="collection-head"><div><div class="collection-label">COLLECTION</div><h2 class="collection-title">{t.stickers}</h2></div><div class="section-count">{categorizedStickers.length}</div></div>
      <div class="controls"><button class="category-button is-active" data-category="すべて">{t.all}</button>{[...new Set(categorizedStickers.map(s=>s.category))].map(category=><button class="category-button" data-category={category}>{category}</button>)}</div>
      <div class="sticker-grid">{categorizedStickers.map(sticker=><a class="sticker-card" data-sticker-category={sticker.category} href={localizedPath(locale,`/stickers/${sticker.id}/`)}><div class="sticker-image-wrap"><img class="sticker-image" src={sticker.image} alt={sticker.localizedTitle} loading="lazy" /></div><div class="sticker-info"><h3 class="sticker-title">{sticker.localizedTitle}</h3><p class="sticker-description">{sticker.localizedDescription}</p><span class="sticker-link">{t.details}</span></div></a>)}</div>
    </section>

    <section class="goods-section">
      <div class="collection-head"><div><div class="collection-label">CHARACTER GOODS</div><h2 class="collection-title">{t.goodsTitle}</h2><p>{t.goodsLead}</p></div><a class="section-more" href={localizedPath(locale,"/goods/")}>{t.goodsLink}</a></div>
      <div class="goods-grid">{suzuriDesigns.slice(0,4).map(item=><a class="goods-card" href={item.url} rel="noopener noreferrer"><img class="goods-image" src={item.image} alt={item.title} loading="lazy"/><div class="goods-info"><div class="goods-title">{item.title}</div><div class="goods-price">{item.price}</div></div></a>)}</div>
    </section>

    <section class="about-section"><h2 class="about-title">{t.aboutTitle}</h2><p class="about-text">{t.aboutText}</p></section>
    <div id="language" style="margin-top:28px"><LanguageSwitcher locale={locale}/></div>
  </main>

  <footer class="footer"><div class="footer-inner"><div><strong>stamp moke</strong><p>{t.footerCopy}</p></div><nav class="footer-links"><a href={localizedPath(locale,"/stickers/")}>{t.stickers}</a><a href={localizedPath(locale,"/categories/")}>{t.categories}</a><a href={localizedPath(locale,"/goods/")}>{t.goodsTitle}</a></nav></div></footer>
  <script is:inline>
    document.querySelectorAll('[data-category]').forEach(btn=>btn.addEventListener('click',()=>{
      document.querySelectorAll('[data-category]').forEach(b=>b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const cat=btn.dataset.category;
      document.querySelectorAll('[data-sticker-category]').forEach(card=>card.hidden=cat!=='すべて'&&card.dataset.stickerCategory!==cat);
    }));
  </script>
</body>
</html>