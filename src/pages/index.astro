---
import stickers from "../data/stickers.json";
import suzuriDesigns from "../data/suzuri-designs.json";
import Analytics from "../components/Analytics.astro";

const siteTitle = "stamp moke｜LINEスタンプ専門メディア";
const siteDescription =
  "stamp moke（スタンプもけ・スタンプモケ）は、かわいい、おもしろい、毎日使えるLINEスタンプを紹介するstudio mokeの公式サイトです。";
const siteKeywords = "stamp moke,スタンプもけ,スタンプモケ,スタンプもけぇ,studio moke,スタジオモケ,スタジオもけぇ,LINEスタンプ,クリエイターズスタンプ";

function getCategory(sticker) {
  const text = `${sticker.title || ""} ${sticker.description || ""}`;

  if (/博多|福岡|筑後|方言|関西弁|九州弁/.test(text)) return "方言";
  if (/猫|ねこ|ネコ|犬|いぬ|イヌ|柴犬|コーギー|ポメラニアン|うさぎ|ウサギ|兎|くま|クマ|パンダ|鳥|すずめ|ペンギン|アザラシ|猿|サル|タヌキ|たぬき|ねずみ|動物/.test(text)) return "動物";
  if (/ハート|恋|恋愛|カップル|彼氏|彼女|好き|愛/.test(text)) return "恋愛";
  if (/仕事|ビジネス|敬語|丁寧|会社|職場|マーケター|バイト|働く/.test(text)) return "仕事";
  if (/食べ物|料理|ごはん|肉まん|ビール|お酒|ジョッキ|パン|ケーキ|お菓子/.test(text)) return "食べ物";
  if (/面白|おもしろ|ネタ|シュール|ギャグ|ツッコミ|あるある|ウザい|正論|本音/.test(text)) return "おもしろ";
  if (/挨拶|ありがとう|おはよう|こんにちは|こんばんは|おやすみ|よろしく|おつかれ/.test(text)) return "あいさつ";
  if (/かわいい|可愛い|キュート|癒し|ほんわか|ゆるかわ|もふもふ/.test(text)) return "かわいい";
  if (/日常|毎日|返信|返事|会話|リアクション|気持ち/.test(text)) return "日常";
  return "その他";
}

const categorizedStickers = stickers.map((sticker) => ({
  ...sticker,
  category: getCategory(sticker),
}));

function pickForHero(categories, offset = 0) {
  const selected = categorizedStickers.filter((sticker) => categories.includes(sticker.category));
  const pool = selected.length >= 8 ? selected : categorizedStickers;
  return Array.from({ length: Math.min(8, pool.length) }, (_, index) => pool[(index + offset) % pool.length]);
}

const heroSlides = [
  { label: "NEW ARRIVALS", title: "新しいスタンプ、\n続々登場。", accent: "#ffd86b", stickers: categorizedStickers.slice(0, 8) },
  { label: "CUTE & ANIMALS", title: "かわいい仲間が、\nいっぱい。", accent: "#a9dccc", stickers: pickForHero(["動物", "かわいい"], 2) },
  { label: "FUNNY & UNIQUE", title: "クスッと笑える、\nひとことを。", accent: "#f2b8c6", stickers: pickForHero(["おもしろ", "食べ物", "方言"], 4) },
  { label: "DAILY & WORK", title: "毎日の会話を、\nもっと便利に。", accent: "#a9c6eb", stickers: pickForHero(["仕事", "日常", "恋愛", "あいさつ"], 6) },
];

---

<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteTitle}</title>
  <meta name="description" content={siteDescription} />
  <meta name="keywords" content={siteKeywords} />
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={siteDescription} />
  <meta property="og:type" content="website" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "stamp moke",
    alternateName: ["スタンプもけ", "スタンプモケ", "スタンプもけぇ", "studio moke", "スタジオモケ", "スタジオもけぇ"],
    url: "https://stamp-moke.jp/",
    description: siteDescription,
  })} />
  <Analytics />

  <style>
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: #f7f6f2;
      color: #161616;
      font-family: Arial, "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }

    .header {
      height: 86px;
      background: rgba(255,255,255,.96);
      border-bottom: 1px solid #e4e3df;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5vw;
      position: sticky;
      top: 0;
      z-index: 20;
      backdrop-filter: blur(12px);
    }
    .brand { text-decoration: none; }
    .brand-title { font-size: 21px; font-weight: 900; letter-spacing: .1em; line-height: 1; }
    .brand-sub { margin-top: 7px; font-size: 11px; color: #777; letter-spacing: .05em; }
    .header-link {
      text-decoration: none;
      border: 1px solid #d9d8d4;
      background: #fff;
      padding: 13px 22px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
    }
    .header-actions { display: flex; align-items: center; gap: 9px; }
    .header-shop-link { background: #161616; border-color: #161616; color: #fff; }

    .main { max-width: 1180px; margin: 0 auto; padding: 45px 5vw 110px; }
    .hero { padding: 28px 0 72px; }
    .hero-carousel {
      position: relative;
      min-height: 560px;
      overflow: hidden;
      border: 1px solid #deddd8;
      border-radius: 28px;
      background: #fff;
      box-shadow: 0 24px 70px rgba(42,40,32,.08);
    }
    .hero-slide {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: .82fr 1.18fr;
      gap: 28px;
      padding: 54px;
      opacity: 0;
      visibility: hidden;
      transform: translateX(28px);
      transition: opacity .65s ease, transform .65s ease, visibility .65s;
      background:
        radial-gradient(circle at 18% 12%, color-mix(in srgb, var(--accent) 33%, transparent), transparent 34%),
        linear-gradient(135deg, #fff 0%, #faf9f5 100%);
    }
    .hero-slide.is-active { opacity: 1; visibility: visible; transform: translateX(0); z-index: 1; }
    .hero-copy { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; }
    .hero-label { margin-bottom: 18px; color: #666; font-size: 10px; font-weight: 800; letter-spacing: .2em; }
    .hero-title {
      margin: 0;
      font-size: clamp(36px, 4vw, 60px);
      line-height: 1.02;
      letter-spacing: -.05em;
      font-weight: 900;
    }
    .hero-title-line { display: block; white-space: nowrap; }
    .hero-text { max-width: 430px; margin: 24px 0 0; color: #666; font-size: 13px; line-height: 1.9; }
    .hero-cta {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      margin-top: 25px;
      padding: 12px 17px;
      border-radius: 999px;
      background: #161616;
      color: #fff;
      font-size: 11px;
      font-weight: 800;
      text-decoration: none;
    }
    .hero-collage {
      position: relative;
      align-self: center;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      padding: 24px;
      border-radius: 25px;
      background: color-mix(in srgb, var(--accent) 45%, #fff);
      transform: rotate(-1.5deg);
    }
    .hero-sticker {
      position: relative;
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      min-width: 0;
      overflow: hidden;
      border-radius: 18px;
      background: rgba(255,255,255,.82);
      box-shadow: 0 10px 24px rgba(60,55,40,.1);
      transition: transform .25s ease;
    }
    .hero-sticker:nth-child(even) { transform: translateY(9px); }
    .hero-sticker:hover { transform: translateY(-4px) rotate(2deg); }
    .hero-sticker img { display: block; width: 100%; height: 100%; object-fit: contain; padding: 8px; }
    .hero-nav {
      position: absolute;
      z-index: 4;
      left: 54px;
      bottom: 35px;
      display: flex;
      align-items: center;
      gap: 9px;
    }
    .hero-dot { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 99px; background: #c9c7c0; cursor: pointer; transition: width .25s, background .25s; }
    .hero-dot.is-active { width: 28px; background: #161616; }
    .hero-arrow {
      width: 38px;
      height: 38px;
      border: 1px solid #d6d4cd;
      border-radius: 50%;
      background: rgba(255,255,255,.88);
      color: #161616;
      cursor: pointer;
      font-size: 18px;
    }
    .hero-arrow:first-child { margin-right: 5px; }
    .hero-arrow:last-child { margin-left: 5px; }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 30px;
      margin-bottom: 18px;
      padding-bottom: 18px;
      border-bottom: 1px solid #dddcd8;
    }
    .section-label { font-size: 11px; letter-spacing: .18em; color: #777; margin-bottom: 8px; }
    .section-title { margin: 0; font-size: 38px; line-height: 1; letter-spacing: -.03em; font-weight: 900; }
    .section-count { color: #777; font-size: 13px; white-space: nowrap; }

    .controls { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 28px; }
    .category-button {
      appearance: none;
      border: 1px solid #d8d7d2;
      background: #fff;
      color: #555;
      border-radius: 999px;
      padding: 9px 15px;
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }
    .category-button.is-active { background: #161616; color: #fff; border-color: #161616; }
    .category-count { opacity: .6; margin-left: 3px; }

    .sticker-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }
    .sticker-card {
      display: block;
      text-decoration: none;
      background: #fff;
      border: 1px solid #e3e2de;
      border-radius: 18px;
      overflow: hidden;
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    .sticker-card[hidden] { display: none; }
    .sticker-card:hover {
      transform: translateY(-5px);
      border-color: #d1d0cb;
      box-shadow: 0 16px 40px rgba(0,0,0,.08);
    }
    .sticker-image-wrap { position: relative; aspect-ratio: 1 / 1; background: #7696c4; overflow: hidden; }
    .sticker-image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: contain;
      padding: 18px;
      transition: transform .35s ease;
    }
    .sticker-card:hover .sticker-image { transform: scale(1.045); }
    .sticker-content { padding: 18px 18px 20px; }
    .sticker-number { font-size: 10px; letter-spacing: .15em; color: #aaa; margin-bottom: 9px; }
    .sticker-title {
      margin: 0;
      font-size: 17px;
      line-height: 1.45;
      font-weight: 800;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .sticker-description {
      margin: 11px 0 0;
      font-size: 12px;
      line-height: 1.8;
      color: #777;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .sticker-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-top: 17px;
      padding-top: 14px;
      border-top: 1px solid #eeeeeb;
    }
    .price { font-size: 15px; font-weight: 800; }
    .detail-link { font-size: 11px; font-weight: 700; color: #168b52; white-space: nowrap; }

    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: 38px;
    }
    .page-button {
      min-width: 40px;
      height: 40px;
      padding: 0 12px;
      border: 1px solid #d8d7d2;
      border-radius: 10px;
      background: #fff;
      color: #333;
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }
    .page-button.is-active { background: #161616; color: #fff; border-color: #161616; }
    .page-button:disabled { opacity: .35; cursor: default; }
    .page-gap { color: #999; padding: 0 2px; }

    .empty-state {
      display: none;
      padding: 60px 20px;
      text-align: center;
      color: #777;
      background: #fff;
      border: 1px solid #e3e2de;
      border-radius: 18px;
    }

    .goods-section { margin-top: 120px; }
    .goods-lead { max-width: 650px; margin: 15px 0 30px; color: #777; font-size: 13px; line-height: 1.9; }
    .goods-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
    .goods-card {
      display: block;
      overflow: hidden;
      border: 1px solid #e3e2de;
      border-radius: 18px;
      background: #fff;
      color: inherit;
      text-decoration: none;
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    .goods-card:hover { transform: translateY(-5px); border-color: #d1d0cb; box-shadow: 0 16px 40px rgba(0,0,0,.08); }
    .goods-image-wrap { aspect-ratio: 1; overflow: hidden; background: #f0eee8; }
    .goods-image { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
    .goods-card:hover .goods-image { transform: scale(1.035); }
    .goods-content { padding: 17px 18px 19px; }
    .goods-label { margin-bottom: 8px; color: #999; font-size: 9px; font-weight: 800; letter-spacing: .15em; }
    .goods-title { margin: 0; font-size: 15px; line-height: 1.55; font-weight: 800; }
    .goods-link { margin-top: 13px; color: #168b52; font-size: 11px; font-weight: 800; }
    .goods-footer { margin-top: 30px; text-align: center; }
    .goods-shop-button { display: inline-flex; padding: 13px 20px; border-radius: 999px; background: #161616; color: #fff; font-size: 12px; font-weight: 800; text-decoration: none; }

    .intro {
      margin-top: 120px;
      background: #202020;
      color: #fff;
      border-radius: 24px;
      padding: 70px;
    }
    .intro-label { font-size: 11px; letter-spacing: .18em; color: #aaa; margin-bottom: 20px; }
    .intro-title { margin: 0; max-width: 700px; font-size: clamp(38px, 5vw, 66px); line-height: 1.05; letter-spacing: -.04em; font-weight: 900; }
    .intro-text { max-width: 650px; margin-top: 28px; color: #bdbdbd; font-size: 14px; line-height: 2; }

    .footer { background: #181818; color: #fff; padding: 70px 5vw 35px; }
    .footer-inner { max-width: 1180px; margin: 0 auto; }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 50px;
      padding-bottom: 55px;
      border-bottom: 1px solid #333;
    }
    .footer-brand { font-size: 21px; font-weight: 900; letter-spacing: .1em; }
    .footer-copy { margin-top: 18px; color: #999; font-size: 12px; line-height: 1.9; }
    .footer-heading { font-size: 11px; color: #777; letter-spacing: .15em; margin-bottom: 18px; }
    .footer-link { display: block; color: #ccc; text-decoration: none; font-size: 13px; margin-bottom: 12px; }
    .copyright { padding-top: 25px; display: flex; justify-content: space-between; color: #666; font-size: 10px; letter-spacing: .05em; }

    @media (max-width: 900px) {
      .hero-carousel { min-height: 690px; }
      .hero-slide { grid-template-columns: 1fr; grid-template-rows: auto 1fr; padding: 42px; }
      .hero-copy { justify-content: flex-start; }
      .hero-title { font-size: 44px; }
      .hero-text { display: none; }
      .hero-cta { margin-top: 18px; }
      .hero-collage { width: 100%; max-width: 600px; justify-self: center; padding: 20px; }
      .hero-nav { left: 42px; bottom: 24px; }
      .sticker-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
      .goods-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
      .intro { padding: 50px 40px; }
    }
    @media (max-width: 640px) {
      .header { height: 72px; padding: 0 20px; }
      .brand-title { font-size: 17px; }
      .brand-sub { font-size: 9px; margin-top: 5px; }
      .header-link { padding: 10px 14px; font-size: 11px; }
      .header-actions { gap: 6px; }
      .header-shop-link { padding-inline: 12px; }
      .header-actions .header-link:not(.header-shop-link) { display: none; }
      .main { padding: 25px 18px 70px; }
      .hero { padding: 12px 0 48px; }
      .hero-carousel { min-height: 620px; border-radius: 20px; }
      .hero-slide { gap: 18px; padding: 30px 20px 72px; }
      .hero-title { font-size: clamp(30px, 9.2vw, 36px); line-height: 1.06; }
      .hero-label { margin-bottom: 12px; font-size: 9px; }
      .hero-collage { grid-template-columns: repeat(4, minmax(0,1fr)); gap: 7px; padding: 12px; border-radius: 17px; transform: none; }
      .hero-sticker { border-radius: 11px; }
      .hero-sticker img { padding: 4px; }
      .hero-nav { left: 20px; right: 20px; bottom: 20px; justify-content: center; }
      .section-header { display: block; margin-bottom: 18px; }
      .section-title { font-size: 31px; }
      .section-count { display: block; margin-top: 10px; }
      .controls { gap: 7px; }
      .category-button { padding: 8px 12px; font-size: 11px; }
      .sticker-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      .goods-section { margin-top: 85px; }
      .goods-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      .goods-content { padding: 14px; }
      .sticker-card { border-radius: 13px; }
      .sticker-image { padding: 9px; }
      .sticker-content { padding: 12px 12px 14px; }
      .sticker-number { font-size: 8px; margin-bottom: 6px; }
      .sticker-title { font-size: 13px; line-height: 1.4; }
      .sticker-description { font-size: 10px; line-height: 1.6; margin-top: 7px; -webkit-line-clamp: 2; }
      .sticker-meta { margin-top: 11px; padding-top: 10px; }
      .price { font-size: 12px; }
      .detail-link { font-size: 9px; }
      .page-button { min-width: 36px; height: 36px; padding: 0 9px; }
      .intro { margin-top: 75px; padding: 45px 25px; border-radius: 18px; }
      .intro-title { font-size: 39px; }
      .intro-text { font-size: 12px; }
      .footer { padding: 55px 20px 30px; }
      .footer-grid { grid-template-columns: 1fr; gap: 30px; }
      .copyright { display: block; line-height: 2; }
    }
  </style>
</head>

<body>
  <header class="header">
    <a href="/" class="brand">
      <div class="brand-title">stamp moke</div>
      <div class="brand-sub">LINEスタンプ専門メディア</div>
    </a>
    <div class="header-actions">
      <a href="https://suzuri.jp/bayasihimokei" class="header-link header-shop-link" target="_blank" rel="noopener noreferrer">キャラグッズ店 ↗</a>
      <a href="#stickers" class="header-link">スタンプを見る ↓</a>
    </div>
  </header>

  <main class="main">
    <section class="hero">
      <div class="hero-carousel" id="hero-carousel" aria-roledescription="カルーセル" aria-label="stamp mokeのスタンプシリーズ">
        {heroSlides.map((slide, slideIndex) => (
          <article
            class={`hero-slide${slideIndex === 0 ? " is-active" : ""}`}
            style={`--accent:${slide.accent}`}
            aria-hidden={slideIndex === 0 ? "false" : "true"}
          >
            <div class="hero-copy">
              <div class="hero-label">{slide.label} / stamp moke</div>
              <h1 class="hero-title">
                {slide.title.split("\n").map((line) => <span class="hero-title-line">{line}</span>)}
              </h1>
              <p class="hero-text">かわいい、おもしろい、毎日使える。いろいろなシリーズから、あなたにぴったりのLINEスタンプを見つけてください。</p>
              <a class="hero-cta" href="#stickers">スタンプを探す →</a>
            </div>
            <div class="hero-collage">
              {slide.stickers.map((sticker) => (
                <a class="hero-sticker" href={`/stickers/${sticker.id}`} aria-label={sticker.title}>
                  <img src={sticker.image} alt="" loading={slideIndex === 0 ? "eager" : "lazy"} />
                </a>
              ))}
            </div>
          </article>
        ))}
        <div class="hero-nav" aria-label="スライド操作">
          <button class="hero-arrow" type="button" id="hero-prev" aria-label="前のスライド">‹</button>
          {heroSlides.map((_, index) => (
            <button class={`hero-dot${index === 0 ? " is-active" : ""}`} type="button" data-slide={index} aria-label={`${index + 1}枚目を表示`}></button>
          ))}
          <button class="hero-arrow" type="button" id="hero-next" aria-label="次のスライド">›</button>
        </div>
      </div>
    </section>

    <section id="stickers">
      <div class="section-header">
        <div>
          <div class="section-label">STICKER COLLECTION</div>
          <h2 class="section-title">STICKERS</h2>
        </div>
        <div class="section-count" id="sticker-count">{stickers.length} STICKERS</div>
      </div>

      <div class="controls" id="category-controls" aria-label="カテゴリー">
        <button class="category-button is-active" type="button" data-category="すべて">すべて</button>
      </div>

      <div class="sticker-grid" id="sticker-grid">
        {
          categorizedStickers.map((sticker, index) => (
            <a
              href={`/stickers/${sticker.id}`}
              class="sticker-card"
              data-category={sticker.category}
              data-index={index}
            >
              <div class="sticker-image-wrap">
                <img
                  class="sticker-image"
                  src={sticker.image}
                  alt={sticker.title}
                  loading={index < 8 ? "eager" : "lazy"}
                />
              </div>
              <div class="sticker-content">
                <div class="sticker-number">{String(index + 1).padStart(3, "0")}</div>
                <h3 class="sticker-title">{sticker.title}</h3>
                {
                  sticker.description && (
                    <p class="sticker-description">{sticker.description}</p>
                  )
                }
                <div class="sticker-meta">
                  <div class="price">{sticker.price}</div>
                  <div class="detail-link">詳しく見る →</div>
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <div class="empty-state" id="empty-state">該当するスタンプがありません。</div>
      <nav class="pagination" id="pagination" aria-label="ページ"></nav>
    </section>

    {suzuriDesigns.length > 0 && (
      <section class="goods-section" id="character-goods">
        <div class="section-header">
          <div>
            <div class="section-label">CHARACTER GOODS / SUZURI</div>
            <h2 class="section-title">キャラデザイン</h2>
          </div>
          <div class="section-count">{suzuriDesigns.length} DESIGNS</div>
        </div>
        <p class="goods-lead">LINEスタンプから生まれたキャラクターたちを、Tシャツやステッカーなどのグッズにしました。</p>
        <div class="goods-grid">
          {suzuriDesigns.map((design, index) => (
            <a class="goods-card" href={design.url} target="_blank" rel="noopener noreferrer">
              <div class="goods-image-wrap">
                <img class="goods-image" src={design.image} alt={`${design.title}のSUZURIグッズ`} loading={index < 4 ? "eager" : "lazy"} />
              </div>
              <div class="goods-content">
                <div class="goods-label">SUZURI / {design.itemName}</div>
                <h3 class="goods-title">{design.title}</h3>
                <div class="goods-link">グッズを見る ↗</div>
              </div>
            </a>
          ))}
        </div>
        <div class="goods-footer">
          <a class="goods-shop-button" href="https://suzuri.jp/bayasihimokei" target="_blank" rel="noopener noreferrer">SUZURIショップをすべて見る ↗</a>
        </div>
      </section>
    )}

    <section class="intro">
      <div class="intro-label">ABOUT / stamp moke</div>
      <h2 class="intro-title">毎日のひとことを、<br />ちょっと楽しく。</h2>
      <p class="intro-text">
        stamp moke（スタンプもけ／スタンプモケ）は、studio moke（スタジオモケ）が運営する、LINEで使いやすいスタンプを見つけるためのメディアです。
        スタンプが増えても探しやすいように、カテゴリーとページ送りで整理していきます。
      </p>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <div>
          <div class="footer-brand">stamp moke</div>
          <div class="footer-copy">LINEスタンプ専門メディア<br />お気に入りのスタンプを見つけよう。</div>
        </div>
        <div>
          <div class="footer-heading">NAVIGATION</div>
          <a class="footer-link" href="#stickers">スタンプ一覧</a>
          <a class="footer-link" href="/">トップへ戻る</a>
        </div>
        <div>
          <div class="footer-heading">LINK</div>
          <a class="footer-link" href="https://store.line.me/" target="_blank" rel="noreferrer">LINE STORE</a>
          <a class="footer-link" href="https://suzuri.jp/bayasihimokei" target="_blank" rel="noopener noreferrer">LINEスタンプキャラグッズ店（SUZURI）</a>
          <a class="footer-link" href="https://x.com/stampmoke" target="_blank" rel="noopener noreferrer">公式X @stampmoke</a>
        </div>
      </div>
      <div class="copyright">
        <span>© stamp moke</span>
        <span>LINE STICKERS / stamp moke</span>
      </div>
    </div>
  </footer>

  <script>
    const carousel = document.getElementById("hero-carousel");
    const slides = Array.from(carousel.querySelectorAll(".hero-slide"));
    const dots = Array.from(carousel.querySelectorAll(".hero-dot"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let currentSlide = 0;
    let slideTimer;
    let touchStartX = 0;

    function showSlide(index) {
      currentSlide = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === currentSlide;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });
      dots.forEach((dot, dotIndex) => dot.classList.toggle("is-active", dotIndex === currentSlide));
    }

    function stopSlides() {
      if (slideTimer) window.clearInterval(slideTimer);
    }

    function startSlides() {
      stopSlides();
      if (!reducedMotion) slideTimer = window.setInterval(() => showSlide(currentSlide + 1), 5000);
    }

    document.getElementById("hero-prev").addEventListener("click", () => { showSlide(currentSlide - 1); startSlides(); });
    document.getElementById("hero-next").addEventListener("click", () => { showSlide(currentSlide + 1); startSlides(); });
    dots.forEach((dot) => dot.addEventListener("click", () => { showSlide(Number(dot.dataset.slide)); startSlides(); }));
    carousel.addEventListener("mouseenter", stopSlides);
    carousel.addEventListener("mouseleave", startSlides);
    carousel.addEventListener("focusin", stopSlides);
    carousel.addEventListener("focusout", startSlides);
    carousel.addEventListener("touchstart", (event) => { touchStartX = event.changedTouches[0].clientX; }, { passive: true });
    carousel.addEventListener("touchend", (event) => {
      const distance = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(distance) > 45) showSlide(currentSlide + (distance < 0 ? 1 : -1));
      startSlides();
    }, { passive: true });
    document.addEventListener("visibilitychange", () => document.hidden ? stopSlides() : startSlides());
    startSlides();

    const PAGE_SIZE = 24;
    const cards = Array.from(document.querySelectorAll(".sticker-card"));
    const controls = document.getElementById("category-controls");
    const pagination = document.getElementById("pagination");
    const emptyState = document.getElementById("empty-state");
    const countLabel = document.getElementById("sticker-count");

    const categories = [
      "すべて",
      ...new Set(cards.map((card) => card.dataset.category).filter(Boolean)),
    ];

    function makeButton(label, count, active) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = `category-button${active ? " is-active" : ""}`;
      button.dataset.category = label;
      button.innerHTML = `${label}<span class="category-count">(${count})</span>`;
      return button;
    }

    function filteredCards(category) {
      return category === "すべて"
        ? cards
        : cards.filter((card) => card.dataset.category === category);
    }

    function renderPagination(totalPages, currentPage, onChange) {
      pagination.replaceChildren();

      const add = (label, page, disabled = false, active = false) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = `page-button${active ? " is-active" : ""}`;
        button.textContent = label;
        button.disabled = disabled;
        button.addEventListener("click", () => onChange(page));
        pagination.appendChild(button);
      };

      add("‹", currentPage - 1, currentPage === 1);

      const pages = [];
      if (totalPages <= 7) {
        for (let page = 1; page <= totalPages; page++) pages.push(page);
      } else {
        pages.push(1);
        if (currentPage > 4) pages.push("…");
        const start = Math.max(2, currentPage - 1);
        const end = Math.min(totalPages - 1, currentPage + 1);
        for (let page = start; page <= end; page++) pages.push(page);
        if (currentPage < totalPages - 3) pages.push("…");
        pages.push(totalPages);
      }

      pages.forEach((page) => {
        if (page === "…") {
          const span = document.createElement("span");
          span.className = "page-gap";
          span.textContent = "…";
          pagination.appendChild(span);
        } else {
          add(String(page), page, false, page === currentPage);
        }
      });

      add("›", currentPage + 1, currentPage === totalPages);
    }

    function render(category = "すべて", page = 1) {
      const visible = filteredCards(category);
      const totalPages = Math.max(1, Math.ceil(visible.length / PAGE_SIZE));
      const safePage = Math.min(Math.max(page, 1), totalPages);
      const start = (safePage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const visibleSet = new Set(visible.slice(start, end));

      cards.forEach((card) => {
        card.hidden = !visibleSet.has(card);
      });

      emptyState.style.display = visible.length === 0 ? "block" : "none";
      countLabel.textContent = `${visible.length} STICKERS`;
      renderPagination(totalPages, safePage, (nextPage) => {
        render(category, nextPage);
        document.getElementById("stickers").scrollIntoView({ behavior: "smooth", block: "start" });
      });

      controls.querySelectorAll(".category-button").forEach((button) => {
        button.classList.toggle("is-active", button.dataset.category === category);
      });
    }

    categories.forEach((category) => {
      const count = category === "すべて"
        ? cards.length
        : cards.filter((card) => card.dataset.category === category).length;
      controls.appendChild(makeButton(category, count, category === "すべて"));
    });

    controls.addEventListener("click", (event) => {
      const button = event.target.closest(".category-button");
      if (!button) return;
      render(button.dataset.category, 1);
    });

    render();
  </script>
</body>
</html>
