---
import Analytics from "./Analytics.astro";
import { normalizeLocale } from "../lib/i18n";
const locale=normalizeLocale(Astro.props.locale||"ja");
const prefix=locale==="ja"?"":`/${locale}`;
const copy={
 ja:{title:"サイト内検索",lead:"LINEスタンプ、フリー素材、キャラクターグッズをまとめて検索できます。作品名だけでなく、説明文・用途・タグ・スタンプのセリフ・GPTによる詳細紹介も検索対象です。",placeholder:"例：大阪弁、仕事、猫、ポケカラ、サムネ…",search:"検索",all:"すべて",sticker:"スタンプ",free:"フリー素材",goods:"グッズ",empty:"該当する作品が見つかりませんでした。別の言葉でも試してみてください。",start:"キーワードを入力すると、サイト全体から探します。",loading:"検索しています…",results:"件",navStickers:"スタンプを見る",navGoods:"キャラグッズ店",navFree:"フリー素材集",navSearch:"検索"},
 en:{title:"Search stamp moke",lead:"Search LINE stickers, free assets and character goods together. Titles, descriptions, uses, tags, detected sticker phrases and GPT editorial copy are searchable.",placeholder:"Try: work, cat, cute, thumbnail…",search:"Search",all:"All",sticker:"Stickers",free:"Free assets",goods:"Goods",empty:"No matching items found. Try another keyword.",start:"Enter a keyword to search the whole site.",loading:"Searching…",results:"results",navStickers:"Stickers",navGoods:"Goods",navFree:"Free assets",navSearch:"Search"},
 "zh-tw":{title:"站內搜尋",lead:"一次搜尋 LINE 貼圖、免費素材與角色周邊。作品名稱、說明、用途、標籤、貼圖文字與 GPT 詳細介紹都可搜尋。",placeholder:"例如：工作、貓咪、可愛、縮圖…",search:"搜尋",all:"全部",sticker:"貼圖",free:"免費素材",goods:"周邊",empty:"找不到符合的內容，請換個關鍵字。",start:"輸入關鍵字即可搜尋整個網站。",loading:"搜尋中…",results:"件",navStickers:"貼圖",navGoods:"角色周邊",navFree:"免費素材",navSearch:"搜尋"},
 th:{title:"ค้นหาภายในเว็บไซต์",lead:"ค้นหาสติกเกอร์ LINE สื่อฟรี และสินค้าคาแรกเตอร์พร้อมกัน ทั้งชื่อ คำอธิบาย การใช้งาน แท็ก ข้อความในสติกเกอร์ และบทความ GPT",placeholder:"เช่น งาน แมว น่ารัก thumbnail…",search:"ค้นหา",all:"ทั้งหมด",sticker:"สติกเกอร์",free:"素材ฟรี",goods:"สินค้า",empty:"ไม่พบรายการที่ตรงกัน ลองใช้คำค้นอื่น",start:"พิมพ์คำค้นเพื่อค้นหาทั้งเว็บไซต์",loading:"กำลังค้นหา…",results:"รายการ",navStickers:"สติกเกอร์",navGoods:"สินค้า",navFree:"素材ฟรี",navSearch:"ค้นหา"},
 id:{title:"Pencarian situs",lead:"Cari stiker LINE, aset gratis, dan produk karakter sekaligus. Judul, deskripsi, kegunaan, tag, frasa stiker, dan uraian GPT dapat dicari.",placeholder:"Contoh: kerja, kucing, lucu, thumbnail…",search:"Cari",all:"Semua",sticker:"Stiker",free:"Aset gratis",goods:"Produk",empty:"Tidak ada hasil yang cocok. Coba kata kunci lain.",start:"Masukkan kata kunci untuk mencari seluruh situs.",loading:"Mencari…",results:"hasil",navStickers:"Stiker",navGoods:"Produk",navFree:"Aset gratis",navSearch:"Cari"}
};
const t=copy[locale]||copy.ja;
const canonical=`https://stamp-moke.jp${prefix}/search/`;
---
<!doctype html><html lang={locale==='zh-tw'?'zh-Hant':locale}><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{t.title}｜スタンプ・素材・グッズを横断検索 | stamp moke</title><meta name="description" content={t.lead}><link rel="canonical" href={canonical}><meta name="robots" content="index,follow"><Analytics />
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}.header{min-height:86px;background:rgba(255,255,255,.96);border-bottom:1px solid #e4e3df;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px 5vw;position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)}.brand{text-decoration:none}.brand-title{font-size:21px;font-weight:900;letter-spacing:.1em}.brand-sub{font-size:11px;color:#777;margin-top:7px}.nav{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.nav a{text-decoration:none;border:1px solid #d9d8d4;background:#fff;padding:10px 14px;border-radius:999px;font-size:11px;font-weight:800}.nav a.shop{background:#171717;color:#fff;border-color:#171717}.nav a.active{background:#f2efe6;border-color:#d8d2c4}.main{max-width:1080px;margin:auto;padding:54px 22px 90px}.eyebrow{font-size:10px;letter-spacing:.2em;font-weight:900;color:#777}.hero h1{font-size:clamp(38px,6vw,68px);line-height:1;margin:12px 0 18px;letter-spacing:-.05em}.lead{max-width:780px;color:#666;font-size:13px;line-height:1.9}.search-box{display:flex;gap:8px;margin-top:28px;background:#fff;border:1px solid #dddcd7;padding:9px;border-radius:18px;box-shadow:0 12px 32px rgba(40,38,32,.05)}.search-box input{flex:1;min-width:0;border:0;background:#faf9f5;border-radius:12px;padding:14px 16px;font-size:16px;outline:none}.search-box button{border:0;border-radius:12px;background:#171717;color:#fff;padding:0 24px;font-weight:900;cursor:pointer}.tabs{display:flex;gap:7px;flex-wrap:wrap;margin:22px 0 14px}.tab{border:1px solid #d9d8d4;background:#fff;border-radius:999px;padding:8px 13px;font-size:11px;font-weight:800;cursor:pointer}.tab.active{background:#171717;color:#fff;border-color:#171717}.summary{font-size:12px;color:#777;min-height:22px;margin-bottom:14px}.results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.result{display:grid;grid-template-columns:140px minmax(0,1fr);background:#fff;border:1px solid #deddd8;border-radius:17px;overflow:hidden;text-decoration:none;min-height:140px;transition:transform .18s ease,box-shadow .18s ease}.result:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(30,28,24,.07)}.media{background:#ecebe6;min-height:140px;overflow:hidden}.media img{width:100%;height:100%;object-fit:cover;display:block}.body{padding:14px;min-width:0}.kind{font-size:9px;font-weight:900;letter-spacing:.1em;color:#777;text-transform:uppercase}.body h2{font-size:15px;line-height:1.45;margin:6px 0 7px}.body p{font-size:11px;color:#6b6b6b;line-height:1.65;margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.chips{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.chip{font-size:9px;background:#f1f0eb;padding:5px 7px;border-radius:999px;color:#666}.message{grid-column:1/-1;background:#fff;border:1px dashed #d5d3cb;border-radius:18px;padding:45px 20px;text-align:center;color:#777;font-size:13px;line-height:1.8}.footer{margin-top:65px;padding-top:24px;border-top:1px solid #deddd8;color:#777;font-size:11px}@media(max-width:760px){.header{min-height:72px;padding:10px 12px;align-items:flex-start}.brand-title{font-size:17px}.brand-sub{font-size:9px}.nav{max-width:70%;gap:4px}.nav a{padding:7px 9px;font-size:9px}.main{padding:34px 12px 70px}.search-box{padding:7px}.search-box input{font-size:14px;padding:12px}.search-box button{padding:0 15px}.results{grid-template-columns:1fr}.result{grid-template-columns:112px minmax(0,1fr);min-height:118px}.media{min-height:118px}.body{padding:11px}.body h2{font-size:13px}}
</style></head><body><header class="header"><a class="brand" href={`${prefix}/`}><div class="brand-title">stamp moke</div><div class="brand-sub">LINE STICKERS & FREE ASSETS</div></a><nav class="nav"><a href={`${prefix}/#stickers`}>{t.navStickers}</a><a class="shop" href={`${prefix}/goods/`}>{t.navGoods}</a><a href={`${prefix}/free/`}>{t.navFree}</a><a class="active" href={`${prefix}/search/`}>{t.navSearch}</a></nav></header><main class="main"><section class="hero"><div class="eyebrow">SITE SEARCH</div><h1>{t.title}</h1><p class="lead">{t.lead}</p><form id="searchForm" class="search-box"><input id="q" type="search" autocomplete="off" placeholder={t.placeholder} aria-label={t.title}><button type="submit">{t.search}</button></form></section><div id="tabs" class="tabs"><button class="tab active" data-type="all">{t.all} <span data-count="all"></span></button><button class="tab" data-type="sticker">{t.sticker} <span data-count="sticker"></span></button><button class="tab" data-type="free">{t.free} <span data-count="free"></span></button><button class="tab" data-type="goods">{t.goods} <span data-count="goods"></span></button></div><div id="summary" class="summary"></div><section id="results" class="results"><div class="message">{t.start}</div></section><footer class="footer">stamp moke · search across LINE stickers, free assets and original goods</footer></main>
<script define:vars={{ locale, t }}>
const q=document.getElementById('q'),form=document.getElementById('searchForm'),results=document.getElementById('results'),summary=document.getElementById('summary'),tabs=[...document.querySelectorAll('.tab')];let active='all',lastQuery='';const esc=(v='')=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));const typeLabel={sticker:t.sticker,free:t.free,goods:t.goods};function setCounts(c={}){document.querySelectorAll('[data-count]').forEach(el=>{const n=c[el.dataset.count]||0;el.textContent=n?`(${n})`:''})}function render(data){setCounts(data.counts);summary.textContent=data.counts?.all?`${data.counts.all} ${t.results}`:'';if(!data.results?.length){results.innerHTML=`<div class="message">${esc(t.empty)}</div>`;return}results.innerHTML=data.results.map(item=>`<a class="result" href="${esc(item.url)}" ${item.external?'target="_blank" rel="noopener noreferrer"':''}><div class="media">${item.image?`<img loading="lazy" decoding="async" src="${esc(item.image)}" alt="${esc(item.title)}">`:''}</div><div class="body"><div class="kind">${esc(typeLabel[item.type]||item.type)}</div><h2>${esc(item.title)}</h2><p>${esc(item.description||'')}</p>${item.tags?.length?`<div class="chips">${item.tags.slice(0,5).map(x=>`<span class="chip">${esc(x)}</span>`).join('')}</div>`:''}</div></a>`).join('')}async function run(push=true){const value=q.value.trim();lastQuery=value;if(!value){results.innerHTML=`<div class="message">${esc(t.start)}</div>`;summary.textContent='';setCounts({});return}results.innerHTML=`<div class="message">${esc(t.loading)}</div>`;const url=`/api/site-search?q=${encodeURIComponent(value)}&locale=${encodeURIComponent(locale)}&type=${encodeURIComponent(active)}`;try{const r=await fetch(url);const data=await r.json();if(value!==lastQuery)return;if(!r.ok)throw new Error(data.error||'search failed');render(data);if(push){const u=new URL(location.href);u.searchParams.set('q',value);if(active!=='all')u.searchParams.set('type',active);else u.searchParams.delete('type');history.replaceState({},'',u)}}catch(e){results.innerHTML=`<div class="message">${esc(t.empty)}</div>`}}form.addEventListener('submit',e=>{e.preventDefault();run()});tabs.forEach(btn=>btn.addEventListener('click',()=>{tabs.forEach(x=>x.classList.remove('active'));btn.classList.add('active');active=btn.dataset.type||'all';if(q.value.trim())run()}));const params=new URLSearchParams(location.search),initial=params.get('q'),initialType=params.get('type');if(initialType&&tabs.some(x=>x.dataset.type===initialType)){active=initialType;tabs.forEach(x=>x.classList.toggle('active',x.dataset.type===active))}if(initial){q.value=initial;run(false)}
</script></body></html>
