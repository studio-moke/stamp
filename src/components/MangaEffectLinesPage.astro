---
import SiteHeader from "./SiteHeader.astro";
const { locale="ja" } = Astro.props;
const prefix = locale === "ja" ? "" : `/${locale}`;
const nav=[
  ["集中線","manga-speed-lines"],["効果線","manga-effect-lines"],["フキダシ","manga-speech-bubble"],["効果音","manga-sfx"],["ポップアート","pop-art-maker"],["ドット絵","pixel-art-maker"],["ステッカー","sticker-maker"]
];
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>漫画効果線メーカー｜スピード線・斜線・震え線を無料生成 | stamp moke</title><meta name="description" content="漫画のスピード線・斜線・震え線・波線・雨線などの効果線をブラウザで自由に作成。透過PNGで保存できます。"/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/manga-effect-lines/`}/>
<style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:1080px;margin:auto;padding:34px 18px 80px}.crumb{font-size:11px;color:#777;margin-bottom:20px}.crumb a{color:inherit}.toolnav{display:flex;gap:7px;overflow:auto;padding:4px 0 18px}.toolnav a{white-space:nowrap;text-decoration:none;color:#555;background:#fff;border:1px solid #ddd;border-radius:999px;padding:9px 13px;font-size:10px;font-weight:800}.toolnav a.on{background:#171717;color:#fff}.hero{text-align:center;padding:18px 0 30px}.icon{width:58px;height:58px;border-radius:18px;margin:0 auto 13px;display:grid;place-items:center;background:#171717;color:#fff;font-size:24px}.hero h1{font-size:clamp(32px,6vw,58px);letter-spacing:-.05em;margin:0 0 10px}.hero .sub{font-weight:900;font-size:15px}.hero p{max-width:650px;margin:10px auto 0;color:#6a6a6a;font-size:12px;line-height:1.9}.app{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px;align-items:start}.preview{background:#fff;border:1px solid #ddd;border-radius:22px;padding:14px}.stage{border-radius:15px;overflow:hidden;background:linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%);background-size:20px 20px}.stage canvas{display:block;width:100%;height:auto}.controls{background:#fff;border:1px solid #ddd;border-radius:22px;padding:18px;position:sticky;top:14px}.controls h2{font-size:14px;margin:0 0 15px}.row{margin:0 0 15px}.row label{display:flex;justify-content:space-between;gap:10px;font-size:10px;font-weight:900;margin-bottom:7px}.row input[type=range],.row select,.row input[type=color]{width:100%}.row select{border:1px solid #ccc;border-radius:10px;padding:10px;background:#fff}.row input[type=color]{height:40px;border:1px solid #ccc;border-radius:10px;background:#fff;padding:3px}.checks{display:grid;grid-template-columns:1fr 1fr;gap:6px}.checks label{display:flex;align-items:center;gap:6px;font-size:10px;background:#f6f5f1;border:1px solid #ddd;border-radius:9px;padding:8px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:7px}.actions button{border:0;border-radius:11px;padding:13px 8px;font-size:10px;font-weight:900;cursor:pointer}.download{background:#171717;color:#fff}.secondary{background:#eceae4}.note{font-size:9px;color:#888;line-height:1.6;margin-top:10px}@media(max-width:800px){.app{grid-template-columns:1fr}.controls{position:static}}@media(max-width:520px){.wrap{padding:22px 10px 55px}.preview{padding:8px;border-radius:16px}.controls{border-radius:16px;padding:14px}.hero{padding-top:8px}}</style></head><body><SiteHeader locale={locale}/><main class="wrap"><div class="crumb"><a href={`${prefix}/`}>stamp moke</a> / <a href={`${prefix}/free/`}>無料ツール</a> / 漫画効果線メーカー</div><nav class="toolnav">{nav.map(n=><a class={n[1]==="manga-effect-lines"?'on':''} href={`${prefix}/${n[1]}/`}>{n[0]}</a>)}</nav><section class="hero"><div class="icon">〽</div><h1>漫画効果線メーカー</h1><div class="sub">スピード線・斜線・震え線・波線を自由に生成</div><p>漫画やイラストの背景に使える効果線を、線の密度・太さ・角度・揺れ・長さを調整して作れます。<br/>画像はサーバーへ送らず、この端末のブラウザ内で処理します。</p></section><section class="app"><div class="preview"><div class="stage"><canvas id="canvas" width="900" height="900"></canvas></div></div><aside class="controls"><h2>調整</h2><div class="row"><label><span>効果線タイプ</span></label><select id="type"><option value="speed">スピード線</option><option value="diagonal">斜線</option><option value="shake">震え線</option><option value="wave">波線</option><option value="rain">雨線</option><option value="cross">交差線</option></select></div><div class="row"><label><span>線の本数</span><b id="countv">70</b></label><input id="count" type="range" min="10" max="180" value="70"/></div><div class="row"><label><span>線の太さ</span><b id="widthv">3</b></label><input id="width" type="range" min="1" max="12" value="3"/></div><div class="row"><label><span>角度</span><b id="anglev">20</b></label><input id="angle" type="range" min="-90" max="90" value="20"/></div><div class="row"><label><span>揺れ</span><b id="jitterv">28</b></label><input id="jitter" type="range" min="0" max="100" value="28"/></div><div class="row"><label><span>線の長さ</span><b id="lengthv">80</b></label><input id="length" type="range" min="20" max="100" value="80"/></div><div class="row"><label><span>線の色</span></label><input id="color" type="color" value="#111111"/></div><div class="checks"><label><input id="fade" type="checkbox" checked/>端を薄く</label><label><input id="random" type="checkbox" checked/>長さをランダム</label></div><div class="actions" style="margin-top:14px"><button class="secondary" id="regen">ランダム</button><button class="download" id="download">PNG保存</button></div><div class="note">背景は透明です。漫画・動画・サムネイル・SNS素材などに使えます。</div></aside></section></main><script is:inline>(()=>{const c=document.getElementById('canvas'),ctx=c.getContext('2d');let seed=13;const ids=['count','width','angle','jitter','length'];for(const id of ids){const e=document.getElementById(id),v=document.getElementById(id+'v');e.oninput=()=>{v.textContent=e.value;draw()}}for(const id of ['type','color','fade','random'])document.getElementById(id).addEventListener('input',draw);function rnd(){seed=(seed*9301+49297)%233280;return seed/233280}function line(x1,y1,x2,y2,w,a=1){ctx.globalAlpha=a;ctx.lineWidth=w;ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke()}function draw(){ctx.clearRect(0,0,c.width,c.height);seed=13;const type=document.getElementById('type').value,n=+document.getElementById('count').value,w=+document.getElementById('width').value,ang=+document.getElementById('angle').value*Math.PI/180,jit=+document.getElementById('jitter').value/100,len=+document.getElementById('length').value/100,fade=document.getElementById('fade').checked,random=document.getElementById('random').checked;ctx.strokeStyle=document.getElementById('color').value;ctx.lineCap='round';for(let i=0;i<n;i++){let a=ang+(rnd()-.5)*jit*.4,L=900*len*(random?(.45+rnd()*.55):1),x=rnd()*900,y=rnd()*900,alpha=fade?.35+rnd()*.65:1;if(type==='speed'){x=-120;y=(i/(n-1))*1020-60;line(x,y,x+Math.cos(a)*L,y+Math.sin(a)*L,w*(.6+rnd()*.8),alpha)}else if(type==='diagonal'){x=(i/(n-1))*1080-90;y=-120;line(x,y,x+Math.cos(a+Math.PI/2)*L,y+Math.sin(a+Math.PI/2)*L,w*(.7+rnd()*.5),alpha)}else if(type==='rain'){a=ang+Math.PI/2;x=rnd()*900;y=rnd()*900-300;line(x,y,x+Math.cos(a)*L*.45,y+Math.sin(a)*L*.45,w*(.5+rnd()*.7),alpha)}else if(type==='cross'){const a2=i%2?a+Math.PI/2:a;line(x,y,x+Math.cos(a2)*L*.6,y+Math.sin(a2)*L*.6,w,alpha)}else{ctx.globalAlpha=alpha;ctx.lineWidth=w*(.7+rnd()*.5);ctx.beginPath();ctx.moveTo(x,y);const steps=type==='wave'?18:12;for(let s=1;s<=steps;s++){const t=s/steps,baseX=x+Math.cos(a)*L*t,baseY=y+Math.sin(a)*L*t,amp=type==='wave'?Math.sin(t*Math.PI*6)*18*(.4+jit):((rnd()-.5)*35*jit);ctx.lineTo(baseX-Math.sin(a)*amp,baseY+Math.cos(a)*amp)}ctx.stroke()}}ctx.globalAlpha=1}document.getElementById('regen').onclick=()=>{seed=Math.floor(Math.random()*99999);draw()};document.getElementById('download').onclick=()=>{c.toBlob(b=>{const u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='manga-effect-lines.png';a.click();setTimeout(()=>URL.revokeObjectURL(u),1200)},'image/png')};draw()})();</script></body></html>