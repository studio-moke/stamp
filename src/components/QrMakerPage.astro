---
import SiteHeader from "./SiteHeader.astro";
import { localeInfo, normalizeLocale } from "../lib/i18n";
const locale = normalizeLocale(Astro.props.locale);
const C = {
  ja:{title:"かわいいQRコードメーカー｜色・動物・キャラ入りQRを無料作成 | stamp moke",desc:"色・形・余白・動物キャラや自分のロゴを自由に選んで、かわいいQRコードを無料作成。登録不要・ブラウザ内生成・PNG保存対応。",hero:"かわいいQRコードを、\n自分らしく。",lead:"URLや文字を入れて、色・形・動物キャラ・自分のロゴを選ぶだけ。シンプルにも、かわいくも作れます。",badges:["無料","登録不要","PNG保存","画像は送信しません"],design:"デザインする",input:"URL・テキスト",theme:"かわいい配色",themes:["シンプル","いちごミルク","ラベンダー","ミント","ソーダ","カフェラテ"],color:"カラー",qrColor:"QRの色",bg:"背景色",shape:"QRの形",shapes:["四角","角丸","ドット"],margin:"余白",center:"真ん中のキャラ",chars:["なし","ねこ","いぬ","うさぎ","くま","パンダ","ひよこ","ハリネズミ","きつね","ペンギン","コアラ"],upload:"または、自分の画像・ロゴ",choose:"画像を選ぶ",clear:"解除",uploadHint:"PNG / JPG / WebP / SVG（5MBまで）",size:"中央画像サイズ",sizes:["小","中","大"],preview:"プレビュー",quality:"読み取りやすさ目安",save:"PNGで保存",reset:"リセット",noteTitle:"読み取りについて：",note:"「読み取りやすさ目安」は色のコントラスト、余白、中央画像サイズ、QRの形、入力文字量から算出する簡易チェックです。実際のカメラ読み取りを保証するものではありません。中央画像を使う場合は誤り訂正レベルHで生成します。アップロード画像・URL・テキストはサーバーへ送信せず、ブラウザ内だけで処理します。",count:"文字",status:{lowContrast:"QRと背景の色が近すぎます。より濃淡差のある配色にしてください。",large:"中央画像「大」はデザイン性重視です。保存後に必ず読み取り確認をしてください。",improve:"読み取りやすさを上げるには、余白を4以上・中央画像を小さめにするのがおすすめです。",center:"中央画像に合わせて誤り訂正レベルHで生成しています。",good:"読み取りやすさを保ちながら生成しています。",error:"QRコードを生成できませんでした。入力内容をご確認ください。",tooBig:"5MB以下の画像を選んでください。",selected:"選択中：",imageError:"画像を読み込めませんでした。別の画像をお試しください。"}},
  en:{title:"Cute QR Code Maker | Free Custom QR with Colors & Icons | stamp moke",desc:"Create a cute QR code for free with custom colors, shapes, spacing, animal icons or your own logo. No signup. Browser-only generation and PNG export.",hero:"Make a cute QR code,\nyour way.",lead:"Enter a URL or text, then choose colors, shape, an animal icon or your own logo. Keep it simple or make it cute.",badges:["Free","No signup","PNG export","Images stay on your device"],design:"Design",input:"URL or text",theme:"Cute color themes",themes:["Simple","Strawberry Milk","Lavender","Mint","Soda","Cafe Latte"],color:"Colors",qrColor:"QR color",bg:"Background",shape:"QR style",shapes:["Square","Rounded","Dots"],margin:"Quiet zone",center:"Center character",chars:["None","Cat","Dog","Rabbit","Bear","Panda","Chick","Hedgehog","Fox","Penguin","Koala"],upload:"Or use your own image / logo",choose:"Choose image",clear:"Remove",uploadHint:"PNG / JPG / WebP / SVG (max 5MB)",size:"Center image size",sizes:["Small","Medium","Large"],preview:"Preview",quality:"Readability estimate",save:"Save PNG",reset:"Reset",noteTitle:"About readability: ",note:"The readability score is a simple estimate based on contrast, quiet zone, center image size, QR style and text length. It does not guarantee camera scanning. Error correction level H is used when a center image is present. Uploaded images, URLs and text are processed only in your browser.",count:" chars",status:{lowContrast:"The QR and background colors are too similar. Choose stronger contrast.",large:"A large center image prioritizes design. Test the saved QR with a real phone.",improve:"For better readability, use a quiet zone of 4 or more and a smaller center image.",center:"Using error correction level H for the center image.",good:"Generated with readability in mind.",error:"Could not generate the QR code. Check your input.",tooBig:"Choose an image under 5MB.",selected:"Selected: ",imageError:"Could not load this image. Try another file."}},
  "zh-tw":{title:"可愛QR Code產生器｜免費自訂顏色與角色 | stamp moke",desc:"免費製作可愛QR Code，可自訂顏色、形狀、留白、動物角色或自己的Logo。免註冊、瀏覽器內處理、支援PNG儲存。",hero:"做一個可愛的QR Code，\n展現你的風格。",lead:"輸入網址或文字，再選擇顏色、形狀、動物角色或自己的Logo。簡約或可愛都可以。",badges:["免費","免註冊","PNG儲存","圖片不會上傳"],design:"設計QR Code",input:"網址・文字",theme:"可愛配色",themes:["簡約","草莓牛奶","薰衣草","薄荷","蘇打","咖啡拿鐵"],color:"顏色",qrColor:"QR顏色",bg:"背景色",shape:"QR形狀",shapes:["方形","圓角","圓點"],margin:"留白",center:"中央角色",chars:["無","貓","狗","兔子","熊","熊貓","小雞","刺蝟","狐狸","企鵝","無尾熊"],upload:"或使用自己的圖片・Logo",choose:"選擇圖片",clear:"移除",uploadHint:"PNG / JPG / WebP / SVG（5MB以內）",size:"中央圖片大小",sizes:["小","中","大"],preview:"預覽",quality:"可讀性參考",save:"儲存PNG",reset:"重設",noteTitle:"關於讀取：",note:"可讀性分數是根據顏色對比、留白、中央圖片大小、QR形狀與文字長度計算的簡易參考，並不保證實際相機一定能讀取。使用中央圖片時會採用H級錯誤修正。圖片、網址與文字只在瀏覽器內處理。",count:"字",status:{lowContrast:"QR與背景顏色太接近，請提高明暗對比。",large:"中央圖片使用「大」尺寸時偏重設計感，儲存後請用手機實際測試。",improve:"建議留白設為4以上，並縮小中央圖片以提升可讀性。",center:"已針對中央圖片使用H級錯誤修正。",good:"目前設定兼顧可讀性。",error:"無法產生QR Code，請確認輸入內容。",tooBig:"請選擇5MB以下的圖片。",selected:"已選擇：",imageError:"無法讀取圖片，請嘗試其他檔案。"}},
  th:{title:"สร้าง QR Code น่ารักฟรี | ปรับสีและใส่คาแรกเตอร์ | stamp moke",desc:"สร้าง QR Code น่ารักฟรี ปรับสี รูปแบบ ระยะขอบ ใส่คาแรกเตอร์สัตว์หรือโลโก้ของคุณได้ ไม่ต้องสมัคร และบันทึกเป็น PNG",hero:"สร้าง QR Code น่ารัก\nในสไตล์ของคุณ",lead:"ใส่ URL หรือข้อความ แล้วเลือกสี รูปแบบ คาแรกเตอร์สัตว์ หรือโลโก้ของคุณ จะเรียบง่ายหรือน่ารักก็ได้",badges:["ฟรี","ไม่ต้องสมัคร","บันทึก PNG","รูปไม่ถูกอัปโหลด"],design:"ออกแบบ",input:"URL หรือข้อความ",theme:"ชุดสีน่ารัก",themes:["เรียบง่าย","สตรอว์เบอร์รีมิลค์","ลาเวนเดอร์","มิ้นต์","โซดา","คาเฟ่ลาเต้"],color:"สี",qrColor:"สี QR",bg:"สีพื้นหลัง",shape:"รูปแบบ QR",shapes:["สี่เหลี่ยม","มุมมน","จุด"],margin:"ระยะขอบ",center:"คาแรกเตอร์ตรงกลาง",chars:["ไม่มี","แมว","สุนัข","กระต่าย","หมี","แพนด้า","ลูกเจี๊ยบ","เม่น","จิ้งจอก","เพนกวิน","โคอาลา"],upload:"หรือใช้รูป / โลโก้ของคุณ",choose:"เลือกรูป",clear:"ลบ",uploadHint:"PNG / JPG / WebP / SVG (ไม่เกิน 5MB)",size:"ขนาดรูปตรงกลาง",sizes:["เล็ก","กลาง","ใหญ่"],preview:"ตัวอย่าง",quality:"คะแนนการอ่านโดยประมาณ",save:"บันทึก PNG",reset:"รีเซ็ต",noteTitle:"เกี่ยวกับการอ่าน: ",note:"คะแนนนี้เป็นการประเมินจากคอนทราสต์ ระยะขอบ ขนาดรูปตรงกลาง รูปแบบ QR และความยาวข้อความ ไม่รับประกันการสแกนจริง เมื่อมีรูปตรงกลางจะใช้การแก้ไขข้อผิดพลาดระดับ H ข้อมูลทั้งหมดประมวลผลในเบราว์เซอร์เท่านั้น",count:" ตัวอักษร",status:{lowContrast:"สี QR กับพื้นหลังใกล้กันเกินไป ควรเพิ่มคอนทราสต์",large:"รูปตรงกลางขนาดใหญ่เน้นดีไซน์ โปรดทดสอบด้วยโทรศัพท์หลังบันทึก",improve:"แนะนำระยะขอบอย่างน้อย 4 และลดขนาดรูปตรงกลาง",center:"กำลังใช้การแก้ไขข้อผิดพลาดระดับ H สำหรับรูปตรงกลาง",good:"สร้างโดยคำนึงถึงการอ่าน",error:"สร้าง QR Code ไม่ได้ โปรดตรวจสอบข้อมูล",tooBig:"กรุณาเลือกรูปไม่เกิน 5MB",selected:"เลือกแล้ว: ",imageError:"โหลดรูปไม่ได้ กรุณาลองไฟล์อื่น"}},
  id:{title:"Pembuat QR Code Lucu Gratis | Warna & Karakter | stamp moke",desc:"Buat QR code lucu gratis dengan warna, bentuk, margin, karakter hewan atau logo sendiri. Tanpa daftar, diproses di browser, dan bisa disimpan sebagai PNG.",hero:"Buat QR code lucu,\ndengan gaya Anda.",lead:"Masukkan URL atau teks, lalu pilih warna, bentuk, karakter hewan atau logo Anda sendiri. Bisa simpel atau imut.",badges:["Gratis","Tanpa daftar","Simpan PNG","Gambar tidak diunggah"],design:"Desain",input:"URL atau teks",theme:"Tema warna lucu",themes:["Simpel","Strawberry Milk","Lavender","Mint","Soda","Cafe Latte"],color:"Warna",qrColor:"Warna QR",bg:"Latar belakang",shape:"Bentuk QR",shapes:["Kotak","Membulat","Titik"],margin:"Margin",center:"Karakter tengah",chars:["Tidak ada","Kucing","Anjing","Kelinci","Beruang","Panda","Anak ayam","Landak","Rubah","Penguin","Koala"],upload:"Atau gunakan gambar / logo sendiri",choose:"Pilih gambar",clear:"Hapus",uploadHint:"PNG / JPG / WebP / SVG (maks. 5MB)",size:"Ukuran gambar tengah",sizes:["Kecil","Sedang","Besar"],preview:"Pratinjau",quality:"Perkiraan keterbacaan",save:"Simpan PNG",reset:"Reset",noteTitle:"Tentang keterbacaan: ",note:"Skor ini adalah perkiraan sederhana berdasarkan kontras, margin, ukuran gambar tengah, bentuk QR, dan panjang teks. Tidak menjamin hasil pemindaian kamera. Koreksi kesalahan level H digunakan bila ada gambar tengah. Gambar, URL, dan teks diproses hanya di browser.",count:" karakter",status:{lowContrast:"Warna QR dan latar terlalu mirip. Gunakan kontras yang lebih kuat.",large:"Gambar tengah besar lebih mengutamakan desain. Uji QR setelah disimpan dengan ponsel.",improve:"Gunakan margin 4 atau lebih dan gambar tengah yang lebih kecil.",center:"Menggunakan koreksi kesalahan level H untuk gambar tengah.",good:"Dibuat dengan mempertimbangkan keterbacaan.",error:"QR code tidak dapat dibuat. Periksa input Anda.",tooBig:"Pilih gambar di bawah 5MB.",selected:"Dipilih: ",imageError:"Gambar tidak dapat dimuat. Coba file lain."}}
}[locale];
const path="/qr-maker";
const canonical=locale==="ja"?"https://stamp-moke.jp/qr-maker":`https://stamp-moke.jp/${locale}/qr-maker`;
const chars=["none","cat","dog","rabbit","bear","panda","chick","hedgehog","fox","penguin","koala"];
---
<!doctype html><html lang={localeInfo[locale].htmlLang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{C.title}</title><meta name="description" content={C.desc}/><link rel="canonical" href={canonical}/><link rel="stylesheet" href="/site-shell.css"/><meta property="og:title" content={C.title}/><meta property="og:description" content={C.desc}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/></head><body>
<SiteHeader locale={locale} path={path}/><main class="qr-wrap"><section class="qr-hero"><div class="qr-eyebrow">CUTE QR MAKER</div><h1>{C.hero.split("\n").map(x=><span>{x}<br/></span>)}</h1><p>{C.lead}</p><div class="qr-badges">{C.badges.map(x=><span>{x}</span>)}</div></section><section class="qr-grid"><div class="qr-card"><h2>{C.design}</h2><div class="field"><label for="qrText">{C.input}</label><input id="qrText" class="text" value="https://stamp-moke.jp/" autocomplete="off"/><div id="textInfo" class="small">22{C.count}</div></div><div class="field"><label>{C.theme}</label><div class="themes" id="themes">{C.themes.map((x,i)=><button class="theme" data-dark={["#342f33","#c94f82","#6556a8","#287d72","#326da3","#79533e"][i]} data-light={["#ffffff","#fff1f7","#f4f0ff","#effbf7","#eef7ff","#fff7ed"][i]}>{x}</button>)}</div></div><div class="field"><label>{C.color}</label><div class="color-grid"><div><div class="small">{C.qrColor}</div><div class="colorbox"><input id="qrColor" type="color" value="#342f33"/><span id="qrHex">#342f33</span></div></div><div><div class="small">{C.bg}</div><div class="colorbox"><input id="bgColor" type="color" value="#ffffff"/><span id="bgHex">#ffffff</span></div></div></div></div><div class="field"><label>{C.shape}</label><div class="choices" id="shapes">{C.shapes.map((x,i)=><button class:list={["choice",{active:i===0}]} data-shape={["square","rounded","dots"][i]}>{x}</button>)}</div></div><div class="field"><label>{C.margin}</label><div class="range-row"><input id="margin" type="range" min="2" max="8" value="4"/><span id="marginValue" class="value">4</span></div></div><div class="field"><label>{C.center}</label><div class="characters" id="characters">{chars.map((x,i)=><button class:list={["char",{active:i===0}]} data-char={x}><span class="char-icon">{["—","🐱","🐶","🐰","🐻","🐼","🐥","🦔","🦊","🐧","🐨"][i]}</span><span>{C.chars[i]}</span></button>)}</div></div><div class="field"><label>{C.upload}</label><div class="upload"><label class="upload-btn" for="logoFile">{C.choose}</label><input id="logoFile" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml"/><button id="clearLogo" class="clear-btn" type="button">{C.clear}</button></div><div id="uploadName" class="upload-name">{C.uploadHint}</div></div><div class="field"><label>{C.size}</label><div class="size-row" id="sizes">{C.sizes.map((x,i)=><button class:list={["size-btn",{active:i===1}]} data-size={["small","medium","large"][i]}>{x}</button>)}</div></div></div><div class="qr-card"><h2>{C.preview}</h2><div class="preview"><canvas id="qrCanvas" width="720" height="720"></canvas></div><div id="quality" class="quality good"><div><strong>{C.quality}</strong><div class="meter"><i id="meterBar"></i></div></div><div id="qualityScore" class="quality-score">100</div></div><div class="status" id="status" aria-live="polite">{C.status.good}</div><div class="actions"><button class="download" id="downloadBtn">{C.save}</button><button class="reset" id="resetBtn" type="button">{C.reset}</button></div></div></section><section class="note"><strong>{C.noteTitle}</strong>{C.note}</section></main>
<style>
:root{--ink:#302b30;--muted:#766d75;--line:#eadfe6;--pink:#ed78aa;--soft:#fff0f6}*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#fff7fb,#fff 44%);color:var(--ink);font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.qr-wrap{max-width:1160px;margin:auto;padding:22px}.qr-hero{text-align:center;padding:30px 10px 24px}.qr-eyebrow{font-size:12px;font-weight:900;letter-spacing:.13em;color:#b45b83}.qr-hero h1{font-size:clamp(31px,5vw,52px);line-height:1.12;margin:8px 0 12px}.qr-hero p{max-width:760px;margin:auto;color:var(--muted);line-height:1.8}.qr-badges,.choices,.themes{display:flex;gap:8px;flex-wrap:wrap}.qr-badges{justify-content:center;margin-top:14px}.qr-badges span{background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 11px;font-size:12px;font-weight:800}.qr-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(350px,.95fr);gap:20px}.qr-card,.note{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px;box-shadow:0 14px 40px rgba(126,70,98,.08)}h2{margin:0 0 18px}.field{margin-bottom:20px}.field>label{display:block;font-weight:900;margin-bottom:9px}.text{width:100%;border:2px solid #e5d7df;border-radius:14px;padding:14px;font-size:16px}.small,.upload-name{font-size:12px;color:var(--muted);font-weight:800;margin-top:7px}.color-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.colorbox{display:flex;align-items:center;gap:9px;border:1px solid var(--line);border-radius:13px;padding:9px}.colorbox input{width:36px;height:36px;border:0}.choice,.size-btn,.theme,.char,.upload-btn,.clear-btn{border:1px solid var(--line);background:#fff;border-radius:12px;padding:10px 13px;font-weight:850;cursor:pointer}.choice.active,.size-btn.active{background:#342f33;color:#fff}.characters{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.char{min-height:76px;padding:7px 3px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:11px}.char.active{border:2px solid var(--pink);background:var(--soft)}.char-icon{font-size:27px;line-height:1}.size-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.range-row,.upload{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.range-row input{flex:1}.upload input{display:none}.upload-btn{background:#fff0f6;color:#9b4269}.preview{display:flex;align-items:center;justify-content:center;min-height:430px;background:linear-gradient(45deg,#fff3f8 25%,#fff 25%,#fff 50%,#fff3f8 50%,#fff3f8 75%,#fff 75%);background-size:28px 28px;border:1px solid var(--line);border-radius:20px;padding:22px}.preview canvas{display:block;width:min(100%,430px);height:auto;border-radius:14px}.quality{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:13px;padding:12px 14px;border:1px solid var(--line);border-radius:14px}.quality>div:first-child{flex:1}.quality-score{font-size:20px;font-weight:950}.meter{height:7px;border-radius:99px;background:#eee5ea;overflow:hidden;margin-top:7px}.meter i{display:block;height:100%;background:#18794e}.status{font-size:13px;line-height:1.7;margin-top:12px;padding:11px;border-radius:12px;background:#f8f6f7;color:var(--muted)}.status.warn{background:#fff2df;color:#94560b}.actions{display:grid;grid-template-columns:1fr auto;gap:9px;margin-top:14px}.download,.reset{border-radius:14px;padding:14px;font-weight:900;cursor:pointer}.download{border:0;background:var(--pink);color:#fff}.reset{border:1px solid var(--line);background:#fff}.note{margin-top:24px;color:var(--muted);line-height:1.8}@media(max-width:850px){.qr-grid{grid-template-columns:1fr}.characters{grid-template-columns:repeat(4,1fr)}}@media(max-width:460px){.characters{grid-template-columns:repeat(3,1fr)}.color-grid{grid-template-columns:1fr}.actions{grid-template-columns:1fr}}
</style>
<script define:vars={{ C }}>
window.__QR_COPY__=C;
</script><script>
import QRCode from 'qrcode';const C=window.__QR_COPY__;const canvas=document.getElementById('qrCanvas'),ctx=canvas.getContext('2d'),input=document.getElementById('qrText'),qrColor=document.getElementById('qrColor'),bgColor=document.getElementById('bgColor'),qrHex=document.getElementById('qrHex'),bgHex=document.getElementById('bgHex'),margin=document.getElementById('margin'),marginValue=document.getElementById('marginValue'),status=document.getElementById('status'),logoFile=document.getElementById('logoFile'),uploadName=document.getElementById('uploadName'),quality=document.getElementById('quality'),qualityScore=document.getElementById('qualityScore'),meterBar=document.getElementById('meterBar'),textInfo=document.getElementById('textInfo');let currentChar='none',currentSize='medium',currentShape='square',customImage=null,customUrl='';const defaults={text:'https://stamp-moke.jp/',dark:'#342f33',light:'#ffffff',margin:'4'};const ratios={small:.13,medium:.18,large:.23};const paths={cat:'M17 24 13 10l14 8c3-1 7-1 10 0l14-8-4 14c4 4 6 9 6 15 0 12-9 19-21 19S11 51 11 39c0-6 2-11 6-15Z',dog:'M18 19C8 19 6 10 8 5c9 2 15 7 18 12 4-1 8-1 12 0C41 12 47 7 56 5c2 5 0 14-10 14 5 5 8 11 8 19 0 13-9 20-22 20S10 51 10 38c0-8 3-14 8-19Z',rabbit:'M24 26C14 16 14 3 19 2c6-1 10 12 11 20h4c1-8 5-21 11-20 5 1 5 14-5 24 8 3 13 10 13 18 0 10-9 17-21 17S11 54 11 44c0-8 5-15 13-18Z',bear:'M16 20a9 9 0 1 1 12-9c3-1 5-1 8 0a9 9 0 1 1 12 9c5 5 8 11 8 19 0 13-10 21-24 21S8 52 8 39c0-8 3-14 8-19Z',panda:'M16 19a9 9 0 1 1 12-9h8a9 9 0 1 1 12 9c5 5 8 12 8 20 0 13-10 21-24 21S8 52 8 39c0-8 3-15 8-20Z',chick:'M33 8c12 0 22 10 22 23 0 4-1 8-3 11l9 4-12 3c-4 5-10 8-16 8-13 0-23-10-23-24S20 8 33 8Z',hedgehog:'m8 34 6-4-5-6 8-1-2-8 8 3 2-9 7 6 6-8 4 9 9-5v10l8-1-4 9 7 3-7 6c0 13-9 21-23 21S8 49 8 34Z',fox:'M10 12l17 9c3-1 7-1 10 0l17-9-5 17c3 4 5 8 5 13 0 11-10 18-22 18S10 53 10 42c0-5 2-9 5-13L10 12Z',penguin:'M32 5c13 0 21 12 21 27 0 6-2 12-5 17l8 6-13-1c-3 3-7 5-11 5s-8-2-11-5L8 55l8-6c-3-5-5-11-5-17C11 17 19 5 32 5Z',koala:'M14 22a11 11 0 1 1 15-12c2-1 4-1 6 0a11 11 0 1 1 15 12c4 5 6 10 6 17 0 13-10 21-24 21S8 52 8 39c0-7 2-12 6-17Z'};function rgb(h){const n=parseInt(h.slice(1),16);return[(n>>16)&255,(n>>8)&255,n&255]}function lum(h){return rgb(h).map(v=>{v/=255;return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4)}).reduce((a,v,i)=>a+v*[.2126,.7152,.0722][i],0)}function contrast(a,b){const x=lum(a),y=lum(b);return(Math.max(x,y)+.05)/(Math.min(x,y)+.05)}function finder(r,c,n){return(r<7&&c<7)||(r<7&&c>=n-7)||(r>=n-7&&c<7)}function module(x,y,s,f){ctx.fillStyle=qrColor.value;if(f||currentShape==='square')return ctx.fillRect(x,y,s+.15,s+.15);if(currentShape==='dots'){ctx.beginPath();ctx.arc(x+s/2,y+s/2,s*.42,0,Math.PI*2);return ctx.fill()}ctx.beginPath();ctx.roundRect(x+.08*s,y+.08*s,s*.84,s*.84,s*.32);ctx.fill()}function score(text,center){let s=100,cr=contrast(qrColor.value,bgColor.value);if(cr<2)s-=55;else if(cr<3)s-=35;else if(cr<4.5)s-=15;if(+margin.value<4)s-=12;if(currentShape==='dots')s-=5;else if(currentShape==='rounded')s-=2;if(center)s-=currentSize==='large'?20:currentSize==='medium'?8:0;if(text.length>500)s-=18;else if(text.length>250)s-=10;else if(text.length>120)s-=5;return Math.max(0,Math.min(100,s))}function qRender(s){qualityScore.textContent=s;meterBar.style.width=s+'%';meterBar.style.background=s>=80?'#18794e':s>=60?'#9a6700':'#b42318'}function centerBox(circle=false){const box=720*ratios[currentSize],pad=box*.17,x=(720-box)/2;ctx.fillStyle=bgColor.value;ctx.beginPath();circle?ctx.arc(360,360,(box+pad*2)/2,0,Math.PI*2):ctx.roundRect(x-pad,x-pad,box+pad*2,box+pad*2,box*.2);ctx.fill();return{x,box}}function overlayCustom(){const{x,box}=centerBox(false),w0=customImage.naturalWidth||1,h0=customImage.naturalHeight||1,k=Math.min(box/w0,box/h0),w=w0*k,h=h0*k;ctx.drawImage(customImage,(720-w)/2,(720-h)/2,w,h)}function overlayChar(){return new Promise(done=>{const{x,box}=centerBox(true),svg=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><path fill="${qrColor.value}" d="${paths[currentChar]}"/></svg>`,img=new Image();img.onload=()=>{ctx.drawImage(img,x,x,box,box);done()};img.onerror=done;img.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg)})}async function draw(){const text=input.value.trim()||defaults.text,hasCenter=customImage||currentChar!=='none';qrHex.textContent=qrColor.value;bgHex.textContent=bgColor.value;marginValue.textContent=margin.value;textInfo.textContent=[...text].length+C.count;try{const qr=QRCode.create(text,{errorCorrectionLevel:hasCenter?'H':'M'}),n=qr.modules.size,m=+margin.value,cell=720/(n+m*2);ctx.fillStyle=bgColor.value;ctx.fillRect(0,0,720,720);for(let r=0;r<n;r++)for(let c=0;c<n;c++)if(qr.modules.get(r,c))module((c+m)*cell,(r+m)*cell,cell,finder(r,c,n));if(customImage)overlayCustom();else if(currentChar!=='none')await overlayChar();const cr=contrast(qrColor.value,bgColor.value),s=score(text,hasCenter);qRender(s);status.classList.toggle('warn',s<80);status.textContent=cr<3?C.status.lowContrast:currentSize==='large'&&hasCenter?C.status.large:s<80?C.status.improve:hasCenter?C.status.center:C.status.good}catch{qRender(0);status.classList.add('warn');status.textContent=C.status.error}}function activate(p,sel,b){p.querySelectorAll(sel).forEach(x=>x.classList.remove('active'));b.classList.add('active')}function clearUpload(){if(customUrl)URL.revokeObjectURL(customUrl);customUrl='';customImage=null;logoFile.value='';uploadName.textContent=C.uploadHint}input.addEventListener('input',draw);qrColor.addEventListener('input',draw);bgColor.addEventListener('input',draw);margin.addEventListener('input',draw);document.getElementById('themes').addEventListener('click',e=>{const b=e.target.closest('[data-dark]');if(!b)return;qrColor.value=b.dataset.dark;bgColor.value=b.dataset.light;draw()});document.getElementById('shapes').addEventListener('click',e=>{const b=e.target.closest('[data-shape]');if(!b)return;activate(e.currentTarget,'.choice',b);currentShape=b.dataset.shape;draw()});document.getElementById('characters').addEventListener('click',e=>{const b=e.target.closest('[data-char]');if(!b)return;activate(e.currentTarget,'.char',b);currentChar=b.dataset.char;clearUpload();draw()});document.getElementById('sizes').addEventListener('click',e=>{const b=e.target.closest('[data-size]');if(!b)return;activate(e.currentTarget,'.size-btn',b);currentSize=b.dataset.size;draw()});logoFile.addEventListener('change',()=>{const f=logoFile.files?.[0];if(!f)return;if(f.size>5242880){uploadName.textContent=C.status.tooBig;logoFile.value='';return}if(customUrl)URL.revokeObjectURL(customUrl);customUrl=URL.createObjectURL(f);const img=new Image();img.onload=()=>{customImage=img;currentChar='none';document.querySelectorAll('.char').forEach(x=>x.classList.toggle('active',x.dataset.char==='none'));uploadName.textContent=C.status.selected+f.name;draw()};img.onerror=()=>{uploadName.textContent=C.status.imageError;clearUpload();draw()};img.src=customUrl});document.getElementById('clearLogo').onclick=()=>{clearUpload();draw()};document.getElementById('resetBtn').onclick=()=>{clearUpload();input.value=defaults.text;qrColor.value=defaults.dark;bgColor.value=defaults.light;margin.value=defaults.margin;currentChar='none';currentSize='medium';currentShape='square';document.querySelectorAll('.char').forEach(x=>x.classList.toggle('active',x.dataset.char==='none'));document.querySelectorAll('#sizes .size-btn').forEach(x=>x.classList.toggle('active',x.dataset.size==='medium'));document.querySelectorAll('#shapes .choice').forEach(x=>x.classList.toggle('active',x.dataset.shape==='square'));draw()};document.getElementById('downloadBtn').onclick=()=>{const a=document.createElement('a');a.download='cute-qr-code.png';a.href=canvas.toDataURL('image/png');a.click()};draw();
</script></body></html>