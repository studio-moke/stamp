---
import designs from "../data/suzuri-designs.json";
import SiteHeader from "./SiteHeader.astro";
import SeoHead from "./SeoHead.astro";
import Analytics from "./Analytics.astro";
import { localeInfo, localizedPath, normalizeLocale } from "../lib/i18n";
import { absoluteUrl } from "../lib/seo";
const locale=normalizeLocale(Astro.props.locale),design=Astro.props.design;
if((locale!=="zh-cn"&&locale!=="ko")||!design) throw new Error("Invalid goods page");
const t={"zh-cn":{suffix:"角色周边",desc:`查看 stamp moke 原创角色「${design.title}」的 T 恤、贴纸与 SUZURI 周边商品。`,back:"返回周边列表",products:"在售周边",shop:"前往 SUZURI 查看 ↗",tax:"含税"},ko:{suffix:"캐릭터 굿즈",desc:`stamp moke 오리지널 캐릭터 「${design.title}」의 티셔츠, 스티커 및 SUZURI 굿즈를 확인해 보세요.`,back:"굿즈 목록으로",products:"판매 중인 굿즈",shop:"SUZURI에서 보기 ↗",tax:"세금 포함"}}[locale];
const path=`/goods/${design.id}/`,canonical=absoluteUrl(localizedPath(locale,path)),title=`${design.title} ${t.suffix} | stamp moke`,products=Array.isArray(design.products)?design.products:[];
---
<!doctype html><html lang={localeInfo[locale].htmlLang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><SeoHead title={title} description={t.desc} canonical={canonical} image={design.image} type="article" locale={locale} path={path}/><Analytics/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.main{max-width:1180px;margin:auto;padding:40px 5vw 100px}.crumb{font-size:12px;color:#777;margin-bottom:25px}.crumb a{color:inherit}.feature{display:grid;grid-template-columns:.85fr 1.15fr;gap:48px;align-items:center;padding:42px;background:#fff;border:1px solid #ddd;border-radius:26px}.feature img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:20px}.feature h1{font-size:clamp(34px,5vw,58px);margin:0 0 20px}.feature p{color:#666;line-height:2}.shop{display:inline-flex;margin-top:20px;padding:13px 18px;border-radius:999px;background:#161616;color:#fff;text-decoration:none}.products{margin-top:75px}.products h2{font-size:36px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.card{background:#fff;border:1px solid #ddd;border-radius:17px;overflow:hidden;text-decoration:none}.card img{width:100%;aspect-ratio:1;object-fit:cover}.body{padding:14px}.body h3{font-size:13px;margin:0}.price{margin-top:10px;font-size:11px;color:#777}@media(max-width:800px){.feature{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.main{padding:25px 18px 70px}.feature{padding:18px}}</style></head><body><SiteHeader locale={locale} path={path}/><main class="main"><nav class="crumb"><a href={localizedPath(locale,"/")}>stamp moke</a> / <a href={localizedPath(locale,"/goods/")}>{t.back}</a> / {design.title}</nav><article class="feature"><img src={design.image} alt={design.title}/><div><h1>{design.title}</h1><p>{t.desc}</p><a class="shop" href="https://suzuri.jp/stamp-moke" target="_blank" rel="noopener noreferrer">{t.shop}</a></div></article><section class="products"><h2>{t.products}</h2><div class="grid">{products.map((p,i)=><a class="card" href={p.url} target="_blank" rel="noopener noreferrer"><img src={p.image} alt={p.title} loading={i<8?"eager":"lazy"}/><div class="body"><h3>{p.title}</h3>{p.price&&<div class="price">¥{Number(p.price).toLocaleString(locale==="ko"?"ko-KR":"zh-CN")} {t.tax}</div>}</div></a>)}</div></section></main></body></html>
