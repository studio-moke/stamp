---
import SiteHeader from "./SiteHeader.astro";
import { normalizeLocale, localeInfo } from "../lib/i18n";
const locale = normalizeLocale(Astro.props.locale);
const lang = localeInfo[locale].htmlLang;
const copy = {
  ja:{title:"画像圧縮・リサイズ・変換｜PNG/JPG/WebPをブラウザで軽量化 | stamp moke",desc:"PNG・JPG・WebP画像をブラウザだけで圧縮、リサイズ、形式変換、透過余白トリミング。画像はサーバーへ送信せず無料で処理できます。",eyebrow:"IMAGE TOOLS",hero:"画像を、かんたんに軽く。",lead:"やりたいことを1つ選んで、画像を入れるだけ。圧縮・リサイズ・形式変換・透過余白の自動トリミングを、すべてブラウザ内で処理します。",privacy:"画像はサーバーへ送信しません。",privacySub:"選んだ画像はこの端末だけで処理され、ページを閉じると残りません。",tasks:["容量を軽くする","サイズを変更する","形式を変換する","透過余白を切る"],taskSubs:["JPG / PNG / WebP","幅・高さを指定","PNG / JPG / WebP","透明部分を自動検出"],drop:"画像をここにドロップ",dropSub:"またはクリックして選択 · 複数画像OK",selected:"選択中",settings:"設定",quality:"画質",width:"最大幅",height:"最大高さ",format:"出力形式",padding:"余白",keepRatio:"縦横比を維持",auto:"自動",same:"元の形式",run:"画像を処理する",working:"処理中…",results:"処理結果",downloadAll:"まとめて保存",again:"別の画像を選ぶ",original:"元画像",after:"処理後",saved:"削減",download:"保存",notice:"PNGは画像内容によって容量が小さくならない場合があります。透明画像はWebP変換で軽くなることがあります。",error:"この画像は処理できませんでした。"},
  en:{title:"Image Compressor, Resizer & Converter | PNG JPG WebP | stamp moke",desc:"Compress, resize, convert and trim PNG, JPG and WebP images entirely in your browser. Images are never uploaded to a server.",eyebrow:"IMAGE TOOLS",hero:"Make images lighter, simply.",lead:"Choose one task, add your images, and go. Compress, resize, convert formats, or trim transparent margins entirely in your browser.",privacy:"Your images never leave your device.",privacySub:"Processing happens only in this browser and files are discarded when you leave the page.",tasks:["Compress images","Resize images","Convert format","Trim transparent margins"],taskSubs:["JPG / PNG / WebP","Set max dimensions","PNG / JPG / WebP","Detect transparent edges"],drop:"Drop images here",dropSub:"or click to choose · multiple files supported",selected:"Selected",settings:"Settings",quality:"Quality",width:"Max width",height:"Max height",format:"Output format",padding:"Padding",keepRatio:"Keep aspect ratio",auto:"Auto",same:"Same as source",run:"Process images",working:"Processing…",results:"Results",downloadAll:"Save all",again:"Choose other images",original:"Original",after:"After",saved:"Saved",download:"Save",notice:"PNG files may not always become smaller. Transparent images often shrink more when converted to WebP.",error:"This image could not be processed."},
  "zh-tw":{title:"圖片壓縮、縮放與格式轉換｜PNG JPG WebP | stamp moke",desc:"在瀏覽器內壓縮、縮放、轉換 PNG、JPG、WebP，並自動裁切透明邊界。圖片不會上傳到伺服器。",eyebrow:"IMAGE TOOLS",hero:"讓圖片變輕，更簡單。",lead:"先選一個目的，再加入圖片即可。壓縮、縮放、格式轉換與透明邊界裁切都只在瀏覽器內處理。",privacy:"圖片不會傳送到伺服器。",privacySub:"只在目前裝置的瀏覽器內處理，離開頁面後不保留檔案。",tasks:["壓縮容量","調整尺寸","轉換格式","裁切透明邊界"],taskSubs:["JPG / PNG / WebP","指定最大寬高","PNG / JPG / WebP","自動偵測透明區域"],drop:"把圖片拖到這裡",dropSub:"或點擊選擇 · 可一次多張",selected:"已選擇",settings:"設定",quality:"畫質",width:"最大寬度",height:"最大高度",format:"輸出格式",padding:"保留邊距",keepRatio:"維持長寬比",auto:"自動",same:"與原格式相同",run:"開始處理",working:"處理中…",results:"處理結果",downloadAll:"全部儲存",again:"重新選擇圖片",original:"原始",after:"處理後",saved:"減少",download:"儲存",notice:"PNG 是否能縮小取決於圖片內容。透明圖片轉成 WebP 時通常能更有效減少容量。",error:"無法處理這張圖片。"},
  th:{title:"บีบอัด ปรับขนาด และแปลงรูป PNG JPG WebP | stamp moke",desc:"บีบอัด ปรับขนาด แปลงไฟล์ และตัดขอบโปร่งใสของ PNG, JPG และ WebP ในเบราว์เซอร์โดยไม่อัปโหลดรูปขึ้นเซิร์ฟเวอร์",eyebrow:"IMAGE TOOLS",hero:"ทำให้รูปเบาลง แบบง่าย ๆ",lead:"เลือกสิ่งที่ต้องการเพียงอย่างเดียว แล้วใส่รูป บีบอัด ปรับขนาด แปลงไฟล์ หรือตัดขอบโปร่งใสได้ทั้งหมดในเบราว์เซอร์",privacy:"รูปจะไม่ถูกส่งไปยังเซิร์ฟเวอร์",privacySub:"ประมวลผลเฉพาะในเบราว์เซอร์ของอุปกรณ์นี้ และไม่เก็บไฟล์หลังออกจากหน้า",tasks:["บีบอัดรูป","ปรับขนาดรูป","แปลงไฟล์","ตัดขอบโปร่งใส"],taskSubs:["JPG / PNG / WebP","กำหนดขนาดสูงสุด","PNG / JPG / WebP","ตรวจหาขอบใสอัตโนมัติ"],drop:"ลากรูปมาวางที่นี่",dropSub:"หรือคลิกเพื่อเลือก · เลือกหลายไฟล์ได้",selected:"เลือกแล้ว",settings:"ตั้งค่า",quality:"คุณภาพ",width:"ความกว้างสูงสุด",height:"ความสูงสูงสุด",format:"รูปแบบไฟล์",padding:"ระยะขอบ",keepRatio:"คงอัตราส่วน",auto:"อัตโนมัติ",same:"เหมือนต้นฉบับ",run:"ประมวลผลรูป",working:"กำลังประมวลผล…",results:"ผลลัพธ์",downloadAll:"บันทึกทั้งหมด",again:"เลือกรูปใหม่",original:"ต้นฉบับ",after:"หลังประมวลผล",saved:"ลดลง",download:"บันทึก",notice:"PNG อาจไม่เล็กลงเสมอ ขึ้นอยู่กับภาพ รูปโปร่งใสมักลดขนาดได้มากเมื่อแปลงเป็น WebP",error:"ไม่สามารถประมวลผลรูปนี้ได้"},
  id:{title:"Kompres, Resize & Konversi Gambar PNG JPG WebP | stamp moke",desc:"Kompres, ubah ukuran, konversi format, dan potong margin transparan PNG, JPG, WebP langsung di browser tanpa mengunggah gambar ke server.",eyebrow:"IMAGE TOOLS",hero:"Ringankan gambar, tanpa ribet.",lead:"Pilih satu tujuan, masukkan gambar, lalu proses. Kompres, resize, konversi format, dan potong margin transparan seluruhnya di browser.",privacy:"Gambar tidak dikirim ke server.",privacySub:"Semua proses hanya terjadi di browser perangkat ini dan file tidak disimpan setelah halaman ditutup.",tasks:["Kompres gambar","Ubah ukuran","Konversi format","Potong margin transparan"],taskSubs:["JPG / PNG / WebP","Atur dimensi maksimum","PNG / JPG / WebP","Deteksi area transparan"],drop:"Tarik gambar ke sini",dropSub:"atau klik untuk memilih · bisa banyak file",selected:"Dipilih",settings:"Pengaturan",quality:"Kualitas",width:"Lebar maks.",height:"Tinggi maks.",format:"Format output",padding:"Padding",keepRatio:"Pertahankan rasio",auto:"Otomatis",same:"Sama seperti sumber",run:"Proses gambar",working:"Memproses…",results:"Hasil",downloadAll:"Simpan semua",again:"Pilih gambar lain",original:"Asli",after:"Setelah",saved:"Hemat",download:"Simpan",notice:"PNG tidak selalu menjadi lebih kecil, tergantung isi gambar. Gambar transparan biasanya lebih ringan jika dikonversi ke WebP.",error:"Gambar ini tidak dapat diproses."}
}[locale];
const prefix = locale === "ja" ? "" : `/${locale}`;
const canonical = `https://stamp-moke.jp${prefix}/image-tools/`;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{copy.title}</title>
<meta name="description" content={copy.desc} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={copy.title} />
<meta property="og:description" content={copy.desc} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<link rel="alternate" hreflang="ja" href="https://stamp-moke.jp/image-tools/" />
<link rel="alternate" hreflang="en" href="https://stamp-moke.jp/en/image-tools/" />
<link rel="alternate" hreflang="zh-Hant-TW" href="https://stamp-moke.jp/zh-tw/image-tools/" />
<link rel="alternate" hreflang="th" href="https://stamp-moke.jp/th/image-tools/" />
<link rel="alternate" hreflang="id" href="https://stamp-moke.jp/id/image-tools/" />
<link rel="alternate" hreflang="x-default" href="https://stamp-moke.jp/image-tools/" />
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.wrap{max-width:1120px;margin:auto;padding:38px 22px 90px}.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:end;margin-bottom:28px}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.2em;color:#777;margin-bottom:12px}.hero h1{font-size:clamp(38px,5.4vw,70px);line-height:1.01;letter-spacing:-.055em;margin:0}.hero p{font-size:13px;line-height:1.85;color:#666;max-width:720px}.privacy{background:#171717;color:#fff;border-radius:20px;padding:19px 21px;font-size:11px;line-height:1.75}.privacy strong{display:block;font-size:14px;margin-bottom:4px}.task-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:15px}.task{appearance:none;border:1px solid #deddd8;background:#fff;border-radius:17px;padding:16px;text-align:left;cursor:pointer;transition:.18s;color:#171717}.task:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(0,0,0,.05)}.task.active{background:#171717;color:#fff;border-color:#171717}.task b{display:block;font-size:13px;margin-bottom:5px}.task span{font-size:9px;color:#888}.task.active span{color:#bbb}.panel{background:#fff;border:1px solid #deddd8;border-radius:22px;box-shadow:0 12px 34px rgba(35,32,23,.055)}.drop{min-height:220px;padding:28px;border:2px dashed #cbc9c1;border-radius:22px;display:flex;align-items:center;justify-content:center;text-align:center;background:#fbfaf7;cursor:pointer;transition:.18s}.drop.drag{background:#f0eee6;border-color:#777}.drop input{display:none}.drop-icon{width:54px;height:54px;border-radius:16px;background:#171717;color:#fff;display:grid;place-items:center;margin:0 auto 14px;font-size:24px}.drop strong{display:block;font-size:18px;margin-bottom:7px}.drop span{font-size:10px;color:#777}.workspace{display:none;margin-top:15px}.workspace.show{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(300px,.92fr);gap:15px}.files-panel{padding:16px}.files-head,.settings-head,.results-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.files-head h2,.settings-head h2,.results-head h2{font-size:17px;margin:0}.muted{font-size:9px;color:#888}.file-list{display:grid;gap:8px;max-height:470px;overflow:auto;padding-right:3px}.file-row{display:grid;grid-template-columns:54px minmax(0,1fr) auto;gap:10px;align-items:center;border:1px solid #e2e0da;border-radius:13px;padding:8px}.thumb{width:54px;height:54px;border-radius:9px;object-fit:cover;background:linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%);background-size:12px 12px;background-position:0 0,0 6px,6px -6px,-6px 0}.file-meta{min-width:0}.file-name{font-size:10px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.file-size{font-size:9px;color:#888;margin-top:4px}.remove{border:0;background:#f1f0eb;border-radius:999px;width:28px;height:28px;cursor:pointer;font-size:14px}.settings{padding:16px}.setting-group{display:grid;gap:12px}.field{display:grid;gap:6px}.field label{font-size:10px;font-weight:900}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.select,.input{width:100%;border:1px solid #d9d7d1;background:#fff;border-radius:11px;padding:10px 11px;font:inherit;font-size:11px}.range-wrap{display:grid;grid-template-columns:1fr 48px;align-items:center;gap:9px}.range{width:100%;accent-color:#171717}.range-value{font-size:10px;font-weight:900;text-align:right}.check{display:flex;align-items:center;gap:8px;font-size:10px;font-weight:800}.notice{font-size:9px;line-height:1.65;color:#777;background:#f5f4ef;border-radius:11px;padding:10px 11px}.run{width:100%;border:0;border-radius:13px;background:#171717;color:#fff;padding:13px 16px;font-size:11px;font-weight:900;cursor:pointer;margin-top:2px}.run:disabled{opacity:.45;cursor:wait}.results{display:none;margin-top:15px;padding:16px}.results.show{display:block}.results-actions{display:flex;gap:7px;flex-wrap:wrap}.ghost{border:1px solid #d8d7d1;background:#fff;border-radius:10px;padding:8px 11px;font-size:9px;font-weight:900;cursor:pointer}.result-list{display:grid;gap:9px}.result-row{display:grid;grid-template-columns:58px minmax(0,1fr) auto;gap:11px;align-items:center;border:1px solid #e1dfd8;border-radius:14px;padding:9px}.result-stats{display:flex;gap:10px;flex-wrap:wrap;margin-top:5px;font-size:9px;color:#777}.saved{font-weight:900;color:#171717}.download{border:0;background:#171717;color:#fff;border-radius:10px;padding:8px 10px;font-size:9px;font-weight:900;cursor:pointer}.error{font-size:9px;color:#9b3028}.helper{margin-top:22px;border-top:1px solid #ddd9d1;padding-top:16px;font-size:10px;color:#777;line-height:1.7}@media(max-width:820px){.hero,.workspace{grid-template-columns:1fr}.task-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.wrap{padding:27px 11px 70px}.hero h1{font-size:42px}.task-grid{gap:7px}.task{padding:13px 12px;border-radius:14px}.drop{min-height:185px;padding:20px}.files-panel,.settings,.results{padding:11px}.result-row{grid-template-columns:48px minmax(0,1fr)}.result-row .download{grid-column:1/-1;width:100%}.thumb{width:48px;height:48px}.file-row{grid-template-columns:48px minmax(0,1fr) auto}}
</style>
</head>
<body>
<SiteHeader locale={locale} path="/image-tools/" />
<main class="wrap">
<section class="hero"><div><div class="eyebrow">{copy.eyebrow}</div><h1>{copy.hero}</h1><p>{copy.lead}</p></div><aside class="privacy"><strong>{copy.privacy}</strong>{copy.privacySub}</aside></section>
<section class="task-grid" id="taskGrid">{copy.tasks.map((t,i)=><button class:list={["task",i===0&&"active"]} data-mode={["compress","resize","convert","trim"][i]}><b>{t}</b><span>{copy.taskSubs[i]}</span></button>)}</section>
<section><label class="drop panel" id="drop"><input id="file" type="file" accept="image/png,image/jpeg,image/webp" multiple /><div><div class="drop-icon">＋</div><strong>{copy.drop}</strong><span>{copy.dropSub}</span></div></label></section>
<section class="workspace" id="workspace"><div class="panel files-panel"><div class="files-head"><h2>{copy.selected}</h2><span class="muted" id="fileCount">0</span></div><div class="file-list" id="fileList"></div></div><aside class="panel settings"><div class="settings-head"><h2>{copy.settings}</h2><span class="muted" id="modeLabel"></span></div><div class="setting-group">
<div class="field" id="qualityField"><label>{copy.quality}</label><div class="range-wrap"><input class="range" id="quality" type="range" min="35" max="95" value="78" /><span class="range-value" id="qualityValue">78%</span></div></div>
<div class="field-row" id="sizeFields"><div class="field"><label>{copy.width}</label><input class="input" id="maxWidth" type="number" min="1" placeholder={copy.auto} /></div><div class="field"><label>{copy.height}</label><input class="input" id="maxHeight" type="number" min="1" placeholder={copy.auto} /></div></div>
<label class="check" id="ratioField"><input id="keepRatio" type="checkbox" checked /> {copy.keepRatio}</label>
<div class="field" id="formatField"><label>{copy.format}</label><select class="select" id="format"><option value="same">{copy.same}</option><option value="image/webp">WebP</option><option value="image/jpeg">JPG</option><option value="image/png">PNG</option></select></div>
<div class="field" id="paddingField" style="display:none"><label>{copy.padding}</label><select class="select" id="padding"><option value="0">0 px</option><option value="4">4 px</option><option value="8" selected>8 px</option><option value="16">16 px</option><option value="24">24 px</option><option value="32">32 px</option></select></div>
<div class="notice">{copy.notice}</div><button class="run" id="run">{copy.run}</button></div></aside></section>
<section class="panel results" id="results"><div class="results-head"><h2>{copy.results}</h2><div class="results-actions"><button class="ghost" id="downloadAll">{copy.downloadAll}</button><button class="ghost" id="again">{copy.again}</button></div></div><div class="result-list" id="resultList"></div></section>
<div class="helper">PNG / JPG / WebP · Browser-only processing · No upload · No registration</div>
</main>
<script is:inline define:vars={{ copy }}>
const $=id=>document.getElementById(id);const file=$("file"),drop=$("drop"),workspace=$("workspace"),fileList=$("fileList"),fileCount=$("fileCount"),taskGrid=$("taskGrid"),quality=$("quality"),qualityValue=$("qualityValue"),maxWidth=$("maxWidth"),maxHeight=$("maxHeight"),format=$("format"),padding=$("padding"),qualityField=$("qualityField"),sizeFields=$("sizeFields"),ratioField=$("ratioField"),formatField=$("formatField"),paddingField=$("paddingField"),run=$("run"),results=$("results"),resultList=$("resultList"),downloadAll=$("downloadAll"),again=$("again"),modeLabel=$("modeLabel");let mode="compress",files=[],outputs=[];
const human=n=>{if(n<1024)return n+" B";if(n<1048576)return(n/1024).toFixed(1)+" KB";return(n/1048576).toFixed(2)+" MB"};const ext=t=>t==="image/png"?"png":t==="image/jpeg"?"jpg":"webp";const safeName=(name,t)=>name.replace(/\.[^.]+$/,"")+"-optimized."+ext(t);const readImage=f=>new Promise((res,rej)=>{const u=URL.createObjectURL(f),img=new Image();img.onload=()=>{URL.revokeObjectURL(u);res(img)};img.onerror=()=>{URL.revokeObjectURL(u);rej(new Error("load"))};img.src=u});const toBlob=(c,t,q)=>new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error("blob")),t,q));
function updateMode(){document.querySelectorAll('.task').forEach(b=>b.classList.toggle('active',b.dataset.mode===mode));const idx={compress:0,resize:1,convert:2,trim:3}[mode];modeLabel.textContent=copy.tasks[idx];qualityField.style.display=mode==='trim'?'none':'';sizeFields.style.display=(mode==='resize'||mode==='compress')?'grid':'none';ratioField.style.display=mode==='resize'?'flex':'none';formatField.style.display=mode==='trim'?'none':'';paddingField.style.display=mode==='trim'?'grid':'none';if(mode==='compress'&&format.value==='same')format.value='image/webp';if(mode==='convert'&&format.value==='same')format.value='image/webp'}
function renderFiles(){fileCount.textContent=files.length;fileList.innerHTML='';files.forEach((f,i)=>{const row=document.createElement('div');row.className='file-row';const u=URL.createObjectURL(f);row.innerHTML=`<img class="thumb" src="${u}"><div class="file-meta"><div class="file-name"></div><div class="file-size">${human(f.size)} · ${f.type.replace('image/','').toUpperCase()}</div></div><button class="remove" type="button">×</button>`;row.querySelector('.file-name').textContent=f.name;row.querySelector('img').onload=()=>URL.revokeObjectURL(u);row.querySelector('.remove').onclick=()=>{files.splice(i,1);renderFiles();if(!files.length){workspace.classList.remove('show');results.classList.remove('show')}};fileList.appendChild(row)});workspace.classList.toggle('show',files.length>0)}
function addFiles(list){const good=[...list].filter(f=>/^image\/(png|jpeg|webp)$/.test(f.type));files=[...files,...good].slice(0,30);renderFiles();results.classList.remove('show')}
function cropBounds(ctx,w,h){const d=ctx.getImageData(0,0,w,h).data;let minX=w,minY=h,maxX=-1,maxY=-1;for(let y=0;y<h;y++){for(let x=0;x<w;x++){if(d[(y*w+x)*4+3]>8){if(x<minX)minX=x;if(x>maxX)maxX=x;if(y<minY)minY=y;if(y>maxY)maxY=y}}}return maxX<0?{x:0,y:0,w,h}:{x:minX,y:minY,w:maxX-minX+1,h:maxY-minY+1}}
async function processOne(f){const img=await readImage(f);let sx=0,sy=0,sw=img.naturalWidth,sh=img.naturalHeight;let targetW=sw,targetH=sh;let outType=mode==='trim'?f.type:(format.value==='same'?f.type:format.value);if(outType==='image/jpeg'&&f.type==='image/png'){}if(mode==='trim'){const c0=document.createElement('canvas');c0.width=sw;c0.height=sh;const x0=c0.getContext('2d',{willReadFrequently:true});x0.drawImage(img,0,0);const b=cropBounds(x0,sw,sh),p=Number(padding.value)||0;sx=Math.max(0,b.x-p);sy=Math.max(0,b.y-p);sw=Math.min(img.naturalWidth-sx,b.w+p*2);sh=Math.min(img.naturalHeight-sy,b.h+p*2);targetW=sw;targetH=sh}else if(mode==='resize'||mode==='compress'){const mw=Number(maxWidth.value)||sw,mh=Number(maxHeight.value)||sh;const scale=Math.min(1,mw/sw,mh/sh);targetW=Math.max(1,Math.round(sw*scale));targetH=Math.max(1,Math.round(sh*scale))}const c=document.createElement('canvas');c.width=targetW;c.height=targetH;const cx=c.getContext('2d');if(outType==='image/jpeg'){cx.fillStyle='#fff';cx.fillRect(0,0,targetW,targetH)}cx.imageSmoothingEnabled=true;cx.imageSmoothingQuality='high';cx.drawImage(img,sx,sy,sw,sh,0,0,targetW,targetH);const q=Number(quality.value)/100;const blob=await toBlob(c,outType,q);return{file:f,blob,type:outType,w:targetW,h:targetH,name:safeName(f.name,outType)}}
function renderResults(){resultList.innerHTML='';outputs.forEach((o,i)=>{const row=document.createElement('div');row.className='result-row';if(o.error){row.innerHTML=`<div></div><div><div class="file-name"></div><div class="error">${copy.error}</div></div>`;row.querySelector('.file-name').textContent=o.file.name;resultList.appendChild(row);return}const u=URL.createObjectURL(o.blob);const pct=Math.round((1-o.blob.size/o.file.size)*100);row.innerHTML=`<img class="thumb" src="${u}"><div class="file-meta"><div class="file-name"></div><div class="result-stats"><span>${copy.original}: ${human(o.file.size)}</span><span>${copy.after}: ${human(o.blob.size)}</span><span>${o.w}×${o.h}</span><span class="saved">${copy.saved}: ${pct>0?pct+'%':'—'}</span></div></div><button class="download">${copy.download}</button>`;row.querySelector('.file-name').textContent=o.name;row.querySelector('img').onload=()=>URL.revokeObjectURL(u);row.querySelector('.download').onclick=()=>saveOutput(o);resultList.appendChild(row)});results.classList.add('show');results.scrollIntoView({behavior:'smooth',block:'start'})}
function saveOutput(o){if(!o.blob)return;const u=URL.createObjectURL(o.blob),a=document.createElement('a');a.href=u;a.download=o.name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),1500)}
async function processAll(){if(!files.length)return;run.disabled=true;run.textContent=copy.working;outputs=[];for(const f of files){try{outputs.push(await processOne(f))}catch(e){outputs.push({file:f,error:true})}}renderResults();run.disabled=false;run.textContent=copy.run}
taskGrid.addEventListener('click',e=>{const b=e.target.closest('.task');if(!b)return;mode=b.dataset.mode;updateMode()});file.onchange=()=>addFiles(file.files);drop.addEventListener('dragover',e=>{e.preventDefault();drop.classList.add('drag')});drop.addEventListener('dragleave',()=>drop.classList.remove('drag'));drop.addEventListener('drop',e=>{e.preventDefault();drop.classList.remove('drag');addFiles(e.dataTransfer.files)});quality.oninput=()=>qualityValue.textContent=quality.value+'%';run.onclick=processAll;downloadAll.onclick=async()=>{for(const o of outputs.filter(x=>x.blob)){saveOutput(o);await new Promise(r=>setTimeout(r,180))}};again.onclick=()=>{files=[];outputs=[];file.value='';renderFiles();results.classList.remove('show');drop.scrollIntoView({behavior:'smooth',block:'center'})};updateMode();
</script>
</body>
</html>