---
import SiteHeader from "./SiteHeader.astro";
const { locale="ja" } = Astro.props;
const prefix = locale === "ja" ? "" : `/${locale}`;
const ja = locale === "ja";
const t = ja ? {
 title:"ペット写真をステッカーに", sub:"写真を選ぶだけ。AIで動物を切り抜いて、白フチ付きPNGに。", upload:"写真を選ぶ", original:"元写真", sticker:"ステッカー", cutout:"切り抜き", transparent:"透過", white:"白背景", dark:"濃色背景", outline:"フチの太さ", padding:"余白", shadow:"影", scale:"大きさ", rotate:"角度", quality:"切り抜き品質", fast:"標準（おすすめ）", high:"高精度", rerun:"AIで切り抜き直す", save:"PNG保存", working:"AIが被写体を切り抜いています", first:"初回はAIモデルを読み込むため少し時間がかかります。", ready:"切り抜き完了！フチを調整して保存できます。", error:"AI切り抜きに失敗しました。ページを再読み込みして、もう一度お試しください。", step1:"1 写真を選ぶ",step2:"2 AIで切り抜く",step3:"3 フチを調整",step4:"4 PNG保存", privacy:"写真はブラウザ内で処理され、stamp moke のサーバーには送信されません。"
} : {
 title:"Turn pet photos into stickers", sub:"Choose a photo. AI cuts out the subject and adds a sticker outline.", upload:"Choose photo", original:"Original", sticker:"Sticker", cutout:"Cutout", transparent:"Transparent", white:"White", dark:"Dark", outline:"Outline", padding:"Padding", shadow:"Shadow", scale:"Scale", rotate:"Rotation", quality:"Cutout quality", fast:"Standard", high:"High quality", rerun:"Run AI cutout again", save:"Save PNG", working:"AI is cutting out the subject", first:"The AI model is downloaded on first use.", ready:"Cutout complete. Adjust and save.", error:"Background removal failed. Reload and try again.", step1:"1 Choose photo",step2:"2 AI cutout",step3:"3 Adjust",step4:"4 Save PNG", privacy:"Your photo is processed locally in your browser and is not uploaded to stamp moke."
};
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t.title}｜無料AIステッカーメーカー | stamp moke</title><meta name="description" content={t.sub}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/sticker-maker/`}/>
<script src="https://cdn.jsdelivr.net/npm/onnxruntime-web@1.23.0/dist/ort.min.js"></script>
<script src="https://unpkg.com/@bunnio/rembg-web@1.0.2/dist/index.umd.min.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;background:#f4f7fb;color:#15203a;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:1280px;margin:auto;padding:24px 16px 70px}.hero{text-align:center;padding:10px 0 20px}.hero h1{font-size:clamp(34px,5.5vw,58px);letter-spacing:-.05em;margin:0 0 8px}.hero p{margin:0;color:#667085;font-size:13px}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:0 auto 16px;max-width:980px}.step{padding:12px 8px;border:1px solid #d9e0ea;border-radius:13px;background:#fff;text-align:center;font-size:11px;font-weight:900;color:#7b8493}.step.on{background:#171717;color:#fff;border-color:#171717}.app{display:grid;grid-template-columns:260px minmax(0,1fr) 280px;gap:14px;align-items:start}.card{background:#fff;border:1px solid #dfe5ee;border-radius:20px;box-shadow:0 12px 35px rgba(20,30,50,.06)}.left,.right{padding:16px}.upload{display:block;border:2px dashed #b9c6d8;border-radius:15px;padding:12px;text-align:center;cursor:pointer}.upload input{display:none}.upload strong{display:block;background:#1677ee;color:#fff;border-radius:12px;padding:15px;font-size:13px}.upload span{display:block;margin-top:8px;color:#7c8797;font-size:9px}.thumb{margin-top:12px;border-radius:12px;overflow:hidden;background:#eef2f7}.thumb img{display:block;width:100%;max-height:180px;object-fit:cover}.section{padding-top:15px;margin-top:15px;border-top:1px solid #edf0f4}.section h2{font-size:13px;margin:0 0 12px}.row{margin-bottom:13px}.rowhead{display:flex;justify-content:space-between;font-size:10px;font-weight:800;margin-bottom:6px}.row input[type=range]{width:100%;accent-color:#1677ee}.select{width:100%;padding:10px;border:1px solid #d7dde7;border-radius:10px;background:#fff}.btn{width:100%;border:0;border-radius:12px;padding:13px;font-weight:900;cursor:pointer}.btn.blue{background:#1677ee;color:#fff}.btn.dark{background:#17233a;color:#fff}.center{padding:12px}.toolbar{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:10px}.tabs,.bg{display:flex;gap:6px}.toolbar button{border:0;border-radius:999px;padding:8px 11px;font-size:10px;font-weight:900;background:#eef2f7;cursor:pointer}.toolbar button.on{background:#1677ee;color:#fff}.stage{position:relative;min-height:650px;display:grid;place-items:center;border-radius:15px;overflow:hidden;background-color:#fff;background-image:linear-gradient(45deg,#e7ebf0 25%,transparent 25%),linear-gradient(-45deg,#e7ebf0 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e7ebf0 75%),linear-gradient(-45deg,transparent 75%,#e7ebf0 75%);background-size:24px 24px;background-position:0 0,0 12px,12px -12px,-12px 0}.stage.white{background:#fff;background-image:none}.stage.dark{background:#28303b;background-image:none}.stage canvas{width:100%;height:auto;display:block}.busy{position:absolute;inset:0;display:none;place-items:center;text-align:center;background:rgba(255,255,255,.92);z-index:5}.busy.show{display:grid}.spinner{width:44px;height:44px;border:4px solid #dce7f5;border-top-color:#1677ee;border-radius:50%;animation:spin 1s linear infinite;margin:auto auto 12px}@keyframes spin{to{transform:rotate(360deg)}}.status{margin-top:12px;padding:11px;border-radius:11px;background:#eef8f1;color:#24713b;font-size:10px;font-weight:800;display:none}.status.show{display:block}.status.error{background:#fff0f0;color:#b42318}.right .hint{font-size:10px;line-height:1.65;color:#7c8797}.privacy{font-size:9px;line-height:1.6;color:#8a94a3;margin-top:12px}@media(max-width:950px){.app{grid-template-columns:1fr}.center{order:1}.left{order:2}.right{order:3}.stage{min-height:420px}.hero{padding-top:4px}}@media(max-width:520px){.wrap{padding:14px 8px 50px}.steps{gap:4px}.step{font-size:8px;padding:9px 3px}.center{padding:7px}.stage{min-height:320px}.left,.right{padding:13px}}
</style></head><body><SiteHeader locale={locale}/><main class="wrap"><section class="hero"><h1>{t.title}</h1><p>{t.sub}</p></section><div class="steps"><div class="step on" data-step="1">{t.step1}</div><div class="step" data-step="2">{t.step2}</div><div class="step" data-step="3">{t.step3}</div><div class="step" data-step="4">{t.step4}</div></div><section class="app">
<aside class="card left"><label class="upload"><input id="file" type="file" accept="image/png,image/jpeg,image/webp"/><strong>{t.upload}</strong><span>JPG / PNG / WebP</span></label><div class="thumb" id="thumbWrap" hidden><img id="thumb" alt=""/></div><div class="section"><h2>{t.quality}</h2><select id="quality" class="select"><option value="u2netp">{t.fast}</option><option value="isnet-general-use">{t.high}</option></select><button id="rerun" class="btn dark" style="margin-top:9px">{t.rerun}</button></div><p class="privacy">{t.privacy}</p></aside>
<div class="card center"><div class="toolbar"><div class="tabs"><button id="stickerTab" class="on">{t.sticker}</button><button id="cutoutTab">{t.cutout}</button><button id="originalTab">{t.original}</button></div><div class="bg"><button class="on" data-bg="transparent">{t.transparent}</button><button data-bg="white">{t.white}</button><button data-bg="dark">{t.dark}</button></div></div><div class="stage" id="stage"><canvas id="canvas" width="900" height="900"></canvas><div class="busy" id="busy"><div><div class="spinner"></div><strong>{t.working}</strong><p>{t.first}</p><b id="progress">0%</b></div></div></div></div>
<aside class="card right"><div class="section" style="border:0;margin:0;padding:0"><h2>{ja?'仕上げオプション':'Finish options'}</h2><div class="row"><div class="rowhead"><span>{t.outline}</span><b id="outlineV">18</b></div><input id="outline" type="range" min="0" max="48" value="18"/></div><div class="row"><div class="rowhead"><span>{t.padding}</span><b id="paddingV">48</b></div><input id="padding" type="range" min="0" max="140" value="48"/></div><div class="row"><div class="rowhead"><span>{t.shadow}</span><b id="shadowV">10</b></div><input id="shadow" type="range" min="0" max="35" value="10"/></div><div class="row"><div class="rowhead"><span>{t.scale}</span><b id="scaleV">100</b></div><input id="scale" type="range" min="70" max="125" value="100"/></div><div class="row"><div class="rowhead"><span>{t.rotate}</span><b id="rotateV">0°</b></div><input id="rotate" type="range" min="-20" max="20" value="0"/></div><button id="save" class="btn blue">{t.save}</button><div id="status" class="status"></div></div></aside>
</section></main>
<script is:inline define:vars={{t}}>(()=>{const $=id=>document.getElementById(id),file=$('file'),canvas=$('canvas'),ctx=canvas.getContext('2d'),stage=$('stage'),busy=$('busy'),status=$('status');let original=null,cutout=null,mode='sticker',objectUrl='';const vals=['outline','padding','shadow','scale','rotate'];const modelBase='https://github.com/bunn-io/rembg-web/releases/download/base-models';
function step(n){document.querySelectorAll('[data-step]').forEach(x=>x.classList.toggle('on',+x.dataset.step<=n))}function msg(s,err=false){status.textContent=s;status.classList.add('show');status.classList.toggle('error',err)}function labels(){vals.forEach(id=>{const o=$(id+'V');if(o)o.textContent=id==='rotate'?$(id).value+'°':$(id).value})}function bbox(c){const x=c.getContext('2d',{willReadFrequently:true}),d=x.getImageData(0,0,c.width,c.height).data;let x0=c.width,y0=c.height,x1=-1,y1=-1;for(let y=0;y<c.height;y+=2)for(let xx=0;xx<c.width;xx+=2)if(d[(y*c.width+xx)*4+3]>12){x0=Math.min(x0,xx);x1=Math.max(x1,xx);y0=Math.min(y0,y);y1=Math.max(y1,y)}return x1<0?{x:0,y:0,w:c.width,h:c.height}:{x:x0,y:y0,w:x1-x0+1,h:y1-y0+1}}
function drawCentered(img){ctx.clearRect(0,0,900,900);const w=img.naturalWidth||img.width,h=img.naturalHeight||img.height,r=Math.min(820/w,820/h);ctx.drawImage(img,(900-w*r)/2,(900-h*r)/2,w*r,h*r)}function draw(){ctx.clearRect(0,0,900,900);if(!original)return;if(mode==='original'){drawCentered(original);return}if(!cutout)return;const b=bbox(cutout);if(mode==='cutout'){const r=Math.min(820/b.w,820/b.h),w=b.w*r,h=b.h*r;ctx.drawImage(cutout,b.x,b.y,b.w,b.h,(900-w)/2,(900-h)/2,w,h);return}const outline=+$('outline').value,pad=+$('padding').value,shadow=+$('shadow').value,sc=+$('scale').value/100,rot=+$('rotate').value*Math.PI/180,usable=Math.max(160,900-pad*2-outline*2-shadow*2),r=Math.min(usable/b.w,usable/b.h)*sc,w=b.w*r,h=b.h*r,x=(900-w)/2,y=(900-h)/2,temp=document.createElement('canvas');temp.width=temp.height=900;const tx=temp.getContext('2d');tx.translate(450,450);tx.rotate(rot);tx.translate(-450,-450);if(shadow){tx.save();tx.shadowColor='rgba(0,0,0,.3)';tx.shadowBlur=shadow*1.5;tx.shadowOffsetY=shadow*.7;tx.drawImage(cutout,b.x,b.y,b.w,b.h,x,y,w,h);tx.restore()}if(outline){for(let rr=outline;rr>0;rr-=Math.max(1,outline/6))for(let i=0;i<48;i++){const a=i/48*Math.PI*2;tx.drawImage(cutout,b.x,b.y,b.w,b.h,x+Math.cos(a)*rr,y+Math.sin(a)*rr,w,h)}tx.globalCompositeOperation='source-in';tx.fillStyle='#fff';tx.fillRect(0,0,900,900);tx.globalCompositeOperation='source-over'}tx.drawImage(cutout,b.x,b.y,b.w,b.h,x,y,w,h);ctx.drawImage(temp,0,0)}
async function run(){const f=file.files&&file.files[0];if(!f)return;if(!window.rembgWeb){msg(t.error,true);return}busy.classList.add('show');status.classList.remove('show');step(2);try{window.rembgWeb.rembgConfig.setBaseUrl(modelBase);const model=$('quality').value;const session=await window.rembgWeb.newSession(model,undefined,{onProgress:i=>{$('progress').textContent=Math.round(i.progress||0)+'%'}});const blob=await window.rembgWeb.remove(f,{session,postProcessMask:true});const u=URL.createObjectURL(blob),im=new Image;await new Promise((res,rej)=>{im.onload=res;im.onerror=rej;im.src=u});cutout=document.createElement('canvas');cutout.width=im.naturalWidth;cutout.height=im.naturalHeight;cutout.getContext('2d').drawImage(im,0,0);URL.revokeObjectURL(u);mode='sticker';sync();step(3);msg(t.ready);draw()}catch(e){console.error('sticker-cutout',e);msg(t.error,true)}finally{busy.classList.remove('show')}}function sync(){$('stickerTab').classList.toggle('on',mode==='sticker');$('cutoutTab').classList.toggle('on',mode==='cutout');$('originalTab').classList.toggle('on',mode==='original')}
function load(f){if(!f)return;if(objectUrl)URL.revokeObjectURL(objectUrl);objectUrl=URL.createObjectURL(f);const im=new Image;im.onload=()=>{original=im;$('thumb').src=objectUrl;$('thumbWrap').hidden=false;mode='original';sync();draw();run()};im.src=objectUrl}file.onchange=()=>load(file.files&&file.files[0]);$('rerun').onclick=run;$('stickerTab').onclick=()=>{mode='sticker';sync();draw()};$('cutoutTab').onclick=()=>{mode='cutout';sync();draw()};$('originalTab').onclick=()=>{mode='original';sync();draw()};document.querySelectorAll('[data-bg]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-bg]').forEach(x=>x.classList.toggle('on',x===b));stage.classList.toggle('white',b.dataset.bg==='white');stage.classList.toggle('dark',b.dataset.bg==='dark')});vals.forEach(id=>$(id).oninput=()=>{labels();draw()});$('save').onclick=()=>{mode='sticker';sync();draw();canvas.toBlob(blob=>{const u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='stamp-moke-sticker.png';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);step(4)},'image/png')};['dragenter','dragover'].forEach(n=>document.addEventListener(n,e=>e.preventDefault()));document.addEventListener('drop',e=>{e.preventDefault();const f=e.dataTransfer.files&&e.dataTransfer.files[0];if(f){const dt=new DataTransfer();dt.items.add(f);file.files=dt.files;load(f)}});labels()})();</script></body></html>