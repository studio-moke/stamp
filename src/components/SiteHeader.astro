---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import stickers from "../data/stickers.json";
import { localizedPath, messages, normalizeLocale } from "../lib/i18n";
import { localizedStickerTitle } from "../lib/sticker-content";

const locale = normalizeLocale(Astro.props.locale);
const path = Astro.props.path || "/";
const t = messages[locale];
const labels = {
  ja: { home: "トップ", stickers: "LINEスタンプ", free: "フリー素材", goods: "グッズ", search: "サイト内検索", qr: "QRメーカー", chat: "チャットスタンプ" },
  en: { home: "Home", stickers: "LINE Stickers", free: "Free assets", goods: "Goods", search: "Search", qr: "QR Maker", chat: "Chat Stamp Maker" },
  "zh-tw": { home: "首頁", stickers: "LINE貼圖", free: "免費素材", goods: "商品", search: "站內搜尋", qr: "QR產生器", chat: "聊天貼圖產生器" },
  th: { home: "หน้าแรก", stickers: "สติกเกอร์ LINE", free: "素材ฟรี", goods: "สินค้า", search: "ค้นหา", qr: "สร้าง QR", chat: "สร้างสติกเกอร์แชต" },
  id: { home: "Beranda", stickers: "Stiker LINE", free: "Aset gratis", goods: "Produk", search: "Cari", qr: "Pembuat QR", chat: "Pembuat Stiker Chat" },
}[locale];
const toolPaths = { ja: path, en: `/en${path}`, "zh-tw": `/zh-tw${path}`, th: `/th${path}`, id: `/id${path}` };
const toolHref = (slug) => locale === "ja" ? `/${slug}` : `/${locale}/${slug}`;
const promoEnabled = ["/free/", "/qr-maker", "/chat-stamp-maker"].includes(path);
const promoCopy = {
  ja: { eyebrow: "LINE STICKERS / stamp moke", title: "LINEスタンプ販売中！こっちも見てね！", lead: "stamp mokeでは、毎日の会話で使えるオリジナルLINEスタンプも販売しています。気になるシリーズをのぞいてみてください。", more: "LINEスタンプをもっと見る →" },
  en: { eyebrow: "LINE STICKERS / stamp moke", title: "Our LINE stickers are on sale too!", lead: "Discover original stamp moke LINE sticker sets for everyday chats, work, friends and family.", more: "Browse more LINE stickers →" },
  "zh-tw": { eyebrow: "LINE STICKERS / stamp moke", title: "也來看看我們販售中的LINE貼圖！", lead: "stamp moke也推出各種適合日常聊天、工作、朋友與家人的原創LINE貼圖。", more: "查看更多LINE貼圖 →" },
  th: { eyebrow: "LINE STICKERS / stamp moke", title: "แวะดูสติกเกอร์ LINE ของเราด้วย!", lead: "พบกับสติกเกอร์ LINE ต้นฉบับจาก stamp moke สำหรับแชตประจำวัน ที่ทำงาน เพื่อน และครอบครัว", more: "ดูสติกเกอร์ LINE เพิ่มเติม →" },
  id: { eyebrow: "LINE STICKERS / stamp moke", title: "Lihat juga stiker LINE kami!", lead: "Temukan stiker LINE orisinal stamp moke untuk obrolan sehari-hari, kerja, teman, dan keluarga.", more: "Lihat lebih banyak stiker LINE →" },
}[locale];
const promoPool = promoEnabled ? stickers.slice(0, 48).map((sticker) => ({ id: String(sticker.id), title: localizedStickerTitle(sticker, locale), image: sticker.image, href: localizedPath(locale, `/stickers/${sticker.id}`) })) : [];
---
<link rel="stylesheet" href="/site-header.css" />
<header class="sm-site-header" data-sm-canonical="1">
  <a href={localizedPath(locale, "/")} class="sm-site-brand" aria-label="stamp moke home"><span class="sm-site-brand-title">stamp moke</span><span class="sm-site-brand-sub">{t.brandSub}</span></a>
  <nav class="sm-site-actions" aria-label="Primary navigation">
    <a class="sm-site-link sm-site-hide-mobile" href={localizedPath(locale, "/free/")}>{labels.free}</a>
    <a class="sm-site-link sm-site-hide-mobile" href={localizedPath(locale, "/search/")}>{labels.search}</a>
    <a class="sm-site-link sm-site-tool" href={toolHref("qr-maker")}>{labels.qr}</a>
    <a class="sm-site-link sm-site-tool sm-site-hide-tablet" href={toolHref("chat-stamp-maker")}>{labels.chat}</a>
    <div class="sm-language-host"><LanguageSwitcher locale={locale} path={path} paths={toolPaths} /></div>
    <details class="sm-mobile-menu">
      <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
      <div class="sm-mobile-menu-panel">
        <a href={localizedPath(locale, "/")}>{labels.home}</a>
        <a href={`${localizedPath(locale, "/")}#stickers`}>{labels.stickers}</a>
        <a class="sm-mobile-menu-feature" href={localizedPath(locale, "/free/")}>🎨 {labels.free}</a>
        <a href={localizedPath(locale, "/goods/")}>{labels.goods}</a>
        <a href={localizedPath(locale, "/search/")}>🔎 {labels.search}</a>
        <div class="sm-mobile-menu-sep"></div>
        <a href={toolHref("qr-maker")}>▦ {labels.qr}</a>
        <a href={toolHref("chat-stamp-maker")}>💬 {labels.chat}</a>
      </div>
    </details>
  </nav>
</header>
<script is:inline src="/site-header.js"></script>
<style is:global>
.sm-language-host .language-switcher{position:relative!important;display:inline-block!important;margin:0!important;color:#555!important}.sm-language-host .language-switcher summary{list-style:none!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;height:40px!important;min-height:40px!important;border:1px solid #d9d8d4!important;background:#fff!important;border-radius:999px!important;padding:0 13px!important;cursor:pointer!important;user-select:none!important;white-space:nowrap!important}.sm-language-host .language-switcher summary::-webkit-details-marker{display:none!important}.sm-language-host .language-icon{font-size:14px!important;line-height:1!important}.sm-language-host .language-current{font-size:12px!important;font-weight:800!important;color:#161616!important;line-height:1!important}.sm-language-host .language-menu{position:absolute!important;right:0!important;top:calc(100% + 8px)!important;z-index:1100!important;min-width:190px!important;padding:7px!important;border:1px solid #dddcd7!important;border-radius:15px!important;background:#fff!important;box-shadow:0 16px 40px rgba(0,0,0,.12)!important}.sm-language-host .language-option{display:block!important;padding:10px 12px!important;border-radius:10px!important;color:#333!important;background:#fff!important;font-size:12px!important;font-weight:700!important;line-height:1.3!important;text-decoration:none!important;white-space:nowrap!important}.sm-language-host .language-option:hover{background:#f4f3ef!important}.sm-language-host .language-option.active{background:#171717!important;color:#fff!important}
.sm-sticker-promo{margin:54px 0 24px;padding:28px;border:1px solid #deddd8;border-radius:24px;background:#fff;box-shadow:0 14px 36px rgba(42,40,32,.05)}.sm-sticker-promo-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:20px}.sm-sticker-promo-eyebrow{font-size:10px;font-weight:900;letter-spacing:.18em;color:#888;margin-bottom:8px}.sm-sticker-promo h2{margin:0;font-size:clamp(24px,3vw,36px);line-height:1.15;letter-spacing:-.035em}.sm-sticker-promo p{max-width:620px;margin:10px 0 0;color:#777;font-size:12px;line-height:1.8}.sm-sticker-promo-more{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border-radius:999px;background:#161616;color:#fff!important;text-decoration:none!important;font-size:12px;font-weight:900;white-space:nowrap}.sm-sticker-promo-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.sm-sticker-promo-card{display:block;min-width:0;border:1px solid #e3e2de;border-radius:16px;background:#faf9f5;overflow:hidden;color:#161616!important;text-decoration:none!important;transition:transform .2s ease,box-shadow .2s ease}.sm-sticker-promo-card:hover{transform:translateY(-3px);box-shadow:0 12px 26px rgba(0,0,0,.07)}.sm-sticker-promo-media{aspect-ratio:1;background:#7696c4;overflow:hidden}.sm-sticker-promo-media img{display:block;width:100%;height:100%;object-fit:contain;padding:7px}.sm-sticker-promo-title{display:block;padding:10px;font-size:11px;font-weight:800;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:50px}@media(max-width:900px){.sm-sticker-promo-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:640px){.sm-language-host .language-switcher summary{height:34px!important;min-height:34px!important;padding:0 9px!important;gap:5px!important}.sm-language-host .language-current{max-width:72px!important;overflow:hidden!important;text-overflow:ellipsis!important;font-size:11px!important}.sm-language-host .language-menu{min-width:170px!important}.sm-sticker-promo{margin:36px 0 18px;padding:18px;border-radius:18px}.sm-sticker-promo-head{display:block}.sm-sticker-promo-more{margin-top:14px}.sm-sticker-promo-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.sm-sticker-promo-title{font-size:10px;padding:8px;min-height:44px}}
</style>
{promoEnabled && <script is:inline define:vars={{ promoPool, promoCopy }}>
(() => { const mount=()=>{if(document.querySelector('.sm-sticker-promo')||!promoPool?.length)return;const main=document.querySelector('main');if(!main)return;const items=[...promoPool];for(let i=items.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[items[i],items[j]]=[items[j],items[i]]}const picked=items.slice(0,6);const esc=(v='')=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));const section=document.createElement('section');section.className='sm-sticker-promo';section.setAttribute('aria-label',promoCopy.title);section.innerHTML=`<div class="sm-sticker-promo-head"><div><div class="sm-sticker-promo-eyebrow">${esc(promoCopy.eyebrow)}</div><h2>${esc(promoCopy.title)}</h2><p>${esc(promoCopy.lead)}</p></div><a class="sm-sticker-promo-more" href="${location.pathname.startsWith('/en/')?'/en/':location.pathname.startsWith('/zh-tw/')?'/zh-tw/':location.pathname.startsWith('/th/')?'/th/':location.pathname.startsWith('/id/')?'/id/':'/'}#stickers">${esc(promoCopy.more)}</a></div><div class="sm-sticker-promo-grid">${picked.map(item=>`<a class="sm-sticker-promo-card" href="${esc(item.href)}"><span class="sm-sticker-promo-media"><img loading="lazy" decoding="async" src="${esc(item.image)}" alt="${esc(item.title)}"></span><span class="sm-sticker-promo-title">${esc(item.title)}</span></a>`).join('')}</div>`;const footer=[...main.children].find(el=>el.matches?.('footer,.footer'));if(footer)main.insertBefore(section,footer);else main.appendChild(section)};if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mount,{once:true});else mount();})();
</script>}
