<link rel="icon" href={`/favicon.svg?v=${headerVersion}`} type="image/svg+xml" />
<link rel="stylesheet" href={`/site-header.css?v=${headerVersion}`} />
<link rel="stylesheet" href="/share-buttons.css?v=20260902-1" />
<link rel="stylesheet" href="/image-compressor-mobile-fix.css" />
<link rel="stylesheet" href="/free-tools-mobile-ux.css?v=20260903-1" />
<link rel="stylesheet" href="/business-tools-pro.css?v=20260903-1" />
<script is:inline src={`/api-url-normalizer.js?v=${headerVersion}`}></script>
<script is:inline define:vars={{ htmlLang }}>document.documentElement.lang=htmlLang;</script>
<script is:inline src="/free-tools-mobile-ux.js?v=20260903-1"></script>
<script is:inline src="/business-tools-pro.js?v=20260903-1"></script>
<script is:inline src="/postal-code-fallback.js?v=20260903-1"></script>
<script is:inline src="/tools-hub-i18n.js?v=20260903-1"></script>
<header class="sm-site-header" data-sm-canonical="1" data-locale={locale}></header>
