---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { localizedPath, messages, normalizeLocale } from "../lib/i18n";

const locale = normalizeLocale(Astro.props.locale);
const path = Astro.props.path || "/";
const t = messages[locale];
const labels = {
  ja: { free: "フリー素材", search: "サイト内検索", qr: "QRメーカー", chat: "チャットスタンプ" },
  en: { free: "Free assets", search: "Search", qr: "QR Maker", chat: "Chat Stamp Maker" },
  "zh-tw": { free: "免費素材", search: "站內搜尋", qr: "QR產生器", chat: "聊天貼圖產生器" },
  th: { free: "素材ฟรี", search: "ค้นหา", qr: "สร้าง QR", chat: "สร้างสติกเกอร์แชต" },
  id: { free: "Aset gratis", search: "Cari", qr: "Pembuat QR", chat: "Pembuat Stiker Chat" },
}[locale];
const toolPaths = {
  ja: path,
  en: `/en${path}`,
  "zh-tw": `/zh-tw${path}`,
  th: `/th${path}`,
  id: `/id${path}`,
};
---
<link rel="stylesheet" href="/site-header.css" />
<header class="sm-site-header" data-sm-canonical="1">
  <a href={localizedPath(locale, "/")} class="sm-site-brand" aria-label="stamp moke home">
    <span class="sm-site-brand-title">stamp moke</span>
    <span class="sm-site-brand-sub">{t.brandSub}</span>
  </a>
  <nav class="sm-site-actions" aria-label="Primary navigation">
    <a class="sm-site-link sm-site-hide-mobile" href={localizedPath(locale, "/free/")}>{labels.free}</a>
    <a class="sm-site-link sm-site-hide-mobile" href={localizedPath(locale, "/search/")}>{labels.search}</a>
    <a class="sm-site-link sm-site-tool" href={locale === "ja" ? "/qr-maker" : `/${locale}/qr-maker`}>{labels.qr}</a>
    <a class="sm-site-link sm-site-tool sm-site-hide-tablet" href={locale === "ja" ? "/chat-stamp-maker" : `/${locale}/chat-stamp-maker`}>{labels.chat}</a>
    <div class="sm-language-host"><LanguageSwitcher locale={locale} path={path} paths={toolPaths} /></div>
  </nav>
</header>
<script is:inline src="/site-header.js"></script>
<style is:global>
.sm-language-host .language-switcher{position:relative!important;display:inline-block!important;margin:0!important;color:#555!important}.sm-language-host .language-switcher summary{list-style:none!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;height:40px!important;min-height:40px!important;border:1px solid #d9d8d4!important;background:#fff!important;border-radius:999px!important;padding:0 13px!important;cursor:pointer!important;user-select:none!important;white-space:nowrap!important}.sm-language-host .language-switcher summary::-webkit-details-marker{display:none!important}.sm-language-host .language-icon{font-size:14px!important;line-height:1!important}.sm-language-host .language-current{font-size:12px!important;font-weight:800!important;color:#161616!important;line-height:1!important}.sm-language-host .language-menu{position:absolute!important;right:0!important;top:calc(100% + 8px)!important;z-index:1100!important;min-width:190px!important;padding:7px!important;border:1px solid #dddcd7!important;border-radius:15px!important;background:#fff!important;box-shadow:0 16px 40px rgba(0,0,0,.12)!important}.sm-language-host .language-option{display:block!important;padding:10px 12px!important;border-radius:10px!important;color:#333!important;background:#fff!important;font-size:12px!important;font-weight:700!important;line-height:1.3!important;text-decoration:none!important;white-space:nowrap!important}.sm-language-host .language-option:hover{background:#f4f3ef!important}.sm-language-host .language-option.active{background:#171717!important;color:#fff!important}@media(max-width:640px){.sm-language-host .language-switcher summary{height:34px!important;min-height:34px!important;padding:0 9px!important;gap:5px!important}.sm-language-host .language-current{max-width:92px!important;overflow:hidden!important;text-overflow:ellipsis!important;font-size:11px!important}.sm-language-host .language-menu{min-width:170px!important}}
</style>