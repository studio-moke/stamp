---
import { normalizeLocale, localeInfo } from "../lib/i18n";
const locale = normalizeLocale(Astro.props.locale);
const htmlLang = localeInfo[locale].htmlLang;
---
<link rel="stylesheet" href="/site-header.css" />
<link rel="stylesheet" href="/image-compressor-mobile-fix.css" />
<script is:inline define:vars={{ htmlLang }}>document.documentElement.lang=htmlLang;</script>
<header class="sm-site-header" data-sm-canonical="1" data-locale={locale}></header>
<script is:inline src="/site-header.js"></script>
<script is:inline src="/site-extra-nav.js"></script>
<script is:inline src="/seal-maker-nav.js"></script>
<script is:inline src="/image-tool-nav.js"></script>
<script is:inline src="/image-compressor-enhance.js"></script>
<script is:inline src="/sticker-promo-global.js"></script>
<script is:inline src="/free-tools-hub.js"></script>
<script is:inline src="/creative-tools-nav.js"></script>
<script is:inline src="/auto-free-manga-assets.js"></script>