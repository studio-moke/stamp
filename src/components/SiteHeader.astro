---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { localizedPath, messages, normalizeLocale } from "../lib/i18n";

const locale = normalizeLocale(Astro.props.locale);
const path = Astro.props.path || "/";
const t = messages[locale];
const labels = {
  ja: { free: "フリー素材", search: "サイト内検索", qr: "QRメーカー", chat: "チャットスタンプ" },
  en: { free: "Free assets", search: "Search", qr: "QR Maker", chat: "Chat Stamp Maker" },
  "zh-tw": { free: "免費素材", search: "站內搜尋", qr: "QR產生器", chat: "聊天貼圖產生器" },
  th: { free: "素材ฟรี", search: "ค้นหา", qr: "สร้าง QR", chat: "สร้างสติกเกอร์แชต" },
  id: { free: "Aset gratis", search: "Cari", qr: "Pembuat QR", chat: "Pembuat Stiker Chat" },
}[locale];
const toolPaths = {
  ja: path,
  en: `/en${path}`,
  "zh-tw": `/zh-tw${path}`,
  th: `/th${path}`,
  id: `/id${path}`,
};
---
<header class="site-header">
  <a href={localizedPath(locale, "/")} class="site-brand" aria-label="stamp moke home">
    <span class="site-brand-title">stamp moke</span>
    <span class="site-brand-sub">{t.brandSub}</span>
  </a>
  <nav class="site-header-actions" aria-label="Primary navigation">
    <a class="site-header-link site-hide-mobile" href={localizedPath(locale, "/free/")}>{labels.free}</a>
    <a class="site-header-link site-hide-mobile" href={localizedPath(locale, "/search/")}>{labels.search}</a>
    <a class="site-header-link site-tool-link" href={locale === "ja" ? "/qr-maker" : `/${locale}/qr-maker`}>{labels.qr}</a>
    <a class="site-header-link site-tool-link site-hide-tablet" href={locale === "ja" ? "/chat-stamp-maker" : `/${locale}/chat-stamp-maker`}>{labels.chat}</a>
    <LanguageSwitcher locale={locale} path={path} paths={toolPaths} />
  </nav>
</header>

<style>
.site-header{height:86px;background:rgba(255,255,255,.96);border-bottom:1px solid #e4e3df;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:0 5vw;position:sticky;top:0;z-index:50;backdrop-filter:blur(12px);font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.site-brand{display:flex;flex-direction:column;color:#161616;text-decoration:none;min-width:max-content}.site-brand-title{font-size:21px;font-weight:900;letter-spacing:.1em;line-height:1}.site-brand-sub{margin-top:7px;font-size:11px;color:#777;letter-spacing:.05em}.site-header-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-width:0}.site-header-link{display:inline-flex;align-items:center;justify-content:center;min-height:40px;border:1px solid #d9d8d4;background:#fff;color:#161616;padding:9px 14px;border-radius:999px;font-size:12px;font-weight:800;text-decoration:none;white-space:nowrap}.site-header-link:hover{background:#f5f4f0}.site-tool-link{background:#161616;border-color:#161616;color:#fff}.site-tool-link:hover{background:#333}.site-header :global(.language-switcher){flex:0 0 auto}@media(max-width:900px){.site-hide-tablet{display:none}}@media(max-width:640px){.site-header{height:72px;padding:0 16px;gap:10px}.site-brand-title{font-size:17px}.site-brand-sub{font-size:9px;margin-top:5px}.site-hide-mobile,.site-tool-link{display:none}.site-header-actions{gap:5px}}
</style>