<script is:inline src={`/site-logo-sync.js?v=${headerVersion}`}></script>
<script is:inline src={`/trailing-slash-links.js?v=${headerVersion}`}></script>
<script is:inline src="/share-buttons.js?v=20260902-1"></script>
