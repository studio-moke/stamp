---
const { locale = "ja" } = Astro.props;
const copy = {
  ja:{title:"無料フリー素材",lead:"ポケカラやSNS、個人プロフィール、学校・サークルなどの非商用制作で使える素材を配布しています。",terms:"個人利用・非商用利用のみ無料。商用利用、販売、再配布、自作発言は禁止です。著作権は © stamp-moke.jp に帰属します。",search:"素材を検索",all:"すべて",category:"カテゴリ",tag:"タグ",newest:"新着順",popular:"人気順",empty:"条件に合う素材はまだありません。",loading:"素材を読み込んでいます…",count:"件"},
  en:{title:"Free Assets",lead:"Free assets for Pokekara, social media, personal profiles, school and non-commercial projects.",terms:"Free for personal and non-commercial use only. Commercial use, resale, redistribution and claiming authorship are prohibited. Copyright © stamp-moke.jp.",search:"Search assets",all:"All",category:"Category",tag:"Tag",newest:"Newest",popular:"Popular",empty:"No assets match these filters.",loading:"Loading assets…",count:"items"},
  "zh-tw":{title:"免費素材",lead:"適合 Pokekara、社群媒體、個人檔案、學校與非商業用途的免費素材。",terms:"僅限個人與非商業使用。禁止商業使用、販售、再散布與冒充作者。著作權 © stamp-moke.jp。",search:"搜尋素材",all:"全部",category:"分類",tag:"標籤",newest:"最新",popular:"熱門",empty:"沒有符合條件的素材。",loading:"正在載入素材…",count:"件"},
  th:{title:"素材ฟรี",lead:"素材ฟรีสำหรับ Pokekara โซเชียล โปรไฟล์ส่วนตัว โรงเรียน และงานที่ไม่ใช่เชิงพาณิชย์",terms:"ใช้ได้เฉพาะส่วนบุคคลและไม่ใช่เชิงพาณิชย์ ห้ามขาย แจกจ่ายซ้ำ หรืออ้างว่าเป็นผลงานของตน ลิขสิทธิ์ © stamp-moke.jp",search:"ค้นหาส素材",all:"ทั้งหมด",category:"หมวดหมู่",tag:"แท็ก",newest:"ใหม่ล่าสุด",popular:"ยอดนิยม",empty:"ยังไม่มี素材ที่ตรงกับเงื่อนไข",loading:"กำลังโหลด…",count:"รายการ"},
  id:{title:"Aset Gratis",lead:"Aset gratis untuk Pokekara, media sosial, profil pribadi, sekolah, dan proyek non-komersial.",terms:"Hanya untuk penggunaan pribadi dan non-komersial. Dilarang untuk komersial, dijual, didistribusikan ulang, atau diklaim sebagai karya sendiri. Hak cipta © stamp-moke.jp.",search:"Cari aset",all:"Semua",category:"Kategori",tag:"Tag",newest:"Terbaru",popular:"Populer",empty:"Belum ada aset yang cocok.",loading:"Memuat aset…",count:"item"}
};
const t = copy[locale] || copy.ja;
const prefix = locale === "ja" ? "" : `/${locale}`;
const canonical = `https://stamp-moke.jp${prefix}/free/`;
const langMap={ja:"ja",en:"en","zh-tw":"zh-Hant",th:"th",id:"id"};
const labels={pokekara:"Pokekara",x:"X",instagram:"Instagram",facebook:"Facebook",line:"LINE",youtube:"YouTube",other:"Other",icon:"Icon",header:"Header",background:"Background",story:"Story",wallpaper:"Wallpaper",thumbnail:"Thumbnail",frame:"Frame",decoration:"Decoration",cat:"Cat",dog:"Dog",bird:"Bird",food:"Food",human:"Human",text:"Text",cute:"Cute",simple:"Simple",handdrawn:"Hand drawn",funny:"Funny",cool:"Cool",retro:"Retro",minimal:"Minimal"};
---
<!doctype html><html lang={langMap[locale] || "ja"}><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>{t.title} | stamp moke</title><meta name="description" content={t.lead}><link rel="canonical" href={canonical}><link rel="alternate" hreflang="ja" href="https://stamp-moke.jp/free/"><link rel="alternate" hreflang="en" href="https://stamp-moke.jp/en/free/"><link rel="alternate" hreflang="zh-Hant" href="https://stamp-moke.jp/zh-tw/free/"><link rel="alternate" hreflang="th" href="https://stamp-moke.jp/th/free/"><link rel="alternate" hreflang="id" href="https://stamp-moke.jp/id/free/"><link rel="alternate" hreflang="x-default" href="https://stamp-moke.jp/free/"><meta property="og:title" content={`${t.title} | stamp moke`}><meta property="og:description" content={t.lead}><meta property="og:type" content="website"><meta property="og:url" content={canonical}>
<style>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}.header{height:86px;background:rgba(255,255,255,.96);border-bottom:1px solid #e4e3df;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;position:sticky;top:0;z-index:20;backdrop-filter:blur(12px)}.brand{text-decoration:none}.brand-title{font-size:21px;font-weight:900;letter-spacing:.1em}.brand-sub{margin-top:7px;font-size:11px;color:#777}.langs{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}.langs a{text-decoration:none;border:1px solid #dddcd7;background:#fff;padding:7px 10px;border-radius:99px;font-size:11px}.langs a.active{background:#161616;color:#fff;border-color:#161616}.main{max-width:1180px;margin:auto;padding:50px 5vw 110px}.hero{display:grid;grid-template-columns:1fr .8fr;gap:28px;align-items:end;margin-bottom:30px}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.2em;color:#777;margin-bottom:13px}.hero h1{font-size:clamp(38px,6vw,68px);line-height:1;margin:0;letter-spacing:-.055em}.hero p{margin:18px 0 0;max-width:670px;color:#666;line-height:1.9;font-size:13px}.terms{background:#fff;border:1px solid #deddd8;border-radius:20px;padding:18px 20px;font-size:12px;line-height:1.8;box-shadow:0 14px 35px rgba(42,40,32,.04)}.tools{background:#fff;border:1px solid #deddd8;border-radius:22px;padding:15px;margin:25px 0 20px;display:grid;grid-template-columns:minmax(220px,1.4fr) repeat(3,minmax(130px,.6fr));gap:10px}.tools input,.tools select{width:100%;border:1px solid #d9d8d4;background:#faf9f5;border-radius:999px;padding:11px 14px;font:inherit;font-size:12px}.platforms{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:20px}.platforms button{border:1px solid #d9d8d4;background:#fff;border-radius:999px;padding:8px 12px;font-size:11px;font-weight:800;cursor:pointer}.platforms button.active{background:#161616;color:#fff;border-color:#161616}.summary{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:16px 0;color:#666;font-size:12px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.card{min-width:0;background:#fff;border:1px solid #deddd8;border-radius:20px;overflow:hidden;box-shadow:0 12px 32px rgba(42,40,32,.045);transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-3px);box-shadow:0 18px 42px rgba(42,40,32,.08)}.thumb{display:block;aspect-ratio:1.15/1;background:#efeee9;overflow:hidden}.thumb img{display:block;width:100%;height:100%;object-fit:cover}.card-body{padding:13px}.card h2{font-size:14px;line-height:1.5;margin:0 0 8px}.card h2 a{text-decoration:none}.card p{font-size:11px;line-height:1.65;color:#737373;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.chips{display:flex;gap:4px;flex-wrap:wrap;margin-top:10px}.chip{font-size:9px;padding:4px 6px;border-radius:99px;background:#f1f0eb;color:#656565}.empty{grid-column:1/-1;text-align:center;padding:70px 20px;color:#777}.footer{margin-top:70px;padding-top:24px;border-top:1px solid #deddd8;font-size:11px;color:#777}@media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}.tools{grid-template-columns:1fr 1fr}.hero{grid-template-columns:1fr}}@media(max-width:620px){.header{height:auto;min-height:76px;padding:14px 16px;gap:10px}.main{padding:35px 12px 80px}.grid{grid-template-columns:repeat(2,1fr);gap:9px}.tools{grid-template-columns:1fr;padding:11px}.card{border-radius:14px}.card-body{padding:9px}.hero h1{font-size:40px}.terms{padding:14px}.langs a{padding:5px 7px;font-size:9px}}
</style></head><body><header class="header"><a class="brand" href={`${prefix}/`}><div class="brand-title">stamp moke</div><div class="brand-sub">LINE STICKERS & FREE ASSETS</div></a><nav class="langs"><a class={locale==='ja'?'active':''} href="/free/">JA</a><a class={locale==='en'?'active':''} href="/en/free/">EN</a><a class={locale==='zh-tw'?'active':''} href="/zh-tw/free/">繁中</a><a class={locale==='th'?'active':''} href="/th/free/">TH</a><a class={locale==='id'?'active':''} href="/id/free/">ID</a></nav></header><main class="main"><section class="hero"><div><div class="eyebrow">FREE ASSET LIBRARY</div><h1>{t.title}</h1><p>{t.lead}</p></div><div class="terms">{t.terms}</div></section><section class="tools"><input id="search" type="search" placeholder={t.search}><select id="category"><option value="">{t.category}: {t.all}</option></select><select id="tag"><option value="">{t.tag}: {t.all}</option></select><select id="sort"><option value="new">{t.newest}</option><option value="popular">{t.popular}</option></select></section><div class="platforms" id="platforms"></div><div class="summary"><span id="resultCount">0 {t.count}</span><span>© stamp-moke.jp</span></div><section class="grid" id="grid"><div class="empty">{t.loading}</div></section><footer class="footer">stamp moke free asset library · personal / non-commercial use only</footer></main>
<script define:vars={{ locale, prefix, labels, t }}>
const $=id=>document.getElementById(id),grid=$("grid"),search=$("search"),category=$("category"),tag=$("tag"),sort=$("sort"),platforms=$("platforms"),resultCount=$("resultCount");let assets=[],activePlatform="";const esc=(v="")=>String(v).replace(/[&<>\"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));const label=v=>labels[v]||v;
function allTags(a){return [...(a.platforms||[]),...(a.types||[]),...(a.motifs||[]),...(a.styles||[])]}function localized(a){return a.locales?.[locale]||a.locales?.ja||{}}function detailPath(slug){return `${prefix}/free/${encodeURIComponent(slug)}`}
function setup(){const ps=[...new Set(assets.flatMap(a=>a.platforms||[]))];platforms.innerHTML=["",...ps].map(p=>`<button data-v="${p}" class="${p===activePlatform?'active':''}">${p?esc(label(p)):esc(t.all)}</button>`).join("");platforms.querySelectorAll("button").forEach(b=>b.onclick=()=>{activePlatform=b.dataset.v;setup();render()});const cats=[...new Set(assets.flatMap(a=>[...(a.types||[]),...(a.motifs||[])]))].sort();category.innerHTML=`<option value="">${esc(t.category)}: ${esc(t.all)}</option>`+cats.map(v=>`<option value="${esc(v)}">${esc(label(v))}</option>`).join("");const tags=[...new Set(assets.flatMap(a=>a.styles||[]))].sort();tag.innerHTML=`<option value="">${esc(t.tag)}: ${esc(t.all)}</option>`+tags.map(v=>`<option value="${esc(v)}">${esc(label(v))}</option>`).join("")}
function render(){const q=search.value.trim().toLowerCase(),cat=category.value,tg=tag.value;let rows=assets.filter(a=>{const l=localized(a),hay=[l.title,l.description,...(l.keywords||[]),...allTags(a)].join(" ").toLowerCase();return(!q||hay.includes(q))&&(!activePlatform||(a.platforms||[]).includes(activePlatform))&&(!cat||(a.types||[]).includes(cat)||(a.motifs||[]).includes(cat))&&(!tg||(a.styles||[]).includes(tg))});rows.sort(sort.value==="popular"?(a,b)=>Number(b.downloads||0)-Number(a.downloads||0):(a,b)=>String(b.publishedAt).localeCompare(String(a.publishedAt)));resultCount.textContent=`${rows.length} ${t.count}`;if(!rows.length){grid.innerHTML=`<div class="empty">${esc(t.empty)}</div>`;return}grid.innerHTML=rows.map(a=>{const l=localized(a),chips=allTags(a).slice(0,4).map(v=>`<span class="chip">${esc(label(v))}</span>`).join("");return `<article class="card"><a class="thumb" href="${detailPath(a.slug)}"><img loading="lazy" decoding="async" src="/api/free-preview?variant=thumb&slug=${encodeURIComponent(a.slug)}" alt="${esc(l.alt||l.title||'free asset')}"></a><div class="card-body"><h2><a href="${detailPath(a.slug)}">${esc(l.title||a.locales?.ja?.title||a.slug)}</a></h2><p>${esc(l.description||a.locales?.ja?.description||'')}</p><div class="chips">${chips}</div></div></article>`}).join("")}
[search,category,tag,sort].forEach(el=>el.addEventListener(el===search?"input":"change",render));fetch('/api/free-assets?action=list&limit=5000').then(r=>r.json()).then(j=>{assets=j.assets||[];setup();render()}).catch(()=>grid.innerHTML=`<div class="empty">${esc(t.empty)}</div>`);
</script></body></html>
