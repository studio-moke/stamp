---
import SiteHeader from "./SiteHeader.astro";
const { locale = "ja" } = Astro.props;
const copy = {
  ja:{title:"無料フリー素材",lead:"ポケカラやSNS、個人プロフィール、学校・サークルなどの非商用制作で使える素材を配布しています。",terms:"個人利用・非商用利用のみ無料。商用利用、販売、再配布、自作発言は禁止です。著作権は © stamp-moke.jp に帰属します。",search:"素材を検索",all:"すべて",category:"カテゴリ",tag:"タグ",newest:"新着順",popular:"人気順",empty:"条件に合う素材はまだありません。",loading:"素材を読み込んでいます…",more:"さらに読み込んでいます…",count:"件"},
  en:{title:"Free Assets",lead:"Free assets for Pokekara, social media, personal profiles, school and non-commercial projects.",terms:"Free for personal and non-commercial use only. Commercial use, resale, redistribution and claiming authorship are prohibited. Copyright © stamp-moke.jp.",search:"Search assets",all:"All",category:"Category",tag:"Tag",newest:"Newest",popular:"Popular",empty:"No assets match these filters.",loading:"Loading assets…",more:"Loading more…",count:"items"},
  "zh-tw":{title:"免費素材",lead:"適合 Pokekara、社群媒體、個人檔案、學校與非商業用途的免費素材。",terms:"僅限個人與非商業使用。禁止商業使用、販售、再散布與冒充作者。著作權 © stamp-moke.jp。",search:"搜尋素材",all:"全部",category:"分類",tag:"標籤",newest:"最新",popular:"熱門",empty:"沒有符合條件的素材。",loading:"正在載入素材…",more:"正在載入更多素材…",count:"件"},
  th:{title:"素材ฟรี",lead:"素材ฟรีสำหรับ Pokekara โซเชียล โปรไฟล์ส่วนตัว โรงเรียน และงานที่ไม่ใช่เชิงพาณิชย์",terms:"ใช้ได้เฉพาะส่วนบุคคลและไม่ใช่เชิงพาณิชย์ ห้ามขาย แจกจ่ายซ้ำ หรืออ้างว่าเป็นผลงานของตน ลิขสิทธิ์ © stamp-moke.jp",search:"ค้นหาส素材",all:"ทั้งหมด",category:"หมวดหมู่",tag:"แท็ก",newest:"ใหม่ล่าสุด",popular:"ยอดนิยม",empty:"ยังไม่มี素材ที่ตรงกับเงื่อนไข",loading:"กำลังโหลด…",more:"กำลังโหลดเพิ่ม…",count:"รายการ"},
  id:{title:"Aset Gratis",lead:"Aset gratis untuk Pokekara, media sosial, profil pribadi, sekolah, dan proyek non-komersial.",terms:"Hanya untuk penggunaan pribadi dan non-komersial. Dilarang untuk komersial, dijual, didistribusikan ulang, atau diklaim sebagai karya sendiri. Hak cipta © stamp-moke.jp.",search:"Cari aset",all:"Semua",category:"Kategori",tag:"Tag",newest:"Terbaru",popular:"Populer",empty:"Belum ada aset yang cocok.",loading:"Memuat aset…",more:"Memuat lebih banyak…",count:"item"}
};
const labelSets={
  ja:{pokekara:"ポケカラ",x:"X",instagram:"Instagram",facebook:"Facebook",line:"LINE",youtube:"YouTube",other:"その他",icon:"アイコン",header:"ヘッダー",background:"背景",story:"ストーリー",wallpaper:"壁紙",thumbnail:"サムネイル",frame:"フレーム",decoration:"装飾",cat:"猫",dog:"犬",bird:"鳥",food:"食べ物",human:"人物",text:"文字",cute:"かわいい",simple:"シンプル",handdrawn:"手描き",funny:"おもしろ",cool:"クール",retro:"レトロ",minimal:"ミニマル"},
  en:{pokekara:"Pokekara",x:"X",instagram:"Instagram",facebook:"Facebook",line:"LINE",youtube:"YouTube",other:"Other",icon:"Icon",header:"Header",background:"Background",story:"Story",wallpaper:"Wallpaper",thumbnail:"Thumbnail",frame:"Frame",decoration:"Decoration",cat:"Cat",dog:"Dog",bird:"Bird",food:"Food",human:"Human",text:"Text",cute:"Cute",simple:"Simple",handdrawn:"Hand drawn",funny:"Funny",cool:"Cool",retro:"Retro",minimal:"Minimal"},
  "zh-tw":{pokekara:"Pokekara",x:"X",instagram:"Instagram",facebook:"Facebook",line:"LINE",youtube:"YouTube",other:"其他",icon:"圖示",header:"頁首",background:"背景",story:"限時動態",wallpaper:"桌布",thumbnail:"縮圖",frame:"邊框",decoration:"裝飾",cat:"貓",dog:"狗",bird:"鳥",food:"食物",human:"人物",text:"文字",cute:"可愛",simple:"簡約",handdrawn:"手繪",funny:"有趣",cool:"酷",retro:"復古",minimal:"極簡"},
  th:{pokekara:"Pokekara",x:"X",instagram:"Instagram",facebook:"Facebook",line:"LINE",youtube:"YouTube",other:"อื่น ๆ",icon:"ไอคอน",header:"ส่วนหัว",background:"พื้นหลัง",story:"สตอรี่",wallpaper:"วอลเปเปอร์",thumbnail:"ภาพปก",frame:"กรอบ",decoration:"ตกแต่ง",cat:"แมว",dog:"สุนัข",bird:"นก",food:"อาหาร",human:"บุคคล",text:"ข้อความ",cute:"น่ารัก",simple:"เรียบง่าย",handdrawn:"วาดมือ",funny:"ตลก",cool:"เท่",retro:"เรโทร",minimal:"มินิมอล"},
  id:{pokekara:"Pokekara",x:"X",instagram:"Instagram",facebook:"Facebook",line:"LINE",youtube:"YouTube",other:"Lainnya",icon:"Ikon",header:"Header",background:"Latar belakang",story:"Story",wallpaper:"Wallpaper",thumbnail:"Thumbnail",frame:"Bingkai",decoration:"Dekorasi",cat:"Kucing",dog:"Anjing",bird:"Burung",food:"Makanan",human:"Orang",text:"Teks",cute:"Lucu",simple:"Sederhana",handdrawn:"Gambar tangan",funny:"Humor",cool:"Keren",retro:"Retro",minimal:"Minimal"}
};
const t=copy[locale]||copy.ja,labels=labelSets[locale]||labelSets.en;
const prefix=locale==="ja"?"":`/${locale}`;
const canonical=`https://stamp-moke.jp${prefix}/free/`;
const langMap={ja:"ja",en:"en","zh-tw":"zh-Hant",th:"th",id:"id"};
---
<!doctype html><html lang={langMap[locale]||"ja"}><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{t.title} | stamp moke</title><meta name="description" content={t.lead}><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="shortcut icon" href="/favicon.ico"><link rel="canonical" href={canonical}><link rel="alternate" hreflang="ja" href="https://stamp-moke.jp/free/"><link rel="alternate" hreflang="en" href="https://stamp-moke.jp/en/free/"><link rel="alternate" hreflang="zh-Hant" href="https://stamp-moke.jp/zh-tw/free/"><link rel="alternate" hreflang="th" href="https://stamp-moke.jp/th/free/"><link rel="alternate" hreflang="id" href="https://stamp-moke.jp/id/free/"><link rel="alternate" hreflang="x-default" href="https://stamp-moke.jp/free/"><meta property="og:title" content={`${t.title} | stamp moke`}><meta property="og:description" content={t.lead}><meta property="og:type" content="website"><meta property="og:url" content={canonical}>
<style is:global>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}.main{max-width:1180px;margin:auto;padding:42px 24px 90px}.hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:28px;align-items:end;margin-bottom:28px}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.2em;color:#777;margin-bottom:12px}.hero h1{font-size:clamp(38px,5vw,64px);line-height:1;margin:0;letter-spacing:-.055em}.hero p{margin:16px 0 0;max-width:680px;color:#666;line-height:1.85;font-size:13px}.terms{background:#fff;border:1px solid #deddd8;border-radius:18px;padding:17px 20px;font-size:12px;line-height:1.75;box-shadow:0 12px 28px rgba(42,40,32,.04)}.tools{background:#fff;border:1px solid #deddd8;border-radius:18px;padding:12px;margin:22px 0 14px;display:grid;grid-template-columns:minmax(240px,1.5fr) repeat(3,minmax(130px,.65fr));gap:9px}.tools input,.tools select{width:100%;border:1px solid #d9d8d4;background:#faf9f5;border-radius:12px;padding:11px 13px;font:inherit;font-size:12px;min-height:42px}.platforms{display:flex;gap:7px;flex-wrap:wrap;margin:14px 0}.platforms button{border:1px solid #d9d8d4;background:#fff;border-radius:999px;padding:7px 12px;font-size:11px;font-weight:800;cursor:pointer}.platforms button.active{background:#161616;color:#fff;border-color:#161616}.summary{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:14px 0 12px;color:#666;font-size:12px}.grid{display:grid!important;grid-template-columns:repeat(auto-fill,minmax(220px,1fr))!important;gap:16px!important;align-items:stretch!important}.card{min-width:0!important;background:#fff!important;border:1px solid #deddd8!important;border-radius:18px!important;overflow:hidden!important;box-shadow:0 8px 24px rgba(42,40,32,.05)!important;transition:transform .18s ease,box-shadow .18s ease!important;content-visibility:auto;contain-intrinsic-size:320px}.card:hover{transform:translateY(-3px)!important;box-shadow:0 14px 32px rgba(42,40,32,.09)!important}.thumb{display:block!important;width:100%!important;height:165px!important;background:#ebeae5!important;overflow:hidden!important;text-decoration:none!important}.thumb img{display:block!important;width:100%!important;height:100%!important;max-width:none!important;object-fit:cover!important}.card-body{padding:13px!important}.card h2{font-size:14px!important;line-height:1.45!important;margin:0 0 7px!important;font-weight:800!important}.card h2 a{color:#161616!important;text-decoration:none!important}.card p{font-size:11px!important;line-height:1.65!important;color:#737373!important;margin:0!important;display:-webkit-box!important;-webkit-line-clamp:2!important;-webkit-box-orient:vertical!important;overflow:hidden!important;min-height:36px}.chips{display:flex!important;gap:5px!important;flex-wrap:wrap!important;margin-top:10px!important}.chip{display:inline-flex!important;align-items:center!important;font-size:9px!important;line-height:1!important;padding:5px 7px!important;border-radius:999px!important;background:#f1f0eb!important;color:#656565!important}.empty,.load-more{grid-column:1/-1;text-align:center;padding:54px 20px;color:#777;font-size:12px}.load-more{padding:28px 20px}.footer{margin-top:60px;padding-top:22px;border-top:1px solid #deddd8;font-size:11px;color:#777}@media(max-width:900px){.tools{grid-template-columns:1fr 1fr}.hero{grid-template-columns:1fr}.grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}.thumb{height:145px!important}}@media(max-width:640px){.main{padding:30px 12px 70px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:9px!important}.thumb{height:118px!important}.tools{grid-template-columns:1fr;padding:10px}.card{border-radius:13px!important}.card-body{padding:9px!important}.hero h1{font-size:40px}.terms{padding:14px}.card h2{font-size:12px!important}.card p{font-size:10px!important}}
</style></head><body><SiteHeader locale={locale} path="/free/" /><main class="main"><section class="hero"><div><div class="eyebrow">FREE ASSET LIBRARY</div><h1>{t.title}</h1><p>{t.lead}</p></div><div class="terms">{t.terms}</div></section><section class="tools"><input id="search" type="search" placeholder={t.search}><select id="category"><option value="">{t.category}: {t.all}</option></select><select id="tag"><option value="">{t.tag}: {t.all}</option></select><select id="sort"><option value="new">{t.newest}</option><option value="popular">{t.popular}</option></select></section><div class="platforms" id="platforms"></div><div class="summary"><span id="resultCount">0 {t.count}</span><span>© stamp-moke.jp</span></div><section class="grid" id="grid"><div class="empty">{t.loading}</div></section><div id="sentinel" class="load-more" hidden>{t.more}</div><footer class="footer">stamp moke free asset library · personal / non-commercial use only</footer></main>
<script define:vars={{ locale, prefix, labels, t }}>
const $=id=>document.getElementById(id),grid=$("grid"),search=$("search"),category=$("category"),tag=$("tag"),sort=$("sort"),platforms=$("platforms"),resultCount=$("resultCount"),sentinel=$("sentinel");
let activePlatform="",offset=0,total=0,hasMore=true,loading=false,facetsReady=false,requestId=0;const PAGE=24;
const esc=(v="")=>String(v).replace(/[&<>\"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));const label=v=>labels[v]||v;
function localized(a){return a.locales?.[locale]||a.locales?.ja||{}}function allTags(a){return [...(a.platforms||[]),...(a.types||[]),...(a.motifs||[]),...(a.styles||[])]}function detailPath(slug){return `${prefix}/free/${encodeURIComponent(slug)}`}
function card(a,i){const l=localized(a),chips=allTags(a).slice(0,4).map(v=>`<span class="chip">${esc(label(v))}</span>`).join(""),img=`/api/free-preview?variant=thumb&slug=${encodeURIComponent(a.slug)}`;return `<article class="card"><a class="thumb" href="${detailPath(a.slug)}"><img loading="lazy" decoding="async" fetchpriority="low" width="360" height="240" src="${img}" alt="${esc(l.alt||l.title||'free asset')}"></a><div class="card-body"><h2><a href="${detailPath(a.slug)}">${esc(l.title||a.locales?.ja?.title||a.slug)}</a></h2><p>${esc(l.description||a.locales?.ja?.description||'')}</p><div class="chips">${chips}</div></div></article>`}
function setFacets(f){if(facetsReady)return;facetsReady=true;const ps=f.platforms||[];platforms.innerHTML=["",...ps].map(p=>`<button data-v="${esc(p)}" class="${p===activePlatform?'active':''}">${p?esc(label(p)):esc(t.all)}</button>`).join("");platforms.querySelectorAll("button").forEach(b=>b.onclick=()=>{activePlatform=b.dataset.v;platforms.querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===b));resetAndLoad()});const cats=[...new Set([...(f.types||[]),...(f.motifs||[])])].sort();category.innerHTML=`<option value="">${esc(t.category)}: ${esc(t.all)}</option>`+cats.map(v=>`<option value="${esc(v)}">${esc(label(v))}</option>`).join("");const styles=(f.styles||[]).slice().sort();tag.innerHTML=`<option value="">${esc(t.tag)}: ${esc(t.all)}</option>`+styles.map(v=>`<option value="${esc(v)}">${esc(label(v))}</option>`).join("")}
async function loadMore(reset=false){if(loading||(!hasMore&&!reset))return;loading=true;const id=++requestId;if(reset){offset=0;hasMore=true;grid.innerHTML=`<div class="empty">${esc(t.loading)}</div>`}sentinel.hidden=false;const params=new URLSearchParams({locale,limit:String(PAGE),offset:String(offset),q:search.value.trim(),platform:activePlatform,category:category.value,style:tag.value,sort:sort.value});try{const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),12000);const r=await fetch(`/api/free-list?${params}`,{signal:controller.signal});clearTimeout(timer);if(!r.ok)throw new Error(`HTTP ${r.status}`);const j=await r.json();if(id!==requestId)return;setFacets(j.facets||{});const rows=j.assets||[];total=Number(j.total||0);resultCount.textContent=`${total} ${t.count}`;if(reset)grid.innerHTML="";if(!rows.length&&offset===0){grid.innerHTML=`<div class="empty">${esc(t.empty)}</div>`}else{grid.insertAdjacentHTML("beforeend",rows.map(card).join(""))}offset=Number(j.nextOffset||offset+rows.length);hasMore=Boolean(j.hasMore);sentinel.hidden=!hasMore}catch(e){if(id===requestId&&offset===0){grid.innerHTML=`<div class="empty">${esc(t.empty)}</div>`;resultCount.textContent=`0 ${t.count}`}console.error(e);hasMore=false;sentinel.hidden=true}finally{loading=false}}
function resetAndLoad(){requestId++;loading=false;loadMore(true)}
let searchTimer;search.addEventListener("input",()=>{clearTimeout(searchTimer);searchTimer=setTimeout(resetAndLoad,250)});[category,tag,sort].forEach(el=>el.addEventListener("change",resetAndLoad));
const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting))loadMore(false)},{rootMargin:"700px 0px"});observer.observe(sentinel);loadMore(true);
</script></body></html>
