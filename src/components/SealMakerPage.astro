---
import SiteHeader from "./SiteHeader.astro";
import stickers from "../data/stickers.json";
const {locale="ja"}=Astro.props; const prefix=locale==="ja"?"":`/${locale}`; const picks=stickers.slice(0,6);
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>電子印鑑・落款画像メーカー｜背景透過PNGを無料作成 | stamp moke</title><meta name="description" content="名前や会社名から電子印鑑・落款の印影画像を無料作成。丸印・角印・落款、朱色や黒、縦書きに対応し背景透過PNGで保存できます。"/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/seal-maker/`}/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",serif}.wrap{max-width:1000px;margin:auto;padding:35px 16px 80px}.crumb{font-size:11px;color:#777;margin-bottom:25px}.crumb a{color:inherit}.hero{text-align:center;padding:25px 0}.hero h1{font-size:clamp(34px,6vw,60px);letter-spacing:-.05em;margin:0 0 12px}.hero p{font-size:12px;color:#666;line-height:1.9}.maker{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel,.preview{background:#fff;border:1px solid #ddd;border-radius:20px;padding:20px}.panel h2,.preview h2{font-size:16px;margin:0 0 18px}.row{margin-bottom:15px}.row label{display:block;font-size:10px;font-weight:900;margin-bottom:6px}.row input,.row select{width:100%;border:1px solid #ccc;border-radius:10px;padding:11px;background:#fff}.types{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.types button{border:1px solid #ccc;background:#fff;border-radius:10px;padding:11px 4px;font-weight:800;font-size:10px}.types button.on{background:#171717;color:#fff}.canvas-wrap{min-height:390px;display:flex;align-items:center;justify-content:center;background-color:#fafafa;background-image:linear-gradient(45deg,#e9e9e9 25%,transparent 25%),linear-gradient(-45deg,#e9e9e9 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e9e9e9 75%),linear-gradient(-45deg,transparent 75%,#e9e9e9 75%);background-size:18px 18px;border-radius:14px}canvas{width:min(330px,90%);height:auto}.save{width:100%;border:0;background:#171717;color:#fff;border-radius:13px;padding:15px;font-weight:900;margin-top:13px;cursor:pointer}.note{font-size:10px;color:#777;line-height:1.7;margin-top:10px}.info{margin-top:45px;background:#fff;border:1px solid #ddd;border-radius:18px;padding:22px}.info h2{font-size:22px}.info p{font-size:11px;line-height:2;color:#555}.stamp-section{margin-top:60px;padding-top:30px;border-top:1px solid #ddd}.stamp-section h2{font-size:27px;margin-bottom:6px}.stamp-section>p{font-size:11px;color:#777}.stamp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stamp{background:#fff;border:1px solid #ddd;border-radius:15px;padding:9px;text-decoration:none;color:#171717}.stamp img{width:100%;aspect-ratio:1;object-fit:contain}.stamp b{font-size:10px;display:block;margin-top:6px}.tools{margin-top:45px}.tools a{display:inline-block;background:#fff;border:1px solid #ddd;border-radius:999px;padding:9px 12px;margin:3px;text-decoration:none;color:#333;font-size:10px;font-weight:800}@media(max-width:700px){.maker{grid-template-columns:1fr}.preview{order:-1}.canvas-wrap{min-height:320px}.stamp-grid{grid-template-columns:repeat(2,1fr)}} </style></head><body><SiteHeader locale={locale}/><main class="wrap"><div class="crumb"><a href={`${prefix}/`}>stamp moke</a> / 無料ツール / 電子印鑑・落款</div><section class="hero"><h1>電子印鑑・落款メーカー</h1><p>名前・会社名から印影画像を作成。請求書、見積書、納品書、PDFなどに使いやすい<br/>背景透過PNGをブラウザだけで作れます。画像はサーバーへ送信しません。</p></section><div class="maker"><section class="panel"><h2>印影を設定</h2><div class="row"><label>文字</label><input id="text" value="山田" maxlength="12"/></div><div class="row"><label>形</label><div class="types"><button class="on" data-type="circle">丸印</button><button data-type="square">角印</button><button data-type="rakkan">落款</button></div></div><div class="row"><label>文字方向</label><select id="direction"><option value="vertical">縦書き</option><option value="horizontal">横書き</option></select></div><div class="row"><label>色</label><select id="color"><option value="#b52b27">朱色</option><option value="#d11919">赤</option><option value="#1d1d1d">黒</option><option value="#6f1d1b">古朱</option></select></div><div class="row"><label>書体</label><select id="font"><option value="serif">明朝・印鑑風</option><option value="sans-serif">ゴシック</option><option value="cursive">筆文字風</option></select></div><div class="row"><label>枠の太さ</label><input id="border" type="range" min="4" max="22" value="11"/></div><div class="row"><label>文字サイズ</label><input id="size" type="range" min="60" max="190" value="125"/></div><div class="row"><label>かすれ</label><input id="rough" type="range" min="0" max="40" value="5"/></div></section><section class="preview"><h2>仕上がりプレビュー</h2><div class="canvas-wrap"><canvas id="canvas" width="600" height="600"></canvas></div><button class="save" id="save">背景透過PNGを保存</button><div class="note">600×600pxの透過PNGで保存します。設定変更はリアルタイムで反映されます。</div></section></div><section class="info"><h2>電子取引・書類作成にも使える印影画像</h2><p>電子印鑑の画像は、請求書・見積書・納品書などのPDFや電子書類へ印影を配置したいときに便利です。落款はイラスト、写真、書作品などのサイン画像としても利用できます。本ツールで作成するものは「印影画像」です。電子署名・電子証明書や、本人性を証明する実印・印鑑証明とは異なります。契約や重要な電子取引では、取引先の運用ルールや必要な電子署名方式をご確認ください。</p></section><section class="tools"><h2>ほかの無料画像ツール</h2><a href={`${prefix}/image-compressor/`}>画像圧縮</a><a href={`${prefix}/image-resizer/`}>サイズ変更</a><a href={`${prefix}/convert-to-jpg/`}>JPG変換</a><a href={`${prefix}/png-transparent/`}>背景透過</a><a href={`${prefix}/color-palette/`}>カラーパレット</a></section><section class="stamp-section"><h2>stamp mokeのLINEスタンプ</h2><p>仕事の連絡や毎日の会話に使えるオリジナルLINEスタンプも公開しています。</p><div class="stamp-grid">{picks.map(s=><a class="stamp" href={`${prefix}/stickers/${s.id}/`}><img src={s.image} loading="lazy" alt={s.title}/><b>{s.title.replace(' - LINE スタンプ | LINE STORE','')}</b></a>)}</div></section></main><script is:inline>(()=>{const c=document.getElementById('canvas'),ctx=c.getContext('2d'),text=document.getElementById('text'),direction=document.getElementById('direction'),color=document.getElementById('color'),font=document.getElementById('font'),border=document.getElementById('border'),size=document.getElementById('size'),rough=document.getElementById('rough');let type='circle';function draw(){ctx.clearRect(0,0,600,600);const col=color.value,b=+border.value;ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineWidth=b;ctx.lineJoin='round';if(type==='circle'){ctx.beginPath();ctx.arc(300,300,250,0,Math.PI*2);ctx.stroke()}else{ctx.strokeRect(type==='rakkan'?105:65,type==='rakkan'?70:65,type==='rakkan'?390:470,type==='rakkan'?460:470)}const chars=[...text.value];ctx.textAlign='center';ctx.textBaseline='middle';ctx.font=`900 ${size.value}px ${font.value}`;if(direction.value==='vertical'){const step=Math.min(150,430/Math.max(chars.length,1)),start=300-step*(chars.length-1)/2;chars.forEach((ch,i)=>ctx.fillText(ch,300,start+i*step))}else{let fs=+size.value;ctx.font=`900 ${fs}px ${font.value}`;while(ctx.measureText(text.value).width>420&&fs>30){fs-=3;ctx.font=`900 ${fs}px ${font.value}`}ctx.fillText(text.value,300,300)}const r=+rough.value;if(r){ctx.globalCompositeOperation='destination-out';for(let i=0;i<r*14;i++){const x=Math.random()*520+40,y=Math.random()*520+40,rr=Math.random()*3+1;ctx.beginPath();ctx.arc(x,y,rr,0,7);ctx.fill()}ctx.globalCompositeOperation='source-over'}}document.querySelectorAll('.types button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.types button').forEach(x=>x.classList.remove('on'));b.classList.add('on');type=b.dataset.type;draw()});[text,direction,color,font,border,size,rough].forEach(x=>x.addEventListener('input',draw));document.getElementById('save').onclick=()=>c.toBlob(b=>{const u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='stamp-moke-seal.png';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)},'image/png');draw()})();</script></body></html>