<script define:vars={{ C }}>window.__CHAT_COPY__=C;</script><script>
const C=window.__CHAT_COPY__,canvas=document.getElementById('preview'),input=document.getElementById('stampText'),safetyEl=document.getElementById('safetyStatus'),consent=document.getElementById('publishConsent'),toast=document.getElementById('toast');let style='business';const fonts={gothic:{family:'"Arial Black","Noto Sans JP",sans-serif',weight:900},rounded:{family:'"Hiragino Maru Gothic ProN","Yu Gothic",sans-serif',weight:900},mincho:{family:'"Yu Mincho","Hiragino Mincho ProN",serif',weight:900},serif:{family:'"Yu Mincho",serif',weight:900},hand:{family:'"Comic Sans MS","Yu Gothic",sans-serif',weight:800},pop:{family:'"Arial Rounded MT Bold","Noto Sans JP",sans-serif',weight:900},retro:{family:'Impact,"Noto Sans JP",sans-serif',weight:900},bold:{family:'Impact,"Arial Black","Noto Sans JP",sans-serif',weight:900},classic:{family:'Georgia,"Yu Mincho",serif',weight:800},casual:{family:'"Trebuchet MS","Yu Gothic",sans-serif',weight:800}};const presets={business:{font:'gothic',textColor:'#111827',strokeColor:'#ffffff',strokeWidth:14,effect:'none',background:'transparent',backgroundColor:'#ffffff',fontScale:100,letterSpacing:0,horizontalScale:100,rotation:0,padding:5,stampShape:'rounded'},pop:{font:'pop',textColor:'#ff4f87',strokeColor:'#ffffff',strokeWidth:16,effect:'shadow',background:'color',backgroundColor:'#fff3f7',fontScale:105,letterSpacing:1,horizontalScale:100,rotation:0,padding:5,stampShape:'rounded'},stamp:{font:'serif',textColor:'#b91c1c',strokeColor:'#ffffff',strokeWidth:8,effect:'none',background:'transparent',backgroundColor:'#ffffff',fontScale:92,letterSpacing:2,horizontalScale:100,rotation:0,padding:7,stampShape:'rounded'},bold:{font:'bold',textColor:'#111111',strokeColor:'#ffffff',strokeWidth:18,effect:'depth',background:'transparent',backgroundColor:'#ffffff',fontScale:108,letterSpacing:-1,horizontalScale:92,rotation:-2,padding:3,stampShape:'rounded'},soft:{font:'rounded',textColor:'#6d5c80',strokeColor:'#ffffff',strokeWidth:12,effect:'none',background:'color',backgroundColor:'#f6f1fb',fontScale:100,letterSpacing:1,horizontalScale:100,rotation:0,padding:6,stampShape:'rounded'},mono:{font:'gothic',textColor:'#ffffff',strokeColor:'#111111',strokeWidth:10,effect:'none',background:'color',backgroundColor:'#111111',fontScale:100,letterSpacing:0,horizontalScale:100,rotation:0,padding:4,stampShape:'rounded'}};const $=id=>document.getElementById(id);function validHex(v){return /^#[0-9a-fA-F]{6}$/.test(v)}function syncPair(cId,hId){const c=$(cId),h=$(hId);c.oninput=()=>{h.value=c.value;update()};h.oninput=()=>{if(validHex(h.value)){c.value=h.value;update()}}}syncPair('textColor','textHex');syncPair('strokeColor','strokeHex');syncPair('backgroundColor','backgroundHex');function settings(){return{lineMode:$('lineMode').value,font:$('font').value,textColor:$('textColor').value,strokeEnabled:$('strokeEnabled').checked,strokeColor:$('strokeColor').value,strokeWidth:+$('strokeWidth').value,effect:$('effect').value,background:$('background').value,backgroundColor:$('backgroundColor').value,fontScale:+$('fontScale').value,letterSpacing:+$('letterSpacing').value,horizontalScale:+$('horizontalScale').value,rotation:+$('rotation').value,padding:+$('padding').value,stampShape:$('stampShape').value}}function applySettings(s){$('font').value=s.font||'gothic';$('textColor').value=s.textColor||'#111827';$('textHex').value=$('textColor').value;$('strokeEnabled').checked=s.strokeEnabled!==false;$('strokeColor').value=s.strokeColor||'#ffffff';$('strokeHex').value=$('strokeColor').value;$('strokeWidth').value=s.strokeWidth??14;$('effect').value=s.effect||'none';$('background').value=s.background||'transparent';$('backgroundColor').value=s.backgroundColor||'#fff3f7';$('backgroundHex').value=$('backgroundColor').value;$('fontScale').value=s.fontScale??100;$('letterSpacing').value=s.letterSpacing??0;$('horizontalScale').value=s.horizontalScale??100;$('rotation').value=s.rotation??0;$('padding').value=s.padding??5;$('stampShape').value=s.stampShape||'rounded';labels()}function balanced(text,mode){const manual=String(text).split('\n').map(x=>x.trim()).filter(Boolean);if(manual.length>1)return manual.slice(0,4);const chars=[...String(text).replace(/\s+/g,'')];let rows=mode==='auto'?(chars.length<=4?1:chars.length<=8?2:chars.length<=15?3:4):+mode;rows=Math.max(1,Math.min(4,rows));const base=Math.floor(chars.length/rows),extra=chars.length%rows;let i=0;return Array.from({length:rows},(_,r)=>{const n=base+(r<extra?1:0),v=chars.slice(i,i+n).join('');i+=n;return v}).filter(Boolean)}function measure(x,t,s){const a=[...t];return a.reduce((w,ch)=>w+x.measureText(ch).width,0)+Math.max(0,a.length-1)*s}function fit(x,lines,f,w,h,spacing,scale){let size=270;while(size>30){x.font=`${f.weight} ${size}px ${f.family}`;const widest=Math.max(...lines.map(v=>measure(x,v,spacing)*(scale/100))),lh=size*.98;if(widest<=w&&lh*lines.length<=h)return{size,lh};size-=2}return{size:30,lh:30}}function spaced(x,text,y,spacing,stroke,width){const chars=[...text],total=measure(x,text,spacing);let cur=-total/2;chars.forEach(ch=>{const w=x.measureText(ch).width,px=cur+w/2;if(stroke&&width>0)x.strokeText(ch,px,y);x.fillText(ch,px,y);cur+=w+spacing})}function drawStamp(c=canvas,text=input.value.trim()||C.sample,st=settings(),lay=$('layout').value){const x=c.getContext('2d'),f=fonts[st.font]||fonts.gothic,pad=Math.round(c.width*(Math.max(0,Math.min(20,st.padding??5))/100));x.clearRect(0,0,c.width,c.height);x.save();if(st.background!=='transparent'){x.fillStyle=st.background==='white'?'#fff':st.backgroundColor;x.fillRect(0,0,c.width,c.height)}x.textAlign='center';x.textBaseline='middle';x.lineJoin='round';x.fillStyle=st.textColor;x.strokeStyle=st.strokeColor;if(st.effect==='shadow'){x.shadowColor='rgba(0,0,0,.35)';x.shadowBlur=12;x.shadowOffsetX=7;x.shadowOffsetY=9}else if(st.effect==='glow'){x.shadowColor=st.textColor;x.shadowBlur=25}else if(st.effect==='depth'){x.shadowColor='rgba(0,0,0,.45)';x.shadowOffsetX=10;x.shadowOffsetY=10}if(lay==='vertical'){const chars=[...text.replace(/\s+/g,'')].slice(0,12),base=Math.max(34,Math.min(155,(c.height-pad*2)/Math.max(chars.length,1)*.9)),fs=base*((st.fontScale||100)/100);x.translate(c.width/2,c.height/2);x.rotate((st.rotation||0)*Math.PI/180);x.scale((st.horizontalScale||100)/100,1);x.font=`${f.weight} ${fs}px ${f.family}`;x.lineWidth=st.strokeEnabled?Math.min(st.strokeWidth,fs*.18):0;const step=Math.min(fs*.96+st.letterSpacing,(c.height-pad*2)/Math.max(chars.length,1)),start=-step*(chars.length-1)/2;chars.forEach((ch,i)=>{if(st.strokeEnabled&&st.strokeWidth>0)x.strokeText(ch,0,start+i*step);x.fillText(ch,0,start+i*step)})}else{const lines=balanced(text,st.lineMode),v=fit(x,lines,f,c.width-pad*2,c.height-pad*2,st.letterSpacing||0,st.horizontalScale||100),fs=v.size*((st.fontScale||100)/100),lh=v.lh*((st.fontScale||100)/100);x.translate(c.width/2,c.height/2);x.rotate((st.rotation||0)*Math.PI/180);x.scale((st.horizontalScale||100)/100,1);x.font=`${f.weight} ${fs}px ${f.family}`;x.lineWidth=st.strokeEnabled?Math.min(st.strokeWidth,fs*.2):0;const first=-lh*lines.length/2+lh/2;lines.forEach((line,i)=>spaced(x,line,first+i*lh,st.letterSpacing||0,st.strokeEnabled,st.strokeWidth))}x.restore();if(style==='stamp'){x.save();x.strokeStyle=st.textColor;x.lineWidth=7;if((st.stampShape||'rounded')==='circle'){const r=Math.max(10,Math.min(c.width,c.height)/2-pad-4);x.beginPath();x.arc(c.width/2,c.height/2,r,0,Math.PI*2);x.stroke()}else{x.beginPath();x.roundRect(pad,pad,c.width-pad*2,c.height-pad*2,Math.min(40,c.width*.06));x.stroke()}x.restore()}}function safety(raw){const t=String(raw||'').normalize('NFKC').trim(),flat=t.replace(/\n/g,' ');if(!t)return{level:'red',reason:C.msgs.empty};const red=[/(?:https?:\/\/|www\.)/i,/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i,/(?:password|passcode|confidential|secret|パスワード|暗証番号|社外秘|機密|極秘|顧客情報|個人情報|口座番号|カード番号)/i,/\d{8,}/];if(red.some(p=>p.test(flat)))return{level:'red',reason:C.msgs.red};const yellow=[/\d{4,}/,/(?:株式会社|有限会社|合同会社|company|client|customer|担当者|取引先|クライアント)/i];if(yellow.some(p=>p.test(flat)))return{level:'yellow',reason:C.msgs.yellow};return{level:'green',reason:C.msgs.green}}function labels(){$('strokeValue').textContent=$('strokeWidth').value;$('fontScaleValue').textContent=$('fontScale').value+'%';$('letterSpacingValue').textContent=$('letterSpacing').value+'px';$('horizontalScaleValue').textContent=$('horizontalScale').value+'%';$('rotationValue').textContent=$('rotation').value+'°';$('paddingValue').textContent=$('padding').value+'%'}function update(){labels();drawStamp();const s=safety(input.value);safetyEl.className='status '+s.level;safetyEl.textContent=s.level.toUpperCase()+'：'+s.reason}function notify(m){toast.textContent=m;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2500)}function download(c,n){const a=document.createElement('a');a.download=n;a.href=c.toDataURL('image/png');a.click()}input.oninput=update;['font','lineMode','layout','effect','background','strokeWidth','strokeEnabled','fontScale','letterSpacing','horizontalScale','rotation','padding','stampShape'].forEach(id=>$(id).addEventListener('input',update));document.querySelectorAll('[data-style]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-style]').forEach(x=>x.classList.remove('active'));b.classList.add('active');style=b.dataset.style;applySettings({...presets[style],lineMode:$('lineMode').value,strokeEnabled:true});update()});$('downloadBtn').onclick=()=>{drawStamp();download(canvas,'stamp-moke-'+Date.now()+'.png')};$('publishBtn').onclick=async()=>{const safe=safety(input.value);if(safe.level!=='green')return notify(C.msgs.onlyGreen);if(!consent.checked)return notify(C.msgs.needConsent);try{const r=await fetch('/api/chat-stamps',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:input.value,style,layout:$('layout').value,settings:settings(),consent:true})}),d=await r.json();if(!r.ok)throw new Error(d?.safety?.reason||d.error||C.msgs.publishFail);localStorage.setItem('chat-stamp-delete-'+d.item.id,d.deleteToken);$('deleteInfo').textContent=C.msgs.publishedDelete;consent.checked=false;notify(C.msgs.published);loadGallery()}catch(e){notify(e.message)}};function galleryCanvas(item){const c=document.createElement('canvas');c.width=c.height=640;const old=style;style=item.style||'business';drawStamp(c,item.text,item.settings||presets[item.style]||presets.business,item.layout||'horizontal');style=old;return c}async function del(item){const token=localStorage.getItem('chat-stamp-delete-'+item.id);if(!token)return;const r=await fetch('/api/chat-stamps',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:item.id,deleteToken:token})});if(r.ok){localStorage.removeItem('chat-stamp-delete-'+item.id);notify(C.msgs.deleted);loadGallery()}}async function loadGallery(){const g=$('galleryGrid');g.innerHTML='<div class="privacy">'+C.msgs.loading+'</div>';try{const r=await fetch('/api/chat-stamps'),d=await r.json();g.innerHTML='';if(!d.items?.length){g.innerHTML='<div class="privacy">'+C.msgs.emptyGallery+'</div>';return}d.items.forEach(item=>{const card=document.createElement('div');card.className='stamp-card';const c=galleryCanvas(item);card.appendChild(c);const meta=document.createElement('div');meta.className='meta';const dl=document.createElement('button');dl.className='mini';dl.textContent=C.msgs.save;dl.onclick=()=>download(c,'stamp-moke-'+item.id+'.png');meta.appendChild(dl);if(localStorage.getItem('chat-stamp-delete-'+item.id)){const b=document.createElement('button');b.className='mini';b.textContent=C.msgs.delete;b.onclick=()=>del(item);meta.appendChild(b)}card.appendChild(meta);g.appendChild(card)})}catch{g.innerHTML='<div class="privacy">'+C.msgs.galleryFail+'</div>'}}$('reloadBtn').onclick=loadGallery;update();loadGallery();
</script></body></html>
