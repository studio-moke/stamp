---
import SiteHeader from "./SiteHeader.astro";
import { localeInfo, normalizeLocale } from "../lib/i18n";
const locale=normalizeLocale(Astro.props.locale);
const C={
ja:{title:"社内チャットスタンプメーカー｜Slack・Teams・LINE WORKS向け無料作成 | stamp moke",desc:"Slack、Teams、LINE WORKSなどで使える文字スタンプを無料作成。フォント・色・縁取り・背景・エフェクト・行数・文字サイズ・字間・横比率・角度まで自由に編集。",hero:"社内チャットで使える\n文字スタンプを、自由に作る。",lead:"文字・フォント・色・フチ・背景・エフェクト・行数に加え、文字サイズ・字間・横幅・角度・余白まで細かく調整できます。画像生成AIやGPTは使いません。",badges:["AI不使用","640×640 PNG","10フォント","文字サイズ自由","字間・角度調整","公開は本人同意制"],make:"スタンプを作る",text:"文字（改行もできます）",sample:"確認しました",preset:"プリセット",presets:["ビジネス","ポップ","ハンコ","無骨","やわらか","白黒"],font:"フォント",fonts:["極太ゴシック","丸ゴシック","明朝","筆・毛筆風","手書き風","ポップ","レトロ","無骨","クラシック","カジュアル"],lines:"行数",auto:"自動",direction:"文字方向",horizontal:"横書き",vertical:"縦書き",effect:"エフェクト",effects:["なし","影","発光","立体"],fontSize:"文字サイズ",spacing:"文字間隔",width:"文字の横比率",angle:"文字の角度",padding:"キャンバス余白",paddingHint:"0%で正方形いっぱいまで使用",frame:"ハンコ枠",rounded:"角丸四角",circle:"正円",textColor:"文字色",strokeColor:"フチ色",strokeOn:"フチを付ける",strokeWidth:"フチの太さ",background:"背景",transparent:"透明",white:"白",customColor:"好きな色",private:"非公開スタンプはサーバーへ保存しません。一般公開する場合のみ安全判定を再実行します。",consent:"このスタンプを「みんなのチャットスタンプ」に一般公開することに同意します。",download:"PNGをダウンロード",publish:"みんなに公開する",preview:"プレビュー",previewNote:"背景透過対応・640×640px。余白0%ではキャンバスの端まで使えます。文字サイズを100%以上にすると、意図的にはみ出す表現も可能です。",gallery:"みんなのチャットスタンプ",reload:"更新",safetyTitle:"安全について：",safetyNote:"公開時はメールアドレス、電話番号、長い数字列、認証情報、機密関連語、固有情報らしい表現などをルールベースで検査します。自動判定は完全ではないため、公開前に必ず内容をご確認ください。",msgs:{empty:"文字を入力してください",red:"個人情報・機密情報の可能性があります",yellow:"固有情報を含む可能性があります",green:"公開可能な範囲と判定しました",onlyGreen:"GREEN判定のスタンプだけ公開できます",needConsent:"公開への同意チェックが必要です",published:"公開しました",publishedDelete:"公開しました。この端末から削除できます。",publishFail:"公開できません",deleted:"削除しました",loading:"読み込み中...",emptyGallery:"まだ公開スタンプはありません。",save:"PNG保存",delete:"削除",galleryFail:"ギャラリーを読み込めませんでした。"}},
en:{title:"Free Chat Stamp Maker for Slack, Teams & Work Chat | stamp moke",desc:"Create custom text stamps for Slack, Teams, LINE WORKS and workplace chat. Adjust fonts, colors, outlines, effects, spacing, scale, angle and more.",hero:"Create custom text stamps\nfor work chat.",lead:"Fine-tune text, font, color, outline, background, effects, line count, size, spacing, width, rotation and padding. No image-generation AI or GPT is used.",badges:["No AI","640×640 PNG","10 fonts","Free text sizing","Spacing & rotation","Opt-in public gallery"],make:"Create a stamp",text:"Text (line breaks supported)",sample:"Got it",preset:"Presets",presets:["Business","Pop","Stamp","Bold","Soft","Mono"],font:"Font",fonts:["Heavy Sans","Rounded Sans","Mincho / Serif","Brush style","Handwritten","Pop","Retro","Bold","Classic","Casual"],lines:"Lines",auto:"Auto",direction:"Text direction",horizontal:"Horizontal",vertical:"Vertical",effect:"Effect",effects:["None","Shadow","Glow","Depth"],fontSize:"Text size",spacing:"Letter spacing",width:"Horizontal scale",angle:"Rotation",padding:"Canvas padding",paddingHint:"0% uses the full square canvas",frame:"Stamp frame",rounded:"Rounded square",circle:"Circle",textColor:"Text color",strokeColor:"Outline color",strokeOn:"Enable outline",strokeWidth:"Outline width",background:"Background",transparent:"Transparent",white:"White",customColor:"Custom color",private:"Private stamps are not saved to the server. Safety checks run again only when you choose to publish.",consent:"I agree to publish this stamp in the public chat-stamp gallery.",download:"Download PNG",publish:"Publish",preview:"Preview",previewNote:"Transparent background supported, 640×640px. With 0% padding you can use the full canvas. Text over 100% can intentionally extend beyond the normal fit.",gallery:"Public Chat Stamps",reload:"Reload",safetyTitle:"Safety: ",safetyNote:"Before publishing, rule-based checks look for email addresses, phone numbers, long number strings, credentials, 