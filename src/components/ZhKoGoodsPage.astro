---
import designs from "../data/suzuri-designs.json";
import SiteHeader from "./SiteHeader.astro";
import SeoHead from "./SeoHead.astro";
import Analytics from "./Analytics.astro";
import { localeInfo, localizedPath, normalizeLocale } from "../lib/i18n";
import { absoluteUrl } from "../lib/seo";
const locale=normalizeLocale(Astro.props.locale);
if(locale!=="zh-cn"&&locale!=="ko") throw new Error(`Unsupported locale: ${locale}`);
const t={"zh-cn":{title:"原创角色周边",lead:"按角色与设计浏览 stamp moke 的 SUZURI 周边。选择喜欢的角色，即可查看 T 恤、配件与生活杂货。",shop:"前往 SUZURI 商店 ↗",collection:"按角色浏览",count:"个角色",view:"查看这个角色的周边 →",note:"最新销售状态与价格请以 SUZURI 商品页面为准。"},ko:{title:"오리지널 캐릭터 굿즈",lead:"캐릭터와 디자인별로 stamp moke의 SUZURI 굿즈를 둘러보세요. 좋아하는 캐릭터를 선택하면 티셔츠, 액세서리, 생활용품을 확인할 수 있습니다.",shop:"SUZURI 스토어 보기 ↗",collection:"캐릭터로 찾기",count:"개 캐릭터",view:"이 캐릭터 굿즈 보기 →",note:"판매 여부와 최신 가격은 SUZURI 상품 페이지에서 확인해 주세요."}}[locale];
const canonicalPath="/goods/",canonical=absoluteUrl(localizedPath(locale,canonicalPath)),title=`${t.title} | stamp moke`;
---
<!doctype html><html lang={localeInfo[locale].htmlLang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><SeoHead title={title} description={t.lead} canonical={canonical} locale={locale} path={canonicalPath}/><Analytics/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.main{max-width:1180px;margin:auto;padding:55px 5vw 100px}.hero h1{font-size:clamp(42px,7vw,76px);margin:0 0 20px}.hero p{max-width:800px;color:#666;line-height:2}.shop{display:inline-flex;margin-top:20px;padding:14px 20px;border-radius:999px;background:#161616;color:#fff;text-decoration:none;font-weight:800}.section{margin-top:60px}.head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #ddd;padding-bottom:18px;margin-bottom:22px}.head h2{font-size:34px;margin:0}.count{font-size:12px;color:#777}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.card{background:#fff;border:1px solid #e3e2de;border-radius:18px;overflow:hidden;text-decoration:none}.media{aspect-ratio:1}.media img{width:100%;height:100%;object-fit:cover}.body{padding:15px}.body h3{font-size:14px;margin:0}.detail{margin-top:12px;color:#168b52;font-size:11px;font-weight:800}.note{margin-top:50px;color:#777;font-size:11px}@media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){.main{padding:38px 18px 70px}.grid{grid-template-columns:repeat(2,1fr);gap:11px}.head h2{font-size:27px}}</style></head><body><SiteHeader locale={locale} path={canonicalPath}/><main class="main"><section class="hero"><h1>{t.title}</h1><p>{t.lead}</p><a class="shop" href="https://suzuri.jp/stamp-moke" target="_blank" rel="noopener noreferrer">{t.shop}</a></section><section class="section"><div class="head"><h2>{t.collection}</h2><div class="count">{designs.length} {t.count}</div></div><div class="grid">{designs.map((d,i)=><a class="card" href={localizedPath(locale,`/goods/${d.id}/`)}><div class="media"><img src={d.image} alt={d.title} loading={i<8?"eager":"lazy"}/></div><div class="body"><h3>{d.title}</h3><div class="detail">{t.view}</div></div></a>)}</div></section><p class="note">{t.note}</p></main></body></html>
