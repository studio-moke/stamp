---
import SiteHeader from "./SiteHeader.astro";
import stickers from "../data/stickers.json";
const { locale="ja", tool="compress" }=Astro.props;
const prefix=locale==="ja"?"":`/${locale}`;
const defs={
 compress:{title:"画像容量を圧縮",sub:"JPG・PNG・SVG・GIFをまとめて軽量化",desc:"画像を選ぶだけ。画質をできるだけ保ちながらファイル容量を小さくします。",accept:"image/jpeg,image/png,image/svg+xml,image/gif",button:"画像を圧縮する",seo:"画像圧縮・JPG PNG SVG GIFの容量を小さくする無料ツール"},
 resize:{title:"画像サイズを変更",sub:"幅・高さを指定してかんたんリサイズ",desc:"縦横比を保ちながら、画像のピクセルサイズをまとめて変更できます。",accept:"image/jpeg,image/png,image/webp,image/gif",button:"サイズを変更する",seo:"画像リサイズ・画像サイズ変更を無料で"},
 tojpg:{title:"画像をJPGに変換",sub:"PNG・GIF・TIF・PSD・SVG・HEIC・RAW → JPG",desc:"いろいろな画像形式を、使いやすいJPGへまとめて変換します。",accept:"image/*,.tif,.tiff,.psd,.heic,.heif,.raw,.dng,.cr2,.nef,.arw",button:"JPGに変換する",seo:"PNG GIF TIF PSD SVG HEIC RAWをJPGに変換する無料ツール"},
 fromjpg:{title:"JPGをPNG・GIFに変換",sub:"JPG → PNG / GIF",desc:"JPG画像をPNGまたはGIFへ。複数画像もまとめて変換できます。",accept:"image/jpeg,.jpg,.jpeg",button:"画像を変換する",seo:"JPGをPNG・GIFに変換する無料ツール"},
 transparent:{title:"PNGの背景を透過",sub:"背景色を透明にしてPNG保存",desc:"画像の背景色をクリックして指定し、透明PNGとして保存できます。",accept:"image/png,image/jpeg,image/webp",button:"透過PNGを作る",seo:"PNG背景透過・画像の背景を透明にする無料ツール"}
};
const d=defs[tool]||defs.compress; const picks=stickers.slice(0,6);
const nav=[['compress','画像圧縮','image-compressor'],['resize','サイズ変更','image-resizer'],['tojpg','JPGに変換','convert-to-jpg'],['fromjpg','JPGから変換','jpg-to-image'],['transparent','背景透過','png-transparent']];
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{d.seo} | stamp moke</title><meta name="description" content={d.desc}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/${nav.find(x=>x[0]===tool)?.[2]}/`}/>
<style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:1040px;margin:auto;padding:38px 18px 80px}.crumb{font-size:11px;color:#777;margin-bottom:28px}.crumb a{color:inherit}.hero{text-align:center;padding:24px 0 30px}.hero h1{font-size:clamp(34px,6vw,62px);letter-spacing:-.05em;margin:0 0 12px}.hero .sub{font-weight:900;font-size:16px}.hero p{color:#666;font-size:13px;line-height:1.8}.tools{display:flex;gap:7px;overflow:auto;padding:4px 0 18px}.tools a{white-space:nowrap;text-decoration:none;color:#555;background:#fff;border:1px solid #ddd;border-radius:999px;padding:9px 13px;font-size:10px;font-weight:800}.tools a.on{background:#171717;color:#fff}.drop{display:block;background:#fff;border:2px dashed #c9c7bf;border-radius:22px;padding:58px 20px;text-align:center;cursor:pointer}.drop input{display:none}.drop strong{display:block;font-size:19px;margin-bottom:8px}.drop span{font-size:10px;color:#777}.work{display:none;margin-top:14px}.work.show{display:block}.preview-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;margin-bottom:12px}.preview{background:#fff;border:1px solid #ddd;border-radius:14px;padding:8px}.preview img{width:100%;height:105px;object-fit:contain;background:linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%);background-size:14px 14px}.preview div{font-size:9px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:6px}.options{background:#fff;border:1px solid #ddd;border-radius:18px;padding:16px;margin-bottom:12px}.option-row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.option-row label{font-size:11px;font-weight:900}.option-row input[type=number],.option-row select{border:1px solid #ccc;border-radius:10px;padding:10px}.quality{width:min(360px,100%)}.run{width:100%;border:0;background:#171717;color:#fff;border-radius:14px;padding:16px;font-size:13px;font-weight:900;cursor:pointer}.status{font-size:11px;color:#666;margin:10px 0}.results{display:grid;gap:8px}.result{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #ddd;border-radius:12px;padding:10px}.result span{flex:1;font-size:10px}.result a{background:#171717;color:#fff;text-decoration:none;border-radius:9px;padding:8px 10px;font-size:9px;font-weight:900}.stamp-section{margin-top:70px;padding-top:34px;border-top:1px solid #ddd}.stamp-section h2{font-size:27px;margin:0 0 7px}.stamp-section>p{font-size:11px;color:#777;margin:0 0 18px}.stamp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stamp{background:#fff;border:1px solid #ddd;border-radius:16px;padding:10px;text-decoration:none;color:#171717}.stamp img{width:100%;aspect-ratio:1/1;object-fit:contain}.stamp b{display:block;font-size:10px;line-height:1.5;margin-top:7px}.related{margin-top:45px}.related h2{font-size:20px}.related-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.related-grid a{background:#fff;border:1px solid #ddd;border-radius:12px;padding:14px 8px;text-align:center;text-decoration:none;color:#171717;font-size:10px;font-weight:900}@media(max-width:620px){.wrap{padding:25px 11px 60px}.hero{padding-top:10px}.drop{padding:45px 12px}.stamp-grid{grid-template-columns:repeat(2,1fr)}.related-grid{grid-template-columns:1fr 1fr}.result{align-items:flex-start;flex-wrap:wrap}.result a{width:100%;text-align:center}}</style></head><body><SiteHeader locale={locale}/><main class="wrap"><div class="crumb"><a href={`${prefix}/`}>stamp moke</a> / 画像ツール / {d.title}</div><nav class="tools">{nav.map(n=><a class={n[0]===tool?'on':''} href={`${prefix}/${n[2]}/`}>{n[1]}</a>)}</nav><section class="hero"><h1>{d.title}</h1><div class="sub">{d.sub}</div><p>{d.desc}<br/>画像はサーバーへ保存せず、この端末のブラウザ内で処理します。</p></section><label class="drop" id="drop"><input id="file" type="file" accept={d.accept} multiple/><strong>画像を選択</strong><span>またはここに画像をドロップ · 複数画像OK</span></label><section class="work" id="work"><div class="preview-list" id="previews"></div><div class="options" id="options"><div class="option-row" id="optionRow"></div></div><button class="run" id="run">{d.button}</button><div class="status" id="status"></div><div class="results" id="results"></div></section><section class="related"><h2>ほかの画像ツール</h2><div class="related-grid">{nav.filter(n=>n[0]!==tool).map(n=><a href={`${prefix}/${n[2]}/`}>{n[1]} →</a>)}</div></section><section class="stamp-section"><h2>stamp mokeのLINEスタンプ</h2><p>画像ツールを使ったあとは、毎日の会話に使えるオリジナルLINEスタンプもどうぞ。</p><div class="stamp-grid">{picks.map(s=><a class="stamp" href={`${prefix}/stickers/${s.id}/`}><img src={s.image} loading="lazy" alt={s.title}/><b>{s.title.replace(' - LINE スタンプ | LINE STORE','')}</b></a>)}</div></section></main>
<script is:inline define:vars={{tool}}>
(()=>{const f=document.getElementById('file'),drop=document.getElementById('drop'),work=document.getElementById('work'),previews=document.getElementById('previews'),optionRow=document.getElementById('optionRow'),run=document.getElementById('run'),status=document.getElementById('status'),results=document.getElementById('results');let files=[];
const opts={compress:'<label>圧縮レベル <input class="quality" id="quality" type="range" min="40" max="95" value="78"></label><b id="qv">78%</b>',resize:'<label>幅 <input id="w" type="number" min="1" value="1200"></label><label>高さ <input id="h" type="number" min="1" placeholder="自動"></label>',tojpg:'<label>JPG画質 <input class="quality" id="quality" type="range" min="50" max="100" value="88"></label><b id="qv">88%</b>',fromjpg:'<label>変換先 <select id="target"><option value="png">PNG</option><option value="gif">GIF</option></select></label>',transparent:'<label>許容値 <input class="quality" id="tol" type="range" min="0" max="100" value="28"></label><span>背景色は画像の左上を基準にします</span>'};optionRow.innerHTML=opts[tool]||'';const q=document.getElementById('quality'),qv=document.getElementById('qv');if(q)q.oninput=()=>qv.textContent=q.value+'%';
function setFiles(list){files=[...list];if(!files.length)return;work.classList.add('show');previews.innerHTML='';files.forEach(x=>{const u=URL.createObjectURL(x),d=document.createElement('div');d.className='preview';d.innerHTML='<img><div></div>';d.querySelector('img').src=u;d.querySelector('img').onload=()=>URL.revokeObjectURL(u);d.querySelector('div').textContent=x.name;previews.appendChild(d)})}f.onchange=()=>setFiles(f.files);['dragenter','dragover'].forEach(e=>drop.addEventListener(e,x=>{x.preventDefault()}));drop.ondrop=e=>{e.preventDefault();setFiles(e.dataTransfer.files)};
const load=file=>new Promise((res,rej)=>{const u=URL.createObjectURL(file),i=new Image;i.onload=()=>{URL.revokeObjectURL(u);res(i)};i.onerror=()=>{URL.revokeObjectURL(u);rej(new Error('この形式をブラウザで読み込めません'))};i.src=u});const blob=(c,t,q)=>new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error('変換できませんでした')),t,q));function canvas(img,w=img.naturalWidth,h=img.naturalHeight){const c=document.createElement('canvas');c.width=w;c.height=h;c.getContext('2d').drawImage(img,0,0,w,h);return c}function dl(b,name){const u=URL.createObjectURL(b),a=document.createElement('a');a.className='save';a.href=u;a.download=name;a.textContent='保存';a.onclick=()=>setTimeout(()=>URL.revokeObjectURL(u),1500);return a}
async function one(file){const base=file.name.replace(/\.[^.]+$/,'');if(tool==='compress'&&file.type==='image/svg+xml'){let s=await file.text();s=s.replace(/<!--([\s\S]*?)-->/g,'').replace(/>\s+</g,'><').replace(/\s{2,}/g,' ');return {b:new Blob([s],{type:'image/svg+xml'}),name:base+'-compressed.svg'}};const img=await load(file);if(tool==='resize'){const W=+document.getElementById('w').value||img.naturalWidth,H=+document.getElementById('h').value||0,r=Math.min(W/img.naturalWidth,H?H/img.naturalHeight:Infinity,1),c=canvas(img,Math.round(img.naturalWidth*r),Math.round(img.naturalHeight*r));return {b:await blob(c,file.type==='image/png'?'image/png':'image/jpeg',.9),name:base+'-resized.'+(file.type==='image/png'?'png':'jpg')}}if(tool==='tojpg'){const c=canvas(img);c.getContext('2d').globalCompositeOperation='destination-over';c.getContext('2d').fillStyle='#fff';c.getContext('2d').fillRect(0,0,c.width,c.height);return {b:await blob(c,'image/jpeg',(+q.value)/100),name:base+'.jpg'}}if(tool==='fromjpg'){const t=document.getElementById('target').value;if(t==='png')return {b:await blob(canvas(img),'image/png',1),name:base+'.png'};throw new Error('GIF変換は現在のブラウザで準備中です')}if(tool==='transparent'){const c=canvas(img),ctx=c.getContext('2d'),im=ctx.getImageData(0,0,c.width,c.height),p=im.data,r=p[0],g=p[1],b=p[2],tol=(+document.getElementById('tol').value)*4.42;for(let i=0;i<p.length;i+=4){const d=Math.hypot(p[i]-r,p[i+1]-g,p[i+2]-b);if(d<tol)p[i+3]=0}ctx.putImageData(im,0,0);return {b:await blob(c,'image/png',1),name:base+'-transparent.png'}}const c=canvas(img),type=file.type==='image/png'?'image/png':'image/jpeg';return {b:await blob(c,type,(+q.value)/100),name:base+'-compressed.'+(type==='image/png'?'png':'jpg')}}
run.onclick=async()=>{results.innerHTML='';status.textContent='処理中…';let ok=0;for(const file of files){const row=document.createElement('div');row.className='result';try{const o=await one(file);row.innerHTML='<span></span>';row.querySelector('span').textContent=`${file.name} → ${(o.b.size/1024).toFixed(1)} KB`;row.appendChild(dl(o.b,o.name));ok++}catch(e){row.innerHTML='<span></span>';row.querySelector('span').textContent=file.name+'：'+e.message}results.appendChild(row)}status.textContent=`${ok} / ${files.length} 枚 完了`};})();
</script></body></html>