---
import SiteHeader from "./SiteHeader.astro";
const { locale="ja" }=Astro.props;
const prefix=locale==="ja"?"":`/${locale}`;
const copy={
 ja:{title:"無料で使えるツール",lead:"目的から迷わず選べるように、漫画系・デザイン系・実用系に整理しました。すべて登録不要で使えます。",groups:{manga:"漫画系",design:"デザイン系",utility:"実用系"},groupLead:{manga:"漫画表現や素材をブラウザで手軽に作れます。",design:"写真や文字、配色を使ったクリエイティブ制作向け。",utility:"画像加工やQRなど、日常的に使いやすい便利ツール。"}},
 en:{title:"Free Tools",lead:"Free tools organized into Manga, Design and Utility so you can quickly find what you need.",groups:{manga:"Manga",design:"Design",utility:"Utility"},groupLead:{manga:"Create manga effects and assets in your browser.",design:"Creative tools for images, stickers and color work.",utility:"Practical image, QR and everyday utilities."}},
 "zh-tw":{title:"免費工具",lead:"依漫畫、設計與實用三類整理，讓你快速找到需要的工具。",groups:{manga:"漫畫系",design:"設計系",utility:"實用系"},groupLead:{manga:"在瀏覽器製作漫畫表現與素材。",design:"適合圖片、貼紙與配色創作。",utility:"圖片處理、QR 等常用工具。"}},
 th:{title:"เครื่องมือฟรี",lead:"จัดหมวดเป็นมังงะ ดีไซน์ และยูทิลิตี้ เพื่อให้หาเครื่องมือได้ง่ายขึ้น",groups:{manga:"มังงะ",design:"ดีไซน์",utility:"ยูทิลิตี้"},groupLead:{manga:"สร้างเอฟเฟกต์และ素材มังงะในเบราว์เซอร์",design:"เครื่องมือสำหรับภาพ สติกเกอร์ และสี",utility:"เครื่องมือรูป QR และงานใช้งานทั่วไป"}},
 id:{title:"Alat Gratis",lead:"Dikelompokkan menjadi Manga, Desain, dan Utilitas agar mudah menemukan alat yang dibutuhkan.",groups:{manga:"Manga",design:"Desain",utility:"Utilitas"},groupLead:{manga:"Buat efek dan aset manga di browser.",design:"Alat kreatif untuk gambar, stiker, dan warna.",utility:"Alat gambar, QR, dan kebutuhan praktis."}}
}[locale]||null;
const t=copy||{};
const tools=[
 {g:"manga",p:"/manga-speed-lines/",i:"✹",n:"漫画集中線メーカー",d:"集中線を透過PNGで生成"},{g:"manga",p:"/manga-effect-lines/",i:"〽",n:"漫画効果線メーカー",d:"スピード線・斜線・震え線など"},{g:"manga",p:"/manga-tone-maker/",i:"●",n:"漫画トーンメーカー",d:"網点・砂目・グラデ・カケアミ"},{g:"manga",p:"/manga-speech-bubble/",i:"◯",n:"漫画フキダシメーカー",d:"フキダシをPNG・SVGで作成"},{g:"manga",p:"/manga-sfx/",i:"ド",n:"漫画効果音メーカー",d:"擬音語を漫画風PNGに"},
 {g:"design",p:"/pop-art-maker/",i:"POP",n:"ポップアートメーカー",d:"写真をカラフルなポップアートに"},{g:"design",p:"/pixel-art-maker/",i:"▦",n:"ドット絵メーカー",d:"写真やイラストをドット絵に"},{g:"design",p:"/sticker-maker/",i:"★",n:"ステッカーメーカー",d:"画像をフチ付きステッカー風に"},{g:"design",p:"/chat-stamp-maker",i:"印",n:"チャットスタンプメーカー",d:"文字からチャット用スタンプ作成"},{g:"design",p:"/color-palette/",i:"#",n:"カラーパレット",d:"画像から色と相性配色を抽出"},
 {g:"utility",p:"/image-compressor/",i:"KB",n:"画像容量圧縮",d:"JPG・PNGなどを軽量化"},{g:"utility",p:"/image-resizer/",i:"↔",n:"画像サイズ変更",d:"幅・高さを指定してリサイズ"},{g:"utility",p:"/convert-to-jpg/",i:"JPG",n:"JPGに変換",d:"各種画像をJPGへ変換"},{g:"utility",p:"/jpg-to-image/",i:"PNG",n:"JPGから変換",d:"JPGをPNG・GIFに変換"},{g:"utility",p:"/png-transparent/",i:"◫",n:"背景透過PNG",d:"背景色を透明にして保存"},{g:"utility",p:"/qr-maker",i:"QR",n:"QRコードメーカー",d:"URLや文字からQRコード作成"},{g:"utility",p:"/seal-maker/",i:"印",n:"電子印鑑・落款",d:"背景透過PNGの印影を作成"}
];
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t.title} | stamp moke</title><meta name="description" content={t.lead}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/tools/`}/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.main{max-width:1180px;margin:auto;padding:50px 22px 90px}.hero{padding:24px 0 38px;border-bottom:1px solid #dddcd8}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.2em;color:#888}.hero h1{margin:8px 0 12px;font-size:clamp(40px,6vw,68px);letter-spacing:-.055em}.hero p{max-width:760px;margin:0;color:#666;font-size:13px;line-height:1.9}.group{margin-top:48px}.group-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:15px}.group h2{font-size:24px;margin:0}.group p{max-width:520px;margin:0;color:#777;font-size:11px;line-height:1.7;text-align:right}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.card{display:grid;grid-template-columns:52px 1fr 18px;align-items:center;gap:12px;padding:16px;border:1px solid #deddd8;border-radius:17px;background:#fff;color:#171717;text-decoration:none;transition:.18s}.card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(0,0,0,.07)}.icon{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;background:#171717;color:#fff;font-size:12px;font-weight:900}.card strong{display:block;font-size:14px;line-height:1.4}.card small{display:block;margin-top:5px;color:#777;font-size:10px;line-height:1.5}.arrow{color:#999}@media(max-width:800px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.group-head{display:block}.group p{margin-top:7px;text-align:left}}@media(max-width:540px){.main{padding:30px 12px 65px}.grid{grid-template-columns:1fr}.group{margin-top:34px}.card{padding:13px}.hero h1{font-size:42px}}</style></head><body><SiteHeader locale={locale}/><main class="main"><section class="hero"><div class="eyebrow">FREE TOOLS / stamp moke</div><h1>{t.title}</h1><p>{t.lead}</p></section>{["manga","design","utility"].map(g=><section class="group"><div class="group-head"><h2>{t.groups[g]}</h2><p>{t.groupLead[g]}</p></div><div class="grid">{tools.filter(x=>x.g===g).map(x=><a class="card" href={`${prefix}${x.p}`}><span class="icon">{x.i}</span><span><strong>{x.n}</strong><small>{x.d}</small></span><span class="arrow">→</span></a>)}</div></section>)}</main></body></html>