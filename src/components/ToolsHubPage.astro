---
import SiteHeader from "./SiteHeader.astro";
const { locale="ja" }=Astro.props;
const prefix=locale==="ja"?"":`/${locale}`;
const copy={
 ja:{title:"無料で使えるツール",lead:"目的から迷わず選べるように、漫画系・デザイン系・実用系・業務系に整理しました。すべて登録不要で使えます。",groups:{manga:"漫画系",design:"デザイン系",utility:"実用系",business:"業務・EC・マーケティング"},groupLead:{manga:"漫画表現や素材をブラウザで手軽に作れます。",design:"写真や文字、配色を使ったクリエイティブ制作向け。",utility:"画像加工やQRなど、日常的に使いやすい便利ツール。",business:"計算・文章整形・EC運営・広告運用など、仕事で頻繁に使う小さな便利ツール。"}},
 en:{title:"Free Tools",lead:"Free tools organized into Manga, Design, Utility and Business so you can quickly find what you need.",groups:{manga:"Manga",design:"Design",utility:"Utility",business:"Business / EC / Marketing"},groupLead:{manga:"Create manga effects and assets in your browser.",design:"Creative tools for images, stickers and color work.",utility:"Practical image, QR and everyday utilities.",business:"Quick calculators and text utilities for work, ecommerce and marketing. Business tools currently open in Japanese."}},
 "zh-tw":{title:"免費工具",lead:"依漫畫、設計、實用與工作類整理，讓你快速找到需要的工具。",groups:{manga:"漫畫系",design:"設計系",utility:"實用系",business:"工作・EC・行銷"},groupLead:{manga:"在瀏覽器製作漫畫表現與素材。",design:"適合圖片、貼紙與配色創作。",utility:"圖片處理、QR 等常用工具。",business:"工作、電商與行銷常用的計算與文字整理工具。目前工作工具以日文顯示。"}},
 th:{title:"เครื่องมือฟรี",lead:"จัดหมวดเป็นมังงะ ดีไซน์ ยูทิลิตี้ และงานธุรกิจ เพื่อให้หาเครื่องมือได้ง่ายขึ้น",groups:{manga:"มังงะ",design:"ดีไซน์",utility:"ยูทิลิตี้",business:"ธุรกิจ / EC / การตลาด"},groupLead:{manga:"สร้างเอฟเฟกต์และ素材มังงะในเบราว์เซอร์",design:"เครื่องมือสำหรับภาพ สติกเกอร์ และสี",utility:"เครื่องมือรูป QR และงานใช้งานทั่วไป",business:"เครื่องมือคำนวณและจัดข้อความสำหรับงาน อีคอมเมิร์ซ และการตลาด ขณะนี้เครื่องมือธุรกิจแสดงเป็นภาษาญี่ปุ่น"}},
 id:{title:"Alat Gratis",lead:"Dikelompokkan menjadi Manga, Desain, Utilitas, dan Bisnis agar mudah menemukan alat yang dibutuhkan.",groups:{manga:"Manga",design:"Desain",utility:"Utilitas",business:"Bisnis / EC / Marketing"},groupLead:{manga:"Buat efek dan aset manga di browser.",design:"Alat kreatif untuk gambar, stiker, dan warna.",utility:"Alat gambar, QR, dan kebutuhan praktis.",business:"Kalkulator dan alat teks cepat untuk kerja, ecommerce, dan marketing. Alat bisnis saat ini ditampilkan dalam bahasa Jepang."}}
}[locale]||null;
const t=copy||copy.ja;
const tools=[
 {g:"manga",p:"/manga-speed-lines/",i:"✹",n:"漫画集中線メーカー",d:"集中線を透過PNGで生成"},{g:"manga",p:"/manga-effect-lines/",i:"〽",n:"漫画効果線メーカー",d:"スピード線・斜線・震え線など"},{g:"manga",p:"/manga-tone-maker/",i:"●",n:"漫画トーンメーカー",d:"網点・砂目・グラデ・カケアミ"},{g:"manga",p:"/manga-speech-bubble/",i:"◯",n:"漫画フキダシメーカー",d:"フキダシをPNG・SVGで作成"},{g:"manga",p:"/manga-sfx/",i:"ド",n:"漫画効果音メーカー",d:"擬音語を漫画風PNGに"},
 {g:"design",p:"/pop-art-maker/",i:"POP",n:"ポップアートメーカー",d:"写真をカラフルなポップアートに"},{g:"design",p:"/pixel-art-maker/",i:"▦",n:"ドット絵メーカー",d:"写真やイラストをドット絵に"},{g:"design",p:"/sticker-maker/",i:"★",n:"ステッカーメーカー",d:"画像をフチ付きステッカー風に"},{g:"design",p:"/chat-stamp-maker",i:"印",n:"チャットスタンプメーカー",d:"文字からチャット用スタンプ作成"},{g:"design",p:"/color-palette/",i:"#",n:"カラーパレット",d:"画像から色と相性配色を抽出"},
 {g:"utility",p:"/image-compressor/",i:"KB",n:"画像容量圧縮",d:"JPG・PNGなどを軽量化"},{g:"utility",p:"/image-resizer/",i:"↔",n:"画像サイズ変更",d:"幅・高さを指定してリサイズ"},{g:"utility",p:"/convert-to-jpg/",i:"JPG",n:"JPGに変換",d:"各種画像をJPGへ変換"},{g:"utility",p:"/jpg-to-image/",i:"PNG",n:"JPGから変換",d:"JPGをPNG・GIFに変換"},{g:"utility",p:"/png-transparent/",i:"◫",n:"背景透過PNG",d:"背景色を透明にして保存"},{g:"utility",p:"/qr-maker",i:"QR",n:"QRコードメーカー",d:"URLや文字からQRコード作成"},{g:"utility",p:"/seal-maker/",i:"印",n:"電子印鑑・落款",d:"背景透過PNGの印影を作成"},
 {g:"business",p:"/tools/ip-rights-check/",i:"IP",n:"商標・特許・意匠チェック",d:"権利情報の確認と代替ネーミング提案"},{g:"business",p:"/tools/date-calculator/",i:"日",n:"日付計算ツール",d:"日付の加減算・日数差を計算"},{g:"business",p:"/tools/gross-profit/",i:"粗",n:"粗利計算ツール",d:"粗利額・粗利率・原価率を計算"},{g:"business",p:"/tools/text-counter/",i:"字",n:"文字数・行数カウント",d:"広告文・提案書の文字数をリアルタイム表示"},{g:"business",p:"/tools/dedupe-lines/",i:"重",n:"重複行の削除",d:"重複した行を一括削除"},{g:"business",p:"/tools/postal-code/",i:"〒",n:"郵便番号検索",d:"郵便番号←→住所を検索"},{g:"business",p:"/tools/mojibake/",i:"文",n:"文字化け変換",d:"典型的な文字化けの修復を試す"},{g:"business",p:"/tools/password-generator/",i:"PW",n:"パスワード生成",d:"条件指定でランダム生成"},{g:"business",p:"/tools/html-entities/",i:"&",n:"HTMLエンティティ変換",d:"エンコード・デコード"},{g:"business",p:"/tools/age-table/",i:"年",n:"年齢早見表",d:"西暦・和暦・年齢を一覧表示"},{g:"business",p:"/tools/text-sort/",i:"↕",n:"テキストソート",d:"行を昇順・降順・数値順に並べ替え"},{g:"business",p:"/tools/sku-generator/",i:"SKU",n:"連番付きSKUコード生成",d:"SKUをまとめて一括生成"},{g:"business",p:"/tools/zenkaku-hankaku/",i:"Aa",n:"全角英数字を半角に統一",d:"英数字・スペースを半角化"},{g:"business",p:"/tools/trim-spaces/",i:"SP",n:"余分なスペースの除去",d:"前後・連続スペースを整理"},{g:"business",p:"/tools/tax-calculator/",i:"税",n:"税込・税抜計算",d:"8%・10%の税計算"},{g:"business",p:"/tools/price-change-rate/",i:"%",n:"値上げ・値下げ率計算",d:"変更前後の価格から変化率を計算"},{g:"business",p:"/tools/roas/",i:"R",n:"ROAS計算",d:"広告費と広告売上からROASを計算"},{g:"business",p:"/tools/roi/",i:"ROI",n:"ROI計算",d:"利益と投資額からROIを計算"},{g:"business",p:"/tools/marketing-kpi/",i:"KPI",n:"CPA・CVR・CTR計算",d:"広告運用KPIをまとめて計算"}
];
const hrefFor=(x)=>x.g==="business"?x.p:`${prefix}${x.p}`;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t.title} | stamp moke</title><meta name="description" content={t.lead}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/tools/`}/><link rel="icon" href="/favicon.svg?v=20260902" type="image/svg+xml"/><link rel="shortcut icon" href="/favicon.ico?v=20260902" sizes="any"/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.main{max-width:1180px;margin:auto;padding:50px 22px 90px}.hero{padding:24px 0 38px;border-bottom:1px solid #dddcd8}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.2em;color:#888}.hero h1{margin:8px 0 12px;font-size:clamp(40px,6vw,68px);letter-spacing:-.055em}.hero p{max-width:760px;margin:0;color:#666;font-size:13px;line-height:1.9}.group{margin-top:48px}.group-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:15px}.group h2{font-size:24px;margin:0}.group p{max-width:520px;margin:0;color:#777;font-size:11px;line-height:1.7;text-align:right}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.card{display:grid;grid-template-columns:52px 1fr 18px;align-items:center;gap:12px;padding:16px;border:1px solid #deddd8;border-radius:17px;background:#fff;color:#171717;text-decoration:none;transition:.18s}.card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(0,0,0,.07)}.icon{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;background:#171717;color:#fff;font-size:12px;font-weight:900}.card strong{display:block;font-size:14px;line-height:1.4}.card small{display:block;margin-top:5px;color:#777;font-size:10px;line-height:1.5}.arrow{color:#999}@media(max-width:800px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.group-head{display:block}.group p{margin-top:7px;text-align:left}}@media(max-width:540px){.main{padding:30px 12px 65px}.grid{grid-template-columns:1fr}.group{margin-top:34px}.card{padding:13px}.hero h1{font-size:42px}}</style></head><body><SiteHeader locale={locale}/><main class="main"><section class="hero"><div class="eyebrow">FREE TOOLS / stamp moke</div><h1>{t.title}</h1><p>{t.lead}</p></section>{["manga","design","utility","business"].map(g=><section class="group"><div class="group-head"><h2>{t.groups[g]}</h2><p>{t.groupLead[g]}</p></div><div class="grid">{tools.filter(x=>x.g===g).map(x=><a class="card" href={hrefFor(x)}><span class="icon">{x.i}</span><span><strong>{x.n}</strong><small>{x.d}</small></span><span class="arrow">→</span></a>)}</div></section>)}</main></body></html>