---
import SiteHeader from "./SiteHeader.astro";
const { locale="ja" }=Astro.props;
const prefix=locale==="ja"?"":`/${locale}`;
const copy={
 ja:{title:"無料ツール",lead:"作りたいものから選べる、stamp mokeの無料クリエイティブツール集。",groups:{manga:"漫画を作る",creative:"画像で遊ぶ",image:"画像を整える",utility:"デザイン・便利"}},
 en:{title:"Free Tools",lead:"Choose what you want to make with stamp moke's free creative tools.",groups:{manga:"Make manga",creative:"Play with images",image:"Image tools",utility:"Design & utility"}},
 "zh-tw":{title:"免費工具",lead:"依想製作的內容選擇 stamp moke 的免費創作工具。",groups:{manga:"漫畫製作",creative:"圖片創作",image:"圖片處理",utility:"設計・便利"}},
 th:{title:"เครื่องมือฟรี",lead:"เลือกสิ่งที่อยากสร้างด้วยเครื่องมือครีเอทีฟฟรีจาก stamp moke",groups:{manga:"สร้างมังงะ",creative:"เล่นกับรูปภาพ",image:"เครื่องมือรูป",utility:"ดีไซน์・ยูทิลิตี้"}},
 id:{title:"Alat Gratis",lead:"Pilih yang ingin dibuat dengan alat kreatif gratis stamp moke.",groups:{manga:"Buat manga",creative:"Kreasi gambar",image:"Alat gambar",utility:"Desain & utilitas"}}
}[locale]||null;
const t=copy||{};
const tools=[
 {g:"manga",p:"/manga-speed-lines/",i:"✹",n:"漫画集中線メーカー",d:"集中線を透過PNGで生成"},{g:"manga",p:"/manga-effect-lines/",i:"〽",n:"漫画効果線メーカー",d:"スピード線・斜線・震え線など"},{g:"manga",p:"/manga-tone-maker/",i:"●",n:"漫画トーンメーカー",d:"網点・砂目・グラデ・カケアミ"},{g:"manga",p:"/manga-speech-bubble/",i:"◯",n:"漫画フキダシメーカー",d:"フキダシをPNG・SVGで作成"},{g:"manga",p:"/manga-sfx/",i:"ド",n:"漫画効果音メーカー",d:"擬音語を漫画風PNGに"},
 {g:"creative",p:"/pop-art-maker/",i:"POP",n:"ポップアートメーカー",d:"写真をカラフルなポップアートに"},{g:"creative",p:"/pixel-art-maker/",i:"▦",n:"ドット絵メーカー",d:"写真やイラストをドット絵に"},{g:"creative",p:"/sticker-maker/",i:"★",n:"ステッカーメーカー",d:"画像をフチ付きステッカー風に"},{g:"creative",p:"/chat-stamp-maker",i:"印",n:"チャットスタンプメーカー",d:"文字からチャット用スタンプ作成"},
 {g:"image",p:"/image-compressor/",i:"KB",n:"画像容量圧縮",d:"JPG・PNGなどを軽量化"},{g:"image",p:"/image-resizer/",i:"↔",n:"画像サイズ変更",d:"幅・高さを指定してリサイズ"},{g:"image",p:"/convert-to-jpg/",i:"JPG",n:"JPGに変換",d:"各種画像をJPGへ変換"},{g:"image",p:"/jpg-to-image/",i:"PNG",n:"JPGから変換",d:"JPGをPNG・GIFに変換"},{g:"image",p:"/png-transparent/",i:"◫",n:"背景透過PNG",d:"背景色を透明にして保存"},
 {g:"utility",p:"/color-palette/",i:"#",n:"カラーパレット",d:"画像から色と相性配色を抽出"},{g:"utility",p:"/qr-maker",i:"QR",n:"QRコードメーカー",d:"URLや文字からQRコード作成"},{g:"utility",p:"/seal-maker/",i:"印",n:"電子印鑑・落款",d:"背景透過PNGの印影を作成"}
];
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{t.title} | stamp moke</title><meta name="description" content={t.lead}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/tools/`}/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.main{max-width:1180px;margin:auto;padding:50px 22px 90px}.hero{padding:24px 0 38px;border-bottom:1px solid #dddcd8}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.2em;color:#888}.hero h1{margin:8px 0 12px;font-size:clamp(40px,6vw,68px);letter-spacing:-.055em}.hero p{max-width:680px;margin:0;color:#666;font-size:13px;line-height:1.9}.group{margin-top:46px}.group h2{font-size:22px;margin:0 0 15px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.card{display:grid;grid-template-columns:52px 1fr 18px;align-items:center;gap:12px;padding:16px;border:1px solid #deddd8;border-radius:17px;background:#fff;color:#171717;text-decoration:none;transition:.18s}.card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(0,0,0,.07)}.icon{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;background:#171717;color:#fff;font-size:12px;font-weight:900}.card strong{display:block;font-size:14px;line-height:1.4}.card small{display:block;margin-top:5px;color:#777;font-size:10px;line-height:1.5}.arrow{color:#999}@media(max-width:800px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:540px){.main{padding:30px 12px 65px}.grid{grid-template-columns:1fr}.group{margin-top:34px}.card{padding:13px}.hero h1{font-size:42px}}</style></head><body><SiteHeader locale={locale}/><main class="main"><section class="hero"><div class="eyebrow">FREE CREATIVE TOOLS</div><h1>{t.title}</h1><p>{t.lead}</p></section>{["manga","creative","image","utility"].map(g=><section class="group"><h2>{t.groups[g]}</h2><div class="grid">{tools.filter(x=>x.g===g).map(x=><a class="card" href={`${prefix}${x.p}`}><span class="icon">{x.i}</span><span><strong>{x.n}</strong><small>{x.d}</small></span><span class="arrow">→</span></a>)}</div></section>)}</main></body></html>