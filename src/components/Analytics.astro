---
import stickers from "../data/stickers.json";
import { normalizeLocale, type Locale } from "../lib/i18n";
import { getCategory, getCategorySlug } from "../lib/stickers";
import { getStickerPhrases, getTagById, getTagIdsForSticker, getTagPath } from "../lib/sticker-search-tags";
import { r2GetJson } from "../../server/api/_r2.js";

const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "G-QSXPPLWSB7";
const enabled = /^G-[A-Z0-9]+$/i.test(measurementId);
const parts = Astro.url.pathname.split("/").filter(Boolean);
let locale: Locale = "ja";
if (["en", "zh-tw", "th", "id"].includes(parts[0])) locale = normalizeLocale(parts.shift());
const stickerId = parts[0] === "stickers" && /^\d+$/.test(parts[1] || "") ? parts[1] : null;
const sticker = stickerId ? stickers.find((item) => String(item.id) === stickerId) : null;
const homePath = locale === "ja" ? "/" : `/${locale}/`;
const showHomeTools = Astro.url.pathname === homePath;

const copy = {
  ja:{label:"WORDS & USES",title:"このスタンプの言葉・用途",lead:"画像内の文字、作品タイトル、説明文をもとに、検索に役立つ代表的なセリフ・用途・テーマを整理しています。",tags:"用途・テーマから探す",all:"言葉・用途の一覧を見る →"},
  en:{label:"WORDS & USES",title:"Phrases, uses & themes",lead:"Representative phrases, uses and themes inferred from the sticker artwork, title and description.",tags:"Browse by use or theme",all:"Browse all phrases & uses →"},
  "zh-tw":{label:"語句與用途",title:"這組貼圖的語句與用途",lead:"根據貼圖文字、作品標題與說明，整理有助於搜尋的代表性語句、用途與主題。",tags:"依用途或主題搜尋",all:"查看所有語句與用途 →"},
  th:{label:"คำและการใช้งาน",title:"คำ การใช้งาน และธีมของชุดนี้",lead:"สรุปคำที่สำคัญ การใช้งาน และธีมจากข้อความในภาพ ชื่อผลงาน และคำอธิบาย เพื่อช่วยให้ค้นหาได้ง่ายขึ้น",tags:"ค้นหาตามการใช้งานหรือธีม",all:"ดูคำและการใช้งานทั้งหมด →"},
  id:{label:"FRASA & KEGUNAAN",title:"Frasa, kegunaan & tema",lead:"Frasa, kegunaan, dan tema utama dirangkum dari teks gambar, judul karya, dan deskripsi agar lebih mudah ditemukan.",tags:"Cari berdasarkan kegunaan atau tema",all:"Lihat semua frasa & kegunaan →"},
}[locale];
const navCopy={
  ja:{free:"フリー素材集",search:"サイト内検索",qr:"QRメーカー",chat:"チャットスタンプ"},
  en:{free:"Free assets",search:"Search",qr:"QR Maker",chat:"Chat Stamp Maker"},
  "zh-tw":{free:"免費素材",search:"站內搜尋",qr:"QR產生器",chat:"聊天貼圖產生器"},
  th:{free:"素材ฟรี",search:"ค้นหา",qr:"สร้าง QR",chat:"สร้างสติกเกอร์แชต"},
  id:{free:"Aset gratis",search:"Cari",qr:"Pembuat QR",chat:"Pembuat Stiker Chat"}
}[locale];
const toolCopy={
  ja:{title:"無料で使えるメーカー",lead:"登録不要。ブラウザですぐ使える、stamp mokeの便利なクリエイティブツールです。",qr:"かわいいQRコードメーカー",qrDesc:"色・形・動物キャラやロゴを選んで、かわいいQRコードを無料作成。",chat:"社内チャットスタンプメーカー",chatDesc:"社内チャットで使いやすい文字スタンプ画像を、かんたんに作成。"},
  en:{title:"Free creative tools",lead:"No signup. Use stamp moke's creative tools directly in your browser.",qr:"Cute QR Code Maker",qrDesc:"Create cute QR codes with colors, shapes, animal icons or your own logo.",chat:"Chat Stamp Maker",chatDesc:"Create custom text stamps for Slack, Teams and workplace chat."},
  "zh-tw":{title:"免費創作工具",lead:"免註冊，直接在瀏覽器使用stamp moke的實用創作工具。",qr:"可愛QR Code產生器",qrDesc:"選擇顏色、形狀、動物角色或自己的Logo，免費製作可愛QR Code。",chat:"聊天文字貼圖產生器",chatDesc:"輕鬆製作適合工作聊天與團隊溝通的文字貼圖。"},
  th:{title:"เครื่องมือสร้างสรรค์ฟรี",lead:"ไม่ต้องสมัคร ใช้เครื่องมือสร้างสรรค์ของ stamp moke ได้ทันทีในเบราว์เซอร์",qr:"สร้าง QR Code น่ารัก",qrDesc:"เลือกสี รูปแบบ คาแรกเตอร์สัตว์ หรือโลโก้ของคุณเพื่อสร้าง QR Code ฟรี",chat:"สร้างสติกเกอร์แชต",chatDesc:"สร้างสติกเกอร์ข้อความสำหรับ Slack, Teams และแชตที่ทำงานได้ง่าย ๆ"},
  id:{title:"Alat kreatif gratis",lead:"Tanpa daftar. Gunakan alat kreatif stamp moke langsung di browser.",qr:"Pembuat QR Code Lucu",qrDesc:"Buat QR code lucu dengan warna, bentuk, karakter hewan atau logo Anda.",chat:"Pembuat Stiker Chat",chatDesc:"Buat stiker teks untuk Slack, Teams, dan obrolan kerja dengan mudah."}
}[locale];
const freeHref=locale==="ja"?"/free/":`/${locale}/free/`;
const searchHref=locale==="ja"?"/search/":`/${locale}/search/`;
const qrHref=locale==="ja"?"/qr-maker":`/${locale}/qr-maker`;
const chatHref=locale==="ja"?"/chat-stamp-maker":`/${locale}/chat-stamp-maker`;
const seoCopy={
 ja:{label:"ABOUT THIS STICKER",title:"このLINEスタンプについて",target:"こんな人におすすめ",concept:"コンセプト",uses:"こんな場面で使えます",keywords:"関連キーワード"},
 en:{label:"ABOUT THIS STICKER",title:"About this LINE sticker set",target:"Recommended for",concept:"Concept",uses:"When to use it",keywords:"Related searches"},
 "zh-tw":{label:"ABOUT THIS STICKER",title:"關於這組LINE貼圖",target:"推薦給這些人",concept:"貼圖概念",uses:"適合使用的情境",keywords:"相關搜尋詞"},
 th:{label:"ABOUT THIS STICKER",title:"เกี่ยวกับสติกเกอร์ LINE ชุดนี้",target:"เหมาะสำหรับ",concept:"คอนเซปต์",uses:"สถานการณ์ที่เหมาะ",keywords:"คำค้นที่เกี่ยวข้อง"},
 id:{label:"ABOUT THIS STICKER",title:"Tentang set stiker LINE ini",target:"Cocok untuk",concept:"Konsep",uses:"Situasi penggunaan",keywords:"Kata kunci terkait"}
}[locale];
let smartTagPayload=null;
if(sticker){const phrases=getStickerPhrases(sticker.id);const tags=getTagIdsForSticker(sticker).map(id=>getTagById(id)).filter(Boolean).map(tag=>({label:tag.labels[locale],href:getTagPath(locale,tag)}));if(tags.length===0){const category=getCategory(sticker),categorySlug=getCategorySlug(category);if(categorySlug)tags.push({label:category,href:`/categories/${categorySlug}/1`})}smartTagPayload={phrases,tags,copy,allHref:locale==="ja"?"/tags/":`/${locale}/tags/`}}
let stickerSeoPayload=null;
if(stickerId){try{const record=await r2GetJson(`sticker-seo/${stickerId}.json`,null);const content=record?.locales?.[locale]||record?.locales?.ja;if(content)stickerSeoPayload={content,copy:seoCopy}}catch(error){console.warn("sticker SEO section unavailable",error)}}
---
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="stylesheet" href="/site-shell.css" />
<style is:inline>.global-tool-link{background:#161616!important;border-color:#161616!important;color:#fff!important}@media(max-width:1050px){.global-tool-link{display:none!important}}</style>
{showHomeTools && <style is:inline>
.home-tools{margin:-28px 0 68px}.home-tools-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}.home-tools-label{font-size:11px;letter-spacing:.18em;color:#777;margin-bottom:8px}.home-tools-title{margin:0;font-size:30px;line-height:1.1;letter-spacing:-.03em;font-weight:900}.home-tools-lead{margin:0;max-width:440px;color:#777;font-size:12px;line-height:1.8}.home-tools-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.home-tool-card{position:relative;display:grid;grid-template-columns:72px 1fr auto;align-items:center;gap:18px;min-height:142px;padding:24px;border:1px solid #deddd8;border-radius:22px;background:#fff;text-decoration:none;overflow:hidden;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}.home-tool-card:hover{transform:translateY(-4px);border-color:#cac8c1;box-shadow:0 16px 38px rgba(42,40,32,.09)}.home-tool-icon{width:72px;height:72px;display:grid;place-items:center;border-radius:20px;font-size:31px;font-weight:900}.home-tool-card.qr .home-tool-icon{background:#fff0f6;color:#b8547f}.home-tool-card.chat .home-tool-icon{background:#eef6ff;color:#356b9d}.home-tool-kicker{font-size:9px;font-weight:800;letter-spacing:.16em;color:#999;margin-bottom:7px}.home-tool-name{margin:0;font-size:18px;line-height:1.4;font-weight:900}.home-tool-desc{margin:7px 0 0;color:#777;font-size:11px;line-height:1.7}.home-tool-arrow{width:38px;height:38px;display:grid;place-items:center;border-radius:50%;background:#161616;color:#fff;font-size:17px}.home-tool-new{position:absolute;top:12px;right:14px;padding:5px 8px;border-radius:999px;background:#f7f6f2;color:#777;font-size:8px;font-weight:900;letter-spacing:.12em}@media(max-width:760px){.home-tools{margin:-18px 0 52px}.home-tools-head{display:block}.home-tools-lead{margin-top:9px}.home-tools-grid{grid-template-columns:1fr}.home-tool-card{grid-template-columns:58px 1fr auto;min-height:120px;padding:18px;gap:13px;border-radius:18px}.home-tool-icon{width:58px;height:58px;border-radius:16px;font-size:25px}.home-tool-name{font-size:16px}.home-tool-desc{font-size:10px}.home-tool-arrow{width:34px;height:34px}}
</style>}
<script is:inline define:vars={{ freeHref, searchHref, qrHref, chatHref, navCopy }}>document.addEventListener("DOMContentLoaded",()=>{const header=document.querySelector(".header");if(!header)return;let actions=header.querySelector(".header-actions, .actions, .nav, .header-nav, .site-nav");if(!actions){actions=document.createElement("div");actions.className="header-actions";header.appendChild(actions)}const add=(href,text,cls="")=>{const exists=[...header.querySelectorAll('a[href]')].some(a=>{try{return new URL(a.href,location.origin).pathname===href}catch{return false}});if(exists)return;const link=document.createElement("a");link.href=href;link.textContent=text;link.className=`header-link ${cls}`.trim();actions.appendChild(link)};add(freeHref,navCopy.free,"global-free-link");add(searchHref,navCopy.search,"global-search-link");add(qrHref,navCopy.qr,"global-tool-link");add(chatHref,navCopy.chat,"global-tool-link");});</script>
{showHomeTools && <script is:inline define:vars={{ toolCopy, qrHref, chatHref, homePath }}>document.addEventListener("DOMContentLoaded",()=>{if(location.pathname!==homePath)return;const hero=document.querySelector("main .hero");if(!hero||document.querySelector(".home-tools"))return;const section=document.createElement("section");section.className="home-tools";section.setAttribute("aria-labelledby","home-tools-title");section.innerHTML=`<div class="home-tools-head"><div><div class="home-tools-label">FREE TOOLS / stamp moke</div><h2 class="home-tools-title" id="home-tools-title">${toolCopy.title}</h2></div><p class="home-tools-lead">${toolCopy.lead}</p></div><div class="home-tools-grid"><a class="home-tool-card qr" href="${qrHref}"><span class="home-tool-new">NEW</span><span class="home-tool-icon" aria-hidden="true">QR</span><span><span class="home-tool-kicker">CUTE QR MAKER</span><h3 class="home-tool-name">${toolCopy.qr}</h3><p class="home-tool-desc">${toolCopy.qrDesc}</p></span><span class="home-tool-arrow" aria-hidden="true">→</span></a><a class="home-tool-card chat" href="${chatHref}"><span class="home-tool-new">NEW</span><span class="home-tool-icon" aria-hidden="true">Aa</span><span><span class="home-tool-kicker">CHAT STAMP MAKER</span><h3 class="home-tool-name">${toolCopy.chat}</h3><p class="home-tool-desc">${toolCopy.chatDesc}</p></span><span class="home-tool-arrow" aria-hidden="true">→</span></a></div>`;hero.insertAdjacentElement("afterend",section)});</script>}
{smartTagPayload && <script is:inline define:vars={{ smartTagPayload }}>document.addEventListener("DOMContentLoaded",()=>{const p=smartTagPayload;if(!p||(!p.phrases.length&&!p.tags.length))return;const info=document.querySelector(".info-grid");if(!info)return;let section=document.querySelector(".phrase-section");if(!section){section=document.createElement("section");section.className="phrase-section";section.setAttribute("aria-labelledby","sticker-phrases");info.insertAdjacentElement("afterend",section)}section.replaceChildren();const label=document.createElement("div");label.className="sub-label";label.textContent=p.copy.label;section.appendChild(label);const title=document.createElement("h2");title.id="sticker-phrases";title.className="sub-title";title.textContent=p.copy.title;section.appendChild(title);const lead=document.createElement("p");lead.className="phrase-lead";lead.textContent=p.copy.lead;section.appendChild(lead);if(p.phrases.length){const ul=document.createElement("ul");ul.className="phrase-list";for(const phrase of p.phrases){const li=document.createElement("li");li.className="phrase-chip";li.lang="ja";li.textContent=phrase;ul.appendChild(li)}section.appendChild(ul)}if(p.tags.length){const block=document.createElement("div");block.className="tag-block";const tl=document.createElement("p");tl.className="tag-label";tl.textContent=p.copy.tags;block.appendChild(tl);const tags=document.createElement("div");tags.className="tag-list";for(const tag of p.tags){const a=document.createElement("a");a.className="tag-chip";a.href=tag.href;a.textContent=tag.label;tags.appendChild(a)}block.appendChild(tags);const all=document.createElement("a");all.className="tag-all";all.href=p.allHref;all.textContent=p.copy.all;block.appendChild(all);section.appendChild(block)}});</script>}
{stickerSeoPayload && <script is:inline define:vars={{ stickerSeoPayload }}>document.addEventListener("DOMContentLoaded",()=>{const p=stickerSeoPayload;if(!p?.content)return;const anchor=document.querySelector(".phrase-section")||document.querySelector(".info-grid");if(!anchor)return;const c=p.content,t=p.copy,section=document.createElement("section");section.className="sticker-seo-section";const text=(tag,cls,value)=>{if(!value)return null;const el=document.createElement(tag);if(cls)el.className=cls;el.textContent=value;return el};section.append(text("div","seo-eyebrow",t.label));section.append(text("h2","seo-title",t.title));section.append(text("p","seo-overview",c.overview));const g=document.createElement("div");g.className="seo-info-grid";for(const [label,value] of [[t.target,c.target],[t.concept,c.concept]]){if(!value)continue;const box=document.createElement("div");box.className="seo-box";box.append(text("h3","seo-subtitle",label));box.append(text("p","seo-text",value));g.appendChild(box)}if(g.children.length)section.appendChild(g);if((c.uses||[]).length){section.append(text("h3","seo-subtitle",t.uses));if(c.usageIntro)section.append(text("p","seo-text",c.usageIntro));const ul=document.createElement("ul");ul.className="seo-use-list";for(const v of c.uses){const li=document.createElement("li");li.textContent=v;ul.appendChild(li)}section.appendChild(ul)}if((c.keywords||[]).length){section.append(text("h3","seo-subtitle",t.keywords));const chips=document.createElement("div");chips.className="seo-keywords";for(const v of c.keywords.slice(0,30)){const span=document.createElement("span");span.textContent=v;chips.appendChild(span)}section.appendChild(chips)}anchor.insertAdjacentElement("afterend",section)});</script>}
{enabled && <><script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script><script is:inline define:vars={{ measurementId }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',measurementId);</script></>}
