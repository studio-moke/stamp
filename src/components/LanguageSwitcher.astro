---
import { LOCALES, localeInfo, localizedPath, normalizeLocale } from "../lib/i18n";

const locale = normalizeLocale(Astro.props.locale);
const path = Astro.props.path || "/";
const paths = Astro.props.paths || null;
const hrefFor = (item) => paths?.[item] || localizedPath(item, path);
---
<details class="language-switcher">
  <summary aria-label="Language selector">
    <span class="language-icon" aria-hidden="true">🌐</span>
    <span class="language-current">{localeInfo[locale].label}</span>
  </summary>
  <nav class="language-menu" aria-label="Languages">
    {LOCALES.map((item) => (
      <a
        href={hrefFor(item)}
        hreflang={localeInfo[item].htmlLang}
        lang={localeInfo[item].htmlLang}
        class:list={["language-option", { active: item === locale }]}
        data-locale={item}
        aria-current={item === locale ? "page" : undefined}
      >
        {localeInfo[item].label}
      </a>
    ))}
  </nav>
</details>

<script>
  document.querySelectorAll('.language-switcher .language-option').forEach((link) => {
    link.addEventListener('click', () => {
      localStorage.setItem('stamp-moke-locale', link.dataset.locale || 'ja');
    });
  });

  document.addEventListener('click', (event) => {
    document.querySelectorAll('.language-switcher[open]').forEach((details) => {
      if (!details.contains(event.target)) details.removeAttribute('open');
    });
  });
</script>

<style>
  .language-switcher { position:relative; display:inline-block; color:#555; }
  .language-switcher summary { list-style:none; display:inline-flex; align-items:center; gap:7px; min-height:38px; border:1px solid #d9d8d4; background:#fff; border-radius:999px; padding:8px 12px; cursor:pointer; user-select:none; }
  .language-switcher summary::-webkit-details-marker { display:none; }
  .language-icon { font-size:14px; line-height:1; }
  .language-current { color:#161616; font-size:12px; font-weight:800; white-space:nowrap; }
  .language-menu { position:absolute; right:0; top:calc(100% + 8px); z-index:60; min-width:190px; padding:7px; border:1px solid #dddcd7; border-radius:15px; background:#fff; box-shadow:0 16px 40px rgba(0,0,0,.12); }
  .language-option { display:block; padding:10px 12px; border-radius:10px; color:#333; font-size:12px; font-weight:700; text-decoration:none; white-space:nowrap; }
  .language-option:hover { background:#f4f3ef; }
  .language-option.active { background:#171717; color:#fff; }
  @media (max-width:640px) {
    .language-switcher summary { min-height:34px; padding:7px 9px; gap:5px; }
    .language-current { max-width:92px; overflow:hidden; text-overflow:ellipsis; font-size:11px; }
    .language-menu { min-width:170px; }
  }
</style>
