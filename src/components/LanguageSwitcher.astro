---
import { LOCALES, localeInfo, localizedPath, normalizeLocale } from "../lib/i18n";

const locale = normalizeLocale(Astro.props.locale);
const path = Astro.props.path || "/";
---
<label class="language-switcher">
  <span class="language-label">Language</span>
  <select id="language-select" aria-label="Language">
    {LOCALES.map((item) => (
      <option value={localizedPath(item, path)} data-locale={item} selected={item === locale}>
        {localeInfo[item].label}
      </option>
    ))}
  </select>
</label>

<script>
  const select = document.getElementById("language-select");
  select?.addEventListener("change", (event) => {
    const option = event.currentTarget.selectedOptions[0];
    if (!option) return;
    localStorage.setItem("stamp-moke-locale", option.dataset.locale || "ja");
    window.location.href = option.value;
  });
</script>

<style>
  .language-switcher { display:inline-flex; align-items:center; gap:7px; border:1px solid #d9d8d4; background:#fff; border-radius:999px; padding:8px 12px; color:#555; }
  .language-label { font-size:9px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  select { appearance:none; border:0; outline:0; background:transparent; color:#161616; font:inherit; font-size:12px; font-weight:800; cursor:pointer; padding-right:4px; }
  @media (max-width:640px) { .language-label { display:none; } .language-switcher { padding:8px 9px; } select { max-width:82px; font-size:11px; } }
</style>
