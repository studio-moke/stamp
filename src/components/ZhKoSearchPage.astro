---
import SiteHeader from "./SiteHeader.astro";
import SeoHead from "./SeoHead.astro";
import Analytics from "./Analytics.astro";
import { localeInfo, localizedPath, normalizeLocale } from "../lib/i18n";
import { absoluteUrl } from "../lib/seo";
const locale=normalizeLocale(Astro.props.locale);
if(locale!=="zh-cn"&&locale!=="ko") throw new Error(`Unsupported locale: ${locale}`);
const t={"zh-cn":{title:"站内搜索",lead:"同时搜索 LINE 贴图、免费素材和角色周边。标题、说明、用途、标签和贴图文字都可作为搜索对象。",placeholder:"例如：工作、猫、可爱、缩略图…",search:"搜索",all:"全部",sticker:"贴图",free:"免费素材",goods:"周边",empty:"没有找到匹配内容，请尝试其他关键词。",start:"输入关键词即可搜索整个网站。",loading:"正在搜索…",results:"件结果"},ko:{title:"사이트 검색",lead:"LINE 스티커, 무료 소재, 캐릭터 굿즈를 한 번에 검색합니다. 제목, 설명, 용도, 태그와 스티커 문구까지 검색할 수 있습니다.",placeholder:"예: 업무, 고양이, 귀여운, 썸네일…",search:"검색",all:"전체",sticker:"스티커",free:"무료 소재",goods:"굿즈",empty:"검색 결과가 없습니다. 다른 검색어를 사용해 보세요.",start:"검색어를 입력하면 사이트 전체에서 찾습니다.",loading:"검색 중…",results:"개 결과"}}[locale];
const canonicalPath="/search/",canonical=absoluteUrl(localizedPath(locale,canonicalPath)),title=`${t.title} | stamp moke`;
---
<!doctype html><html lang={localeInfo[locale].htmlLang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><SeoHead title={title} description={t.lead} canonical={canonical} locale={locale} path={canonicalPath}/><Analytics/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.main{max-width:1080px;margin:auto;padding:54px 22px 90px}.hero h1{font-size:clamp(40px,6vw,68px);margin:0 0 18px}.lead{color:#666;line-height:1.9}.search-box{display:flex;gap:8px;margin-top:28px;background:#fff;border:1px solid #ddd;padding:9px;border-radius:18px}.search-box input{flex:1;border:0;background:#faf9f5;border-radius:12px;padding:14px;font-size:16px}.search-box button{border:0;border-radius:12px;background:#171717;color:#fff;padding:0 24px;font-weight:900}.tabs{display:flex;gap:7px;flex-wrap:wrap;margin:22px 0}.tab{border:1px solid #d9d8d4;background:#fff;border-radius:999px;padding:8px 13px;font-weight:800}.tab.active{background:#171717;color:#fff}.summary{font-size:12px;color:#777;margin-bottom:14px}.results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.result{display:grid;grid-template-columns:140px 1fr;background:#fff;border:1px solid #ddd;border-radius:17px;overflow:hidden;text-decoration:none}.media{min-height:140px;background:#eee}.media img{width:100%;height:100%;object-fit:cover}.body{padding:14px}.kind{font-size:9px;color:#777}.body h2{font-size:15px;margin:6px 0}.body p{font-size:11px;color:#666;line-height:1.6}.message{grid-column:1/-1;background:#fff;border:1px dashed #ccc;border-radius:18px;padding:45px;text-align:center;color:#777}@media(max-width:760px){.main{padding:34px 12px 70px}.results{grid-template-columns:1fr}.result{grid-template-columns:112px 1fr}}</style></head><body><SiteHeader locale={locale} path={canonicalPath}/><main class="main"><section class="hero"><h1>{t.title}</h1><p class="lead">{t.lead}</p><form id="searchForm" class="search-box"><input id="q" type="search" placeholder={t.placeholder}/><button>{t.search}</button></form></section><div class="tabs"><button class="tab active" data-type="all">{t.all}</button><button class="tab" data-type="sticker">{t.sticker}</button><button class="tab" data-type="free">{t.free}</button><button class="tab" data-type="goods">{t.goods}</button></div><div id="summary" class="summary"></div><section id="results" class="results"><div class="message">{t.start}</div></section></main><script define:vars={{locale,t}}>const q=document.getElementById('q'),form=document.getElementById('searchForm'),results=document.getElementById('results'),summary=document.getElementById('summary'),tabs=[...document.querySelectorAll('.tab')],esc=(v='')=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));let active='all';function render(d){summary.textContent=d.counts?.all?`${d.counts.all} ${t.results}`:'';if(!d.results?.length){results.innerHTML=`<div class="message">${esc(t.empty)}</div>`;return}results.innerHTML=d.results.map(x=>`<a class="result" href="${esc(x.url)}" ${x.external?'target="_blank" rel="noopener noreferrer"':''}><div class="media">${x.image?`<img loading="lazy" src="${esc(x.image)}" alt="${esc(x.title)}">`:''}</div><div class="body"><div class="kind">${esc(x.type==='sticker'?t.sticker:x.type==='free'?t.free:t.goods)}</div><h2>${esc(x.title)}</h2><p>${esc(x.description||'')}</p></div></a>`).join('')}async function run(){const v=q.value.trim();if(!v){results.innerHTML=`<div class="message">${esc(t.start)}</div>`;return}results.innerHTML=`<div class="message">${esc(t.loading)}</div>`;try{const r=await fetch(`/api/site-search?q=${encodeURIComponent(v)}&locale=${encodeURIComponent(locale)}&type=${active}`),d=await r.json();if(!r.ok)throw new Error();render(d)}catch{results.innerHTML=`<div class="message">${esc(t.empty)}</div>`}}form.onsubmit=e=>{e.preventDefault();run()};tabs.forEach(b=>b.onclick=()=>{tabs.forEach(x=>x.classList.toggle('active',x===b));active=b.dataset.type;if(q.value.trim())run()});const p=new URLSearchParams(location.search);if(p.get('q')){q.value=p.get('q');run()}</script></body></html>
