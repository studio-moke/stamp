---
import fs from "node:fs";import path from "node:path";import stickers from "../data/stickers.json";import SiteHeader from "./SiteHeader.astro";import { normalizeLocale,localizedPath } from "../lib/i18n";import { localizedStickerTitle } from "../lib/sticker-content";
const {locale:lp,id=""}=Astro.props;const locale=normalizeLocale(lp);const prefix=`/${locale}`;
const t={en:{title:"Free Custom Emoji & Reaction Icons",lead:"Square transparent PNG icons for Slack, Microsoft Teams and Discord.",termsTitle:"Usage terms",terms:"These images may only be used as custom emoji or reaction icons inside Slack, Microsoft Teams and Discord. Redistribution, resale and use on other services or social media are prohibited.",list:"Free custom emoji & icons",save:"How to save",saveText:"On desktop, right-click an image to save it. On mobile, press and hold the image and choose the save option.",related:"Related content",relatedText:"Want to use the same character on LINE?",line:"View the LINE sticker set →",empty:"Icon images are being prepared."},"zh-tw":{title:"免費自訂表情與反應圖示",lead:"適用於 Slack、Microsoft Teams、Discord 的正方形透明 PNG 圖示。",termsTitle:"使用範圍",terms:"本頁圖片僅限作為 Slack、Microsoft Teams、Discord 內的自訂表情與反應圖示使用。禁止轉載、再散布、販售或於其他服務及社群平台使用。",list:"免費自訂表情・圖示",save:"圖片儲存方式",saveText:"電腦請右鍵儲存圖片；手機請長按圖片並選擇儲存。",related:"相關內容",relatedText:"想在 LINE 使用同樣角色嗎？",line:"查看 LINE 貼圖 →",empty:"圖示圖片準備中。"},"zh-cn":{title:"免费自定义表情与反应图标",lead:"适用于 Slack、Microsoft Teams、Discord 的正方形透明 PNG 图标。",termsTitle:"使用范围",terms:"本页图片仅限作为 Slack、Microsoft Teams、Discord 内的自定义表情和反应图标使用。禁止转载、再分发、销售或用于其他服务及社交平台。",list:"免费自定义表情・图标",save:"图片保存方法",saveText:"电脑请右键保存图片；手机请长按图片并选择保存。",related:"相关内容",relatedText:"想在 LINE 使用同样角色吗？",line:"查看 LINE 贴图 →",empty:"图标图片准备中。"},ko:{title:"무료 커스텀 이모지・리액션 아이콘",lead:"Slack, Microsoft Teams, Discord에서 사용할 수 있는 정사각형 투명 PNG 아이콘입니다.",termsTitle:"이용 범위",terms:"이 이미지는 Slack, Microsoft Teams, Discord 내부의 커스텀 이모지 및 리액션 아이콘 용도로만 사용할 수 있습니다. 재배포, 판매, 다른 서비스나 SNS에서의 사용은 금지됩니다.",list:"무료 커스텀 이모지・아이콘",save:"이미지 저장 방법",saveText:"PC에서는 이미지를 우클릭해 저장하고, 모바일에서는 이미지를 길게 눌러 저장하세요.",related:"관련 콘텐츠",relatedText:"같은 캐릭터를 LINE에서도 사용하고 싶다면 확인해 보세요.",line:"LINE 스티커 보기 →",empty:"아이콘 이미지를 준비 중입니다."},th:{title:"อีโมจิและไอคอนรีแอ็กชันฟรี",lead:"ไฟล์ PNG โปร่งใสทรงสี่เหลี่ยมสำหรับ Slack, Microsoft Teams และ Discord",termsTitle:"ขอบเขตการใช้งาน",terms:"อนุญาตให้ใช้ภาพเหล่านี้เป็นอีโมจิหรือไอคอนรีแอ็กชันภายใน Slack, Microsoft Teams และ Discord เท่านั้น ห้ามแจกจ่ายต่อ ขาย หรือใช้ในบริการและโซเชียลอื่น",list:"อีโมจิและไอคอนฟรี",save:"วิธีบันทึกภาพ",saveText:"บนคอมพิวเตอร์ให้คลิกขวาเพื่อบันทึก บนมือถือให้กดค้างที่ภาพแล้วเลือกบันทึก",related:"เนื้อหาที่เกี่ยวข้อง",relatedText:"ต้องการใช้ตัวละครเดียวกันบน LINE หรือไม่",line:"ดูสติกเกอร์ LINE →",empty:"กำลังเตรียมภาพไอคอน"},id:{title:"Emoji Kustom & Ikon Reaksi Gratis",lead:"Ikon PNG transparan berbentuk persegi untuk Slack, Microsoft Teams, dan Discord.",termsTitle:"Ketentuan penggunaan",terms:"Gambar ini hanya boleh digunakan sebagai emoji kustom atau ikon reaksi di Slack, Microsoft Teams, dan Discord. Dilarang mendistribusikan ulang, menjual, atau menggunakannya di layanan maupun media sosial lain.",list:"Emoji & ikon kustom gratis",save:"Cara menyimpan gambar",saveText:"Di desktop, klik kanan gambar untuk menyimpan. Di ponsel, tekan lama gambar lalu pilih opsi simpan.",related:"Konten terkait",relatedText:"Ingin memakai karakter yang sama di LINE?",line:"Lihat stiker LINE →",empty:"Gambar ikon sedang disiapkan."}}[locale];if(!t)throw new Error(`Unsupported locale ${locale}`);
const available=stickers.filter(s=>{const d=path.join(process.cwd(),"public","images","chat-icons",String(s.id));return fs.existsSync(d)&&fs.readdirSync(d).some(n=>n.endsWith('.png'))});const sticker=id?stickers.find(s=>String(s.id)===String(id)):null;const iconDir=sticker?path.join(process.cwd(),"public","images","chat-icons",String(sticker.id)):"";const files=sticker&&fs.existsSync(iconDir)?fs.readdirSync(iconDir).filter(n=>/^\d{2}-\d+\.png$/.test(n)).sort((a,b)=>a.localeCompare(b,"en",{numeric:true})):[];const display=sticker?localizedStickerTitle(sticker,locale):"";const title=sticker?`${display} | ${t.title}`:t.title;const canonical=sticker?`https://stamp-moke.jp${prefix}/chat-icons/${sticker.id}/`:`https://stamp-moke.jp${prefix}/chat-icons/`;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | stamp moke</title><meta name="description" content={t.lead}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg?v=20260902"/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans",sans-serif}.wrap{width:min(1180px,92vw);margin:auto;padding:34px 0 88px}.crumb{font-size:13px;color:#666;margin-bottom:22px}.crumb a{color:inherit}.hero{background:#fff;border:1px solid #e3e0d9;border-radius:28px;padding:30px}.hero-detail{display:grid;grid-template-columns:minmax(220px,340px) 1fr;gap:30px;align-items:center}.hero-img{aspect-ratio:1;border-radius:20px;background:#eee;display:grid;place-items:center;padding:12%}.hero-img img{width:100%;height:100%;object-fit:contain}.hero h1{font-size:clamp(28px,5vw,48px);line-height:1.2;margin:0}.hero p{line-height:1.9;color:#555}.terms,.guide{margin:24px 0;padding:18px 20px;border:1px solid #d9c9a0;background:#fff8e7;border-radius:18px;line-height:1.8;font-size:13px}.terms strong,.guide strong{display:block;font-size:15px;margin-bottom:4px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:20px}.card{display:block;text-decoration:none;background:#fff;border:1px solid #e3e0d9;border-radius:18px;overflow:hidden;color:inherit}.stage{aspect-ratio:1;background:#eee;display:grid;place-items:center;padding:10%}.stage img{width:100%;height:100%;object-fit:contain}.body{padding:14px}.body h2{font-size:14px;margin:0;line-height:1.5}.icon-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.icon{background:#fff;border:1px solid #e3e0d9;border-radius:16px;padding:10px}.icon img{width:100%;aspect-ratio:1;object-fit:contain;background:#eee}.related{margin-top:36px;padding:24px;background:#fff;border:1px solid #e3e0d9;border-radius:20px;text-align:center}.related a{display:inline-flex;margin-top:12px;padding:12px 16px;border-radius:12px;background:#171717;color:#fff;text-decoration:none;font-weight:800}@media(max-width:760px){.grid{grid-template-columns:repeat(2,1fr)}.icon-grid{grid-template-columns:repeat(3,1fr)}.hero-detail{grid-template-columns:1fr}.hero-img{width:min(70vw,280px);margin:auto}}@media(max-width:430px){.icon-grid{grid-template-columns:repeat(2,1fr)}}</style></head><body><SiteHeader locale={locale}/><main class="wrap"><nav class="crumb"><a href={prefix+"/"}>TOP</a> / {sticker?<><a href={prefix+"/chat-icons/"}>{t.title}</a> / {display}</>:t.title}</nav>{!sticker?(<><section class="hero"><h1>{t.title}</h1><p>{t.lead}</p><div class="terms"><strong>{t.termsTitle}</strong>{t.terms}</div></section><h2>{t.list}</h2><div class="grid">{available.map(s=><a class="card" href={`${prefix}/chat-icons/${s.id}/`}><div class="stage"><img src={s.image} alt={localizedStickerTitle(s,locale)} loading="lazy"/></div><div class="body"><h2>{localizedStickerTitle(s,locale)}</h2></div></a>)}</div></>):(<><section class="hero hero-detail"><div class="hero-img"><img src={sticker.image} alt={display}/></div><div><h1>{display}</h1><p>{t.lead}</p></div></section><div class="guide"><strong>{t.save}</strong>{t.saveText}</div><div class="terms"><strong>{t.termsTitle}</strong>{t.terms}</div><h2>{t.list} <small>({files.length})</small></h2>{files.length?<div class="icon-grid">{files.map((f,i)=><div class="icon"><img src={`/images/chat-icons/${sticker.id}/${f}`} alt={`${display} ${i+1}`} loading="lazy"/></div>)}</div>:<p>{t.empty}</p>}<section class="related"><h2>{t.related}</h2><p>{t.relatedText}</p><a href={localizedPath(locale,`/stickers/${sticker.id}`)}>{t.line}</a></section></>)}</main></body></html>
