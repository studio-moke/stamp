---
import SiteHeader from "./SiteHeader.astro";
import { businessHubCopy, businessToolsByLocale } from "../lib/business-tools-i18n";
import type { Locale } from "../lib/i18n";
const { locale }=Astro.props as {locale:Exclude<Locale,"ja">};
const t=businessHubCopy[locale];
const tools=businessToolsByLocale[locale];
const prefix=`/${locale}`;
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{t.title} | stamp moke</title><meta name="description" content={t.lead}/>
<link rel="canonical" href={`https://stamp-moke.jp${prefix}/tools/`}/>
<link rel="icon" href="/favicon.svg?v=20260902" type="image/svg+xml"/><link rel="shortcut icon" href="/favicon.ico?v=20260902" sizes="any"/>
<style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.main{max-width:1180px;margin:auto;padding:50px 22px 90px}.hero{padding:24px 0 38px;border-bottom:1px solid #dddcd8}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.2em;color:#888}.hero h1{margin:8px 0 12px;font-size:clamp(40px,6vw,68px);letter-spacing:-.055em}.hero p{max-width:760px;margin:0;color:#666;font-size:13px;line-height:1.9}.group{margin-top:48px}.group-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:15px}.group h2{font-size:24px;margin:0}.group p{max-width:600px;margin:0;color:#777;font-size:11px;line-height:1.7;text-align:right}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.card{display:grid;grid-template-columns:52px 1fr 18px;align-items:center;gap:12px;padding:16px;border:1px solid #deddd8;border-radius:17px;background:#fff;color:#171717;text-decoration:none;transition:.18s}.card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(0,0,0,.07)}.icon{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;background:#171717;color:#fff;font-size:12px;font-weight:900}.card strong{display:block;font-size:14px;line-height:1.4}.card small{display:block;margin-top:5px;color:#777;font-size:10px;line-height:1.5}.arrow{color:#999}@media(max-width:800px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.group-head{display:block}.group p{margin-top:7px;text-align:left}}@media(max-width:540px){.main{padding:30px 12px 65px}.grid{grid-template-columns:1fr}.group{margin-top:34px}.card{padding:13px}.hero h1{font-size:42px}}</style>
</head><body><SiteHeader locale={locale}/><main class="main"><section class="hero"><div class="eyebrow">FREE BUSINESS TOOLS / stamp moke</div><h1>{t.title}</h1><p>{t.lead}</p></section><section class="group"><div class="group-head"><h2>{t.group}</h2><p>{t.groupLead}</p></div><div class="grid">{tools.map(x=><a class="card" href={`${prefix}/tools/${x.slug}/`}><span class="icon">{x.icon}</span><span><strong>{x.title}</strong><small>{x.desc}</small></span><span class="arrow">→</span></a>)}</div></section></main></body></html>
