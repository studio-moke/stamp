---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{d.seo} | stamp moke</title><meta name="description" content={d.desc}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/${route}/`}/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:1040px;margin:auto;padding:38px 18px 80px}.crumb{font-size:11px;color:#777;margin-bottom:28px}.hero{text-align:center;padding:24px 0 30px}.hero h1{font-size:clamp(34px,6vw,62px);letter-spacing:-.05em;margin:0 0 12px}.hero .sub{font-weight:900}.hero p{color:#666;font-size:12px;line-height:1.9}.tools{display:flex;gap:7px;overflow:auto;padding:4px 0 18px}.tools a{white-space:nowrap;text-decoration:none;color:#555;background:#fff;border:1px solid #ddd;border-radius:999px;padding:9px 13px;font-size:10px;font-weight:800}.tools a.on{background:#171717;color:#fff}.drop{display:block;background:#fff;border:2px dashed #c9c7bf;border-radius:22px;padding:58px 20px;text-align:center;cursor:pointer}.drop input{display:none}.drop strong{display:block;font-size:19px;margin-bottom:8px}.drop span{font-size:10px;color:#777}.work{display:none;margin-top:14px}.work.show{display:block}.preview-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;margin-bottom:12px}.preview{background:#fff;border:1px solid #ddd;border-radius:14px;padding:8px}.preview img{width:100%;height:105px;object-fit:contain;background:#f1f1ef}.preview div{font-size:9px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:6px}.options{background:#fff;border:1px solid #ddd;border-radius:18px;padding:16px;margin-bottom:12px}.option-row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.option-row label{font-size:11px;font-weight:900}.option-row input,.option-row select{border:1px solid #ccc;border-radius:10px;padding:10px}.quality{width:min(360px,100%)}.run{width:100%;border:0;background:#171717;color:#fff;border-radius:14px;padding:16px;font-size:13px;font-weight:900}.status{font-size:11px;color:#666;margin:10px 0}.results{display:grid;gap:8px}.result{display:flex;gap:10px;align-items:center;background:#fff;border:1px solid #ddd;border-radius:12px;padding:10px}.result span{flex:1;font-size:10px}.result a{background:#171717;color:#fff;text-decoration:none;border-radius:9px;padding:8px 10px;font-size:9px;font-weight:900}.related{margin-top:45px}.related-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.related-grid a{background:#fff;border:1px solid #ddd;border-radius:12px;padding:14px 8px;text-align:center;text-decoration:none;color:#171717;font-size:10px;font-weight:900}.stamp-section{margin-top:70px;padding-top:34px;border-top:1px solid #ddd}.stamp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.stamp{background:#fff;border:1px solid #ddd;border-radius:16px;padding:10px;text-decoration:none;color:#171717}.stamp img{width:100%;aspect-ratio:1;object-fit:contain}.stamp b{display:block;font-size:10px;line-height:1.5;margin-top:7px}@media(max-width:620px){.wrap{padding:25px 11px 60px}.drop{padding:45px 12px}.stamp-grid{grid-template-columns:repeat(2,1fr)}.related-grid{grid-template-columns:1fr 1fr}.result{flex-wrap:wrap}.result a{width:100%;text-align:center}}</style></head><body><SiteHeader locale={locale}/><main class="wrap"><div class="crumb"><a href={`${prefix}/`}>stamp moke</a> / image tools / {d.title}</div><nav class="tools">{nav.map(n=><a class={n[0]===tool?'on':''} href={`${prefix}/${n[1]}/`}>{navLabels[n[0]][0]}</a>)}</nav><section class="hero"><h1>{d.title}</h1><div class="sub">{d.sub}</div><p>{d.desc}<br/>{C.privacy}</p>{tool==='tojpg'&&<p>{C.firstFrame}</p>}</section><label class="drop" id="drop"><input id="file" type="file" multiple/><strong>{C.pick}</strong><span>{C.drop}</span></label><section class="work" id="work"><div class="preview-list" id="previews"></div><div class="options"><div class="option-row" id="optionRow"></div></div><button class="run" id="run">{d.button}</button><div class="status" id="status"></div><div class="results" id="results"></div></section><section class="related"><h2>{C.other}</h2><div class="related-grid">{nav.filter(n=>n[0]!==tool).map(n=><a href={`${prefix}/${n[1]}/`}>{navLabels[n[0]][0]} →</a>)}</div></section><footer class="stamp-section"><h2>{C.stickers}</h2><p>{C.stickerLead}</p><div class="stamp-grid">{picks.map(s=><a class="stamp" href={`${prefix}/stickers/${s.id}/`}><img src={s.image} loading="lazy" alt={s.title}/><b>{s.title.replace(' - LINE スタンプ | LINE STORE','')}</b></a>)}</div></footer></main><script is:inline define:vars={{tool,C}}>
(()=>{const f=document.getElementById('file'),drop=document.getElementById('drop'),work=document.getElementById('work'),previews=document.getElementById('previews'),row=document.getElementById('optionRow'),run=document.getElementById('run'),status=document.getElementById('status'),results=document.getElementById('results');let files=[];const opts={compress:`<label>${C.quality} <input class="quality" id="quality" type="range" min="35" max="95" value="78"></label><b id="qv">78%</b>`,resize:`<label>${C.width} <input id="w" type="number" min="1" value="1200"></label><label>${C.height} <input id="h" type="number" min="1" placeholder="${C.auto}"></label>`,tojpg:`<label>${C.quality} <input class="quality" id="quality" type="range" min="50" max="100" value="88"></label><b id="qv">88%</b>`,fromjpg:`<label>${C.target} <select id="target"><option value="png">PNG</option><option value="gif">GIF</option></select></label>`,transparent:`<label>Tolerance <input class="quality" id="tol" type="range" min="0" max="100" value="28"></label>`};row.innerHTML=opts[tool]||'';const q=document.getElementById('quality'),qv=document.getElementById('qv');if(q)q.oninput=()=>qv.textContent=q.value+'%';function setFiles(list){files=[...list];if(!files.length)return;work.classList.add('show');previews.innerHTML='';files.forEach(x=>{const d=document.createElement('div');d.className='preview';d.innerHTML='<img><div></div>';const u=URL.createObjectURL(x);d.querySelector('img').src=u;d.querySelector('img').onerror=()=>d.querySelector('img').remove();d.querySelector('img')?.addEventListener('load',()=>URL.revokeObjectURL(u));d.querySelector('div').textContent=x.name;previews.appendChild(d)})}f.onchange=()=>setFiles(f.files);['dragenter','dragover'].forEach(e=>drop.addEventListener(e,x=>x.preventDefault()));drop.ondrop=e=>{e.preventDefault();setFiles(e.dataTransfer.files)};
const imp=u=>import(u);const toBlob=(c,t,q)=>new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error(C.unsupported)),t,q));const loadNative=file=>new Promise((res,rej)=>{const u=URL.createObjectURL(file),i=new Image;i.onload=()=>{URL.revokeObjectURL(u);res(i)};i.onerror=()=>{URL.revokeObjectURL(u);rej(new Error(C.unsupported))};i.src=u});function canvas(w,h){const c=document.createElement('canvas');c.width=w;c.height=h;return c}function canvasFromImage(img){const c=canvas(img.naturalWidth||img.width,img.naturalHeight||img.height);c.getContext('2d').drawImage(img,0,0);return c}function ext(file){return (file.name.split('.').pop()||'').toLowerCase()}function saveLink(b,name){const u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=name;a.textContent=C.save;a.onclick=()=>setTimeout(()=>URL.revokeObjectURL(u),1500);return a}
async function decodeToCanvas(file){const e=ext(file);if(['jpg','jpeg','png','webp','gif','svg'].includes(e))return canvasFromImage(await loadNative(file));if(['heic','heif'].includes(e)){const m=await imp('https://esm.sh/heic2any@0.0.4');const out=await m.default({blob:file,toType:'image/png'});const b=Array.isArray(out)?out[0]:out;return canvasFromImage(await loadNative(b))}if(['tif','tiff'].includes(e)){const U=await imp('https://esm.sh/utif2@4.1.0');const buf=await file.arrayBuffer(),ifds=U.decode(buf);if(!ifds.length)throw new Error(C.unsupported);U.decodeImage(buf,ifds[0]);const rgba=U.toRGBA8(ifds[0]),c=canvas(ifds[0].width,ifds[0].height);c.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(rgba),c.width,c.height),0,0);return c}if(e==='psd'){const P=await imp('https://esm.sh/ag-psd@31.0.2');const psd=P.readPsd(await file.arrayBuffer());if(psd.canvas)return psd.canvas;if(psd.imageData){const c=canvas(psd.width,psd.height);c.getContext('2d').putImageData(psd.imageData,0,0);return c}throw new Error(C.unsupported)}if(['raw','dng','cr2','cr3','nef','arw','orf','rw2','raf','pef'].includes(e)){const M=await imp('https://esm.sh/libraw-wasm@1.6.0?bundle');const LibRaw=M.default;const raw=new LibRaw();await raw.open(new Uint8Array(await file.arrayBuffer()));const im=await raw.imageData();const c=canvas(im.width,im.height),data=im.data instanceof Uint8ClampedArray?im.data:new Uint8ClampedArray(im.data);c.getContext('2d').putImageData(new ImageData(data,im.width,im.height),0,0);if(raw.close)await raw.close();return c}throw new Error(C.unsupported)}
async function gifBlobFromCanvas(c,colors=256){const G=await imp('https://esm.sh/gifenc@1.0.3');const img=c.getContext('2d').getImageData(0,0,c.width,c.height),pal=G.quantize(img.data,Math.max(32,Math.min(256,colors))),idx=G.applyPalette(img.data,pal),gif=G.GIFEncoder();gif.writeFrame(idx,c.width,c.height,{palette:pal});gif.finish();return new Blob([gif.bytes()],{type:'image/gif'})}
async function compressGif(file){const D=await imp('https://esm.sh/gifuct-js@2.1.2'),G=await imp('https://esm.sh/gifenc@1.0.3'),gif=D.parseGIF(await file.arrayBuffer()),frames=D.decompressFrames(gif,true);if(!frames.length)throw new Error(C.unsupported);const W=gif.lsd.width,H=gif.lsd.height,c=canvas(W,H),ctx=c.getContext('2d'),enc=G.GIFEncoder(),colors=Math.max(32,Math.round(256*((+q.value)/100)));let restore=null;for(const fr of frames){if(fr.disposalType===3)restore=ctx.getImageData(0,0,W,H);if(fr.disposalType===2)ctx.clearRect(fr.dims.left,fr.dims.top,fr.dims.width,fr.dims.height);ctx.putImageData(new ImageData(fr.patch,fr.dims.width,fr.dims.height),fr.dims.left,fr.dims.top);const full=ctx.getImageData(0,0,W,H),pal=G.quantize(full.data,colors),idx=G.applyPalette(full.data,pal);enc.writeFrame(idx,W,H,{palette:pal,delay:Math.max(20,fr.delay||100),repeat:0});if(fr.disposalType===3&&restore)ctx.putImageData(restore,0,0)}enc.finish();return new Blob([enc.bytes()],{type:'image/gif'})}
async function one(file){const base=file.name.replace(/\.[^.]+$/,''),e=ext(file);if(tool==='compress'){if(e==='svg'){let s=await file.text();s=s.replace(/<!--([\s\S]*?)-->/g,'').replace(/>\s+</g,'><').replace(/\s{2,}/g,' ');return {b:new Blob([s],{type:'image/svg+xml'}),name:base+'-compressed.svg'}}if(e==='gif')return {b:await compressGif(file),name:base+'-compressed.gif'};const c=await decodeToCanvas(file);if(e==='png'){const U=await imp('https://esm.sh/upng-js@2.1.0');const im=c.getContext('2d').getImageData(0,0,c.width,c.height),colors=Math.max(16,Math.round(256*((+q.value)/100)));return {b:new Blob([U.encode([im.data.buffer],c.width,c.height,colors)],{type:'image/png'}),name:base+'-compressed.png'}}return {b:await toBlob(c,'image/jpeg',(+q.value)/100),name:base+'-compressed.jpg'}}if(tool==='resize'){const src=await decodeToCanvas(file),W=+document.getElementById('w').value||src.width,H=+document.getElementById('h').value||0,r=Math.min(W/src.width,H?H/src.height:Infinity),c=canvas(Math.max(1,Math.round(src.width*r)),Math.max(1,Math.round(src.height*r)));c.getContext('2d').drawImage(src,0,0,c.width,c.height);return {b:await toBlob(c,e==='png'?'image/png':'image/jpeg',.9),name:base+'-resized.'+(e==='png'?'png':'jpg')}}if(tool==='tojpg'){const c=await decodeToCanvas(file),ctx=c.getContext('2d');ctx.globalCompositeOperation='destination-over';ctx.fillStyle='#fff';ctx.fillRect(0,0,c.width,c.height);return {b:await toBlob(c,'image/jpeg',(+q.value)/100),name:base+'.jpg'}}if(tool==='fromjpg'){const c=await decodeToCanvas(file),t=document.getElementById('target').value;if(t==='gif')return {b:await gifBlobFromCanvas(c,256),name:base+'.gif'};return {b:await toBlob(c,'image/png',1),name:base+'.png'}}if(tool==='transparent'){const c=await decodeToCanvas(file),ctx=c.getContext('2d'),im=ctx.getImageData(0,0,c.width,c.height),p=im.data,r=p[0],g=p[1],b=p[2],tol=(+document.getElementById('tol').value)*4.42;for(let i=0;i<p.length;i+=4)if(Math.hypot(p[i]-r,p[i+1]-g,p[i+2]-b)<tol)p[i+3]=0;ctx.putImageData(im,0,0);return {b:await toBlob(c,'image/png',1),name:base+'-transparent.png'}}throw new Error(C.unsupported)}
run.onclick=async()=>{results.innerHTML='';status.textContent=C.working;let ok=0;for(const file of files){const r=document.createElement('div');r.className='result';try{const o=await one(file);r.innerHTML='<span></span>';r.querySelector('span').textContent=`${file.name} → ${(o.b.size/1024).toFixed(1)} KB`;r.appendChild(saveLink(o.b,o.name));ok++}catch(e){r.innerHTML='<span></span>';r.querySelector('span').textContent=file.name+'：'+(e?.message||C.libfail)}results.appendChild(r)}status.textContent=`${ok} / ${files.length} ${C.done}`};})();
</script></body></html>