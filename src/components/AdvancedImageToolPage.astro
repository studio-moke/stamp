 th:{compress:['บีบอัดรูปภาพ','บีบอัด JPG, PNG, SVG และ GIF','ลดขนาดไฟล์โดยคงคุณภาพที่ใช้งานได้','บีบอัด JPG PNG SVG GIF ฟรี','บีบอัดรูป'],resize:['ปรับขนาดรูปภาพ','กำหนดความกว้างและความสูง','ปรับขนาดพิกเซลโดยรักษาสัดส่วนภาพ','ปรับขนาดรูปภาพฟรี','ปรับขนาด'],tojpg:['แปลงรูปเป็น JPG','PNG, GIF, TIF, PSD, SVG, HEIC, RAW → JPG','แปลงไฟล์รูปทั่วไป HEIC และ RAW จากกล้องเป็น JPG','แปลง PNG GIF TIF PSD SVG HEIC RAW เป็น JPG','แปลงเป็น JPG'],fromjpg:['แปลง JPG เป็น PNG หรือ GIF','JPG → PNG / GIF','แปลงไฟล์ JPG หลายไฟล์เป็น PNG หรือ GIF','แปลง JPG เป็น PNG GIF ฟรี','แปลงรูป'],transparent:['ทำพื้นหลังโปร่งใส','ลบพื้นหลังและบันทึกเป็น PNG','ทำสีพื้นหลังใกล้เคียงให้โปร่งใสและส่งออก PNG','ทำพื้นหลัง PNG โปร่งใสฟรี','สร้าง PNG โปร่งใส']},
 id:{compress:['Kompres gambar','Kompres JPG, PNG, SVG dan GIF','Kurangi ukuran file sambil menjaga kualitas visual.','Kompres JPG PNG SVG GIF gratis','Kompres gambar'],resize:['Ubah ukuran gambar','Atur lebar dan tinggi','Ubah dimensi piksel sambil menjaga rasio gambar.','Ubah ukuran gambar online gratis','Ubah ukuran'],tojpg:['Konversi gambar ke JPG','PNG, GIF, TIF, PSD, SVG, HEIC, RAW → JPG','Konversi gambar umum, HEIC, dan RAW kamera ke JPG.','Konversi PNG GIF TIF PSD SVG HEIC RAW ke JPG','Konversi ke JPG'],fromjpg:['Konversi JPG ke PNG atau GIF','JPG → PNG / GIF','Konversi satu atau banyak file JPG menjadi PNG atau GIF.','Konversi JPG ke PNG GIF gratis','Konversi gambar'],transparent:['Buat latar transparan','Hapus latar dan simpan sebagai PNG','Jadikan piksel yang mirip latar transparan dan ekspor PNG.','Buat background PNG transparan gratis','Buat PNG transparan']}
};
const arr=(defsByLocale[locale]||defsByLocale.ja)[tool]||(defsByLocale[locale]||defsByLocale.ja).compress;
const d={title:arr[0],sub:arr[1],desc:arr[2],seo:arr[3],button:arr[4]};
const route={compress:'image-compressor',resize:'image-resizer',tojpg:'convert-to-jpg',fromjpg:'jpg-to-image',transparent:'png-transparent'}[tool]||'image-compressor';
const nav=[['compress','image-compressor'],['resize','image-resizer'],['tojpg','convert-to-jpg'],['fromjpg','jpg-to-image'],['transparent','png-transparent']]; const picks=stickers.slice(0,6);
