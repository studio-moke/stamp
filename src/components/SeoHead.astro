---
import { SITE_NAME, absoluteUrl } from "../lib/seo";
import { LOCALES, alternateLinks, localeInfo, normalizeLocale } from "../lib/i18n";
import { r2GetJson } from "../../server/api/_r2.js";

const { title, description, canonical, image, type = "website", locale: localeProp = "ja", path = Astro.url.pathname, alternatePaths = null } = Astro.props;
const locale = normalizeLocale(localeProp);
const url = canonical || absoluteUrl(Astro.url.pathname);
const socialImage = absoluteUrl(image || "/images/biglogo.png?v=20260904-1");
const alternates = alternatePaths
  ? LOCALES.filter((item) => alternatePaths[item]).map((item) => ({ locale: item, href: absoluteUrl(alternatePaths[item]) }))
  : alternateLinks(path);
const japaneseAlternate = alternates.find((item) => item.locale === "ja");
const xDefault = japaneseAlternate?.href || absoluteUrl("/");
const stickerMatch = String(path || Astro.url.pathname).match(/\/stickers\/(\d+)/);
const rawPath = String(path || Astro.url.pathname || "/");
const isHomePath = rawPath === "/" || /^\/(en|zh-tw|zh-cn|ko|th|id)\/?$/.test(rawPath);
let stickerSeo = null;
if (stickerMatch) {
  try {
    stickerSeo = await r2GetJson(`sticker-seo/${stickerMatch[1]}.json`, null);
  } catch (error) {
    console.warn("sticker SEO metadata unavailable", error);
  }
}
const seoLocale = stickerSeo?.locales?.[locale] || stickerSeo?.locales?.ja || null;
const finalDescription = seoLocale?.metaDescription || description;
const keywords = Array.isArray(seoLocale?.keywords) ? seoLocale.keywords : [];
---
<meta name="description" content={finalDescription} />
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
<link rel="icon" href="/favicon.svg?v=20260904-6" type="image/svg+xml" />
<link rel="stylesheet" href="/site-header.css?v=20260904-6" />
<script is:inline src="/site-header.js?v=20260906-3"></script>
<script is:inline src="/site-logo-sync.js?v=20260904-6"></script>
<script is:inline src="/site-locale-patch.js?v=20260903-2"></script>
<script is:inline src="/site-extra-nav.js"></script>
<script is:inline src="/chat-icons-nav.js?v=20260906-3"></script>
{isHomePath && <script is:inline src="/home-free-tools-placement.js"></script>}
{isHomePath && <script is:inline src="/home-goods-preview.js?v=20260905-1"></script>}
{isHomePath && <script is:inline src="/home-top-ux.js?v=20260906-2"></script>}
<script is:inline src="/site-breadcrumbs.js?v=20260903-1"></script>
<script is:inline src="/site-pinterest-share.js?v=20260904-1"></script>
<script is:inline>
(() => {
  const normalizePath = (value) => {
    if (!value || !value.startsWith('/')) return value;
    const u = new URL(value, location.origin);
    const p = u.pathname;
    if (p === '/' || p.startsWith('/api/') || p.endsWith('/') || /\/[^/]+\.[a-z0-9]+$/i.test(p)) return value;
    return `${p}/${u.search}${u.hash}`;
  };
  const normalizeLinks = () => document.querySelectorAll('a[href^="/"],form[action^="/"]').forEach((el) => {
    const attr = el.tagName === 'FORM' ? 'action' : 'href';
    const current = el.getAttribute(attr);
    const normalized = normalizePath(current);
    if (normalized && normalized !== current) el.setAttribute(attr, normalized);
  });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', normalizeLinks, { once: true });
  else normalizeLinks();
})();
</script>
<link rel="canonical" href={url} />
{alternates.map((item) => <link rel="alternate" hreflang={localeInfo[item.locale].htmlLang} href={item.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />
<meta property="og:title" content={title} />
<meta property="og:description" content={finalDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={localeInfo[locale].ogLocale} />
{alternates.filter((item) => item.locale !== locale).map((item) => <meta property="og:locale:alternate" content={localeInfo[item.locale].ogLocale} />)}
<meta property="og:image" content={socialImage} />
<meta property="og:image:secure_url" content={socialImage} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={title} />
{seoLocale && <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"CreativeWork",name:title,url,description:seoLocale.overview||finalDescription,abstract:seoLocale.concept||undefined,audience:seoLocale.target?{"@type":"Audience",audienceType:seoLocale.target}:undefined,keywords,usageInfo:seoLocale.usageIntro||undefined,inLanguage:localeInfo[locale].htmlLang,image:socialImage})} />}
