---
import SiteHeader from "./SiteHeader.astro";
import { normalizeLocale } from "../lib/i18n";
const { locale: localeProp } = Astro.props;
const locale = normalizeLocale(localeProp);
if (locale === "ja") throw new Error("LocalizedNewsPage is for non-Japanese locales");
const prefix = `/${locale}`;
const copy = {
  en:{title:"News",lead:"Latest updates from stamp moke: LINE stickers, SUZURI goods, free tools and free assets.",all:"All",sticker:"LINE Stickers",suzuri:"SUZURI",tool:"Free Tools",free:"Free Assets",loading:"Loading news…",empty:"No news yet.",error:"Could not load news.",back:"Back to news",notFound:"Article not found.",viewSticker:"View LINE sticker",viewSuzuri:"View goods",viewTool:"Use free tool",viewFree:"View asset",newSticker:"New LINE sticker",newSuzuri:"New SUZURI item",newTool:"New free tool",newFree:"New free asset",bodySticker:"A new original LINE sticker set has been added to stamp moke. Check the artwork and use it in your everyday chats.",bodySuzuri:"A new stamp moke design is now available as SUZURI goods.",bodyTool:"A new free utility has been added to stamp moke. You can use it directly in your browser.",bodyFree:"A new free asset has been added to the stamp moke collection."},
  "zh-tw":{title:"最新消息",lead:"stamp moke 的最新更新：LINE 貼圖、SUZURI 商品、免費工具與免費素材。",all:"全部",sticker:"LINE 貼圖",suzuri:"SUZURI",tool:"免費工具",free:"免費素材",loading:"正在載入最新消息…",empty:"目前沒有最新消息。",error:"無法載入最新消息。",back:"返回最新消息",notFound:"找不到文章。",viewSticker:"查看 LINE 貼圖",viewSuzuri:"查看商品",viewTool:"使用免費工具",viewFree:"查看素材",newSticker:"新 LINE 貼圖",newSuzuri:"新 SUZURI 商品",newTool:"新免費工具",newFree:"新免費素材",bodySticker:"stamp moke 新增了一組原創 LINE 貼圖。歡迎查看角色與設計，運用在日常聊天中。",bodySuzuri:"stamp moke 的新設計已加入 SUZURI 商品。",bodyTool:"stamp moke 新增了一個免費工具，可直接在瀏覽器使用。",bodyFree:"stamp moke 的免費素材庫新增了新素材。"},
  "zh-cn":{title:"最新消息",lead:"stamp moke 的最新更新：LINE 贴图、SUZURI 商品、免费工具与免费素材。",all:"全部",sticker:"LINE 贴图",suzuri:"SUZURI",tool:"免费工具",free:"免费素材",loading:"正在加载最新消息…",empty:"目前没有最新消息。",error:"无法加载最新消息。",back:"返回最新消息",notFound:"未找到文章。",viewSticker:"查看 LINE 贴图",viewSuzuri:"查看商品",viewTool:"使用免费工具",viewFree:"查看素材",newSticker:"新 LINE 贴图",newSuzuri:"新 SUZURI 商品",newTool:"新免费工具",newFree:"新免费素材",bodySticker:"stamp moke 新增了一组原创 LINE 贴图。欢迎查看角色与设计，并用于日常聊天。",bodySuzuri:"stamp moke 的新设计已加入 SUZURI 商品。",bodyTool:"stamp moke 新增了一个免费工具，可直接在浏览器使用。",bodyFree:"stamp moke 的免费素材库新增了新素材。"},
  ko:{title:"새 소식",lead:"LINE 스티커, SUZURI 굿즈, 무료 도구와 무료 소재 등 stamp moke의 최신 업데이트입니다.",all:"전체",sticker:"LINE 스티커",suzuri:"SUZURI",tool:"무료 도구",free:"무료 소재",loading:"새 소식을 불러오는 중…",empty:"아직 새 소식이 없습니다.",error:"새 소식을 불러오지 못했습니다.",back:"새 소식으로 돌아가기",notFound:"게시물을 찾을 수 없습니다.",viewSticker:"LINE 스티커 보기",viewSuzuri:"굿즈 보기",viewTool:"무료 도구 사용",viewFree:"소재 보기",newSticker:"새 LINE 스티커",newSuzuri:"새 SUZURI 상품",newTool:"새 무료 도구",newFree:"새 무료 소재",bodySticker:"stamp moke에 새로운 오리지널 LINE 스티커 세트가 추가되었습니다. 캐릭터와 디자인을 확인하고 일상 대화에 활용해 보세요.",bodySuzuri:"stamp moke의 새 디자인이 SUZURI 굿즈로 추가되었습니다.",bodyTool:"stamp moke에 새로운 무료 도구가 추가되었습니다. 브라우저에서 바로 사용할 수 있습니다.",bodyFree:"stamp moke 무료 소재 컬렉션에 새로운 소재가 추가되었습니다."},
  th:{title:"ข่าวล่าสุด",lead:"อัปเดตล่าสุดจาก stamp moke ทั้งสติกเกอร์ LINE สินค้า SUZURI เครื่องมือฟรี และ素材ฟรี",all:"ทั้งหมด",sticker:"สติกเกอร์ LINE",suzuri:"SUZURI",tool:"เครื่องมือฟรี",free:"素材ฟรี",loading:"กำลังโหลดข่าว…",empty:"ยังไม่มีข่าวใหม่",error:"ไม่สามารถโหลดข่าวได้",back:"กลับไปหน้าข่าว",notFound:"ไม่พบบทความ",viewSticker:"ดูสติกเกอร์ LINE",viewSuzuri:"ดูสินค้า",viewTool:"ใช้เครื่องมือฟรี",viewFree:"ดู素材",newSticker:"สติกเกอร์ LINE ใหม่",newSuzuri:"สินค้า SUZURI ใหม่",newTool:"เครื่องมือฟรีใหม่",newFree:"素材ฟรีใหม่",bodySticker:"stamp moke เพิ่มชุดสติกเกอร์ LINE ต้นฉบับชุดใหม่แล้ว ลองดูตัวละครและดีไซน์สำหรับใช้ในแชตประจำวัน",bodySuzuri:"ดีไซน์ใหม่ของ stamp moke พร้อมใช้งานเป็นสินค้า SUZURI แล้ว",bodyTool:"มีเครื่องมือฟรีใหม่ใน stamp moke และสามารถใช้งานได้จากเบราว์เซอร์",bodyFree:"มี素材ฟรีรายการใหม่เพิ่มเข้ามาในคอลเลกชันของ stamp moke"},
  id:{title:"Berita",lead:"Pembaruan terbaru stamp moke: stiker LINE, produk SUZURI, alat gratis, dan aset gratis.",all:"Semua",sticker:"Stiker LINE",suzuri:"SUZURI",tool:"Alat Gratis",free:"Aset Gratis",loading:"Memuat berita…",empty:"Belum ada berita.",error:"Berita tidak dapat dimuat.",back:"Kembali ke berita",notFound:"Artikel tidak ditemukan.",viewSticker:"Lihat stiker LINE",viewSuzuri:"Lihat produk",viewTool:"Gunakan alat gratis",viewFree:"Lihat aset",newSticker:"Stiker LINE baru",newSuzuri:"Produk SUZURI baru",newTool:"Alat gratis baru",newFree:"Aset gratis baru",bodySticker:"Satu set stiker LINE orisinal baru telah ditambahkan ke stamp moke. Lihat karakter dan desainnya untuk percakapan sehari-hari.",bodySuzuri:"Desain stamp moke baru kini tersedia sebagai produk SUZURI.",bodyTool:"Alat gratis baru telah ditambahkan ke stamp moke dan dapat digunakan langsung di browser.",bodyFree:"Aset gratis baru telah ditambahkan ke koleksi stamp moke."}
}[locale];
if (!copy) throw new Error(`Unsupported news locale: ${locale}`);
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{copy.title} | stamp moke</title><meta name="description" content={copy.lead}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/news/`}/><link rel="icon" href="/favicon.svg?v=20260902" type="image/svg+xml"/><style>*{box-sizing:border-box}body{margin:0;background:#fbfcfb;color:#141820;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}a{color:inherit}.hero{background:linear-gradient(105deg,#f2f8fa,#eef5f4 48%,#f8f7f0);border-bottom:1px solid #e9eeea}.hero-inner{max-width:1180px;margin:auto;padding:52px clamp(18px,4vw,56px)}.hero h1{margin:0;font-size:clamp(40px,6vw,64px);letter-spacing:-.05em}.hero p{margin:14px 0 0;color:#63706c;line-height:1.8}.content{max-width:1180px;margin:auto;padding:32px clamp(18px,4vw,56px) 90px}.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}.filter{min-height:42px;padding:0 20px;border:1px solid #e3e7e4;background:#f8faf9;border-radius:16px;font-size:12px;font-weight:850;cursor:pointer}.filter.on{background:#16a361;color:#fff;border-color:#16a361}.list{display:grid;gap:14px}.card{display:grid;grid-template-columns:225px 1fr 54px;gap:26px;align-items:center;padding:14px;background:#fff;border:1px solid #e1e7e3;border-radius:16px;text-decoration:none}.thumb{height:112px;border-radius:12px;overflow:hidden;background:#f3f4f3}.thumb img{width:100%;height:100%;object-fit:cover}.meta{display:flex;gap:10px;align-items:center;color:#7b8581;font-size:11px}.label{padding:6px 10px;border-radius:999px;background:#e4f2ff;font-size:10px;font-weight:900}.card h2{margin:8px 0 0;font-size:20px}.summary{margin:7px 0 0;color:#6f7a76;font-size:12px;line-height:1.75}.article-shell{display:none;max-width:900px;margin:auto;padding:42px clamp(18px,4vw,56px) 90px}.article-shell.show{display:block}.article{background:#fff;border:1px solid #e1e7e3;border-radius:24px;padding:clamp(26px,5vw,54px)}.article h1{font-size:clamp(30px,5vw,48px)}.article-image{margin-top:24px}.article-image img{width:100%;max-height:520px;object-fit:contain}.body{margin-top:24px;color:#59635f;font-size:15px;line-height:2}.cta{display:inline-flex;margin-top:30px;padding:13px 19px;border-radius:999px;background:#16a361;color:#fff;text-decoration:none;font-size:12px;font-weight:900}.back{display:inline-flex;margin-bottom:18px;text-decoration:none;font-size:12px;font-weight:800}.empty{padding:42px;text-align:center;color:#7b8581;background:#fff;border:1px solid #e1e7e3;border-radius:16px}@media(max-width:680px){.content{padding:24px 14px 65px}.card{grid-template-columns:96px 1fr 30px;gap:12px;padding:10px}.thumb{height:92px}.card h2{font-size:14px}.summary{font-size:10px}.article-shell{padding:28px 14px 65px}.article{padding:24px 20px}.hero-inner{padding:38px 18px}.hero h1{font-size:42px}}</style></head><body><SiteHeader locale={locale}/><section class="hero"><div class="hero-inner"><h1>{copy.title}</h1><p>{copy.lead}</p></div></section><div id="index-view"><main class="content"><div class="filters" id="filters"></div><div class="list" id="news-list"><div class="empty">{copy.loading}</div></div></main></div><main class="article-shell" id="article-shell"><a class="back" href={`${prefix}/news/`}>← {copy.back}</a><article class="article" id="article"></article></main><script is:inline define:vars={{copy,prefix}}>
const listEl=document.getElementById('news-list'),filtersEl=document.getElementById('filters'),article=document.getElementById('article'),articleShell=document.getElementById('article-shell'),indexView=document.getElementById('index-view');
const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const qs=new URLSearchParams(location.search);let all=[];
const text=n=>n.type==='sticker'?{title:`${copy.newSticker} #${String(n.id||'').replace('sticker:','')}`,body:copy.bodySticker,label:copy.sticker,cta:copy.viewSticker}:n.type==='suzuri'?{title:copy.newSuzuri,body:copy.bodySuzuri,label:copy.suzuri,cta:copy.viewSuzuri}:n.type==='tool'?{title:copy.newTool,body:copy.bodyTool,label:copy.tool,cta:copy.viewTool}:{title:copy.newFree,body:copy.bodyFree,label:copy.free,cta:copy.viewFree};
const imageUrl=n=>n?.image||n?.thumbnail||n?.imageUrl||n?.ogImage||n?.previewUrl||n?.preview||'';
async function load(){try{const r=await fetch('/api/news?limit=80&sync=0');const d=await r.json();all=d.items||[];const slug=qs.get('slug');if(slug)return showArticle(all.find(x=>x.slug===slug));renderFilters();render(all)}catch{listEl.innerHTML=`<div class="empty">${esc(copy.error)}</div>`}}
function renderFilters(){const types=[['all',copy.all],['sticker',copy.sticker],['suzuri',copy.suzuri],['tool',copy.tool],['free',copy.free]];filtersEl.innerHTML=types.map(([v,l],i)=>`<button class="filter${i===0?' on':''}" data-type="${v}">${esc(l)}</button>`).join('');filtersEl.addEventListener('click',e=>{const b=e.target.closest('.filter');if(!b)return;filtersEl.querySelectorAll('.filter').forEach(x=>x.classList.remove('on'));b.classList.add('on');render(b.dataset.type==='all'?all:all.filter(x=>x.type===b.dataset.type))})}
function render(rows){listEl.innerHTML=rows.length?rows.map(n=>{const tx=text(n),img=imageUrl(n);return `<a class="card" href="${prefix}/news/?slug=${encodeURIComponent(n.slug)}"><div class="thumb">${img?`<img src="${esc(img)}" alt="" loading="lazy">`:''}</div><div><div class="meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="label">${esc(tx.label)}</span></div><h2>${esc(tx.title)}</h2><p class="summary">${esc(tx.body)}</p></div><div>›</div></a>`}).join(''):`<div class="empty">${esc(copy.empty)}</div>`}
function showArticle(n){indexView.style.display='none';articleShell.classList.add('show');if(!n){article.innerHTML=`<p>${esc(copy.notFound)}</p>`;return}const tx=text(n),img=imageUrl(n),url=n.url||'/';article.innerHTML=`<div class="meta"><span>${esc((n.date||'').replaceAll('-','.'))}</span><span class="label">${esc(tx.label)}</span></div><h1>${esc(tx.title)}</h1>${img?`<div class="article-image"><img src="${esc(img)}" alt="" /></div>`:''}<div class="body">${esc(tx.body)}</div><a class="cta" href="${esc(url)}">${esc(tx.cta)}　›</a>`}
load();
</script></body></html>
