---
import SiteHeader from "./SiteHeader.astro";
const { locale="ja" }=Astro.props;
const prefix=locale==="ja"?"":`/${locale}`;
const copy={
 ja:{title:"画像の背景を透過",sub:"アップロードすると、切り抜き結果をすぐ確認できます",lead:"背景色を自動判定し、透明PNGをブラウザ内だけで作成します。画像はサーバーへ送信しません。",pick:"画像をアップロード",drop:"または画像をここへドロップ",result:"切り抜き後",original:"元画像",adjust:"仕上がりを調整",tol:"背景を消す範囲",hint:"画像内をタップすると、その色を背景色として再調整できます。",save:"透過PNGをダウンロード",again:"別の画像を選ぶ",empty:"ここに切り抜き結果が表示されます",working:"切り抜き中…"},
 en:{title:"Remove image background",sub:"Upload an image to preview the result instantly",lead:"Detect a flat background and create a transparent PNG locally in your browser. Your image is never uploaded.",pick:"Upload image",drop:"or drop an image here",result:"Removed background",original:"Original",adjust:"Refine result",tol:"Removal range",hint:"Tap the image to use that color as the background.",save:"Download transparent PNG",again:"Choose another image",empty:"Your result will appear here",working:"Removing background…"},
 "zh-tw":{title:"圖片背景透明化",sub:"上傳後立即預覽去背結果",lead:"在瀏覽器內偵測背景色並建立透明PNG，圖片不會上傳。",pick:"上傳圖片",drop:"或拖曳圖片到此處",result:"去背結果",original:"原圖",adjust:"調整效果",tol:"移除範圍",hint:"點選圖片中的顏色，可將它設為背景色。",save:"下載透明PNG",again:"選擇其他圖片",empty:"去背結果會顯示在這裡",working:"去背中…"},
 th:{title:"ทำพื้นหลังรูปโปร่งใส",sub:"อัปโหลดแล้วดูผลลัพธ์ได้ทันที",lead:"ตรวจจับสีพื้นหลังและสร้าง PNG โปร่งใสในเบราว์เซอร์โดยไม่อัปโหลดรูป",pick:"อัปโหลดรูป",drop:"หรือลากรูปมาวางที่นี่",result:"ผลลัพธ์",original:"รูปเดิม",adjust:"ปรับผลลัพธ์",tol:"ช่วงสีที่ลบ",hint:"แตะสีในรูปเพื่อใช้เป็นสีพื้นหลัง",save:"ดาวน์โหลด PNG โปร่งใส",again:"เลือกรูปอื่น",empty:"ผลลัพธ์จะแสดงที่นี่",working:"กำลังลบพื้นหลัง…"},
 id:{title:"Hapus latar belakang gambar",sub:"Unggah dan lihat hasilnya seketika",lead:"Deteksi warna latar dan buat PNG transparan langsung di browser tanpa mengunggah gambar.",pick:"Unggah gambar",drop:"atau tarik gambar ke sini",result:"Hasil",original:"Asli",adjust:"Sesuaikan hasil",tol:"Rentang penghapusan",hint:"Ketuk warna pada gambar untuk menjadikannya warna latar.",save:"Unduh PNG transparan",again:"Pilih gambar lain",empty:"Hasil akan muncul di sini",working:"Menghapus latar…"}
};
const C=copy[locale]||copy.ja;
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{C.title}｜無料の背景透過PNG作成 | stamp moke</title><meta name="description" content={C.lead}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/png-transparent/`}/>
<style>
*{box-sizing:border-box}body{margin:0;background:#f6f7f8;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:1080px;margin:auto;padding:28px 18px 80px}.crumb{font-size:11px;color:#777;margin-bottom:18px}.crumb a{color:inherit}.hero{text-align:center;padding:16px 0 26px}.hero h1{font-size:clamp(36px,6vw,64px);letter-spacing:-.055em;margin:0 0 10px}.hero strong{font-size:16px}.hero p{max-width:690px;margin:12px auto 0;color:#666;font-size:12px;line-height:1.8}.app{display:grid;grid-template-columns:minmax(0,1.25fr) 330px;gap:16px;align-items:start}.preview-card,.control-card{background:#fff;border:1px solid #e0e2e5;border-radius:22px;box-shadow:0 14px 40px rgba(20,25,32,.06)}.preview-card{padding:14px}.tabs{display:flex;gap:6px;margin-bottom:11px}.tabs button{border:0;border-radius:999px;background:#eef0f2;padding:9px 14px;font-size:11px;font-weight:900;cursor:pointer}.tabs button.on{background:#171717;color:#fff}.stage{position:relative;min-height:480px;border-radius:16px;overflow:hidden;display:grid;place-items:center;background-color:#fff;background-image:linear-gradient(45deg,#e7e9eb 25%,transparent 25%),linear-gradient(-45deg,#e7e9eb 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e7e9eb 75%),linear-gradient(-45deg,transparent 75%,#e7e9eb 75%);background-size:24px 24px;background-position:0 0,0 12px,12px -12px,-12px 0}.stage canvas{display:block;width:100%;height:auto;max-height:620px;object-fit:contain;cursor:crosshair}.empty{position:absolute;text-align:center;color:#8a8f98;font-size:12px;font-weight:800}.busy{position:absolute;inset:0;background:rgba(255,255,255,.76);display:none;place-items:center;font-weight:900}.busy.show{display:grid}.control-card{padding:18px;position:sticky;top:14px}.upload{display:block;border:2px dashed #bfc4ca;border-radius:16px;padding:24px 12px;text-align:center;cursor:pointer;background:#fafbfc}.upload input{display:none}.upload strong{display:block;background:#287bde;color:#fff;border-radius:12px;padding:14px 10px;font-size:13px}.upload span{display:block;margin-top:9px;color:#777;font-size:10px}.adjust{display:none;margin-top:18px}.adjust.show{display:block}.adjust h2{font-size:15px;margin:0 0 15px}.range-head{display:flex;justify-content:space-between;font-size:11px;font-weight:900;margin-bottom:8px}.range{width:100%;accent-color:#287bde}.color{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:12px 0;padding:10px;border-radius:12px;background:#f2f4f6;font-size:10px}.color i{width:28px;height:28px;border-radius:8px;border:1px solid #ccc;background:#fff}.hint{font-size:10px;line-height:1.65;color:#727780}.save,.again{width:100%;border:0;border-radius:13px;padding:14px;margin-top:10px;font-weight:900;cursor:pointer}.save{background:#287bde;color:#fff}.again{background:#eef0f2;color:#171717}.privacy{font-size:9px;color:#858a91;line-height:1.6;margin-top:12px}.related{margin-top:42px}.related a{display:inline-block;background:#fff;border:1px solid #ddd;border-radius:999px;padding:9px 12px;margin:3px;color:#333;text-decoration:none;font-size:10px;font-weight:800}@media(max-width:800px){.wrap{padding:20px 10px 60px}.hero{padding-top:8px}.app{grid-template-columns:1fr}.preview-card{order:1}.control-card{order:2;position:static}.stage{min-height:330px}.control-card{padding:14px}.upload{padding:12px}.upload strong{padding:13px}.hero p{font-size:11px}}@media(max-width:480px){.stage{min-height:290px}.preview-card{padding:8px;border-radius:17px}.control-card{border-radius:17px}.hero h1{font-size:40px}}
</style></head><body><SiteHeader locale={locale}/><main class="wrap"><div class="crumb"><a href={`${prefix}/`}>stamp moke</a> / <a href={`${prefix}/tools/`}>無料ツール</a> / {C.title}</div><section class="hero"><h1>{C.title}</h1><strong>{C.sub}</strong><p>{C.lead}</p></section><section class="app"><div class="preview-card"><div class="tabs"><button id="resultTab" class="on">{C.result}</button><button id="originalTab">{C.original}</button></div><div class="stage"><canvas id="canvas"></canvas><div class="empty" id="empty">{C.empty}</div><div class="busy" id="busy">{C.working}</div></div></div><aside class="control-card"><label class="upload"><input id="file" type="file" accept="image/png,image/jpeg,image/webp"/><strong>{C.pick}</strong><span>{C.drop}</span></label><div class="adjust" id="adjust"><h2>{C.adjust}</h2><div class="range-head"><span>{C.tol}</span><b id="tolValue">28</b></div><input class="range" id="tol" type="range" min="0" max="100" value="28"/><div class="color"><span>Background color</span><i id="colorChip"></i></div><p class="hint">{C.hint}</p><button class="save" id="save">{C.save}</button><button class="again" id="again">{C.again}</button></div><div class="privacy">{C.lead}</div></aside></section><section class="related"><a href={`${prefix}/image-compressor/`}>画像圧縮</a><a href={`${prefix}/image-resizer/`}>サイズ変更</a><a href={`${prefix}/color-palette/`}>カラーパレット</a><a href={`${prefix}/qr-maker/`}>QRコード</a></section></main>
<script is:inline>(()=>{const file=document.getElementById('file'),canvas=document.getElementById('canvas'),ctx=canvas.getContext('2d',{willReadFrequently:true}),tol=document.getElementById('tol'),tolValue=document.getElementById('tolValue'),chip=document.getElementById('colorChip'),empty=document.getElementById('empty'),busy=document.getElementById('busy'),adjust=document.getElementById('adjust'),resultTab=document.getElementById('resultTab'),originalTab=document.getElementById('originalTab');let original=null,bg=[255,255,255],showOriginal=false,timer=0;function draw(){if(!original)return;ctx.putImageData(original,0,0);if(!showOriginal){const im=ctx.getImageData(0,0,canvas.width,canvas.height),p=im.data,limit=(+tol.value)*4.42;for(let i=0;i<p.length;i+=4){const d=Math.hypot(p[i]-bg[0],p[i+1]-bg[1],p[i+2]-bg[2]);if(d<limit)p[i+3]=Math.min(p[i+3],Math.max(0,Math.round(255*d/Math.max(1,limit))))}ctx.putImageData(im,0,0)}tolValue.textContent=tol.value;chip.style.background=`rgb(${bg.join(',')})`}function load(f){if(!f)return;busy.classList.add('show');const u=URL.createObjectURL(f),img=new Image;img.onload=()=>{const max=1800,s=Math.min(1,max/Math.max(img.naturalWidth,img.naturalHeight));canvas.width=Math.max(1,Math.round(img.naturalWidth*s));canvas.height=Math.max(1,Math.round(img.naturalHeight*s));ctx.drawImage(img,0,0,canvas.width,canvas.height);original=ctx.getImageData(0,0,canvas.width,canvas.height);const p=original.data,w=canvas.width,h=canvas.height,pts=[[0,0],[w-1,0],[0,h-1],[w-1,h-1]],avg=[0,0,0];pts.forEach(([x,y])=>{const i=(y*w+x)*4;avg[0]+=p[i];avg[1]+=p[i+1];avg[2]+=p[i+2]});bg=avg.map(v=>Math.round(v/4));showOriginal=false;resultTab.classList.add('on');originalTab.classList.remove('on');empty.hidden=true;adjust.classList.add('show');busy.classList.remove('show');URL.revokeObjectURL(u);draw()};img.onerror=()=>{busy.classList.remove('show');URL.revokeObjectURL(u)};img.src=u}file.onchange=()=>load(file.files&&file.files[0]);['dragenter','dragover'].forEach(n=>document.addEventListener(n,e=>e.preventDefault()));document.addEventListener('drop',e=>{e.preventDefault();load(e.dataTransfer.files&&e.dataTransfer.files[0])});tol.oninput=()=>{clearTimeout(timer);timer=setTimeout(draw,30)};resultTab.onclick=()=>{showOriginal=false;resultTab.classList.add('on');originalTab.classList.remove('on');draw()};originalTab.onclick=()=>{showOriginal=true;originalTab.classList.add('on');resultTab.classList.remove('on');draw()};canvas.onclick=e=>{if(!original)return;const r=canvas.getBoundingClientRect(),x=Math.max(0,Math.min(canvas.width-1,Math.floor((e.clientX-r.left)*canvas.width/r.width))),y=Math.max(0,Math.min(canvas.height-1,Math.floor((e.clientY-r.top)*canvas.height/r.height))),i=(y*canvas.width+x)*4;bg=[original.data[i],original.data[i+1],original.data[i+2]];showOriginal=false;resultTab.classList.add('on');originalTab.classList.remove('on');draw()};document.getElementById('save').onclick=()=>canvas.toBlob(b=>{const u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='stamp-moke-transparent.png';a.click();setTimeout(()=>URL.revokeObjectURL(u),1200)},'image/png');document.getElementById('again').onclick=()=>{file.value='';file.click()}})();</script></body></html>
