---
import SiteHeader from "./SiteHeader.astro";
import { getBusinessTool } from "../lib/business-tools-i18n";
import type { Locale } from "../lib/i18n";
const { locale, slug }=Astro.props as {locale:Exclude<Locale,"ja">;slug:string};
const tool=getBusinessTool(locale,slug);
if(!tool) throw new Error(`Unknown business tool: ${slug}`);
const prefix=`/${locale}`;
const nav={en:{tools:"Free tools",back:"Back to free tools"},"zh-tw":{tools:"免費工具",back:"返回免費工具"},"zh-cn":{tools:"免费工具",back:"返回免费工具"},ko:{tools:"무료 도구",back:"무료 도구로 돌아가기"},th:{tools:"เครื่องมือฟรี",back:"กลับไปเครื่องมือฟรี"},id:{tools:"Alat gratis",back:"Kembali ke alat gratis"}}[locale];
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{tool.title} | {nav.tools} | stamp moke</title><meta name="description" content={tool.desc}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/tools/${tool.slug}/`}/><link rel="icon" href="/favicon.svg?v=20260902" type="image/svg+xml"/><link rel="shortcut icon" href="/favicon.ico?v=20260902" sizes="any"/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:1040px;margin:auto;padding:38px 18px 90px}.crumb{font-size:11px;color:#777;margin-bottom:18px}.crumb a{color:#555}.hero{margin-bottom:22px}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.18em;color:#888}.hero h1{margin:8px 0 9px;font-size:clamp(30px,5vw,48px);letter-spacing:-.04em}.hero p{margin:0;max-width:760px;color:#666;font-size:13px;line-height:1.8}.toolbox{background:#fff;border:1px solid #deddd8;border-radius:20px;padding:22px;box-shadow:0 8px 30px rgba(0,0,0,.035)}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{margin-bottom:14px}.field label{display:block;font-size:12px;font-weight:800;margin-bottom:7px}.field input,.field select,.field textarea{width:100%;border:1px solid #d8d7d2;border-radius:12px;padding:12px 13px;background:#fff;color:#171717;font:inherit;font-size:14px;outline:none}.field textarea{min-height:180px;resize:vertical}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:8px}.btn{border:0;border-radius:12px;padding:11px 16px;background:#171717;color:#fff;font-weight:800;cursor:pointer}.btn.sub{background:#ecebe6;color:#222}.result{margin-top:17px;padding:16px;border-radius:15px;background:#f2f1ed;min-height:58px;line-height:1.8;font-size:14px;overflow-wrap:anywhere}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.metric{padding:15px;border:1px solid #e2e1dc;border-radius:14px;background:#fff}.metric