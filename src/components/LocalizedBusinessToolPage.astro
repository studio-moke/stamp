if(!app)return;
if(slug==='date-calculator'){app.innerHTML=`<div class="grid2"><div><div class="field"><label>${t.baseDate}</label><input id="base" type="date"></div><div class="field"><label>${t.days}</label><input id="days" type="number" value="30"></div><button class="btn" id="add">${t.calculate}</button></div><div><div class="field"><label>${t.startDate}</label><input id="from" type="date"></div><div class="field"><label>${t.endDate}</label><input id="to" type="date"></div><button class="btn" id="diff">${t.difference}</button></div></div><div class="result" id="result">${t.enterDate}</div>`;const today=new Date().toISOString().slice(0,10);$('base').value=today;$('from').value=today;$('to').value=today;$('add').onclick=()=>{const d=new Date($('base').value+'T00:00:00');d.setDate(d.getDate()+Number($('days').value||0));$('result').textContent=d.toLocaleDateString(locale)};$('diff').onclick=()=>{const a=new Date($('from').value+'T00:00:00'),b=new Date($('to').value+'T00:00:00');$('result').textContent=`${Math.abs(Math.round((b-a)/86400000))} ${t.days}`}}
else if(slug==='gross-profit'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.sales}</label><input id="sales" type="number" value="10000"></div><div class="field"><label>${t.cost}</label><input id="cost" type="number" value="6000"></div></div>${metric([t.grossProfit],[t.margin],[t.costRatio])}`;const c=()=>{const s=num('sales'),x=num('cost'),g=s-x;$('m1').textContent=fmt(g);$('m2').textContent=s?fmt(g/s*100)+'%':'-';$('m3').textContent=s?fmt(x/s*100)+'%':'-'};app.oninput=c;c()}
else if(slug==='text-counter'){app.innerHTML=`<div class="field"><label>${t.text}</label><textarea id="text" placeholder="${t.textHint}"></textarea></div>${metric([t.chars,'0'],[t.noSpaces,'0'],[t.lines,'0'])}`;$('text').oninput=()=>{const s=$('text').value;$('m1').textContent=s.length;$('m2').textContent=s.replace(/\s/g,'').length;$('m3').textContent=s?s.split(/\r?\n/).length:0}}
else if(slug==='dedupe-lines'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.input}</label><textarea id="text"></textarea></div><div class="field"><label>${t.result}</label><textarea id="out" readonly></textarea></div></div><div class="checkrow"><label><input id="empty" type="checkbox" checked>${t.removeEmpty}</label><label><input id="trim" type="checkbox" checked>${t.ignoreTrim}</label></div><div class="actions"><button class="btn" id="run">${t.removeDuplicates}</button><button class="btn sub" id="cp">${t.copyResult}</button></div><div class="result" id="result">0 ${t.rows}</div>`;$('run').onclick=()=>{const seen=new Set(),rows=[];$('text').value.split(/\r?\n/).forEach(raw=>{const k=$('trim').checked?raw.trim():raw;if($('empty').checked&&!k)return;if(seen.has(k))return;seen.add(k);rows.push(raw)});$('out').value=rows.join('\n');$('result').textContent=`${rows.length} ${t.rows}`};$('cp').onclick=()=>copy($('out').value)}
else if(slug==='postal-code'){app.innerHTML=`<div class="grid2"><div><div class="field"><label>${t.zipToAddr}</label><input id="zip" inputmode="numeric"></div><button class="btn" id="zr">${t.searchAddress}</button></div><div><div class="field"><label>${t.addrToZip}</label><input id="addr"></div><button class="btn" id="ar">${t.searchZip}</button></div></div><div class="result" id="result">${t.searchHere}</div><p class="note">${t.apiNote}</p>`;$('zr').onclick=async()=>{const z=$('zip').value.replace(/\D/g,'');if(z.length!==7){$('result').textContent=t.enterZip;return}$('result').textContent=t.searching;try{const r=await fetch(`https://postcode.teraren.com/postcodes/${z}.json`);if(!r.ok)throw 0;const d=await r.json();$('result').innerHTML=`<b>〒${esc(d.new||d.postcode||z)}</b><br>${esc(d.prefecture||'')}${esc(d.city||'')}${esc(d.suburb||d.town||'')}`}catch{$('result').textContent=t.notFound}};$('ar').onclick=async()=>{const q=$('addr').value.trim();if(!q){$('result').textContent=t.enterAddress;return}$('result').textContent=t.searching;try{const r=await fetch(`https://postcode.teraren.com/postcodes.json?s=${encodeURIComponent(q)}`);if(!r.ok)throw 0;const d=await r.json(),rows=Array.isArray(d)?d:(d.data||d.results||[]);$('result').innerHTML=rows.slice(0,10).map(x=>`<div><b>〒${esc(x.new||x.postcode||'')}</b> ${esc(x.prefecture||'')}${esc(x.city||'')}${esc(x.suburb||x.town||'')}</div>`).join('')||t.notFound}catch{$('result').textContent=t.notFound}}}
else if(slug==='mojibake'){app.innerHTML=`<div class="field"><label>${t.input}</label><textarea id="text"></textarea></div><div class="actions"><button class="btn" id="run">${t.repair}</button></div><div class="field" style="margin-top:14px"><label>${t.result}</label><textarea id="out" readonly></textarea></div>`;$('run').onclick=()=>{const s=$('text').value;try{const bytes=Uint8Array.from([...s].map(c=>c.charCodeAt(0)&255));$('out').value=new TextDecoder('utf-8',{fatal:false}).decode(bytes)}catch{$('out').value=s}}}
else if(slug==='password-generator'){app.innerHTML=`<div class="field"><label>${t.length}</label><input id="len" type="number" min="4" max="128" value="16"></div><div class="checkrow"><label><input id="up" type="checkbox" checked>${t.uppercase}</label><label><input id="lo" type="checkbox" checked>${t.lowercase}</label><label><input id="nu" type="checkbox" checked>${t.numbers}</label><label><input id="sy" type="checkbox" checked>${t.symbols}</label></div><div class="actions"><button class="btn" id="run">${t.generate}</button><button class="btn sub" id="cp">${t.copy}</button></div><div class="result" id="result"></div>`;const gen=()=>{let chars='';if($('up').checked)chars+='ABCDEFGHIJKLMNOPQRSTUVWXYZ';if($('lo').checked)chars+='abcdefghijklmnopqrstuvwxyz';if($('nu').checked)chars+='0123456789';if($('sy').checked)chars+='!@#$%^&*_-+=?';if(!chars){$('result').textContent=t.invalid;return}const a=new Uint32Array(Math.max(4,Math.min(128,num('len'))));crypto.getRandomValues(a);$('result').textContent=[...a].map(n=>chars[n%chars.length]).join('')};$('run').onclick=gen;$('cp').onclick=()=>copy($('result').textContent);gen()}
else if(slug==='html-entities'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.input}</label><textarea id="text"></textarea></div><div class="field"><label>${t.result}</label><textarea id="out" readonly></textarea></div></div><div class="actions"><button class="btn" id="enc">${t.encode}</button><button class="btn" id="dec">${t.decode}</button><button class="btn sub" id="cp">${t.copy}</button></div>`;$('enc').onclick=()=>{$('out').value=$('text').value.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))};$('dec').onclick=()=>{const x=document.createElement('textarea');x.innerHTML=$('text').value;$('out').value=x.value};$('cp').onclick=()=>copy($('out').value)}
else if(slug==='age-table'){app.innerHTML=`<div class="grid2"><div><div class="field"><label>${t.birthDate}</label><input id="birth" type="date"></div><button class="btn" id="ageRun">${t.calculate}</button></div><div><div class="field"><label>${t.currentAge}</label><input id="age" type="number" min="0" max="120" value="45"></div><button class="btn" id="yearRun">${t.calculate}</button></div></div><div class="result" id="result"></div>`;$('ageRun').onclick=()=>{if(!$('birth').value){$('result').textContent=t.enterDate;return}const b=new Date($('birth').value+'T00:00:00'),n=new Date();let a=n.getFullYear()-b.getFullYear();if(n.getMonth()<b.getMonth()||(n.getMonth()===b.getMonth()&&n.getDate()<b.getDate()))a--;$('result').innerHTML=`<b>${t.todayAge}: ${a}</b><br>${t.kazoe}: ${n.getFullYear()-b.getFullYear()+1}<br>${t.birthYear}: ${b.getFullYear()}`};$('yearRun').onclick=()=>{const a=Math.max(0,num('age')),y=new Date().getFullYear();$('result').innerHTML=`${t.birthYear}: <b>${y-a-1}–${y-a}</b>`};$('yearRun').click()}
else if(slug==='text-sort'){app.innerHTML=`<div class="field"><label>${t.text}</label><textarea id="text"></textarea></div><div class="checkrow"><label><input type="radio" name="sort" value="asc" checked>${t.ascending}</label><label><input type="radio" name="sort" value="desc">${t.descending}</label><label><input type="radio" name="sort" value="num">${t.numeric}</label><label><input type="radio" name="sort" value="random">${t.random}</label></div><div class="actions"><button class="btn" id="run">${t.sort}</button><button class="btn sub" id="cp">${t.copy}</button></div><div class="field" style="margin-top:14px"><label>${t.result}</label><textarea id="out" readonly></textarea></div>`;$('run').onclick=()=>{let a=$('text').value.split(/\r?\n/),m=document.querySelector('input[name=sort]:checked').value;if(m==='asc')a.sort((x,y)=>x.localeCompare(y,locale));if(m==='desc')a.sort((x,y)=>y.localeCompare(x,locale));if(m==='num')a.sort((x,y)=>parseFloat(x)-parseFloat(y));if(m==='random')a.sort(()=>Math.random()-.5);$('out').value=a.join('\n')};$('cp').onclick=()=>copy($('out').value)}
else if(slug==='sku-generator'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.prefix}</label><input id="prefix" value="SKU-"></div><div class="field"><label>${t.startNumber}</label><input id="start" type="number" value="1"></div><div class="field"><label>${t.digits}</label><input id="digits" type="number" value="4"></div><div class="field"><label>${t.quantity}</label><input id="qty" type="number" value="10"></div></div><div class="actions"><button class="btn" id="run">${t.generate}</button><button class="btn sub" id="cp">${t.copy}</button></div><div class="field" style="margin-top:14px"><textarea id="out" readonly></textarea></div>`;$('run').onclick=()=>{const p=$('prefix').value,s=num('start'),d=Math.max(1,num('digits')),q=Math.min(1000,Math.max(1,num('qty')));$('out').value=Array.from({length:q},(_,i)=>p+String(s+i).padStart(d,'0')).join('\n')};$('cp').onclick=()=>copy($('out').value);$('run').click()}
else if(slug==='zenkaku-hankaku'||slug==='trim-spaces'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.original}</label><textarea id="text"></textarea></div><div class="field"><label>${t.converted}</label><textarea id="out" readonly></textarea></div></div><div class="actions"><button class="btn" id="run">${t.convert}</button><button class="btn sub" id="cp">${t.copy}</button></div>`;$('run').onclick=()=>{let s=$('text').value;if(slug==='zenkaku-hankaku')s=s.replace(/[！-～]/g,c=>String.fromCharCode(c.charCodeAt(0)-0xFEE0)).replace(/　/g,' ');else s=s.split(/\r?\n/).map(x=>x.trim().replace(/[ \t]+/g,' ')).join('\n').trim();$('out').value=s};$('cp').onclick=()=>copy($('out').value)}
else if(slug==='tax-calculator'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.amount}</label><input id="amount" type="number" value="1000"></div><div class="field"><label>${t.taxRate}</label><select id="rate"><option value="10">10%</option><option value="8">8%</option></select></div></div>${metric([t.taxIncluded],[t.taxExcluded],[t.taxAmount])}`;const c=()=>{const a=num('amount'),r=num('rate')/100;$('m1').textContent=fmt(Math.round(a*(1+r)));$('m2').textContent=fmt(Math.round(a/(1+r)));$('m3').textContent=fmt(Math.round(a*r))};app.oninput=c;c()}
else if(slug==='price-change-rate'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.beforePrice}</label><input id="before" type="number" value="1000"></div><div class="field"><label>${t.afterPrice}</label><input id="after" type="number" value="1200"></div></div>${metric([t.changeRate],[t.amountChange],['', ''])}`;const c=()=>{const a=num('before'),b=num('after');$('m1').textContent=a?fmt((b-a)/a*100)+'%':'-';$('m2').textContent=fmt(b-a);$('m3').parentElement.style.display='none'};app.oninput=c;c()}
else if(slug==='roas'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.adCost}</label><input id="cost" type="number" value="100000"></div><div class="field"><label>${t.adRevenue}</label><input id="rev" type="number" value="500000"></div></div><div class="result" id="result"></div>`;const c=()=>{$('result').innerHTML=`ROAS: <b>${num('cost')?fmt(num('rev')/num('cost')*100):'-'}%</b>`};app.oninput=c;c()}
else if(slug==='roi'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.investment}</label><input id="inv" type="number" value="100000"></div><div class="field"><label>${t.profit}</label><input id="profit" type="number" value="30000"></div></div><div class="result" id="result"></div>`;const c=()=>{$('result').innerHTML=`ROI: <b>${num('inv')?fmt(num('profit')/num('inv')*100):'-'}%</b>`};app.oninput=c;c()}
else if(slug==='marketing-kpi'){app.innerHTML=`<div class="grid2"><div class="field"><label>${t.impressions}</label><input id="imp" type="number" value="100000"></div><div class="field"><label>${t.clicks}</label><input id="clk" type="number" value="2000"></div><div class="field"><label>${t.conversions}</label><input id="cv" type="number" value="100"></div><div class="field"><label>${t.spend}</label><input id="spend" type="number" value="100000"></div></div>${metric(['CTR'],['CVR'],['CPA'])}`;const c=()=>{const i=num('imp'),cl=num('clk'),cv=num('cv'),s=num('spend');$('m1').textContent=i?fmt(cl/i*100)+'%':'-';$('m2').textContent=cl?fmt(cv/cl*100)+'%':'-';$('m3').textContent=cv?fmt(s/cv):'-'};app.oninput=c;c()}
})();
</script></body></html>
