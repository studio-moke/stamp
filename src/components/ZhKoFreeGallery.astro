---
import SiteHeader from "./SiteHeader.astro";
import SeoHead from "./SeoHead.astro";
import Analytics from "./Analytics.astro";
import { localeInfo, localizedPath, normalizeLocale } from "../lib/i18n";
import { absoluteUrl } from "../lib/seo";
const locale=normalizeLocale(Astro.props.locale);
if(locale!=="zh-cn"&&locale!=="ko") throw new Error(`Unsupported locale: ${locale}`);
const prefix=`/${locale}`;
const copy={
 "zh-cn":{title:"免费素材",lead:"适用于 Pokekara、社交媒体、个人资料、学校与非商业项目的免费素材。",terms:"仅限个人与非商业用途免费使用。禁止商业使用、销售、再分发以及冒充作者。著作权归 © stamp-moke.jp 所有。",search:"搜索素材",all:"全部",category:"分类",tag:"标签",newest:"最新",popular:"热门",empty:"没有符合条件的素材。",loading:"正在加载素材…",more:"正在加载更多素材…",count:"件"},
 ko:{title:"무료 소재",lead:"Pokekara, 소셜 미디어, 개인 프로필, 학교 및 비상업 프로젝트에 사용할 수 있는 무료 소재입니다.",terms:"개인 및 비상업 용도로만 무료입니다. 상업적 이용, 판매, 재배포, 저작자 사칭은 금지됩니다. 저작권은 © stamp-moke.jp에 있습니다.",search:"소재 검색",all:"전체",category:"카테고리",tag:"태그",newest:"최신순",popular:"인기순",empty:"조건에 맞는 소재가 없습니다.",loading:"소재를 불러오는 중…",more:"더 불러오는 중…",count:"개"}
}[locale];
const labels={
 "zh-cn":{pokekara:"Pokekara",x:"X",instagram:"Instagram",facebook:"Facebook",line:"LINE",youtube:"YouTube",other:"其他",icon:"图标",header:"页眉",background:"背景",story:"限时动态",wallpaper:"壁纸",thumbnail:"缩略图",frame:"边框",decoration:"装饰",cat:"猫",dog:"狗",bird:"鸟",food:"食物",human:"人物",text:"文字",cute:"可爱",simple:"简约",handdrawn:"手绘",funny:"有趣",cool:"酷",retro:"复古",minimal:"极简"},
 ko:{pokekara:"Pokekara",x:"X",instagram:"Instagram",facebook:"Facebook",line:"LINE",youtube:"YouTube",other:"기타",icon:"아이콘",header:"헤더",background:"배경",story:"스토리",wallpaper:"배경화면",thumbnail:"썸네일",frame:"프레임",decoration:"장식",cat:"고양이",dog:"강아지",bird:"새",food:"음식",human:"인물",text:"문자",cute:"귀여움",simple:"심플",handdrawn:"손그림",funny:"유머",cool:"쿨",retro:"레트로",minimal:"미니멀"}
}[locale];
const canonicalPath="/free/";
const canonical=absoluteUrl(localizedPath(locale,canonicalPath));
const title=`${copy.title} | stamp moke`;
---
<!doctype html><html lang={localeInfo[locale].htmlLang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><SeoHead title={title} description={copy.lead} canonical={canonical} locale={locale} path={canonicalPath}/><Analytics/><style>*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#161616;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.main{max-width:1180px;margin:auto;padding:42px 24px 90px}.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:28px;align-items:end}.hero h1{font-size:clamp(40px,6vw,68px);margin:0}.hero p{color:#666;line-height:1.85}.terms,.tools,.card{background:#fff;border:1px solid #deddd8;border-radius:18px}.terms{padding:18px;line-height:1.75;font-size:12px}.tools{padding:12px;margin:24px 0 14px;display:grid;grid-template-columns:1.5fr repeat(3,.7fr);gap:9px}.tools input,.tools select{min-height:44px;border:1px solid #d9d8d4;border-radius:12px;padding:10px;background:#faf9f5}.platforms{display:flex;gap:7px;flex-wrap:wrap;margin:14px 0}.platforms button{border:1px solid #d9d8d4;background:#fff;border-radius:999px;padding:8px 12px}.platforms button.active{background:#161616;color:#fff}.summary{color:#666;font-size:12px;margin:14px 0}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}.card{overflow:hidden}.thumb{display:block;height:165px;background:#eee}.thumb img{width:100%;height:100%;object-fit:cover}.body{padding:13px}.body h2{font-size:14px;margin:0 0 7px}.body h2 a{text-decoration:none}.body p{font-size:11px;color:#737373;line-height:1.65;margin:0}.chips{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.chip{font-size:9px;padding:5px 7px;border-radius:999px;background:#f1f0eb}.empty{grid-column:1/-1;text-align:center;padding:50px;color:#777}@media(max-width:760px){.hero{grid-template-columns:1fr}.tools{grid-template-columns:1fr}.main{padding:30px 12px 70px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.thumb{height:118px}}</style></head><body><SiteHeader locale={locale} path={canonicalPath}/><main class="main"><section class="hero"><div><h1>{copy.title}</h1><p>{copy.lead}</p></div><div class="terms">{copy.terms}</div></section><section class="tools"><input id="search" type="search" placeholder={copy.search}/><select id="category"><option value="">{copy.category}: {copy.all}</option></select><select id="tag"><option value="">{copy.tag}: {copy.all}</option></select><select id="sort"><option value="new">{copy.newest}</option><option value="popular">{copy.popular}</option></select></section><div class="platforms" id="platforms"></div><div class="summary"><span id="resultCount">0 {copy.count}</span></div><section id="grid" class="grid"><div class="empty">{copy.loading}</div></section><div id="sentinel" class="empty" hidden>{copy.more}</div></main><script define:vars={{locale,prefix,labels,copy}}>const $=id=>document.getElementById(id),grid=$('grid'),search=$('search'),category=$('category'),tag=$('tag'),sort=$('sort'),platforms=$('platforms'),resultCount=$('resultCount'),sentinel=$('sentinel');let activePlatform='',offset=0,hasMore=true,loading=false,facetsReady=false,requestId=0;const PAGE=24,esc=(v='')=>String(v).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])),label=v=>labels[v]||v,localized=a=>a.locales?.[locale]||a.locales?.[locale==='zh-cn'?'zh-tw':'en']||a.locales?.ja||{},tags=a=>[...(a.platforms||[]),...(a.types||[]),...(a.motifs||[]),...(a.styles||[])];function card(a){const l=localized(a),chips=tags(a).slice(0,4).map(v=>`<span class="chip">${esc(label(v))}</span>`).join(''),href=`${prefix}/free/${encodeURIComponent(a.slug)}/`;return `<article class="card"><a class="thumb" href="${href}"><img loading="lazy" src="/api/free-preview?variant=thumb&slug=${encodeURIComponent(a.slug)}" alt="${esc(l.alt||l.title||a.slug)}"></a><div class="body"><h2><a href="${href}">${esc(l.title||a.slug)}</a></h2><p>${esc(l.description||l.metaDescription||'')}</p><div class="chips">${chips}</div></div></article>`}function facets(f){if(facetsReady)return;facetsReady=true;platforms.innerHTML=['',...(f.platforms||[])].map(v=>`<button data-v="${esc(v)}">${v?esc(label(v)):esc(copy.all)}</button>`).join('');platforms.querySelectorAll('button').forEach(b=>b.onclick=()=>{activePlatform=b.dataset.v;platforms.querySelectorAll('button').forEach(x=>x.classList.toggle('active',x===b));reset()});const cats=[...new Set([...(f.types||[]),...(f.motifs||[])])].sort();category.innerHTML=`<option value="">${esc(copy.category)}: ${esc(copy.all)}</option>`+cats.map(v=>`<option value="${esc(v)}">${esc(label(v))}</option>`).join('');tag.innerHTML=`<option value="">${esc(copy.tag)}: ${esc(copy.all)}</option>`+(f.styles||[]).map(v=>`<option value="${esc(v)}">${esc(label(v))}</option>`).join('')}async function load(reset=false){if(loading||(!hasMore&&!reset))return;loading=true;const id=++requestId;if(reset){offset=0;hasMore=true;grid.innerHTML=`<div class="empty">${esc(copy.loading)}</div>`}const p=new URLSearchParams({locale,limit:String(PAGE),offset:String(offset),q:search.value.trim(),platform:activePlatform,category:category.value,style:tag.value,sort:sort.value});try{const r=await fetch(`/api/free-list?${p}`),j=await r.json();if(id!==requestId)return;if(!r.ok)throw new Error();facets(j.facets||{});const rows=j.assets||[];resultCount.textContent=`${Number(j.total||0)} ${copy.count}`;if(reset)grid.innerHTML='';if(!rows.length&&offset===0)grid.innerHTML=`<div class="empty">${esc(copy.empty)}</div>`;else grid.insertAdjacentHTML('beforeend',rows.map(card).join(''));offset=Number(j.nextOffset||offset+rows.length);hasMore=Boolean(j.hasMore);sentinel.hidden=!hasMore}catch{if(reset)grid.innerHTML=`<div class="empty">${esc(copy.empty)}</div>`;hasMore=false}finally{loading=false}}function reset(){requestId++;loading=false;load(true)}let timer;search.oninput=()=>{clearTimeout(timer);timer=setTimeout(reset,250)};[category,tag,sort].forEach(x=>x.onchange=reset);new IntersectionObserver(e=>{if(e.some(x=>x.isIntersecting))load()},{rootMargin:'600px'}).observe(sentinel);load(true);</script></body></html>
