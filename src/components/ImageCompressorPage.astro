---
import SiteHeader from "./SiteHeader.astro";
const locale = Astro.props.locale || "ja";
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>画像圧縮・PNG/JPG/WebP変換・リサイズを無料で | stamp moke</title>
  <meta name="description" content="画像をアップロードせず、ブラウザだけでPNG・JPG・WebPの圧縮、形式変換、リサイズ、透過余白トリミングができる無料画像ツール。LINEスタンプ370×320pxにも対応。" />
  <link rel="canonical" href="https://stamp-moke.jp/image-compressor/" />
  <style>
    :root{--ink:#1d1d1f;--muted:#6e6e73;--line:#e8e8ec;--soft:#f6f6f8;--accent:#ff6b4a;--accent2:#ff8c6f;--good:#178a52;--card:#fff;--shadow:0 16px 50px rgba(0,0,0,.08)}
    *{box-sizing:border-box}body{margin:0;color:var(--ink);background:linear-gradient(180deg,#fff 0,#fafafa 38%,#f6f6f8 100%);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.wrap{width:min(1180px,calc(100% - 28px));margin:0 auto}.hero{padding:58px 0 26px}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.16em;color:var(--accent);text-transform:uppercase}.hero h1{font-size:clamp(32px,6vw,64px);line-height:1.05;margin:12px 0 16px;letter-spacing:-.04em}.hero p{max-width:760px;color:var(--muted);font-size:16px;line-height:1.9;margin:0}.badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.badge{padding:8px 12px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:12px;font-weight:700}.privacy{margin:24px 0 0;padding:14px 16px;border-radius:16px;background:#effaf4;border:1px solid #cdeedc;color:#17633d;font-size:13px;font-weight:700}.grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:22px;padding:22px 0 72px}.card{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.main-card{padding:22px}.side-card{padding:20px;position:sticky;top:18px;height:max-content}.drop{display:block;border:2px dashed #d6d6dc;border-radius:22px;background:var(--soft);padding:40px 20px;text-align:center;cursor:pointer;transition:.2s}.drop.drag{border-color:var(--accent);background:#fff4f0}.drop strong{display:block;font-size:20px;margin-bottom:7px}.drop span{color:var(--muted);font-size:13px}.drop input{display:none}.toolbar{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:20px}.field{display:flex;flex-direction:column;gap:7px}.field label{font-size:12px;font-weight:800;color:#48484c}.field select,.field input[type=number]{width:100%;border:1px solid var(--line);background:#fff;border-radius:12px;padding:11px 12px;font:inherit}.quality-row{display:flex;gap:10px;align-items:center}.quality-row input{width:100%}.quality-value{min-width:42px;font-size:12px;font-weight:800}.checks{display:grid;gap:10px;margin-top:16px}.check{display:flex;align-items:flex-start;gap:10px;font-size:13px;line-height:1.5}.check input{margin-top:3px}.preset{margin-top:18px;padding:15px;border-radius:16px;background:#fff7f3;border:1px solid #ffd9cd}.preset strong{display:block;font-size:13px;margin-bottom:5px}.preset p{margin:0 0 10px;color:var(--muted);font-size:12px;line-height:1.6}.btn{appearance:none;border:0;border-radius:13px;padding:11px 15px;font-weight:800;cursor:pointer}.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff}.btn-sub{background:#fff;border:1px solid var(--line);color:var(--ink)}.btn:disabled{opacity:.45;cursor:not-allowed}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.result-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin:28px 0 12px}.result-head h2{font-size:18px;margin:0}.result-list{display:grid;gap:12px}.result{display:grid;grid-template-columns:88px minmax(0,1fr) auto;gap:14px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:16px}.thumb{width:88px;height:72px;border-radius:12px;background:linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%);background-size:16px 16px;background-position:0 0,0 8px,8px -8px,-8px 0;overflow:hidden}.thumb img{width:100%;height:100%;object-fit:contain}.meta{min-width:0}.name{font-size:13px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sizes{font-size:12px;color:var(--muted);margin-top:5px}.saved{font-size:12px;color:var(--good);font-weight:800;margin-top:4px}.download{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;background:#111;color:#fff;border-radius:11px;padding:9px 12px;font-size:12px;font-weight:800}.empty{padding:28px;text-align:center;color:var(--muted);font-size:13px;border:1px dashed var(--line);border-radius:16px}.side-card h2{font-size:17px;margin:0 0 14px}.side-card ul{padding-left:20px;margin:0;color:var(--muted);font-size:13px;line-height:1.9}.notice{margin-top:16px;padding:13px;border-radius:14px;background:var(--soft);font-size:12px;color:var(--muted);line-height:1.7}.stat{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}.stat div{padding:12px;border-radius:14px;background:var(--soft)}.stat b{display:block;font-size:18px}.stat span{font-size:11px;color:var(--muted)}@media(max-width:840px){.grid{grid-template-columns:1fr}.side-card{position:static;order:-1}.toolbar{grid-template-columns:1fr 1fr}}@media(max-width:560px){.hero{padding-top:36px}.main-card,.side-card{padding:15px}.toolbar{grid-template-columns:1fr}.result{grid-template-columns:72px minmax(0,1fr);}.thumb{width:72px;height:64px}.result .download{grid-column:1/-1}.actions .btn{flex:1}.drop{padding:30px 14px}}
  </style>
</head>
<body>
  <SiteHeader locale={locale} />
  <main class="wrap">
    <section class="hero">
      <div class="eyebrow">IMAGE TOOL / stamp moke</div>
      <h1>画像を軽く、整えて、<br>すぐ保存。</h1>
      <p>PNG・JPG・WebPの圧縮、形式変換、画像サイズ変更、透過余白の自動トリミングをひとつにまとめた無料ツールです。LINEスタンプ向けの370×320pxにもワンクリックで整えられます。</p>
      <div class="badges"><span class="badge">無料</span><span class="badge">登録不要</span><span class="badge">複数画像対応</span><span class="badge">PNG / JPG / WebP</span><span class="badge">LINEスタンプ対応</span></div>
      <div class="privacy">🔒 画像はサーバーへ送信しません。すべてあなたのブラウザ内で処理します。</div>
    </section>

    <section class="grid">
      <div class="card main-card">
        <label class="drop" id="dropZone">
          <input id="fileInput" type="file" accept="image/png,image/jpeg,image/webp" multiple />
          <strong>画像を選ぶ / ここにドロップ</strong>
          <span>PNG・JPG・WebP / 1枚25MBまで / 最大20枚</span>
        </label>

        <div class="toolbar">
          <div class="field"><label for="format">保存形式</label><select id="format"><option value="original">元の形式を維持</option><option value="image/png">PNG</option><option value="image/jpeg">JPG</option><option value="image/webp">WebP</option></select></div>
          <div class="field"><label for="resizeMode">サイズ変更</label><select id="resizeMode"><option value="original">変更しない</option><option value="width">横幅を指定</option><option value="custom">縦横を指定</option></select></div>
          <div class="field"><label for="width">横幅 px</label><input id="width" type="number" min="1" max="8000" placeholder="例: 1200" disabled /></div>
          <div class="field"><label for="height">高さ px</label><input id="height" type="number" min="1" max="8000" placeholder="例: 800" disabled /></div>
        </div>

        <div class="field" style="margin-top:16px"><label>圧縮品質（JPG / WebP）</label><div class="quality-row"><input id="quality" type="range" min="30" max="100" value="82" /><span class="quality-value" id="qualityValue">82%</span></div></div>
        <div class="checks"><label class="check"><input id="trim" type="checkbox" /> <span><b>透過余白を自動トリミング</b><br>透明ピクセルだけの外側余白を削除します。</span></label><label class="check"><input id="keepRatio" type="checkbox" checked /> <span><b>縦横比を維持</b><br>横幅だけを指定した場合は自動で高さを計算します。</span></label></div>

        <div class="preset"><strong>LINEスタンプ用 370×320px</strong><p>画像の比率を壊さず、370×320pxの透明キャンバス内に最大サイズで配置します。透過PNGで保存されます。</p><button class="btn btn-sub" id="linePreset" type="button">LINEスタンプ設定にする</button></div>

        <div class="actions"><button class="btn btn-primary" id="processBtn" type="button" disabled>画像を処理する</button><button class="btn btn-sub" id="clearBtn" type="button" disabled>すべてクリア</button><button class="btn btn-sub" id="downloadAll" type="button" disabled>全部保存</button></div>

        <div class="result-head"><h2>処理結果</h2><span id="statusText" style="font-size:12px;color:var(--muted)"></span></div>
        <div id="resultList" class="result-list"><div class="empty">画像を選ぶと、ここに結果が表示されます。</div></div>
      </div>

      <aside class="card side-card">
        <h2>できること</h2>
        <ul><li>JPG・WebPを画質調整して容量削減</li><li>PNG / JPG / WebPへ形式変換</li><li>横幅指定・縦横指定でリサイズ</li><li>透過PNGの透明余白を自動削除</li><li>LINEスタンプ用370×320pxへ整形</li><li>複数画像をまとめて処理</li></ul>
        <div class="stat"><div><b id="totalBefore">0 B</b><span>処理前 合計</span></div><div><b id="totalAfter">0 B</b><span>処理後 合計</span></div></div>
        <div class="notice">JPGは透明背景を保持できないため、透明部分は白になります。PNGは画像内容によってはCanvas再保存で容量が増えることがあります。容量削減を優先する場合はWebPがおすすめです。</div>
      </aside>
    </section>
  </main>

<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const input=$('fileInput'),drop=$('dropZone'),format=$('format'),resizeMode=$('resizeMode'),width=$('width'),height=$('height'),quality=$('quality'),qualityValue=$('qualityValue'),trim=$('trim'),keepRatio=$('keepRatio'),processBtn=$('processBtn'),clearBtn=$('clearBtn'),downloadAll=$('downloadAll'),linePreset=$('linePreset'),resultList=$('resultList'),statusText=$('statusText'),totalBefore=$('totalBefore'),totalAfter=$('totalAfter');
  let files=[]; let results=[]; let lineMode=false;
  const MAX_FILES=20, MAX_SIZE=25*1024*1024;
  function bytes(n){if(!n)return'0 B';const u=['B','KB','MB','GB'];const i=Math.min(Math.floor(Math.log(n)/Math.log(1024)),u.length-1);return`${(n/Math.pow(1024,i)).toFixed(i?1:0)} ${u[i]}`}
  function extFor(type){return type==='image/png'?'png':type==='image/webp'?'webp':'jpg'}
  function safeBase(name){return name.replace(/\.[^.]+$/,'').replace(/[^a-zA-Z0-9_\-ぁ-んァ-ヶ一-龠]/g,'_')||'image'}
  function syncButtons(){processBtn.disabled=!files.length;clearBtn.disabled=!files.length&&!results.length;downloadAll.disabled=!results.length;totalBefore.textContent=bytes(files.reduce((s,f)=>s+f.size,0));totalAfter.textContent=bytes(results.reduce((s,r)=>s+r.blob.size,0))}
  function setFiles(list){const accepted=[...list].filter(f=>/^image\/(png|jpeg|webp)$/.test(f.type)&&f.size<=MAX_SIZE).slice(0,MAX_FILES);files=accepted;results.forEach(r=>URL.revokeObjectURL(r.url));results=[];resultList.innerHTML=accepted.length?`<div class="empty">${accepted.length}枚選択中。設定を確認して「画像を処理する」を押してください。</div>`:'<div class="empty">画像を選ぶと、ここに結果が表示されます。</div>';statusText.textContent=[...list].length>accepted.length?'一部のファイルは形式・容量・枚数制限により除外しました。':'';syncButtons()}
  input.addEventListener('change',()=>setFiles(input.files));
  ['dragenter','dragover'].forEach(e=>drop.addEventListener(e,ev=>{ev.preventDefault();drop.classList.add('drag')}));
  ['dragleave','drop'].forEach(e=>drop.addEventListener(e,ev=>{ev.preventDefault();drop.classList.remove('drag')}));
  drop.addEventListener('drop',ev=>setFiles(ev.dataTransfer.files));
  quality.addEventListener('input',()=>qualityValue.textContent=`${quality.value}%`);
  resizeMode.addEventListener('change',()=>{lineMode=false;width.disabled=resizeMode.value==='original';height.disabled=resizeMode.value!=='custom';if(resizeMode.value==='original'){width.value='';height.value=''}});
  linePreset.addEventListener('click',()=>{lineMode=true;format.value='image/png';resizeMode.value='custom';width.disabled=false;height.disabled=false;width.value='370';height.value='320';keepRatio.checked=true;statusText.textContent='LINEスタンプ設定：370×320px・PNG・比率維持';});
  clearBtn.addEventListener('click',()=>{files=[];input.value='';results.forEach(r=>URL.revokeObjectURL(r.url));results=[];resultList.innerHTML='<div class="empty">画像を選ぶと、ここに結果が表示されます。</div>';statusText.textContent='';lineMode=false;syncButtons()});
  function load(file){return new Promise((resolve,reject)=>{const url=URL.createObjectURL(file);const img=new Image();img.onload=()=>{URL.revokeObjectURL(url);resolve(img)};img.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('load'))};img.src=url})}
  function trimBounds(img){const c=document.createElement('canvas');c.width=img.naturalWidth;c.height=img.naturalHeight;const x=c.getContext('2d',{willReadFrequently:true});x.drawImage(img,0,0);const d=x.getImageData(0,0,c.width,c.height).data;let minX=c.width,minY=c.height,maxX=-1,maxY=-1;for(let y=0;y<c.height;y++){for(let xx=0;xx<c.width;xx++){if(d[(y*c.width+xx)*4+3]>2){if(xx<minX)minX=xx;if(xx>maxX)maxX=xx;if(y<minY)minY=y;if(y>maxY)maxY=y}}}if(maxX<0)return{x:0,y:0,w:c.width,h:c.height};return{x:minX,y:minY,w:maxX-minX+1,h:maxY-minY+1}}
  function canvasBlob(canvas,type,q){return new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error('blob')),type,q))}
  async function processOne(file){const img=await load(file);const src=trim.checked?trimBounds(img):{x:0,y:0,w:img.naturalWidth,h:img.naturalHeight};let outW=src.w,outH=src.h;const mode=resizeMode.value;
    if(lineMode){outW=370;outH=320}
    else if(mode==='width'&&+width.value>0){outW=Math.min(8000,+width.value);outH=keepRatio.checked?Math.max(1,Math.round(src.h*outW/src.w)):src.h}
    else if(mode==='custom'&&+width.value>0&&+height.value>0){outW=Math.min(8000,+width.value);outH=Math.min(8000,+height.value)}
    const outType=lineMode?'image/png':(format.value==='original'?(file.type==='image/jpeg'?'image/jpeg':file.type):format.value);
    const canvas=document.createElement('canvas');canvas.width=outW;canvas.height=outH;const ctx=canvas.getContext('2d');ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';
    if(outType==='image/jpeg'){ctx.fillStyle='#fff';ctx.fillRect(0,0,outW,outH)}
    if(lineMode||((mode==='custom')&&keepRatio.checked)){const scale=Math.min(outW/src.w,outH/src.h);const dw=Math.max(1,Math.round(src.w*scale)),dh=Math.max(1,Math.round(src.h*scale));ctx.drawImage(img,src.x,src.y,src.w,src.h,Math.round((outW-dw)/2),Math.round((outH-dh)/2),dw,dh)}else{ctx.drawImage(img,src.x,src.y,src.w,src.h,0,0,outW,outH)}
    const blob=await canvasBlob(canvas,outType,Math.max(.3,Math.min(1,+quality.value/100)));const url=URL.createObjectURL(blob);return{file,blob,url,w:outW,h:outH,type:outType,name:`${safeBase(file.name)}-optimized.${extFor(outType)}`}
  }
  function render(){resultList.innerHTML='';for(const r of results){const saved=r.file.size-r.blob.size,rate=Math.round((1-r.blob.size/r.file.size)*100);const row=document.createElement('div');row.className='result';row.innerHTML=`<div class="thumb"><img src="${r.url}" alt=""></div><div class="meta"><div class="name"></div><div class="sizes">${bytes(r.file.size)} → ${bytes(r.blob.size)} ・ ${r.w}×${r.h}px</div><div class="saved">${saved>0?`${rate}% 削減 / ${bytes(saved)} 軽量化`:'変換・整形完了'}</div></div><a class="download" download="${r.name}" href="${r.url}">保存</a>`;row.querySelector('.name').textContent=r.file.name;resultList.appendChild(row)}syncButtons()}
  processBtn.addEventListener('click',async()=>{processBtn.disabled=true;statusText.textContent='処理中…';results.forEach(r=>URL.revokeObjectURL(r.url));results=[];let ok=0;for(let i=0;i<files.length;i++){statusText.textContent=`処理中… ${i+1}/${files.length}`;try{results.push(await processOne(files[i]));ok++}catch(e){console.warn(e)}}render();statusText.textContent=`${ok}枚の処理が完了しました。`});
  downloadAll.addEventListener('click',async()=>{for(const r of results){const a=document.createElement('a');a.href=r.url;a.download=r.name;document.body.appendChild(a);a.click();a.remove();await new Promise(res=>setTimeout(res,220))}});
  syncButtons();
})();
</script>
</body>
</html>
