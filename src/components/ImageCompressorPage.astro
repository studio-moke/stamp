---
import SiteHeader from "./SiteHeader.astro";
const locale = Astro.props.locale || "ja";
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>画像圧縮・PNG/JPG/WebP変換・リサイズを無料で | stamp moke</title>
<meta name="description" content="PNG・JPG・WebP画像をブラウザだけで圧縮、リサイズ、形式変換、透過余白トリミング。画像はサーバーへ送信せず、複数画像も無料で処理できます。" />
<link rel="canonical" href="https://stamp-moke.jp/image-compressor/" />
<style>
*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.wrap{max-width:1120px;margin:auto;padding:38px 22px 90px}.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:end;margin-bottom:28px}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.2em;color:#777;margin-bottom:12px}.hero h1{font-size:clamp(38px,5.4vw,70px);line-height:1.01;letter-spacing:-.055em;margin:0}.hero p{font-size:13px;line-height:1.85;color:#666;max-width:720px}.privacy{background:#171717;color:#fff;border-radius:20px;padding:19px 21px;font-size:11px;line-height:1.75}.privacy strong{display:block;font-size:14px;margin-bottom:4px}.task-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:15px}.task{appearance:none;border:1px solid #deddd8;background:#fff;border-radius:17px;padding:16px;text-align:left;cursor:pointer;transition:.18s;color:#171717}.task:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(0,0,0,.05)}.task.active{background:#171717;color:#fff;border-color:#171717}.task b{display:block;font-size:13px;margin-bottom:5px}.task span{font-size:9px;color:#888}.task.active span{color:#bbb}.panel{background:#fff;border:1px solid #deddd8;border-radius:22px;box-shadow:0 12px 34px rgba(35,32,23,.055)}.drop{min-height:220px;padding:28px;border:2px dashed #cbc9c1;border-radius:22px;display:flex;align-items:center;justify-content:center;text-align:center;background:#fbfaf7;cursor:pointer;transition:.18s}.drop.drag{background:#f0eee6;border-color:#777}.drop input{display:none}.drop-icon{width:54px;height:54px;border-radius:16px;background:#171717;color:#fff;display:grid;place-items:center;margin:0 auto 14px;font-size:24px}.drop strong{display:block;font-size:18px;margin-bottom:7px}.drop span{font-size:10px;color:#777}.workspace{display:none;margin-top:15px}.workspace.show{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(300px,.92fr);gap:15px}.files-panel,.settings,.results{padding:16px}.files-head,.settings-head,.results-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.files-head h2,.settings-head h2,.results-head h2{font-size:17px;margin:0}.muted{font-size:9px;color:#888}.file-list{display:grid;gap:8px;max-height:470px;overflow:auto;padding-right:3px}.file-row{display:grid;grid-template-columns:54px minmax(0,1fr) auto;gap:10px;align-items:center;border:1px solid #e2e0da;border-radius:13px;padding:8px}.thumb{width:54px;height:54px;border-radius:9px;object-fit:contain;background:linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%);background-size:12px 12px;background-position:0 0,0 6px,6px -6px,-6px 0}.file-meta{min-width:0}.file-name{font-size:10px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.file-size{font-size:9px;color:#888;margin-top:4px}.remove{border:0;background:#f1f0eb;border-radius:999px;width:28px;height:28px;cursor:pointer;font-size:14px}.setting-group{display:grid;gap:12px}.field{display:grid;gap:6px}.field label{font-size:10px;font-weight:900}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.select,.input{width:100%;border:1px solid #d9d7d1;background:#fff;border-radius:11px;padding:10px 11px;font:inherit;font-size:11px}.range-wrap{display:grid;grid-template-columns:1fr 48px;align-items:center;gap:9px}.range{width:100%;accent-color:#171717}.range-value{font-size:10px;font-weight:900;text-align:right}.check{display:flex;align-items:center;gap:8px;font-size:10px;font-weight:800}.notice{font-size:9px;line-height:1.65;color:#777;background:#f5f4ef;border-radius:11px;padding:10px 11px}.run{width:100%;border:0;border-radius:13px;background:#171717;color:#fff;padding:13px 16px;font-size:11px;font-weight:900;cursor:pointer}.run:disabled{opacity:.45;cursor:wait}.line-preset{margin-top:12px;padding:12px;border:1px solid #e5e1d8;background:#fbfaf7;border-radius:13px}.line-preset strong{display:block;font-size:10px;margin-bottom:5px}.line-preset p{font-size:9px;line-height:1.6;color:#777;margin:0 0 8px}.ghost{border:1px solid #d8d7d1;background:#fff;border-radius:10px;padding:8px 11px;font-size:9px;font-weight:900;cursor:pointer}.results{display:none;margin-top:15px}.results.show{display:block}.results-actions{display:flex;gap:7px;flex-wrap:wrap}.result-list{display:grid;gap:9px}.result-row{display:grid;grid-template-columns:58px minmax(0,1fr) auto;gap:11px;align-items:center;border:1px solid #e1dfd8;border-radius:14px;padding:9px}.result-stats{display:flex;gap:10px;flex-wrap:wrap;margin-top:5px;font-size:9px;color:#777}.saved{font-weight:900;color:#171717}.download{border:0;background:#171717;color:#fff;border-radius:10px;padding:8px 10px;font-size:9px;font-weight:900;cursor:pointer}.error{font-size:9px;color:#9b3028}.helper{margin-top:22px;border-top:1px solid #ddd9d1;padding-top:16px;font-size:10px;color:#777;line-height:1.7}@media(max-width:820px){.hero,.workspace{grid-template-columns:1fr}.task-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.wrap{padding:27px 11px 70px}.hero h1{font-size:42px}.task-grid{gap:7px}.task{padding:13px 12px;border-radius:14px}.drop{min-height:185px;padding:20px}.files-panel,.settings,.results{padding:11px}.result-row{grid-template-columns:48px minmax(0,1fr)}.result-row .download{grid-column:1/-1;width:100%}.thumb{width:48px;height:48px}.file-row{grid-template-columns:48px minmax(0,1fr) auto}}
</style>
</head>
<body>
<SiteHeader locale={locale} />
<main class="wrap">
<section class="hero"><div><div class="eyebrow">IMAGE TOOLS</div><h1>画像を、かんたんに軽く。</h1><p>最初に「やりたいこと」を1つ選んで、画像を入れるだけ。圧縮・リサイズ・形式変換・透過余白の自動トリミングを、必要な設定だけ見ながら処理できます。</p></div><aside class="privacy"><strong>画像はサーバーへ送信しません。</strong>すべてこの端末のブラウザ内だけで処理します。ページを閉じると画像データは残りません。</aside></section>
<section class="task-grid" id="taskGrid"><button class="task active" data-mode="compress"><b>容量を軽くする</b><span>JPG / PNG / WebP</span></button><button class="task" data-mode="resize"><b>サイズを変更する</b><span>幅・高さを指定</span></button><button class="task" data-mode="convert"><b>形式を変換する</b><span>PNG / JPG / WebP</span></button><button class="task" data-mode="trim"><b>透過余白を切る</b><span>透明部分を自動検出</span></button></section>
<section><label class="drop panel" id="drop"><input id="file" type="file" accept="image/png,image/jpeg,image/webp" multiple /><div><div class="drop-icon">＋</div><strong>画像をここにドロップ</strong><span>またはクリックして選択 · 複数画像OK · 最大20枚</span></div></label></section>
<section class="workspace" id="workspace"><div class="panel files-panel"><div class="files-head"><h2>選択中</h2><span class="muted" id="fileCount">0枚</span></div><div class="file-list" id="fileList"></div></div><aside class="panel settings"><div class="settings-head"><h2>設定</h2><span class="muted" id="modeLabel">容量を軽くする</span></div><div class="setting-group"><div class="field" id="qualityField"><label>画質</label><div class="range-wrap"><input class="range" id="quality" type="range" min="35" max="95" value="78" /><span class="range-value" id="qualityValue">78%</span></div></div><div class="field-row" id="sizeFields"><div class="field"><label>最大幅</label><input class="input" id="maxWidth" type="number" min="1" max="8000" placeholder="自動" /></div><div class="field"><label>最大高さ</label><input class="input" id="maxHeight" type="number" min="1" max="8000" placeholder="自動" /></div></div><div class="field" id="formatField"><label>出力形式</label><select class="select" id="format"><option value="same">元の形式</option><option value="image/webp">WebP</option><option value="image/jpeg">JPG</option><option value="image/png">PNG</option></select></div><div class="field" id="paddingField" style="display:none"><label>残す余白</label><select class="select" id="padding"><option value="0">0 px</option><option value="4">4 px</option><option value="8" selected>8 px</option><option value="16">16 px</option><option value="24">24 px</option></select></div><div class="notice">PNGは画像内容によって容量が小さくならない場合があります。透明画像はWebP変換で軽くなることがあります。</div><button class="run" id="run">画像を処理する</button></div><div class="line-preset"><strong>LINEスタンプ用 370×320px</strong><p>比率を保ったまま透明キャンバス内に収め、PNGで保存します。</p><button class="ghost" id="linePreset" type="button">この設定を使う</button></div></aside></section>
<section class="panel results" id="results"><div class="results-head"><h2>処理結果</h2><div class="results-actions"><button class="ghost" id="downloadAll">まとめて保存</button><button class="ghost" id="again">別の画像を選ぶ</button></div></div><div class="result-list" id="resultList"></div></section>
<div class="helper">PNG / JPG / WebP · ブラウザ内処理 · サーバー送信なし · 登録不要</div>
</main>
<script is:inline>
(()=>{const $=id=>document.getElementById(id);const file=$("file"),drop=$("drop"),workspace=$("workspace"),fileList=$("fileList"),fileCount=$("fileCount"),taskGrid=$("taskGrid"),quality=$("quality"),qualityValue=$("qualityValue"),maxWidth=$("maxWidth"),maxHeight=$("maxHeight"),format=$("format"),padding=$("padding"),qualityField=$("qualityField"),sizeFields=$("sizeFields"),formatField=$("formatField"),paddingField=$("paddingField"),run=$("run"),results=$("results"),resultList=$("resultList"),downloadAll=$("downloadAll"),again=$("again"),modeLabel=$("modeLabel"),linePreset=$("linePreset");let mode="compress",files=[],outputs=[],lineMode=false;const human=n=>n<1024?n+" B":n<1048576?(n/1024).toFixed(1)+" KB":(n/1048576).toFixed(2)+" MB";const ext=t=>t==="image/png"?"png":t==="image/jpeg"?"jpg":"webp";const safeName=(name,t)=>name.replace(/\.[^.]+$/,"")+"-optimized."+ext(t);const readImage=f=>new Promise((res,rej)=>{const u=URL.createObjectURL(f),img=new Image();img.onload=()=>{URL.revokeObjectURL(u);res(img)};img.onerror=()=>{URL.revokeObjectURL(u);rej(new Error("load"))};img.src=u});const toBlob=(c,t,q)=>new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error("blob")),t,q));const labels={compress:"容量を軽くする",resize:"サイズを変更する",convert:"形式を変換する",trim:"透過余白を切る"};
function updateMode(){document.querySelectorAll('.task').forEach(b=>b.classList.toggle('active',b.dataset.mode===mode));modeLabel.textContent=labels[mode];qualityField.style.display=(mode==='compress'||mode==='convert')?'grid':'none';sizeFields.style.display=(mode==='resize'||mode==='compress')?'grid':'none';formatField.style.display=mode==='trim'?'none':'grid';paddingField.style.display=mode==='trim'?'grid':'none';if(mode==='compress'&&format.value==='same')format.value='image/webp';if(mode==='convert'&&format.value==='same')format.value='image/webp';lineMode=false}
function renderFiles(){fileCount.textContent=files.length+'枚';fileList.innerHTML='';files.forEach((f,i)=>{const row=document.createElement('div');row.className='file-row';const u=URL.createObjectURL(f);row.innerHTML=`<img class="thumb" src="${u}"><div class="file-meta"><div class="file-name"></div><div class="file-size">${human(f.size)} · ${f.type.replace('image/','').toUpperCase()}</div></div><button class="remove" type="button">×</button>`;row.querySelector('.file-name').textContent=f.name;row.querySelector('img').onload=()=>URL.revokeObjectURL(u);row.querySelector('.remove').onclick=()=>{files.splice(i,1);renderFiles();if(!files.length){workspace.classList.remove('show');results.classList.remove('show')}};fileList.appendChild(row)});workspace.classList.toggle('show',files.length>0)}
function addFiles(list){const good=[...list].filter(f=>/^image\/(png|jpeg|webp)$/.test(f.type)&&f.size<=25*1024*1024);files=[...files,...good].slice(0,20);renderFiles();results.classList.remove('show')}
function cropBounds(ctx,w,h){const d=ctx.getImageData(0,0,w,h).data;let minX=w,minY=h,maxX=-1,maxY=-1;for(let y=0;y<h;y++){for(let x=0;x<w;x++){if(d[(y*w+x)*4+3]>8){if(x<minX)minX=x;if(x>maxX)maxX=x;if(y<minY)minY=y;if(y>maxY)maxY=y}}}return maxX<0?{x:0,y:0,w,h}:{x:minX,y:minY,w:maxX-minX+1,h:maxY-minY+1}}
async function processOne(f){const img=await readImage(f);if(lineMode){const c=document.createElement('canvas');c.width=370;c.height=320;const x=c.getContext('2d');const s=Math.min(370/img.naturalWidth,320/img.naturalHeight);const w=Math.max(1,Math.round(img.naturalWidth*s)),h=Math.max(1,Math.round(img.naturalHeight*s));x.drawImage(img,Math.round((370-w)/2),Math.round((320-h)/2),w,h);const blob=await toBlob(c,'image/png',1);return{file:f,blob,type:'image/png',w:370,h:320,name:safeName(f.name,'image/png')}}let sx=0,sy=0,sw=img.naturalWidth,sh=img.naturalHeight,targetW=sw,targetH=sh;let outType=mode==='trim'?f.type:(format.value==='same'?f.type:format.value);if(mode==='trim'){const c0=document.createElement('canvas');c0.width=sw;c0.height=sh;const x0=c0.getContext('2d',{willReadFrequently:true});x0.drawImage(img,0,0);const b=cropBounds(x0,sw,sh),p=Number(padding.value)||0;sx=Math.max(0,b.x-p);sy=Math.max(0,b.y-p);sw=Math.min(img.naturalWidth-sx,b.w+p*2);sh=Math.min(img.naturalHeight-sy,b.h+p*2);targetW=sw;targetH=sh}else if(mode==='resize'||mode==='compress'){const mw=Number(maxWidth.value)||sw,mh=Number(maxHeight.value)||sh;const scale=Math.min(1,mw/sw,mh/sh);targetW=Math.max(1,Math.round(sw*scale));targetH=Math.max(1,Math.round(sh*scale))}const c=document.createElement('canvas');c.width=targetW;c.height=targetH;const x=c.getContext('2d');if(outType==='image/jpeg'){x.fillStyle='#fff';x.fillRect(0,0,targetW,targetH)}x.imageSmoothingEnabled=true;x.imageSmoothingQuality='high';x.drawImage(img,sx,sy,sw,sh,0,0,targetW,targetH);const blob=await toBlob(c,outType,Number(quality.value)/100);return{file:f,blob,type:outType,w:targetW,h:targetH,name:safeName(f.name,outType)}}
function saveOutput(o){const u=URL.createObjectURL(o.blob),a=document.createElement('a');a.href=u;a.download=o.name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),1200)}
function renderResults(){resultList.innerHTML='';outputs.forEach(o=>{const row=document.createElement('div');row.className='result-row';if(o.error){row.innerHTML=`<div></div><div><div class="file-name"></div><div class="error">この画像は処理できませんでした。</div></div>`;row.querySelector('.file-name').textContent=o.file.name;resultList.appendChild(row);return}const u=URL.createObjectURL(o.blob),pct=Math.round((1-o.blob.size/o.file.size)*100);row.innerHTML=`<img class="thumb" src="${u}"><div class="file-meta"><div class="file-name"></div><div class="result-stats"><span>元: ${human(o.file.size)}</span><span>処理後: ${human(o.blob.size)}</span><span>${o.w}×${o.h}</span><span class="saved">削減: ${pct>0?pct+'%':'—'}</span></div></div><button class="download">保存</button>`;row.querySelector('.file-name').textContent=o.name;row.querySelector('img').onload=()=>URL.revokeObjectURL(u);row.querySelector('.download').onclick=()=>saveOutput(o);resultList.appendChild(row)});results.classList.add('show');results.scrollIntoView({behavior:'smooth',block:'start'})}
async function processAll(){if(!files.length)return;run.disabled=true;run.textContent='処理中…';outputs=[];for(const f of files){try{outputs.push(await processOne(f))}catch(e){outputs.push({file:f,error:true})}}renderResults();run.disabled=false;run.textContent='画像を処理する'}
taskGrid.addEventListener('click',e=>{const b=e.target.closest('.task');if(!b)return;mode=b.dataset.mode;updateMode()});file.onchange=()=>addFiles(file.files);drop.addEventListener('dragover',e=>{e.preventDefault();drop.classList.add('drag')});drop.addEventListener('dragleave',()=>drop.classList.remove('drag'));drop.addEventListener('drop',e=>{e.preventDefault();drop.classList.remove('drag');addFiles(e.dataTransfer.files)});quality.oninput=()=>qualityValue.textContent=quality.value+'%';run.onclick=processAll;linePreset.onclick=()=>{lineMode=true;modeLabel.textContent='LINEスタンプ 370×320';document.querySelectorAll('.task').forEach(b=>b.classList.remove('active'));qualityField.style.display='none';sizeFields.style.display='none';formatField.style.display='none';paddingField.style.display='none'};downloadAll.onclick=async()=>{for(const o of outputs.filter(x=>x.blob)){saveOutput(o);await new Promise(r=>setTimeout(r,180))}};again.onclick=()=>{files=[];outputs=[];file.value='';renderFiles();results.classList.remove('show');drop.scrollIntoView({behavior:'smooth',block:'center'})};updateMode()})();
</script>
</body>
</html>
