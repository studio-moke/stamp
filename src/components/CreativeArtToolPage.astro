---
import SiteHeader from "./SiteHeader.astro";
const { locale="ja", tool="speed-lines" } = Astro.props;
const prefix = locale === "ja" ? "" : `/${locale}`;
const defs = {
  "speed-lines": { title:"漫画集中線メーカー", sub:"漫画の集中線PNGを自由に生成", desc:"線の本数・太さ・中心の空き・角度を調整して、透過PNGの集中線を作れます。", icon:"✹" },
  "speech-bubble": { title:"漫画フキダシメーカー", sub:"フキダシを自由に作ってPNG / SVG", desc:"丸・トゲ・叫び系のフキダシを作成。線幅やしっぽ位置も調整できます。", icon:"◯" },
  "manga-sfx": { title:"漫画効果音（擬音語）メーカー", sub:"ドン!!・ゴゴゴ・ズキュンを画像化", desc:"文字・縁取り・傾き・影を調整して、漫画風の効果音PNGを作れます。", icon:"ド" },
  "pop-art": { title:"ポップアートメーカー", sub:"写真を4分割ポップアートに変換", desc:"写真を選ぶだけで、鮮やかな4色のポップアート画像を作成します。", icon:"POP" },
  "pixel-art": { title:"ドット絵メーカー", sub:"写真やイラストをレトロなドット絵に", desc:"ドットサイズと色数を変えて、8bit・16bit風のPNG画像を作れます。", icon:"▦" },
  "sticker-maker": { title:"ステッカーメーカー", sub:"画像を白フチ付きステッカー風に", desc:"透明PNGなどにフチ・影・余白を付けて、ステッカー風画像を作成します。", icon:"★" }
};
const d = defs[tool] || defs["speed-lines"];
const nav = [
  ["speed-lines","集中線","manga-speed-lines"],
  ["speech-bubble","フキダシ","manga-speech-bubble"],
  ["manga-sfx","効果音","manga-sfx"],
  ["pop-art","ポップアート","pop-art-maker"],
  ["pixel-art","ドット絵","pixel-art-maker"],
  ["sticker-maker","ステッカー","sticker-maker"]
];
const slug = nav.find(n=>n[0]===tool)?.[2] || "manga-speed-lines";
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{d.title}｜無料・登録不要 | stamp moke</title><meta name="description" content={d.desc}/><link rel="canonical" href={`https://stamp-moke.jp${prefix}/${slug}/`}/>
<style>
*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Sans","Yu Gothic",sans-serif}.wrap{max-width:1080px;margin:auto;padding:34px 18px 80px}.crumb{font-size:11px;color:#777;margin-bottom:20px}.crumb a{color:inherit}.toolnav{display:flex;gap:7px;overflow:auto;padding:4px 0 18px}.toolnav a{white-space:nowrap;text-decoration:none;color:#555;background:#fff;border:1px solid #ddd;border-radius:999px;padding:9px 13px;font-size:10px;font-weight:800}.toolnav a.on{background:#171717;color:#fff}.hero{text-align:center;padding:18px 0 30px}.hero .icon{width:58px;height:58px;border-radius:18px;margin:0 auto 13px;display:grid;place-items:center;background:#171717;color:#fff;font-weight:950;font-size:18px}.hero h1{font-size:clamp(32px,6vw,58px);letter-spacing:-.05em;margin:0 0 10px}.hero .sub{font-weight:900;font-size:15px}.hero p{max-width:650px;margin:10px auto 0;color:#6a6a6a;font-size:12px;line-height:1.9}.app{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px;align-items:start}.preview{background:#fff;border:1px solid #ddd;border-radius:22px;padding:14px;min-width:0}.stage{position:relative;min-height:460px;border-radius:15px;overflow:hidden;background:linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0}.stage canvas{width:100%;height:auto;display:block}.controls{background:#fff;border:1px solid #ddd;border-radius:22px;padding:18px;position:sticky;top:14px}.controls h2{font-size:14px;margin:0 0 15px}.row{margin:0 0 15px}.row label{display:flex;justify-content:space-between;gap:10px;font-size:10px;font-weight:900;margin-bottom:7px}.row input[type=range]{width:100%}.row input[type=text],.row select,.row input[type=number]{width:100%;border:1px solid #ccc;border-radius:10px;padding:10px;background:#fff;font-size:12px}.row input[type=color]{width:100%;height:40px;border:1px solid #ccc;border-radius:10px;background:#fff;padding:3px}.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.seg button{border:1px solid #ccc;background:#fafafa;border-radius:9px;padding:8px 5px;font-size:9px;font-weight:900;cursor:pointer}.seg button.on{background:#171717;color:#fff}.upload{display:block;border:2px dashed #bbb;border-radius:13px;padding:14px 10px;text-align:center;cursor:pointer;font-size:10px;font-weight:900;margin-bottom:14px}.upload input{display:none}.actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}.actions button{border:0;border-radius:11px;padding:13px 8px;font-size:10px;font-weight:900;cursor:pointer}.download{background:#171717;color:white}.secondary{background:#eceae4;color:#171717}.note{font-size:9px;color:#888;line-height:1.6;margin-top:10px}.related{margin-top:48px}.related h2{font-size:20px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.related-grid a{background:#fff;border:1px solid #ddd;border-radius:14px;padding:14px;text-decoration:none;color:#171717;font-size:11px;font-weight:900}.hide{display:none!important}@media(max-width:800px){.app{grid-template-columns:1fr}.controls{position:static}.stage{min-height:0}.related-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.wrap{padding:22px 10px 55px}.preview{padding:8px;border-radius:16px}.controls{border-radius:16px;padding:14px}.hero{padding-top:8px}.related-grid{grid-template-columns:1fr}}
</style></head><body><SiteHeader locale={locale}/><main class="wrap"><div class="crumb"><a href={`${prefix}/`}>stamp moke</a> / <a href={`${prefix}/free/`}>無料ツール</a> / {d.title}</div><nav class="toolnav">{nav.map(n=><a class={n[0]===tool?'on':''} href={`${prefix}/${n[2]}/`}>{n[1]}</a>)}</nav><section class="hero"><div class="icon">{d.icon}</div><h1>{d.title}</h1><div class="sub">{d.sub}</div><p>{d.desc}<br/>画像はサーバーへ送信せず、この端末のブラウザ内で処理します。</p></section><section class="app"><div class="preview"><div class="stage"><canvas id="canvas" width="900" height="900"></canvas></div></div><aside class="controls"><h2>調整</h2><label class="upload" id="uploadBox"><input id="file" type="file" accept="image/*"/>画像を選択</label><div id="controls"></div><div class="actions"><button class="secondary" id="randomize">ランダム</button><button class="download" id="download">PNG保存</button></div><div class="actions" id="svgActions"><button class="secondary" id="downloadSvg">SVG保存</button></div><div class="note">無料・登録不要。商用素材として利用する場合は、アップロード画像や使用フォント等の権利をご確認ください。</div></aside></section><section class="related"><h2>ほかのクリエイティブツール</h2><div class="related-grid">{nav.filter(n=>n[0]!==tool).map(n=><a href={`${prefix}/${n[2]}/`}>{n[1]}メーカー →</a>)}</div></section></main>
<script is:inline define:vars={{tool}}>
(()=>{
const c=document.getElementById('canvas'),ctx=c.getContext('2d'),controls=document.getElementById('controls'),file=document.getElementById('file'),uploadBox=document.getElementById('uploadBox'),randomize=document.getElementById('randomize'),download=document.getElementById('download'),svgActions=document.getElementById('svgActions'),downloadSvg=document.getElementById('downloadSvg');let img=null,seed=7,bubbleType='burst';
const R=(id,min,max,val,label)=>`<div class="row"><label><span>${label}</span><b id="${id}v">${val}</b></label><input id="${id}" type="range" min="${min}" max="${max}" value="${val}"></div>`;
const C=(id,val,label)=>`<div class="row"><label><span>${label}</span></label><input id="${id}" type="color" value="${val}"></div>`;
const T=(id,val,label)=>`<div class="row"><label><span>${label}</span></label><input id="${id}" type="text" value="${val}"></div>`;
const S=(id,label,options)=>`<div class="row"><label><span>${label}</span></label><select id="${id}">${options}</select></div>`;
const ui={
 'speed-lines':()=>R('count',20,180,76,'線の本数')+R('width',1,10,3,'線の太さ')+R('gap',5,55,24,'中心の空き')+R('jitter',0,100,50,'ランダム感')+C('color','#111111','線の色'),
 'speech-bubble':()=>`<div class="row"><label><span>フキダシ形状</span></label><div class="seg"><button data-b="burst" class="on">トゲ</button><button data-b="oval">丸</button><button data-b="cloud">叫び</button></div></div>`+R('stroke',1,14,5,'線の太さ')+R('tail',10,90,72,'しっぽ位置')+C('color','#111111','線の色')+C('fill','#ffffff','塗り'),
 'manga-sfx':()=>T('text','ドン!!','文字')+R('size',80,360,240,'文字サイズ')+R('stroke',0,30,10,'縁取り')+R('angle',-30,30,-8,'傾き')+R('shadow',0,35,10,'影')+C('color','#111111','文字色')+C('outline','#ffffff','縁色'),
 'pop-art':()=>R('contrast',50,220,130,'コントラスト')+R('dots',0,14,4,'網点')+S('palette','カラースタイル','<option value="classic">クラシック</option><option value="neon">ネオン</option><option value="pastel">パステル</option>'),
 'pixel-art':()=>R('pixel',4,48,16,'ドットサイズ')+S('colors','色数','<option value="4">4色</option><option value="8">8色</option><option value="16" selected>16色</option><option value="32">32色</option>')+R('sat',40,180,110,'彩度'),
 'sticker-maker':()=>R('border',2,40,14,'フチの太さ')+R('padding',0,80,30,'余白')+R('shadow',0,40,12,'影')+C('borderColor','#ffffff','フチ色')
};controls.innerHTML=ui[tool]();svgActions.classList.toggle('hide',tool!=='speech-bubble');uploadBox.classList.toggle('hide',!['pop-art','pixel-art','sticker-maker'].includes(tool));randomize.classList.toggle('hide',['pop-art','pixel-art','sticker-maker'].includes(tool));
controls.querySelectorAll('input[type=range]').forEach(x=>x.oninput=()=>{const v=document.getElementById(x.id+'v');if(v)v.textContent=x.value;draw()});controls.querySelectorAll('input,select').forEach(x=>x.addEventListener('input',draw));controls.querySelectorAll('[data-b]').forEach(b=>b.onclick=()=>{bubbleType=b.dataset.b;controls.querySelectorAll('[data-b]').forEach(x=>x.classList.toggle('on',x===b));draw()});
function val(id,fallback=0){const e=document.getElementById(id);return e?+e.value:fallback}function str(id,fallback=''){const e=document.getElementById(id);return e?e.value:fallback}function rand(){seed=(seed*9301+49297)%233280;return seed/233280}function clear(){ctx.clearRect(0,0,c.width,c.height)}
function speed(){clear();const count=val('count',76),w=val('width',3),gap=val('gap',24)/100,jit=val('jitter',50)/100;ctx.strokeStyle=str('color','#111');ctx.lineCap='round';for(let i=0;i<count;i++){const a=(Math.PI*2*i/count)+(rand()-.5)*.09*jit;const r0=c.width*(gap*.45+rand()*.08*jit),r1=c.width*(.53+rand()*.18);ctx.beginPath();ctx.lineWidth=Math.max(1,w*(.55+rand()));ctx.moveTo(c.width/2+Math.cos(a)*r0,c.height/2+Math.sin(a)*r0);ctx.lineTo(c.width/2+Math.cos(a)*r1,c.height/2+Math.sin(a)*r1);ctx.stroke()}}
function bubblePath(){const cx=450,cy=410,rx=310,ry=235,pts=[];if(bubbleType==='oval')return `M ${cx-rx} ${cy} C ${cx-rx} ${cy-ry} ${cx+rx} ${cy-ry} ${cx+rx} ${cy} C ${cx+rx} ${cy+ry} ${cx-rx} ${cy+ry} ${cx-rx} ${cy} Z`;const n=bubbleType==='cloud'?28:22;for(let i=0;i<n;i++){const a=Math.PI*2*i/n;let mul;if(bubbleType==='cloud')mul=.91+.11*Math.sin(i*2.7);else mul=i%2?1:.78;pts.push([cx+Math.cos(a)*rx*mul,cy+Math.sin(a)*ry*mul])}return 'M '+pts.map(p=>p.join(' ')).join(' L ')+' Z'}
function bubbleSvg(){const stroke=val('stroke',5),tail=val('tail',72)/100,color=str('color','#111'),fill=str('fill','#fff'),tx=160+tail*580,ty=690;return `<svg xmlns="http://www.w3.org/2000/svg" width="900" height="900" viewBox="0 0 900 900"><path d="${bubblePath()}" fill="${fill}" stroke="${color}" stroke-width="${stroke}" stroke-linejoin="round"/><path d="M ${tx-55} 585 L ${tx} ${ty} L ${tx+35} 580" fill="${fill}" stroke="${color}" stroke-width="${stroke}" stroke-linejoin="round"/></svg>`}
function bubble(){const svg=bubbleSvg(),u='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg),im=new Image;im.onload=()=>{clear();ctx.drawImage(im,0,0)};im.src=u}
function sfx(){clear();const text=str('text','ドン!!'),size=val('size',240),sw=val('stroke',10),angle=val('angle',-8)*Math.PI/180,shadow=val('shadow',10);ctx.save();ctx.translate(450,450);ctx.rotate(angle);ctx.textAlign='center';ctx.textBaseline='middle';ctx.font=`900 ${size}px Impact, "Arial Black", sans-serif`;ctx.lineJoin='round';ctx.shadowColor='rgba(0,0,0,.35)';ctx.shadowBlur=shadow;ctx.shadowOffsetX=shadow*.65;ctx.shadowOffsetY=shadow*.65;if(sw){ctx.strokeStyle=str('outline','#fff');ctx.lineWidth=sw*2;ctx.strokeText(text,0,0)}ctx.fillStyle=str('color','#111');ctx.fillText(text,0,0);ctx.restore()}
function fitDraw(target,source,x,y,w,h){const r=Math.min(w/source.naturalWidth,h/source.naturalHeight),dw=source.naturalWidth*r,dh=source.naturalHeight*r;target.drawImage(source,x+(w-dw)/2,y+(h-dh)/2,dw,dh)}
function pop(){clear();if(!img){placeholder('画像を選択してください');return}const palettes={classic:[['#ffd400','#e60023'],['#00c2ff','#111111'],['#ff375f','#1c1c1e'],['#45d483','#111111']],neon:[['#ff2bd6','#1616ff'],['#00f5d4','#ff006e'],['#fee440','#8338ec'],['#00bbf9','#f15bb5']],pastel:[['#ffd6e0','#6d597a'],['#bde0fe','#2b2d42'],['#caffbf','#6b705c'],['#fdffb6','#9d4edd']]};const p=palettes[str('palette','classic')],contrast=val('contrast',130)/100,dots=val('dots',4);const off=document.createElement('canvas');off.width=450;off.height=450;const ox=off.getContext('2d');fitDraw(ox,img,0,0,450,450);let data=ox.getImageData(0,0,450,450);for(let q=0;q<4;q++){const d=new ImageData(new Uint8ClampedArray(data.data),450,450),a=hex(p[q][0]),b=hex(p[q][1]);for(let i=0;i<d.data.length;i+=4){let l=(d.data[i]*.299+d.data[i+1]*.587+d.data[i+2]*.114)/255;l=Math.max(0,Math.min(1,(l-.5)*contrast+.5));const cc=l>.5?a:b;d.data[i]=cc[0];d.data[i+1]=cc[1];d.data[i+2]=cc[2]}const tmp=document.createElement('canvas');tmp.width=450;tmp.height=450;tmp.getContext('2d').putImageData(d,0,0);const x=q%2*450,y=Math.floor(q/2)*450;ctx.drawImage(tmp,x,y);if(dots>0){ctx.fillStyle='rgba(0,0,0,.18)';for(let yy=y+dots;yy<y+450;yy+=dots*3)for(let xx=x+dots;xx<x+450;xx+=dots*3){ctx.beginPath();ctx.arc(xx,yy,Math.max(1,dots*.25),0,Math.PI*2);ctx.fill()}}}}
function pixel(){clear();if(!img){placeholder('画像を選択してください');return}const px=val('pixel',16),colors=val('colors',16),sat=val('sat',110)/100,w=Math.max(1,Math.round(900/px)),h=w,off=document.createElement('canvas');off.width=w;off.height=h;const ox=off.getContext('2d');fitDraw(ox,img,0,0,w,h);const d=ox.getImageData(0,0,w,h),levels=Math.max(2,Math.round(Math.cbrt(colors)));for(let i=0;i<d.data.length;i+=4){let r=d.data[i],g=d.data[i+1],b=d.data[i+2],avg=(r+g+b)/3;r=avg+(r-avg)*sat;g=avg+(g-avg)*sat;b=avg+(b-avg)*sat;const q=x=>Math.round(Math.max(0,Math.min(255,x))/255*(levels-1))*255/(levels-1);d.data[i]=q(r);d.data[i+1]=q(g);d.data[i+2]=q(b)}ox.putImageData(d,0,0);ctx.imageSmoothingEnabled=false;ctx.drawImage(off,0,0,900,900);ctx.imageSmoothingEnabled=true}
function sticker(){clear();if(!img){placeholder('透明PNGがおすすめです');return}const border=val('border',14),pad=val('padding',30),shadow=val('shadow',12),bc=str('borderColor','#fff');const scale=Math.min((900-pad*2)/img.naturalWidth,(900-pad*2)/img.naturalHeight),w=img.naturalWidth*scale,h=img.naturalHeight*scale,x=(900-w)/2,y=(900-h)/2;ctx.save();ctx.shadowColor='rgba(0,0,0,.25)';ctx.shadowBlur=shadow;ctx.shadowOffsetY=shadow*.6;ctx.drawImage(img,x,y,w,h);ctx.restore();ctx.save();ctx.globalCompositeOperation='destination-over';ctx.fillStyle=bc;for(let a=0;a<Math.PI*2;a+=Math.PI/24){ctx.drawImage(img,x+Math.cos(a)*border,y+Math.sin(a)*border,w,h)}ctx.restore();ctx.drawImage(img,x,y,w,h)}
function hex(s){s=s.replace('#','');return [parseInt(s.slice(0,2),16),parseInt(s.slice(2,4),16),parseInt(s.slice(4,6),16)]}function placeholder(t){clear();ctx.fillStyle='#f3f2ee';ctx.fillRect(0,0,900,900);ctx.fillStyle='#777';ctx.font='700 28px sans-serif';ctx.textAlign='center';ctx.fillText(t,450,455)}
function draw(){if(tool==='speed-lines')speed();else if(tool==='speech-bubble')bubble();else if(tool==='manga-sfx')sfx();else if(tool==='pop-art')pop();else if(tool==='pixel-art')pixel();else sticker()}
file.onchange=()=>{const f=file.files&&file.files[0];if(!f)return;const u=URL.createObjectURL(f),im=new Image;im.onload=()=>{img=im;URL.revokeObjectURL(u);draw()};im.src=u};randomize.onclick=()=>{seed=Math.floor(Math.random()*99999)+1;draw()};download.onclick=()=>{const a=document.createElement('a');a.download=tool+'.png';a.href=c.toDataURL('image/png');a.click()};downloadSvg.onclick=()=>{if(tool!=='speech-bubble')return;const blob=new Blob([bubbleSvg()],{type:'image/svg+xml'}),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='speech-bubble.svg';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000)};draw();
})();
</script></body></html>