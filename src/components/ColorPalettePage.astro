---
import SiteHeader from "./SiteHeader.astro";
const { locale = "ja" } = Astro.props;
const title = "画像カラーパレット生成｜写真から配色・カラーコードを抽出 | stamp moke";
const desc = "画像を入れるだけで主要カラーを抽出。HEX・RGB・CMYK・PANTONE近似、配色ムード、3色・4色・5色の相性配色を無料で提案。画像はアップロードせずブラウザ内だけで処理します。";
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href="https://stamp-moke.jp/color-palette/" />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://stamp-moke.jp/color-palette/" />
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f7f6f2;color:#171717;font-family:Arial,"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.wrap{max-width:1180px;margin:auto;padding:38px 22px 90px}.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:26px;align-items:end;margin-bottom:26px}.eyebrow{font-size:10px;font-weight:900;letter-spacing:.2em;color:#777;margin-bottom:12px}.hero h1{font-size:clamp(37px,5.2vw,68px);line-height:1.02;letter-spacing:-.055em;margin:0}.hero p{font-size:13px;line-height:1.85;color:#666;max-width:720px}.badges{display:flex;flex-wrap:wrap;gap:7px;margin-top:17px}.badge{background:#fff;border:1px solid #deddd8;border-radius:999px;padding:7px 10px;font-size:10px;font-weight:800}.privacy{background:#161616;color:#fff;border-radius:19px;padding:18px 20px;font-size:12px;line-height:1.75}.privacy strong{display:block;font-size:14px;margin-bottom:4px}.panel{background:#fff;border:1px solid #deddd8;border-radius:22px;box-shadow:0 12px 34px rgba(35,32,23,.055);overflow:hidden}.upload{margin-bottom:18px}.drop{min-height:230px;padding:30px;border:2px dashed #cbc9c1;display:flex;align-items:center;justify-content:center;text-align:center;background:#fbfaf7;cursor:pointer;transition:.18s}.drop.drag{background:#f1efe7;border-color:#777}.drop strong{display:block;font-size:19px;margin-bottom:8px}.drop span{font-size:11px;color:#777}.drop input{display:none}.workspace{display:none;grid-template-columns:minmax(300px,.92fr) minmax(0,1.08fr);gap:18px}.workspace.show{display:grid}.image-box{padding:14px}.image-stage{background:#ecebe6;border-radius:16px;overflow:hidden;min-height:330px;display:flex;align-items:center;justify-content:center;position:relative}.image-stage canvas{display:block;max-width:100%;height:auto;cursor:crosshair}.hint{font-size:11px;color:#777;line-height:1.65;padding:11px 4px 2px}.result{padding:19px}.section-title{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:11px}.section-title h2{font-size:19px;margin:0}.section-title span{font-size:10px;color:#888}.count-switch{display:flex;gap:5px;margin:0 0 13px}.count-switch button,.mode-tabs button{border:1px solid #d8d7d1;background:#fff;border-radius:999px;padding:7px 11px;font-weight:800;font-size:10px;cursor:pointer}.count-switch button.active,.mode-tabs button.active{background:#171717;color:#fff;border-color:#171717}.palette{display:grid;grid-template-columns:repeat(5,1fr);border-radius:15px;overflow:hidden;border:1px solid #deddd8;min-height:112px}.swatch{position:relative;min-width:0;cursor:pointer}.swatch .hex{position:absolute;left:8px;bottom:8px;background:rgba(255,255,255,.86);backdrop-filter:blur(5px);padding:5px 7px;border-radius:8px;font-size:9px;font-weight:900;box-shadow:0 2px 8px rgba(0,0,0,.08)}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:12px}.color-card{border:1px solid #e1dfd8;border-radius:14px;padding:10px}.color-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}.dot{width:26px;height:26px;border-radius:9px;border:1px solid rgba(0,0,0,.08);cursor:pointer}.color-head strong{font-size:11px}.codes{display:grid;gap:4px}.code{display:flex;align-items:center;justify-content:space-between;gap:6px;background:#f7f6f2;border-radius:8px;padding:6px 8px;font-size:9px}.code button{border:0;background:none;cursor:pointer;font:inherit;font-weight:900;color:#555}.mood{margin-top:18px;border-top:1px solid #e5e3dc;padding-top:17px}.mood-grid{display:flex;flex-wrap:wrap;gap:7px}.mood-pill{border-radius:999px;background:#f1f0eb;padding:7px 10px;font-size:10px;font-weight:800}.mood-copy{font-size:11px;color:#666;line-height:1.75;margin:10px 0 0}.harmonies{margin-top:18px;border-top:1px solid #e5e3dc;padding-top:17px}.mode-tabs{display:flex;gap:5px;flex-wrap:wrap;margin:11px 0}.harmony-list{display:grid;gap:9px}.harmony{border:1px solid #deddd8;border-radius:15px;padding:10px;cursor:pointer;transition:.15s}.harmony:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(0,0,0,.05)}.harmony-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}.harmony-top strong{font-size:11px}.harmony-top span{font-size:9px;color:#777}.mini{display:flex;height:56px;border-radius:10px;overflow:hidden}.mini i{flex:1;display:block}.banner-demo{margin-top:18px;border-top:1px solid #e5e3dc;padding-top:17px}.banner{border-radius:17px;overflow:hidden;min-height:190px;padding:26px;display:flex;align-items:center;justify-content:space-between;gap:18px}.banner-copy small{font-weight:900;letter-spacing:.12em}.banner-copy h3{font-size:34px;line-height:1;margin:8px 0}.banner-copy p{font-size:11px;margin:0;max-width:390px;line-height:1.6}.banner-cta{border-radius:999px;padding:11px 16px;font-size:10px;font-weight:900;white-space:nowrap}.reset{margin-top:14px;border:1px solid #d8d7d1;background:#fff;border-radius:12px;padding:9px 13px;font-size:10px;font-weight:900;cursor:pointer}.modal-back{position:fixed;inset:0;background:rgba(0,0,0,.48);display:none;align-items:center;justify-content:center;padding:18px;z-index:1000}.modal-back.show{display:flex}.modal{background:#fff;border-radius:22px;width:min(760px,100%);max-height:90vh;overflow:auto;padding:21px}.modal-head{display:flex;justify-content:space-between;gap:14px;align-items:start}.modal-color{width:70px;height:70px;border-radius:17px;border:1px solid rgba(0,0,0,.08)}.modal h2{font-size:23px;margin:0 0 5px}.modal-sub{font-size:11px;color:#777}.close{border:0;background:#f0efea;border-radius:999px;width:34px;height:34px;font-size:18px;cursor:pointer}.modal .mode-tabs{margin-top:18px}.modal-palettes{display:grid;gap:11px}.modal-palette{border:1px solid #deddd8;border-radius:15px;overflow:hidden}.modal-stripe{display:flex;height:82px}.modal-stripe button{flex:1;border:0;cursor:pointer;position:relative}.modal-stripe button span{position:absolute;left:6px;bottom:6px;background:rgba(255,255,255,.86);border-radius:7px;padding:4px 5px;font-size:8px;font-weight:900}.modal-meta{padding:10px 11px;font-size:10px;display:flex;justify-content:space-between;gap:10px}.copy-all{border:1px solid #d8d7d1;background:#fff;border-radius:9px;padding:6px 8px;font-size:9px;font-weight:900;cursor:pointer}.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(18px);opacity:0;background:#161616;color:#fff;border-radius:999px;padding:9px 14px;font-size:10px;font-weight:800;transition:.2s;z-index:1200}.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}@media(max-width:850px){.hero,.workspace{grid-template-columns:1fr}.image-stage{min-height:250px}.palette{min-height:95px}.banner{min-height:160px}}@media(max-width:600px){.wrap{padding:27px 11px 70px}.hero h1{font-size:42px}.cards{grid-template-columns:1fr}.palette{min-height:88px}.swatch .hex{font-size:8px;left:4px;bottom:5px;padding:4px}.result,.image-box{padding:11px}.banner{padding:18px;align-items:flex-start;flex-direction:column}.banner-copy h3{font-size:27px}.modal{padding:15px}}
</style>
</head>
<body>
<SiteHeader locale={locale} path="/color-palette/" />
<main class="wrap">
<section class="hero"><div><div class="eyebrow">COLOR PALETTE MAKER</div><h1>画像から、使える配色を。</h1><p>写真やイラストから主要カラーを抽出し、HEX・RGB・CMYK・PANTONE近似を表示。さらに、選んだ色を軸にバナーやWebデザインで使いやすい3色・4色・5色の配色を提案します。</p><div class="badges"><span class="badge">無料</span><span class="badge">登録不要</span><span class="badge">画像を保存しません</span><span class="badge">ブラウザ内処理</span></div></div><aside class="privacy"><strong>画像はサーバーへ送信しません。</strong>選択した画像はこの端末のブラウザ内だけで解析します。ページを閉じると画像データは残りません。</aside></section>
<section class="panel upload"><label class="drop" id="drop"><input id="file" type="file" accept="image/png,image/jpeg,image/webp" /><div><strong>画像をここにドロップ</strong><span>またはクリックして画像を選択 · PNG / JPG / WebP</span></div></label></section>
<section class="workspace" id="workspace"><div class="panel image-box"><div class="image-stage"><canvas id="canvas"></canvas></div><div class="hint">画像の好きな場所をクリックすると、その色を基準色として相性のいい配色を作れます。</div><button class="reset" id="reset">別の画像を選ぶ</button></div><div class="panel result"><div class="section-title"><h2>抽出カラーパレット</h2><span>色をクリック → 配色提案</span></div><div class="count-switch" id="countSwitch"><button data-count="3">3色</button><button class="active" data-count="5">5色</button><button data-count="8">8色</button><button data-count="10">10色</button></div><div class="palette" id="palette"></div><div class="cards" id="cards"></div><div class="mood"><div class="section-title"><h2>配色ムード</h2><span>色相・彩度・明度から分析</span></div><div class="mood-grid" id="moodGrid"></div><p class="mood-copy" id="moodCopy"></p></div><div class="harmonies"><div class="section-title"><h2>バナー向けおすすめ配色</h2><span>クリックでプレビュー</span></div><div class="mode-tabs" id="inlineTabs"><button class="active" data-n="3">3色</button><button data-n="4">4色</button><button data-n="5">5色</button></div><div class="harmony-list" id="harmonyList"></div></div><div class="banner-demo"><div class="section-title"><h2>バナープレビュー</h2><span>配色の使い方を確認</span></div><div class="banner" id="banner"><div class="banner-copy"><small>NEW COLLECTION</small><h3>COLOR SALE</h3><p>背景・文字・アクセントのバランスを、実際のバナーに近い形で確認できます。</p></div><div class="banner-cta">CHECK NOW</div></div></div></div></section>
</main>
<div class="modal-back" id="modalBack"><div class="modal"><div class="modal-head"><div style="display:flex;gap:13px;align-items:center"><div class="modal-color" id="modalColor"></div><div><h2 id="modalHex">#000000</h2><div class="modal-sub">この色を主役にした相性配色</div></div></div><button class="close" id="close">×</button></div><div class="mode-tabs" id="modalTabs"><button class="active" data-n="3">3色</button><button data-n="4">4色</button><button data-n="5">5色</button></div><div class="modal-palettes" id="modalPalettes"></div></div></div><div class="toast" id="toast">コピーしました</div>
<script>
const $=id=>document.getElementById(id);const file=$("file"),drop=$("drop"),workspace=$("workspace"),canvas=$("canvas"),ctx=canvas.getContext("2d",{willReadFrequently:true}),palette=$("palette"),cards=$("cards"),countSwitch=$("countSwitch"),moodGrid=$("moodGrid"),moodCopy=$("moodCopy"),harmonyList=$("harmonyList"),banner=$("banner"),modalBack=$("modalBack"),modalColor=$("modalColor"),modalHex=$("modalHex"),modalPalettes=$("modalPalettes"),toast=$("toast");let pixels=[],colors=[],base="#7a5cff",extractCount=5,harmonyCount=3;
const clamp=(v,a=0,b=255)=>Math.min(b,Math.max(a,v));const hex=n=>Math.round(clamp(n)).toString(16).padStart(2,"0");const rgbHex=(r,g,b)=>`#${hex(r)}${hex(g)}${hex(b)}`.toUpperCase();const hexRgb=h=>{h=h.replace("#","");return [parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)]};
function rgbHsl(r,g,b){r/=255;g/=255;b/=255;let mx=Math.max(r,g,b),mn=Math.min(r,g,b),d=mx-mn,h=0,s=0,l=(mx+mn)/2;if(d){s=d/(1-Math.abs(2*l-1));if(mx===r)h=60*(((g-b)/d)%6);else if(mx===g)h=60*((b-r)/d+2);else h=60*((r-g)/d+4)}return[(h+360)%360,s*100,l*100]}
function hslRgb(h,s,l){h=((h%360)+360)%360;s/=100;l/=100;let c=(1-Math.abs(2*l-1))*s,x=c*(1-Math.abs((h/60)%2-1)),m=l-c/2,r=0,g=0,b=0;if(h<60)[r,g,b]=[c,x,0];else if(h<120)[r,g,b]=[x,c,0];else if(h<180)[r,g,b]=[0,c,x];else if(h<240)[r,g,b]=[0,x,c];else if(h<300)[r,g,b]=[x,0,c];else[r,g,b]=[c,0,x];return[(r+m)*255,(g+m)*255,(b+m)*255]}
const hslHex=(h,s,l)=>rgbHex(...hslRgb(h,s,l));
function cmyk(r,g,b){let R=r/255,G=g/255,B=b/255,k=1-Math.max(R,G,B);if(k>.999)return[0,0,0,100];return [Math.round((1-R-k)/(1-k)*100),Math.round((1-G-k)/(1-k)*100),Math.round((1-B-k)/(1-k)*100),Math.round(k*100)]}
const pantones=[['Black C','#2D2926'],['Cool Gray 5 C','#B1B3B3'],['Warm Gray 3 C','#BFB8AF'],['186 C','#C8102E'],['485 C','#DA291C'],['165 C','#FF671F'],['123 C','#FFC72C'],['354 C','#00B140'],['347 C','#009A44'],['326 C','#00B2A9'],['Process Blue C','#0085CA'],['286 C','#0033A0'],['2685 C','#330072'],['2592 C','#9B26B6'],['Rubine Red C','#CE0058'],['7424 C','#E50046'],['468 C','#DDCBA4'],['4655 C','#C4A484'],['7499 C','#F1E6B2'],['White','#FFFFFF']];
function nearestPantone(h){let [r,g,b]=hexRgb(h),best=pantones[0],d=1e9;for(const p of pantones){const [x,y,z]=hexRgb(p[1]),n=(r-x)**2+(g-y)**2+(b-z)**2;if(n<d){d=n;best=p}}return `PANTONE ${best[0]} 近似`}
function sampleImage(img){const max=780,s=Math.min(1,max/img.width,max/img.height);canvas.width=Math.round(img.width*s);canvas.height=Math.round(img.height*s);ctx.clearRect(0,0,canvas.width,canvas.height);ctx.drawImage(img,0,0,canvas.width,canvas.height);const d=ctx.getImageData(0,0,canvas.width,canvas.height).data;pixels=[];const step=Math.max(4,Math.floor((canvas.width*canvas.height)/42000)*4);for(let i=0;i<d.length;i+=step){if(d[i+3]<180)continue;pixels.push([d[i],d[i+1],d[i+2]])}extract();workspace.classList.add('show');drop.parentElement.style.display='none'}
function extract(){if(!pixels.length)return;const k=extractCount,cent=[];for(let i=0;i<k;i++)cent.push([...pixels[Math.floor((i+.5)*pixels.length/k)%pixels.length]]);for(let loop=0;loop<10;loop++){const sums=Array.from({length:k},()=>[0,0,0,0]);for(let p=0;p<pixels.length;p+=2){const v=pixels[p];let bi=0,bd=1e9;for(let j=0;j<k;j++){const c=cent[j],dd=(v[0]-c[0])**2+(v[1]-c[1])**2+(v[2]-c[2])**2;if(dd<bd){bd=dd;bi=j}}sums[bi][0]+=v[0];sums[bi][1]+=v[1];sums[bi][2]+=v[2];sums[bi][3]++}for(let j=0;j<k;j++)if(sums[j][3])cent[j]=sums[j].slice(0,3).map(x=>x/sums[j][3])}colors=cent.map(c=>rgbHex(...c)).filter((v,i,a)=>a.indexOf(v)===i);while(colors.length<k)colors.push(hslHex((colors.length*47)%360,45,60));base=colors[0];render()}
function copy(txt){navigator.clipboard.writeText(txt);toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),1000)}
function render(){palette.style.gridTemplateColumns=`repeat(${colors.length},1fr)`;palette.innerHTML=colors.map(c=>`<div class="swatch" data-color="${c}" style="background:${c}"><span class="hex">${c}</span></div>`).join('');cards.innerHTML=colors.slice(0,Math.min(6,colors.length)).map((c,i)=>{const [r,g,b]=hexRgb(c),[C,M,Y,K]=cmyk(r,g,b);return `<div class="color-card"><div class="color-head"><span class="dot" data-color="${c}" style="background:${c}"></span><strong>COLOR ${i+1}</strong></div><div class="codes"><div class="code"><span>HEX ${c}</span><button data-copy="${c}">COPY</button></div><div class="code"><span>RGB ${r}, ${g}, ${b}</span><button data-copy="rgb(${r}, ${g}, ${b})">COPY</button></div><div class="code"><span>CMYK ${C}, ${M}, ${Y}, ${K}</span><button data-copy="${C}, ${M}, ${Y}, ${K}">COPY</button></div><div class="code"><span>${nearestPantone(c)}</span><button data-copy="${nearestPantone(c)}">COPY</button></div></div></div>`}).join('');renderMood();renderHarmonies();applyBanner(makeSets(base,harmonyCount)[0].colors);document.querySelectorAll('[data-copy]').forEach(b=>b.onclick=()=>copy(b.dataset.copy));document.querySelectorAll('[data-color]').forEach(el=>el.onclick=()=>openColor(el.dataset.color))}
function renderMood(){let sat=0,light=0,warm=0;colors.forEach(c=>{const [r,g,b]=hexRgb(c),[h,s,l]=rgbHsl(r,g,b);sat+=s;light+=l;if((h<70||h>320))warm++});sat/=colors.length;light/=colors.length;const arr=[];if(sat<30)arr.push(['落ち着いた',92],['上品',82]);else if(sat>65)arr.push(['ポップ',91],['エネルギッシュ',82]);else arr.push(['バランス',88],['ナチュラル',76]);if(light>68)arr.push(['やさしい',86],['爽やか',74]);else if(light<38)arr.push(['クール',84],['高級感',76]);if(warm>colors.length/2)arr.push(['あたたかい',81]);else arr.push(['涼しげ',78]);moodGrid.innerHTML=arr.slice(0,5).map(x=>`<span class="mood-pill">${x[0]} ${x[1]}%</span>`).join('');moodCopy.textContent=sat>65?'彩度が高めで視認性と勢いのある配色です。セール、キャンペーン、SNSバナーなど、短時間で目を引かせたいデザインと相性があります。':light>65?'明るく柔らかな色が中心です。美容、雑貨、食品、ライフスタイル系など、親しみや安心感を出したいバナーに向いています。':'彩度と明度のバランスが穏やかです。商品を主役にしながら、長時間見ても疲れにくいWeb・ECデザインに使いやすい構成です。'}
function makeSets(c,n){const [r,g,b]=hexRgb(c),[h,s,l]=rgbHsl(r,g,b),S=Math.max(34,Math.min(82,s)),L=Math.max(34,Math.min(68,l));const schemes=n===3?[['王道・補色',[c,hslHex(h+180,S,L),hslHex(h,S*.3,96)]],['やさしい・類似',[c,hslHex(h+28,S*.72,Math.min(78,L+10)),hslHex(h,S*.2,96)]],['メリハリ・三角',[c,hslHex(h+120,S*.75,L),hslHex(h+240,S*.75,L)]]]:n===4?[['バナー基本',[hslHex(h,S*.18,97),c,hslHex(h+180,S,L),hslHex(h,S*.2,20)]],['スプリット',[c,hslHex(h+150,S*.78,L),hslHex(h+210,S*.78,L),hslHex(h,S*.18,95)]],['トーン統一',[hslHex(h,S*.25,94),hslHex(h,S*.55,77),c,hslHex(h,S*.45,24)]]]:[['ブランド基本',[hslHex(h,S*.18,97),hslHex(h,S*.42,82),c,hslHex(h+180,S*.82,L),hslHex(h,S*.18,20)]],['類似5色',[hslHex(h-35,S*.58,82),hslHex(h-15,S*.72,70),c,hslHex(h+20,S*.76,62),hslHex(h+45,S*.62,78)]],['ECメリハリ',[hslHex(h,S*.12,98),c,hslHex(h+35,S*.8,L),hslHex(h+180,S*.78,L),hslHex(h,S*.2,18)]]];return schemes.map(x=>({name:x[0],colors:x[1]}))}
function renderHarmonies(){const sets=makeSets(base,harmonyCount);harmonyList.innerHTML=sets.map((s,i)=>`<div class="harmony" data-hi="${i}"><div class="harmony-top"><strong>${s.name}</strong><span>${harmonyCount}色配色</span></div><div class="mini">${s.colors.map(c=>`<i style="background:${c}"></i>`).join('')}</div></div>`).join('');harmonyList.querySelectorAll('.harmony').forEach((el,i)=>el.onclick=()=>applyBanner(sets[i].colors))}
function textColor(bg){const [r,g,b]=hexRgb(bg);return (r*299+g*587+b*114)/1000>150?'#171717':'#FFFFFF'}
function applyBanner(cs){const bg=cs[0],main=cs[1]||cs[0],accent=cs[2]||cs[1]||cs[0],txt=cs[cs.length-1]||textColor(bg);banner.style.background=bg;banner.style.color=textColor(bg);banner.querySelector('h3').style.color=main===bg?textColor(bg):main;banner.querySelector('.banner-cta').style.background=accent;banner.querySelector('.banner-cta').style.color=textColor(accent);banner.querySelector('small').style.color=cs.length>3?cs[cs.length-1]:textColor(bg)}
function openColor(c){base=c;modalColor.style.background=c;modalHex.textContent=c;modalBack.classList.add('show');renderHarmonies();renderModal()}
function renderModal(){const sets=makeSets(base,harmonyCount);modalPalettes.innerHTML=sets.map((s,i)=>`<div class="modal-palette"><div class="modal-stripe">${s.colors.map(c=>`<button data-mcolor="${c}" style="background:${c}"><span>${c}</span></button>`).join('')}</div><div class="modal-meta"><span><strong>${s.name}</strong> · バナー/WEB向け</span><button class="copy-all" data-all="${s.colors.join(' ')}">全部コピー</button></div></div>`).join('');modalPalettes.querySelectorAll('[data-mcolor]').forEach(b=>b.onclick=()=>copy(b.dataset.mcolor));modalPalettes.querySelectorAll('[data-all]').forEach(b=>b.onclick=()=>copy(b.dataset.all))}
function load(f){if(!f||!f.type.startsWith('image/'))return;const img=new Image(),url=URL.createObjectURL(f);img.onload=()=>{sampleImage(img);URL.revokeObjectURL(url)};img.src=url}
file.onchange=e=>load(e.target.files[0]);drop.ondragover=e=>{e.preventDefault();drop.classList.add('drag')};drop.ondragleave=()=>drop.classList.remove('drag');drop.ondrop=e=>{e.preventDefault();drop.classList.remove('drag');load(e.dataTransfer.files[0])};countSwitch.onclick=e=>{const b=e.target.closest('button');if(!b)return;extractCount=+b.dataset.count;countSwitch.querySelectorAll('button').forEach(x=>x.classList.toggle('active',x===b));extract()};document.querySelectorAll('#inlineTabs button').forEach(b=>b.onclick=()=>{harmonyCount=+b.dataset.n;document.querySelectorAll('#inlineTabs button').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('#modalTabs button').forEach(x=>x.classList.toggle('active',+x.dataset.n===harmonyCount));renderHarmonies()});document.querySelectorAll('#modalTabs button').forEach(b=>b.onclick=()=>{harmonyCount=+b.dataset.n;document.querySelectorAll('#modalTabs button').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('#inlineTabs button').forEach(x=>x.classList.toggle('active',+x.dataset.n===harmonyCount));renderHarmonies();renderModal()});canvas.onclick=e=>{const r=canvas.getBoundingClientRect(),x=Math.floor((e.clientX-r.left)*canvas.width/r.width),y=Math.floor((e.clientY-r.top)*canvas.height/r.height),d=ctx.getImageData(x,y,1,1).data;if(d[3]>0)openColor(rgbHex(d[0],d[1],d[2]))};$("close").onclick=()=>modalBack.classList.remove('show');modalBack.onclick=e=>{if(e.target===modalBack)modalBack.classList.remove('show')};$("reset").onclick=()=>{workspace.classList.remove('show');drop.parentElement.style.display='block';file.value='';pixels=[];colors=[]};
</script>
</body></html>
